<Project Sdk="Microsoft.NET.Sdk">

  <!-- Import local path overrides if they exist -->
  <Import Project="GamePaths.props" Condition="Exists('GamePaths.props')" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- Pinned, not inherited: RimWorld runs Mono 4.7.2, and the net472 SDK default
         happens to be 7.3 today. Relying on that default would let a future SDK
         silently admit newer syntax the game's runtime cannot load. -->
    <LangVersion>7.3</LangVersion>
    <!-- RimWorld install path - auto-detected per platform (override in GamePaths.props for custom locations) -->
    <!-- 1.7 on macOS reads Mods and Data from the install root; 1.6 read them inside RimWorldMac.app. -->
    <MacSteamRimWorld>$(HOME)/Library/Application Support/Steam/steamapps/common/RimWorld</MacSteamRimWorld>
    <RimWorldDir Condition="'$(RimWorldDir)'=='' And $([MSBuild]::IsOSPlatform('OSX')) And Exists('$(MacSteamRimWorld)/RimWorld.app')">$(MacSteamRimWorld)</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)'=='' And $([MSBuild]::IsOSPlatform('OSX'))">$(MacSteamRimWorld)/RimWorldMac.app</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)'=='' And $([MSBuild]::IsOSPlatform('Linux'))">$(HOME)/.steam/steam/steamapps/common/RimWorld</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)'==''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDir>
    <!-- Mod output folder -->
    <ModOutputDir>$([System.IO.Path]::Combine('$(RimWorldDir)', 'Mods', 'RimWorldAccess'))</ModOutputDir>
    <!-- Disable default compile includes to avoid picking up decompiled game source -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Native Prism library directory (shared across worktrees) -->
    <NativeDir>$(ProjectDir)..\shared\native</NativeDir>
    <!-- Doctrine rules are not advisory: a shadow copy fails the build. See analyzers/README.md. -->
    <WarningsAsErrors>$(WarningsAsErrors);RWA0001</WarningsAsErrors>
  </PropertyGroup>

  <!-- Explicitly include only our source files -->
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <!-- Doctrine analyzers (analyzers/README.md). Referenced for their compile-time effect only,
       never linked into the mod, hence ReferenceOutputAssembly="false". -->
  <ItemGroup>
    <ProjectReference Include="analyzers\RimWorldAccess.Analyzers\RimWorldAccess.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Embed audio files as resources -->
  <ItemGroup>
    <EmbeddedResource Include="Sounds\**\*.wav" />
    <EmbeddedResource Include="Sounds\**\*.ogg" />
    <EmbeddedResource Include="Sounds\**\*.mp3" />
  </ItemGroup>

  <!-- Include native Prism libraries for deployment (NOT as references) -->
  <ItemGroup Condition="'$(NativeDir)'!=''">
    <None Include="$(NativeDir)\prism.dll" Condition="Exists('$(NativeDir)\prism.dll')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="$(NativeDir)\libprism.dylib" Condition="Exists('$(NativeDir)\libprism.dylib')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="$(NativeDir)\libprism.so" Condition="Exists('$(NativeDir)\libprism.so')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- About folder content -->
  <ItemGroup>
    <None Include="About\About.xml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Localization XML files -->
  <ItemGroup>
    <LanguageFiles Include="Languages\**\*.xml" />
  </ItemGroup>

  <!-- Def XML files (RimWorld Access documentation concepts, etc.) -->
  <ItemGroup>
    <DefFiles Include="Defs\**\*.xml" />
  </ItemGroup>

  <!-- Patch XML files (think-tree inserts etc.) -->
  <ItemGroup>
    <PatchFiles Include="Patches\**\*.xml" />
  </ItemGroup>

  <!-- About folder files. Shipped wholesale so About.xml AND, once it exists,
       PublishedFileId.txt (written by Steam after the first Workshop upload, then
       committed into source) both reach the package. Steam matches updates to the
       existing Workshop item by that id, so omitting it would create duplicates. -->
  <ItemGroup>
    <AboutFiles Include="About\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Harmony reference - reference-only package (runtime provided by Harmony mod) -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <!-- RimWorld reference assemblies (includes game and Unity references) -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" />
  </ItemGroup>

  <!-- DEBUG-ONLY: Roslyn scripting for the in-game dev bridge (src/DevBridge).
       Lets external tooling eval C# against the live game. The package and all its
       runtime DLLs are confined to Debug builds (matching the #if DEBUG guards on the
       source) and are NEVER deployed to the Release package, so players never get them. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
  </ItemGroup>

  <!-- Post-build: verify translation-key integrity. Fails the build on "fake"
       keys (.Translate()/.Loc() on a key that exists in no Keyed XML — these
       compile fine and even render plausible English, but speak the raw key
       name in every language) and warns on orphaned keys (defined in our
       English XML but unreferenced in src — the signature of merge-reverted
       announcement code). The Localized-type guard cannot catch either class. -->
  <Target Name="CheckLocalizationKeys" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT'">
    <Exec Command="python3 &quot;$(ProjectDir)scripts/check_l10n_keys.py&quot; --game-dir &quot;$(RimWorldDir)&quot;" />
  </Target>

  <!-- Post-build: verify the mod version matches between src/Core/RimWorldAccessVersion.cs
       and About/About.xml <modVersion>. Drift there would misfire update detection or ship a
       mislabeled mod list, so the build fails if they disagree. (CHANGELOG.md is not checked:
       its release headings are stamped from the version by scripts/build_changelog.py.) -->
  <Target Name="CheckVersionSync" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT'">
    <Exec Command="python3 &quot;$(ProjectDir)scripts/check_version_sync.py&quot;" />
  </Target>

  <!-- Post-build: Copy mod files to RimWorld Mods folder (skip in CI) -->
  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(CI)' != 'true'">
    <Message Text="--- Deploying RimWorld Access mod to $(ModOutputDir) ---" Importance="high" />

    <!-- Create mod folder structure. Wipe Assemblies first so DLLs no longer built
         (e.g. the Roslyn set from an earlier Debug deploy) never linger: RimWorld
         GetTypes()-sweeps every DLL in Assemblies at boot, so a stale corpse there
         is a red boot error. -->
    <RemoveDir Directories="$(ModOutputDir)\Assemblies" />
    <MakeDir Directories="$(ModOutputDir)\About" />
    <MakeDir Directories="$(ModOutputDir)\Assemblies" />

    <!-- Copy About folder (About.xml + PublishedFileId.txt when present) -->
    <Copy
      SourceFiles="@(AboutFiles)"
      DestinationFiles="@(AboutFiles->'$(ModOutputDir)\About\%(RecursiveDir)%(Filename)%(Extension)')"
    />

    <!-- Copy mod DLL to Assemblies folder -->
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(ModOutputDir)\Assemblies\"
    />

    <!-- DEBUG-ONLY: deploy the Roslyn scripting runtime that the dev bridge (src/DevBridge)
         needs to eval C# in-game. These DLLs exist only in the Debug output (the package is
         Debug-conditioned above), so this copy is a no-op for Release and the Release target
         never includes them - players never receive them. Everything in the output dir except
         our own DLL is the Roslyn dependency set. They deploy OUTSIDE Assemblies/ because
         RimWorld GetTypes()-sweeps every DLL there at boot and Microsoft.CodeAnalysis.Scripting
         references System.Runtime.Loader types Mono lacks, producing a red boot error; the
         bridge loads them itself from this folder (RoslynRuntimeLoader). The wipe is
         unconditional so a Release deploy clears a previous Debug deploy's copy. -->
    <RemoveDir Directories="$(ModOutputDir)\DevBridgeLibs" />
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
      <_DevBridgeDlls Include="$(OutDir)*.dll" Exclude="$(OutDir)$(TargetFileName)" />
    </ItemGroup>
    <Copy
      Condition="'$(Configuration)' == 'Debug'"
      SourceFiles="@(_DevBridgeDlls)"
      DestinationFolder="$(ModOutputDir)\DevBridgeLibs\"
    />

    <!-- Copy Defs folder, preserving subdirectory structure. Wipe first so a
         removed/renamed Def does not linger in the deployed mod. -->
    <RemoveDir Directories="$(ModOutputDir)\Defs" />
    <Copy
      SourceFiles="@(DefFiles)"
      DestinationFiles="@(DefFiles->'$(ModOutputDir)\Defs\%(RecursiveDir)%(Filename)%(Extension)')"
    />

    <!-- Copy Patches folder, same wipe-first contract as Defs. -->
    <RemoveDir Directories="$(ModOutputDir)\Patches" />
    <Copy
      SourceFiles="@(PatchFiles)"
      DestinationFiles="@(PatchFiles->'$(ModOutputDir)\Patches\%(RecursiveDir)%(Filename)%(Extension)')"
    />

    <!-- Bundle each language into a .tar exactly as the Release package does, so the
         deployed mod is byte-for-byte what ships and there is a SINGLE language
         artifact per language. RimWorld loads "<Lang>.tar" in preference to a loose
         "<Lang>/" dir, so shipping both lets a stale .tar silently shadow fresh loose
         XML (only newly added keys go missing — a maddening, near-invisible failure).
         The Mods folder is a build output, never hand-edited, so loose files buy
         nothing. Wipe Languages first to clear any stale .tar or loose dir, stage the
         XML, archive Keyed/, then drop the loose staging so only the .tar remains. -->
    <RemoveDir Directories="$(ModOutputDir)\Languages" />
    <Copy
      SourceFiles="@(LanguageFiles)"
      DestinationFiles="@(LanguageFiles->'$(ModOutputDir)\Languages\%(RecursiveDir)%(Filename)%(Extension)')"
    />
    <ItemGroup>
      <_DeployLangDir Include="$([System.IO.Directory]::GetDirectories('$(ModOutputDir)\Languages'))" />
    </ItemGroup>
    <Exec
      Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
      Command="COPYFILE_DISABLE=1 tar --no-xattrs -cf &quot;%(_DeployLangDir.Identity).tar&quot; -C &quot;%(_DeployLangDir.Identity)&quot; Keyed"
    />
    <!-- Windows ships bsdtar in System32, but Git for Windows puts GNU tar on PATH ahead
         of it, and GNU tar reads a leading "C:" as a remote host (rmt "host:path" syntax),
         failing with "Cannot connect to C: resolve failed". Which tar wins is a PATH race,
         so the build broke on some machines and not others. GNU tar's force-local option
         would fix GNU tar and break bsdtar, which rejects that option outright. Instead keep
         every path relative via WorkingDirectory: no colon in an argument, both tars agree. -->
    <Exec
      Condition="$([MSBuild]::IsOSPlatform('Windows'))"
      WorkingDirectory="%(_DeployLangDir.Identity)"
      Command="tar -cf &quot;..\%(_DeployLangDir.Filename).tar&quot; Keyed"
    />
    <!-- Append DefInjected/ when a language ships it (chapters + concept overrides live
         there, not in Keyed/). Only some languages have it, so guard on existence or tar
         errors on the languages that don't. Keyed/ stays the archive root for the guard. -->
    <Exec
      Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
      Command="if test -d &quot;%(_DeployLangDir.Identity)/DefInjected&quot;; then COPYFILE_DISABLE=1 tar --no-xattrs -rf &quot;%(_DeployLangDir.Identity).tar&quot; -C &quot;%(_DeployLangDir.Identity)&quot; DefInjected; fi"
    />
    <Exec
      Condition="$([MSBuild]::IsOSPlatform('Windows'))"
      WorkingDirectory="%(_DeployLangDir.Identity)"
      Command="if exist DefInjected tar -rf &quot;..\%(_DeployLangDir.Filename).tar&quot; DefInjected"
    />
    <RemoveDir Directories="@(_DeployLangDir)" />
    <!-- Guard the silent-fallback gotcha: a mis-rooted archive (entries not at Keyed/)
         makes RimWorld quietly fall back to English, which is invisible while testing
         in English. Fail the build instead if any .tar is not rooted at Keyed/. -->
    <Exec
      Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
      Command="tar -tf &quot;%(_DeployLangDir.Identity).tar&quot; | grep -q '^Keyed/'"
    />

    <!-- Copy native Prism libraries to mod root (for runtime loading) -->
    <Copy
      SourceFiles="$(NativeDir)\prism.dll"
      DestinationFolder="$(ModOutputDir)\"
      Condition="'$(NativeDir)'!='' And Exists('$(NativeDir)\prism.dll')"
    />
    <Copy
      SourceFiles="$(NativeDir)\libprism.dylib"
      DestinationFolder="$(ModOutputDir)\"
      Condition="'$(NativeDir)'!='' And Exists('$(NativeDir)\libprism.dylib')"
    />
    <Copy
      SourceFiles="$(NativeDir)\libprism.so"
      DestinationFolder="$(ModOutputDir)\"
      Condition="'$(NativeDir)'!='' And Exists('$(NativeDir)\libprism.so')"
    />

    <Message Text="--- Mod deployed successfully ---" Importance="high" />

    <!-- Hot reload: if a Debug game session is running, ask its dev bridge to body-swap the
         freshly deployed DLL into the live game. Connection refused (game not running) is
         silent; the reload report prints so restart-required items are visible in the build. -->
    <Exec
      Condition="'$(Configuration)' == 'Debug' And !$([MSBuild]::IsOSPlatform('Windows'))"
      Command="curl -s -m 120 -X POST --data-binary '' http://127.0.0.1:8787/reload 2>/dev/null || true"
      ContinueOnError="true"
      IgnoreExitCode="true"
      ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="HotReloadReport" />
    </Exec>
    <Message Text="--- Hot reload: $(HotReloadReport) ---" Importance="high" Condition="'$(HotReloadReport)' != ''" />
  </Target>

  <!-- Release target -->
  <Target Name="Release" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Message Text="--- Creating Release Package ---" Importance="high" />

    <PropertyGroup>
      <ReleaseFolderPath>$(ProjectDir)release\RimWorldAccess\</ReleaseFolderPath>
    </PropertyGroup>

    <!-- Wipe the package folder first so files removed from the build (e.g. a
         no-longer-shipped README, a renamed Def) never linger as stale corpses.
         Steam uploads the entire content folder, so a leftover file would be
         published to subscribers. -->
    <RemoveDir Directories="$(ReleaseFolderPath)" />

    <!-- Create release folder structure -->
    <MakeDir Directories="$(ReleaseFolderPath)About" />
    <MakeDir Directories="$(ReleaseFolderPath)Assemblies" />

    <!-- Copy About folder (About.xml + PublishedFileId.txt when present) -->
    <Copy
      SourceFiles="@(AboutFiles)"
      DestinationFiles="@(AboutFiles->'$(ReleaseFolderPath)About\%(RecursiveDir)%(Filename)%(Extension)')"
    />

    <!-- Copy DLL -->
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(ReleaseFolderPath)Assemblies\"
    />

    <!-- Copy Defs folder, preserving subdirectory structure -->
    <Copy
      SourceFiles="@(DefFiles)"
      DestinationFiles="@(DefFiles->'$(ReleaseFolderPath)Defs\%(RecursiveDir)%(Filename)%(Extension)')"
    />

    <!-- Copy Patches folder, preserving subdirectory structure -->
    <Copy
      SourceFiles="@(PatchFiles)"
      DestinationFiles="@(PatchFiles->'$(ReleaseFolderPath)Patches\%(RecursiveDir)%(Filename)%(Extension)')"
    />

    <!-- Copy Languages folder, preserving subdirectory structure -->
    <Copy
      SourceFiles="@(LanguageFiles)"
      DestinationFiles="@(LanguageFiles->'$(ReleaseFolderPath)Languages\%(RecursiveDir)%(Filename)%(Extension)')"
    />

    <!-- Bundle each language into a .tar, the way RimWorld ships its own
         languages: fewer files means faster mod scanning and smoother
         distribution. RimWorld's AbstractFilesystem reads "<Lang>.tar" as if it
         were the "<Lang>" directory. The mod ships only Keyed/, so we archive
         that explicitly to reproduce the game's exact tar layout (Keyed/... at
         the archive root, no "./" prefix, no macOS xattr/AppleDouble junk).
         Release-only: the Debug deploy keeps loose files for fast iteration. -->
    <ItemGroup>
      <_ReleaseLangDir Include="$([System.IO.Directory]::GetDirectories('$(ReleaseFolderPath)Languages'))" />
    </ItemGroup>
    <Exec
      Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
      Command="COPYFILE_DISABLE=1 tar --no-xattrs -cf &quot;%(_ReleaseLangDir.Identity).tar&quot; -C &quot;%(_ReleaseLangDir.Identity)&quot; Keyed"
    />
    <!-- Relative paths via WorkingDirectory, same reason as the deploy step above: a
         drive-letter argument makes GNU tar treat "C:" as a remote host. -->
    <Exec
      Condition="$([MSBuild]::IsOSPlatform('Windows'))"
      WorkingDirectory="%(_ReleaseLangDir.Identity)"
      Command="tar -cf &quot;..\%(_ReleaseLangDir.Filename).tar&quot; Keyed"
    />
    <!-- Append DefInjected/ for languages that ship it (doc chapters + concept overrides).
         Guard on existence: not every language has it, and tar errors on a missing member. -->
    <Exec
      Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
      Command="if test -d &quot;%(_ReleaseLangDir.Identity)/DefInjected&quot;; then COPYFILE_DISABLE=1 tar --no-xattrs -rf &quot;%(_ReleaseLangDir.Identity).tar&quot; -C &quot;%(_ReleaseLangDir.Identity)&quot; DefInjected; fi"
    />
    <Exec
      Condition="$([MSBuild]::IsOSPlatform('Windows'))"
      WorkingDirectory="%(_ReleaseLangDir.Identity)"
      Command="if exist DefInjected tar -rf &quot;..\%(_ReleaseLangDir.Filename).tar&quot; DefInjected"
    />
    <!-- Guard the silent-fallback gotcha: fail the build if any .tar is not rooted at Keyed/. -->
    <Exec
      Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
      Command="tar -tf &quot;%(_ReleaseLangDir.Identity).tar&quot; | grep -q '^Keyed/'"
    />
    <RemoveDir Directories="@(_ReleaseLangDir)" />

    <!-- Copy native Prism libraries to mod root -->
    <Copy
      SourceFiles="$(NativeDir)\prism.dll"
      DestinationFolder="$(ReleaseFolderPath)"
      Condition="'$(NativeDir)'!='' And Exists('$(NativeDir)\prism.dll')"
    />
    <Copy
      SourceFiles="$(NativeDir)\libprism.dylib"
      DestinationFolder="$(ReleaseFolderPath)"
      Condition="'$(NativeDir)'!='' And Exists('$(NativeDir)\libprism.dylib')"
    />
    <Copy
      SourceFiles="$(NativeDir)\libprism.so"
      DestinationFolder="$(ReleaseFolderPath)"
      Condition="'$(NativeDir)'!='' And Exists('$(NativeDir)\libprism.so')"
    />

    <!-- README is intentionally NOT shipped: Steam Workshop uploads the entire
         content folder, and the Workshop listing description comes from About.xml,
         not README. Keeping README out avoids publishing in-repo developer/install
         docs to subscribers. -->

    <!-- Copy LICENSE to release folder -->
    <Copy
      SourceFiles="$(ProjectDir)LICENSE"
      DestinationFolder="$(ReleaseFolderPath)"
      Condition="Exists('$(ProjectDir)LICENSE')"
    />

    <!-- Copy CHANGELOG.md to release ROOT (sibling of RimWorldAccess folder) -->
    <Copy
      SourceFiles="$(ProjectDir)CHANGELOG.md"
      DestinationFolder="$(ProjectDir)release\"
      Condition="Exists('$(ProjectDir)CHANGELOG.md')"
    />

    <Message Text="--- Release package created at $(ReleaseFolderPath) ---" Importance="high" />
  </Target>

  <!--
    Download pinned Prism native libraries from GitHub into shared location.
    PrismVersion is pinned deliberately: pulling "latest" silently ships
    upstream regressions to players (v0.16.2 once broke NVDA backend
    detection, ethindp/prism#49). Bump only after verifying the target
    release, and keep the PrismConfig struct in PrismNative.cs in sync with
    the target's PRISM_CONFIG_VERSION: the struct is returned by value, so a
    layout mismatch corrupts the stack. Never drop below v0.18.0: the Macaw
    plugin load in TolkHelper needs prism_registry_builder_add_library.
    Must match PRISM_VERSION in .github/workflows/build-dev.yml.
  -->
  <Target Name="UpdatePrism">
    <PropertyGroup>
      <PrismDownloadDir>$(ProjectDir)..\shared\native</PrismDownloadDir>
      <PrismVersion>v0.18.2</PrismVersion>
      <PrismBaseUrl>https://github.com/ethindp/prism/releases/download/$(PrismVersion)</PrismBaseUrl>
    </PropertyGroup>
    <Message Text="Downloading Prism $(PrismVersion) native libraries to $(PrismDownloadDir)..." Importance="high" />
    <MakeDir Directories="$(PrismDownloadDir)" />

    <!-- Windows x64 -->
    <Exec Command="curl -sL &quot;$(PrismBaseUrl)/prism-windows-x64.zip&quot; -o &quot;$(PrismDownloadDir)/prism-win.zip&quot;" />
    <Exec Command="unzip -o &quot;$(PrismDownloadDir)/prism-win.zip&quot; -d &quot;$(PrismDownloadDir)/prism-win-tmp&quot;" />
    <Copy SourceFiles="$(PrismDownloadDir)/prism-win-tmp/dynamic/release/bin/prism.dll" DestinationFiles="$(PrismDownloadDir)/prism.dll" />
    <RemoveDir Directories="$(PrismDownloadDir)/prism-win-tmp" />
    <Delete Files="$(PrismDownloadDir)/prism-win.zip" />

    <!-- macOS universal -->
    <Exec Command="curl -sL &quot;$(PrismBaseUrl)/prism-macos-universal.zip&quot; -o &quot;$(PrismDownloadDir)/prism-mac.zip&quot;" />
    <Exec Command="unzip -o &quot;$(PrismDownloadDir)/prism-mac.zip&quot; -d &quot;$(PrismDownloadDir)/prism-mac-tmp&quot;" />
    <Copy SourceFiles="$(PrismDownloadDir)/prism-mac-tmp/dynamic/release/lib/libprism.dylib" DestinationFiles="$(PrismDownloadDir)/libprism.dylib" />
    <RemoveDir Directories="$(PrismDownloadDir)/prism-mac-tmp" />
    <Delete Files="$(PrismDownloadDir)/prism-mac.zip" />

    <!-- Linux x64 -->
    <Exec Command="curl -sL &quot;$(PrismBaseUrl)/prism-linux-x64.zip&quot; -o &quot;$(PrismDownloadDir)/prism-linux.zip&quot;" />
    <Exec Command="unzip -o &quot;$(PrismDownloadDir)/prism-linux.zip&quot; -d &quot;$(PrismDownloadDir)/prism-linux-tmp&quot;" />
    <Copy SourceFiles="$(PrismDownloadDir)/prism-linux-tmp/dynamic/release/lib/libprism.so" DestinationFiles="$(PrismDownloadDir)/libprism.so" />
    <RemoveDir Directories="$(PrismDownloadDir)/prism-linux-tmp" />
    <Delete Files="$(PrismDownloadDir)/prism-linux.zip" />

    <Message Text="Prism $(PrismVersion) native libraries updated successfully." Importance="high" />
  </Target>

  <!-- Auto-download Prism on first build when native libraries are missing (skipped in CI) -->
  <Target Name="BootstrapPrism" BeforeTargets="Build"
          Condition="'$(CI)' != 'true' And !Exists('$(ProjectDir)..\shared\native\prism.dll')">
    <Message Text="Native Prism libraries not found. Running first-time download..." Importance="high" />
    <CallTarget Targets="UpdatePrism" />
  </Target>

</Project>
