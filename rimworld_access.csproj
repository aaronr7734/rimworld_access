<Project Sdk="Microsoft.NET.Sdk">

  <!-- Import local path overrides if they exist -->
  <Import Project="GamePaths.props" Condition="Exists('GamePaths.props')" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- RimWorld install path - auto-detected per platform (override in GamePaths.props for custom locations) -->
    <RimWorldDir Condition="'$(RimWorldDir)'=='' And $([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/Steam/steamapps/common/RimWorld/RimWorldMac.app</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)'=='' And $([MSBuild]::IsOSPlatform('Linux'))">$(HOME)/.steam/steam/steamapps/common/RimWorld</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)'==''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDir>
    <!-- Mod output folder -->
    <ModOutputDir>$([System.IO.Path]::Combine('$(RimWorldDir)', 'Mods', 'RimWorldAccess'))</ModOutputDir>
    <!-- Disable default compile includes to avoid picking up decompiled game source -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Native Prism library directory (shared across worktrees) -->
    <NativeDir>$(ProjectDir)..\shared\native</NativeDir>
  </PropertyGroup>

  <!-- Explicitly include only our source files -->
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <!-- Embed audio files as resources -->
  <ItemGroup>
    <EmbeddedResource Include="Sounds\**\*.wav" />
    <EmbeddedResource Include="Sounds\**\*.ogg" />
    <EmbeddedResource Include="Sounds\**\*.mp3" />
  </ItemGroup>

  <!-- Include native Prism libraries for deployment (NOT as references) -->
  <ItemGroup Condition="'$(NativeDir)'!=''">
    <None Include="$(NativeDir)\prism.dll" Condition="Exists('$(NativeDir)\prism.dll')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="$(NativeDir)\libprism.dylib" Condition="Exists('$(NativeDir)\libprism.dylib')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="$(NativeDir)\libprism.so" Condition="Exists('$(NativeDir)\libprism.so')">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- About folder content -->
  <ItemGroup>
    <None Include="About\About.xml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Harmony reference - reference-only package (runtime provided by Harmony mod) -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <!-- RimWorld reference assemblies (includes game and Unity references) -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" />
  </ItemGroup>

  <!-- Post-build: Copy mod files to RimWorld Mods folder (skip in CI) -->
  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(CI)' != 'true'">
    <Message Text="--- Deploying RimWorld Access mod to $(ModOutputDir) ---" Importance="high" />

    <!-- Create mod folder structure -->
    <MakeDir Directories="$(ModOutputDir)\About" />
    <MakeDir Directories="$(ModOutputDir)\Assemblies" />

    <!-- Copy About.xml -->
    <Copy
      SourceFiles="$(ProjectDir)About\About.xml"
      DestinationFolder="$(ModOutputDir)\About\"
    />

    <!-- Copy mod DLL to Assemblies folder -->
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(ModOutputDir)\Assemblies\"
    />

    <!-- Copy native Prism libraries to mod root (for runtime loading) -->
    <Copy
      SourceFiles="$(NativeDir)\prism.dll"
      DestinationFolder="$(ModOutputDir)\"
      Condition="'$(NativeDir)'!='' And Exists('$(NativeDir)\prism.dll')"
    />
    <Copy
      SourceFiles="$(NativeDir)\libprism.dylib"
      DestinationFolder="$(ModOutputDir)\"
      Condition="'$(NativeDir)'!='' And Exists('$(NativeDir)\libprism.dylib')"
    />
    <Copy
      SourceFiles="$(NativeDir)\libprism.so"
      DestinationFolder="$(ModOutputDir)\"
      Condition="'$(NativeDir)'!='' And Exists('$(NativeDir)\libprism.so')"
    />

    <Message Text="--- Mod deployed successfully ---" Importance="high" />
  </Target>

  <!-- Release target -->
  <Target Name="Release" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Message Text="--- Creating Release Package ---" Importance="high" />

    <PropertyGroup>
      <ReleaseFolderPath>$(ProjectDir)release\RimWorldAccess\</ReleaseFolderPath>
    </PropertyGroup>

    <!-- Create release folder structure -->
    <MakeDir Directories="$(ReleaseFolderPath)About" />
    <MakeDir Directories="$(ReleaseFolderPath)Assemblies" />

    <!-- Copy About.xml -->
    <Copy
      SourceFiles="$(ProjectDir)About\About.xml"
      DestinationFolder="$(ReleaseFolderPath)About\"
    />

    <!-- Copy DLL -->
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(ReleaseFolderPath)Assemblies\"
    />

    <!-- Copy native Prism libraries to mod root -->
    <Copy
      SourceFiles="$(NativeDir)\prism.dll"
      DestinationFolder="$(ReleaseFolderPath)"
      Condition="'$(NativeDir)'!='' And Exists('$(NativeDir)\prism.dll')"
    />
    <Copy
      SourceFiles="$(NativeDir)\libprism.dylib"
      DestinationFolder="$(ReleaseFolderPath)"
      Condition="'$(NativeDir)'!='' And Exists('$(NativeDir)\libprism.dylib')"
    />
    <Copy
      SourceFiles="$(NativeDir)\libprism.so"
      DestinationFolder="$(ReleaseFolderPath)"
      Condition="'$(NativeDir)'!='' And Exists('$(NativeDir)\libprism.so')"
    />

    <!-- Copy README.md to release folder -->
    <Copy
      SourceFiles="$(ProjectDir)README.md"
      DestinationFolder="$(ReleaseFolderPath)"
      Condition="Exists('$(ProjectDir)README.md')"
    />

    <!-- Copy LICENSE to release folder -->
    <Copy
      SourceFiles="$(ProjectDir)LICENSE"
      DestinationFolder="$(ReleaseFolderPath)"
      Condition="Exists('$(ProjectDir)LICENSE')"
    />

    <!-- Copy changelog.txt to release ROOT (sibling of RimWorldAccess folder) -->
    <Copy
      SourceFiles="$(ProjectDir)changelog.txt"
      DestinationFolder="$(ProjectDir)release\"
      Condition="Exists('$(ProjectDir)changelog.txt')"
    />

    <Message Text="--- Release package created at $(ReleaseFolderPath) ---" Importance="high" />
  </Target>

  <!-- Download latest Prism native libraries from GitHub into shared location -->
  <Target Name="UpdatePrism">
    <PropertyGroup>
      <PrismDownloadDir>$(ProjectDir)..\shared\native</PrismDownloadDir>
    </PropertyGroup>
    <Message Text="Downloading latest Prism native libraries to $(PrismDownloadDir)..." Importance="high" />
    <MakeDir Directories="$(PrismDownloadDir)" />

    <!-- Windows x64 -->
    <Exec Command="curl -sL &quot;https://github.com/ethindp/prism/releases/latest/download/prism-windows-x64.zip&quot; -o &quot;$(PrismDownloadDir)/prism-win.zip&quot;" />
    <Exec Command="unzip -o &quot;$(PrismDownloadDir)/prism-win.zip&quot; -d &quot;$(PrismDownloadDir)/prism-win-tmp&quot;" />
    <Copy SourceFiles="$(PrismDownloadDir)/prism-win-tmp/dynamic/release/bin/prism.dll" DestinationFiles="$(PrismDownloadDir)/prism.dll" />
    <RemoveDir Directories="$(PrismDownloadDir)/prism-win-tmp" />
    <Delete Files="$(PrismDownloadDir)/prism-win.zip" />

    <!-- macOS universal -->
    <Exec Command="curl -sL &quot;https://github.com/ethindp/prism/releases/latest/download/prism-macos-universal.zip&quot; -o &quot;$(PrismDownloadDir)/prism-mac.zip&quot;" />
    <Exec Command="unzip -o &quot;$(PrismDownloadDir)/prism-mac.zip&quot; -d &quot;$(PrismDownloadDir)/prism-mac-tmp&quot;" />
    <Copy SourceFiles="$(PrismDownloadDir)/prism-mac-tmp/dynamic/release/lib/libprism.dylib" DestinationFiles="$(PrismDownloadDir)/libprism.dylib" />
    <RemoveDir Directories="$(PrismDownloadDir)/prism-mac-tmp" />
    <Delete Files="$(PrismDownloadDir)/prism-mac.zip" />

    <!-- Linux x64 -->
    <Exec Command="curl -sL &quot;https://github.com/ethindp/prism/releases/latest/download/prism-linux-x64.zip&quot; -o &quot;$(PrismDownloadDir)/prism-linux.zip&quot;" />
    <Exec Command="unzip -o &quot;$(PrismDownloadDir)/prism-linux.zip&quot; -d &quot;$(PrismDownloadDir)/prism-linux-tmp&quot;" />
    <Copy SourceFiles="$(PrismDownloadDir)/prism-linux-tmp/dynamic/release/lib/libprism.so" DestinationFiles="$(PrismDownloadDir)/libprism.so" />
    <RemoveDir Directories="$(PrismDownloadDir)/prism-linux-tmp" />
    <Delete Files="$(PrismDownloadDir)/prism-linux.zip" />

    <Message Text="Prism native libraries updated successfully." Importance="high" />
  </Target>

  <!-- Auto-download Prism on first build when native libraries are missing (skipped in CI) -->
  <Target Name="BootstrapPrism" BeforeTargets="Build"
          Condition="'$(CI)' != 'true' And !Exists('$(ProjectDir)..\shared\native\prism.dll')">
    <Message Text="Native Prism libraries not found. Running first-time download..." Importance="high" />
    <CallTarget Targets="UpdatePrism" />
  </Target>

</Project>
