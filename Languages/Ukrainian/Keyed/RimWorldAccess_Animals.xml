  <RimWorldAccess.Animals.Wildlife.Column.Name>Ім'я</RimWorldAccess.Animals.Wildlife.Column.Name>
  <RimWorldAccess.Animals.Wildlife.Column.Predator>Хижак</RimWorldAccess.Animals.Wildlife.Column.Predator>

  <!-- =================================================================
       WildlifeMenuState lifecycle and cell-interaction announcements. -->
  <RimWorldAccess.Animals.Wildlife.Menu.NoWildlife>Диких тварин на мапі не знайдено</RimWorldAccess.Animals.Wildlife.Menu.NoWildlife>
  <RimWorldAccess.Animals.Wildlife.Menu.OpeningTitle>Меню дикої природи, {0} тварин</RimWorldAccess.Animals.Wildlife.Menu.OpeningTitle>
  <RimWorldAccess.Animals.Wildlife.Menu.Closed>Меню дикої природи закрито</RimWorldAccess.Animals.Wildlife.Menu.Closed>
  <RimWorldAccess.Animals.Wildlife.Menu.None>Немає диких тварин</RimWorldAccess.Animals.Wildlife.Menu.None>
  <RimWorldAccess.Animals.Wildlife.Menu.NotOnMap>Тварина не на мапі</RimWorldAccess.Animals.Wildlife.Menu.NotOnMap>
  <RimWorldAccess.Animals.Wildlife.Menu.CannotTame>Цю тварину неможливо приручити</RimWorldAccess.Animals.Wildlife.Menu.CannotTame>

  <!-- Bulk paint phrasing for wildlife (only Hunt/Tame are paintable).
       The "for all wildlife" variant mirrors the animals' "for all
       animals" phrasing so translators can keep them in sync. -->
  <RimWorldAccess.Animals.Wildlife.Paint.Bulk.CellAlreadyAll>{0} вже {1} для всіх диких тварин</RimWorldAccess.Animals.Wildlife.Paint.Bulk.CellAlreadyAll>

  <!-- =================================================================
       AutoSlaughterState (Dialog_AutoSlaughter overlay).
       Column names here are the plain English labels we speak for the
       seven columns of the limit grid; translators can reword each
       independently since they compose into the cell announcement. -->
  <RimWorldAccess.Animals.AutoSlaughter.Column.MaxTotal>Максимальна допустима кількість</RimWorldAccess.Animals.AutoSlaughter.Column.MaxTotal>
  <RimWorldAccess.Animals.AutoSlaughter.Column.MaxMales>Максимальна допустима кількість самців</RimWorldAccess.Animals.AutoSlaughter.Column.MaxMales>
  <RimWorldAccess.Animals.AutoSlaughter.Column.MaxMalesYoung>Максимальна допустима кількість самців незрілого віку</RimWorldAccess.Animals.AutoSlaughter.Column.MaxMalesYoung>
  <RimWorldAccess.Animals.AutoSlaughter.Column.MaxFemales>Максимальна допустима кількість самок</RimWorldAccess.Animals.AutoSlaughter.Column.MaxFemales>
  <RimWorldAccess.Animals.AutoSlaughter.Column.MaxFemalesYoung>Максимальна допустима кількість самок незрілого віку</RimWorldAccess.Animals.AutoSlaughter.Column.MaxFemalesYoung>
  <RimWorldAccess.Animals.AutoSlaughter.Column.AllowPregnant>Дозволити забій вагітних</RimWorldAccess.Animals.AutoSlaughter.Column.AllowPregnant>
  <RimWorldAccess.Animals.AutoSlaughter.Column.AllowBonded>Дозволити забій тварин з прив'язаністю</RimWorldAccess.Animals.AutoSlaughter.Column.AllowBonded>

  <!-- Lifecycle. -->
  <RimWorldAccess.Animals.AutoSlaughter.Menu.NoAnimals>Немає тварин для налаштувань автоматичного забою</RimWorldAccess.Animals.AutoSlaughter.Menu.NoAnimals>
  <RimWorldAccess.Animals.AutoSlaughter.Menu.OpeningTitle>Налаштування автоматичного забою, {0} видів тварин</RimWorldAccess.Animals.AutoSlaughter.Menu.OpeningTitle>
  <RimWorldAccess.Animals.AutoSlaughter.Menu.Closed>Автоматичний забій закрито</RimWorldAccess.Animals.AutoSlaughter.Menu.Closed>
  <RimWorldAccess.Animals.AutoSlaughter.Menu.ClosedWithSummary>Автоматичний забій закрито. {0}</RimWorldAccess.Animals.AutoSlaughter.Menu.ClosedWithSummary>
  <RimWorldAccess.Animals.AutoSlaughter.Menu.NoAnimalsShort>Немає тварин</RimWorldAccess.Animals.AutoSlaughter.Menu.NoAnimalsShort>

  <!-- Slaughter summary: {0} = comma-joined "{count} {species}" entries.
       The entry format itself is a key so non-English languages can
       choose a different count/noun order. -->
  <RimWorldAccess.Animals.AutoSlaughter.Summary.MarkedForSlaughter>Позначено для забою: {0}</RimWorldAccess.Animals.AutoSlaughter.Summary.MarkedForSlaughter>
  <RimWorldAccess.Animals.AutoSlaughter.Summary.Entry>{0} {1}</RimWorldAccess.Animals.AutoSlaughter.Summary.Entry>

  <!-- Column-value cell strings.
       {0} = current count (for Unlimited / WithinLimit / OverLimit).
       Unlimited/WithinLimit: {0} = count, for Unlimited the max is
         implicit; WithinLimit: {0} = max, {1} = current.
       OverLimit: {0} = max, {1} = current, {2} = to-slaughter count.
       Boolean columns phrase the allowed/not-allowed state as a whole
       sentence so languages can vary phrasing freely. -->
  <RimWorldAccess.Animals.AutoSlaughter.Value.Unlimited>необмежено. Поточна кількість: {0}</RimWorldAccess.Animals.AutoSlaughter.Value.Unlimited>
  <RimWorldAccess.Animals.AutoSlaughter.Value.WithinLimit>{0}. Поточна кількість: {1}</RimWorldAccess.Animals.AutoSlaughter.Value.WithinLimit>
  <RimWorldAccess.Animals.AutoSlaughter.Value.OverLimit>{0}. Поточна кількість: {1}. Буде забито: {2}</RimWorldAccess.Animals.AutoSlaughter.Value.OverLimit>
  <RimWorldAccess.Animals.AutoSlaughter.Value.PregnantAllowed>вагітних: {0}, забій дозволено</RimWorldAccess.Animals.AutoSlaughter.Value.PregnantAllowed>
  <RimWorldAccess.Animals.AutoSlaughter.Value.PregnantNotAllowed>вагітних: {0}, забій не дозволено</RimWorldAccess.Animals.AutoSlaughter.Value.PregnantNotAllowed>
  <RimWorldAccess.Animals.AutoSlaughter.Value.BondedAllowed>з прив'язаністю: {0}, забій дозволено</RimWorldAccess.Animals.AutoSlaughter.Value.BondedAllowed>
  <RimWorldAccess.Animals.AutoSlaughter.Value.BondedNotAllowed>з прив'язаністю: {0}, забій не дозволено</RimWorldAccess.Animals.AutoSlaughter.Value.BondedNotAllowed>

  <!-- Cell announcement composition.
       WithName: {0} = animal LabelCap, {1} = column name, {2} = value,
         {3} = position suffix.
       WithoutName: {0} = column name, {1} = value. -->
  <RimWorldAccess.Animals.AutoSlaughter.Cell.WithName>{0}, {1}: {2}. {3}</RimWorldAccess.Animals.AutoSlaughter.Cell.WithName>
  <RimWorldAccess.Animals.AutoSlaughter.Cell.WithoutName>{0}: {1}</RimWorldAccess.Animals.AutoSlaughter.Cell.WithoutName>
  <RimWorldAccess.Animals.AutoSlaughter.Cell.NameWithoutColumn>{0}: {1}. {2}</RimWorldAccess.Animals.AutoSlaughter.Cell.NameWithoutColumn>
  <RimWorldAccess.Animals.AutoSlaughter.Cell.ValueOnly>{0}. {1}</RimWorldAccess.Animals.AutoSlaughter.Cell.ValueOnly>

  <!-- Numeric input mode. "minus" is spoken after the user presses the
       minus key so they hear confirmation of what's in the buffer;
       "Empty" is spoken after backspacing the last character. -->
  <RimWorldAccess.Animals.AutoSlaughter.Numeric.Prompt>Введіть число, потім натисніть Enter для підтвердження або Escape для скасування</RimWorldAccess.Animals.AutoSlaughter.Numeric.Prompt>
  <RimWorldAccess.Animals.AutoSlaughter.Numeric.Minus>мінус</RimWorldAccess.Animals.AutoSlaughter.Numeric.Minus>
  <RimWorldAccess.Animals.AutoSlaughter.Numeric.Empty>Порожньо</RimWorldAccess.Animals.AutoSlaughter.Numeric.Empty>
  <RimWorldAccess.Animals.AutoSlaughter.Numeric.Invalid>Недійсне число. Використовуйте мінус 1 для необмеженого значення</RimWorldAccess.Animals.AutoSlaughter.Numeric.Invalid>
  <RimWorldAccess.Animals.AutoSlaughter.Numeric.Cancelled>Скасовано</RimWorldAccess.Animals.AutoSlaughter.Numeric.Cancelled>
</LanguageData>
