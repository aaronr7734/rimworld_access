<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Colony Manager Redux compatibility strings (src/Compat/ColonyManagerRedux/).
    Only OUR OWN wording lives here. Everything the mod names, it names itself
    at runtime: tab labels and their disabled reasons, job labels and target
    lists, the stamp tooltips for a suspended or completed job, the progress
    bar's status text, and the update interval's own label are all read live
    from the mod's tabs, jobs and triggers.
  -->

  <!-- The two typed content components: the mod's icon strip, and the job list
       of whichever tab it has selected. The third component, the window's own
       buttons, is named by the shared shell. -->
  <RimWorldAccess.Cmr.TabsRegion>Вкладки менеджера</RimWorldAccess.Cmr.TabsRegion>
  <RimWorldAccess.Cmr.JobsRegion>Завдання</RimWorldAccess.Cmr.JobsRegion>

  <!-- Spoken once after switching tab. {0} = the tab's own label. -->
  <RimWorldAccess.Cmr.TabSwitched>Вкладка {0}.</RimWorldAccess.Cmr.TabSwitched>

  <!-- A job row's state, one of these four, spoken ahead of the mod's own
       tooltip for that state. "Suspended by an error" is the state the mod
       shows with an error box around the row rather than a plain paused stamp;
       "Not managed" is a job that exists but was never handed to the manager. -->
  <RimWorldAccess.Cmr.Suspended>Призупинено</RimWorldAccess.Cmr.Suspended>
  <RimWorldAccess.Cmr.SuspendedByError>Призупинено через помилку</RimWorldAccess.Cmr.SuspendedByError>
  <RimWorldAccess.Cmr.Completed>Ціль досягнуто</RimWorldAccess.Cmr.Completed>
  <RimWorldAccess.Cmr.NotManaged>Не керується</RimWorldAccess.Cmr.NotManaged>
  <RimWorldAccess.Cmr.Active>Активне</RimWorldAccess.Cmr.Active>

  <!-- Spoken when the Manage! toolbar button commits a job to the manager, the
       moment its state turns from "Not managed" to managed. -->
  <RimWorldAccess.Cmr.NowManaged>Тепер керується</RimWorldAccess.Cmr.NowManaged>

  <!-- The clock zone of a job row: how long since the manager last worked the
       job, and how often it is due to. {0} = a period ("2 days") for the
       first, the mod's own interval label ("daily") for the second. -->
  <RimWorldAccess.Cmr.NeverUpdated>Ще не оновлювалося</RimWorldAccess.Cmr.NeverUpdated>
  <RimWorldAccess.Cmr.UpdatedAgo>Оновлено {0} тому</RimWorldAccess.Cmr.UpdatedAgo>
  <RimWorldAccess.Cmr.ChecksInterval>Перевіряє {0}</RimWorldAccess.Cmr.ChecksInterval>

  <!-- Spoken after suspending or resuming a job. {0} = the job's own label. -->
  <RimWorldAccess.Cmr.JobSuspended>{0} призупинено.</RimWorldAccess.Cmr.JobSuspended>
  <RimWorldAccess.Cmr.JobUnsuspended>{0} знову активне.</RimWorldAccess.Cmr.JobUnsuspended>

  <!-- The selected job's settings column. The mod draws it with no heading of its
       own (the headings inside it, one per group of settings, are the mod's and
       are spoken as they are crossed); the animal column next to it carries the
       mod's own "Allowed animals" heading, so that region needs no key here. -->
  <RimWorldAccess.Cmr.OptionsRegion>Параметри</RimWorldAccess.Cmr.OptionsRegion>

  <!-- The two icon buttons over the animal list, which the mod draws with no
       hover text of any kind: the refresh arrows and the padlock. -->
  <RimWorldAccess.Cmr.Hunting.RefreshAnimals>Оновити список тварин</RimWorldAccess.Cmr.Hunting.RefreshAnimals>
  <RimWorldAccess.Cmr.Hunting.AnimalsRefreshed>Список тварин оновлено.</RimWorldAccess.Cmr.Hunting.AnimalsRefreshed>
  <RimWorldAccess.Cmr.Hunting.LockAnimalsToMap>Обмежити список тваринами цієї мапи</RimWorldAccess.Cmr.Hunting.LockAnimalsToMap>
  <!-- The Overview tab's controls above its job list (search box, group-by button,
       collapse-all button, job type filter icons), which the mod draws as one strip
       with no heading of its own. -->
  <RimWorldAccess.Cmr.Overview.ListOptionsRegion>Параметри списку завдань</RimWorldAccess.Cmr.Overview.ListOptionsRegion>
  <!-- The Overview search box, which the mod draws with only a magnifier icon. -->
  <RimWorldAccess.Cmr.Overview.Search>Пошук завдань</RimWorldAccess.Cmr.Overview.Search>
  <!-- The delete icon beside a reserved stock row, which has only a tooltip.
       {0} is the mod's own tooltip ("Reset to the default reserved stock amount" or
       "Remove this job's reserved stock amount"), {1} the ingredient. -->
  <RimWorldAccess.Cmr.Production.ReservedStockAction>{0}: {1}</RimWorldAccess.Cmr.Production.ReservedStockAction>
  <!-- Keyboard twin of the modifier-click line the mod adds to every shortcut row's
       tooltip ("Ctrl+click: allow only these" and so on). {0} is the key that plays
       Ctrl on this platform (Ctrl, or Command on a Mac). -->
  <RimWorldAccess.Cmr.Shortcuts.ModifiersTip>{0}+Enter: дозволити лише ці. Shift+Enter: дозволити також ці. Alt+Enter: більше не дозволяти ці.</RimWorldAccess.Cmr.Shortcuts.ModifiersTip>

  <!-- The three controls the mod's threshold details window draws around its item
       filter, none of which it labels: a button showing only a comparison glyph,
       a bare number field beside it, and a grid of stockpile cells. The window's
       own name, its filter tree, the operator names and their explanations, and
       every stockpile cell's label are all the mod's own. The target-count key
       also names every threshold tab's unnamed slider row, one phrase for one
       control everywhere it appears. -->
  <RimWorldAccess.Cmr.Threshold.OperatorRow>Порівняння</RimWorldAccess.Cmr.Threshold.OperatorRow>
  <RimWorldAccess.Cmr.Threshold.TargetCountRow>Цільова кількість</RimWorldAccess.Cmr.Threshold.TargetCountRow>
  <RimWorldAccess.Cmr.Threshold.StockpileRow>Кількість у</RimWorldAccess.Cmr.Threshold.StockpileRow>

  <!-- The claw icon on an animal's row, which the mod draws without hover text.
       It marks an animal likely to turn on its hunter; how likely is already in
       the mod's own aggressiveness line, read out with the rest of the row. -->
  <RimWorldAccess.Cmr.Hunting.RevengeRisk>Ризик помсти</RimWorldAccess.Cmr.Hunting.RevengeRisk>

  <!-- The Forestry, Foraging and Mining clones of the Hunting rows above: the
       tooltipless refresh and padlock icons over each tab's own list. Mining's
       buildings column has only a padlock, no refresh icon of its own; the
       minerals column's refresh already covers both lists. -->
  <RimWorldAccess.Cmr.Forestry.RefreshTrees>Оновити список дерев</RimWorldAccess.Cmr.Forestry.RefreshTrees>
  <RimWorldAccess.Cmr.Forestry.TreesRefreshed>Список дерев оновлено.</RimWorldAccess.Cmr.Forestry.TreesRefreshed>
  <RimWorldAccess.Cmr.Forestry.LockTreesToMap>Обмежити список деревами цієї мапи</RimWorldAccess.Cmr.Forestry.LockTreesToMap>

  <RimWorldAccess.Cmr.Foraging.RefreshPlants>Оновити список рослин</RimWorldAccess.Cmr.Foraging.RefreshPlants>
  <RimWorldAccess.Cmr.Foraging.PlantsRefreshed>Список рослин оновлено.</RimWorldAccess.Cmr.Foraging.PlantsRefreshed>
  <RimWorldAccess.Cmr.Foraging.LockPlantsToMap>Обмежити список рослинами цієї мапи</RimWorldAccess.Cmr.Foraging.LockPlantsToMap>

  <RimWorldAccess.Cmr.Mining.RefreshMinerals>Оновити список мінералів</RimWorldAccess.Cmr.Mining.RefreshMinerals>
  <RimWorldAccess.Cmr.Mining.MineralsRefreshed>Список мінералів оновлено.</RimWorldAccess.Cmr.Mining.MineralsRefreshed>
  <RimWorldAccess.Cmr.Mining.LockMineralsToMap>Обмежити список мінералами цієї мапи</RimWorldAccess.Cmr.Mining.LockMineralsToMap>
  <RimWorldAccess.Cmr.Mining.LockBuildingsToMap>Обмежити список будівлями цієї мапи</RimWorldAccess.Cmr.Mining.LockBuildingsToMap>

  <!-- The Livestock tab. Our wording only: everything the mod names uses the mod's own
       keys. The "{0}" of the first three is the mod's own whole-phrase age and sex label
       ("adult female"), composed by its own AgeAndSexExtensions.GetLabel. -->
  <RimWorldAccess.Cmr.Livestock.JobOpened>Завдання {0} відкрито для налаштування.</RimWorldAccess.Cmr.Livestock.JobOpened>
  <RimWorldAccess.Cmr.Livestock.CountTarget>Цільова кількість {0}</RimWorldAccess.Cmr.Livestock.CountTarget>
  <RimWorldAccess.Cmr.Livestock.RestrictAreaRow>Область {0}</RimWorldAccess.Cmr.Livestock.RestrictAreaRow>

  <!-- The five area strips the mod draws under a send-to-area toggle with no label of their own. -->
  <RimWorldAccess.Cmr.Livestock.CullingAreaRow>Область відбраковування</RimWorldAccess.Cmr.Livestock.CullingAreaRow>
  <RimWorldAccess.Cmr.Livestock.MilkingAreaRow>Область доїння</RimWorldAccess.Cmr.Livestock.MilkingAreaRow>
  <RimWorldAccess.Cmr.Livestock.ShearingAreaRow>Область стрижки</RimWorldAccess.Cmr.Livestock.ShearingAreaRow>
  <RimWorldAccess.Cmr.Livestock.TrainingAreaRow>Область навчання</RimWorldAccess.Cmr.Livestock.TrainingAreaRow>
  <RimWorldAccess.Cmr.Livestock.TrainedAreaRow>Область навчених тварин</RimWorldAccess.Cmr.Livestock.TrainedAreaRow>

  <!-- The Production tab. Our wording only: everything the mod names uses the mod's own keys. -->
  <RimWorldAccess.Cmr.Production.JobOpened>Завдання {0} відкрито для налаштування.</RimWorldAccess.Cmr.Production.JobOpened>
  <RimWorldAccess.Cmr.Production.WorkbenchAreaRow>Область робочого місця</RimWorldAccess.Cmr.Production.WorkbenchAreaRow>

  <!-- The row that follows an ingredient with a producer link: {0} is the ingredient's own label. -->
  <RimWorldAccess.Cmr.Production.SupplyLinkRow>Зв'язок постачання {0}</RimWorldAccess.Cmr.Production.SupplyLinkRow>

  <!-- Spoken after jumping to a linked job from either side of the LinkedJobs section. -->
  <RimWorldAccess.Cmr.Production.LinkedJobSelected>{0} вибрано.</RimWorldAccess.Cmr.Production.LinkedJobSelected>

  <!-- A linked consumer that currently covers nothing still reports its demand; the mod's own
       "Supplies: {0} (needs {1})" line would read as a bare "Supplies:" there. -->
  <RimWorldAccess.Cmr.Production.LinkedRow.Demand>Потребує {0}</RimWorldAccess.Cmr.Production.LinkedRow.Demand>

  <!-- The Overview tab. The workers region normally carries the selected work type's own gerund
       (the mod's own table header); the key below is only its fallback, and the one-row region
       over it holds the jump the sighted row's tab icon performs. -->
  <RimWorldAccess.Cmr.Overview.SelectedJobRegion>Вибране завдання</RimWorldAccess.Cmr.Overview.SelectedJobRegion>
  <RimWorldAccess.Cmr.Overview.WorkersRegion>Робітники</RimWorldAccess.Cmr.Overview.WorkersRegion>

  <!-- The Logs tab. A job row there is the mod's log filter (its click selects a job to filter
       by, and re-clicking clears it), so Enter on a job row speaks one of these two. -->
  <RimWorldAccess.Cmr.Logs.LogsRegion>Журнали</RimWorldAccess.Cmr.Logs.LogsRegion>
  <RimWorldAccess.Cmr.Logs.FilterApplied>Показано журнали для {0}.</RimWorldAccess.Cmr.Logs.FilterApplied>
  <RimWorldAccess.Cmr.Logs.FilterCleared>Показано всі журнали.</RimWorldAccess.Cmr.Logs.FilterCleared>

  <!-- The Import/Export tab. Region names for its three unlabeled panels, our names for the
       per-file rows whose buttons the mod labels without naming their target file, the bare
       name field, and the export button's disabled reason (sighted players see it greyed). -->
  <RimWorldAccess.Cmr.ImportExport.ModeRegion>Режим</RimWorldAccess.Cmr.ImportExport.ModeRegion>
  <RimWorldAccess.Cmr.ImportExport.FilesRegion>Збережені файли</RimWorldAccess.Cmr.ImportExport.FilesRegion>
  <RimWorldAccess.Cmr.ImportExport.ExportRegion>Експорт</RimWorldAccess.Cmr.ImportExport.ExportRegion>
  <RimWorldAccess.Cmr.ImportExport.DeleteRow>Видалити {0}</RimWorldAccess.Cmr.ImportExport.DeleteRow>
  <RimWorldAccess.Cmr.ImportExport.SetDefaultRow>Зробити {0} типовим шаблоном</RimWorldAccess.Cmr.ImportExport.SetDefaultRow>
  <RimWorldAccess.Cmr.ImportExport.FileNameRow>Назва файлу</RimWorldAccess.Cmr.ImportExport.FileNameRow>
  <RimWorldAccess.Cmr.ImportExport.ExportNeedsSelection>Спершу виберіть хоча б одне завдання.</RimWorldAccess.Cmr.ImportExport.ExportNeedsSelection>

  <!-- The Power tab. Its three panels are graphs with legends; the legends and the period
       control are the readable data, and these name the three panels the mod leaves unnamed. -->
  <RimWorldAccess.Cmr.Power.OverallRegion>Огляд живлення</RimWorldAccess.Cmr.Power.OverallRegion>
  <RimWorldAccess.Cmr.Power.ConsumptionRegion>Споживання</RimWorldAccess.Cmr.Power.ConsumptionRegion>
  <RimWorldAccess.Cmr.Power.ProductionRegion>Виробництво</RimWorldAccess.Cmr.Power.ProductionRegion>
</LanguageData>
