  <RimWorldAccess.Prisoner.Action.ToggleEnabled>Увімкнено</RimWorldAccess.Prisoner.Action.ToggleEnabled>
  <RimWorldAccess.Prisoner.Action.ToggleDisabled>Вимкнено</RimWorldAccess.Prisoner.Action.ToggleDisabled>
  <RimWorldAccess.Prisoner.Action.ToggleMode>{0}: {1}</RimWorldAccess.Prisoner.Action.ToggleMode>
</LanguageData>
