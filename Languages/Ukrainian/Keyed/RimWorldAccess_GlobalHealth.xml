<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- Health overview screen (src/Shell/Screens/GlobalHealthScope.Game.cs). -->
  <RimWorldAccess.GlobalHealth.Title>Огляд здоров'я</RimWorldAccess.GlobalHealth.Title>
  <RimWorldAccess.GlobalHealth.RegionName>Персонажі</RimWorldAccess.GlobalHealth.RegionName>
  <RimWorldAccess.GlobalHealth.Node.DownedBleeding>Знерухомлені з кровотечею</RimWorldAccess.GlobalHealth.Node.DownedBleeding>
  <RimWorldAccess.GlobalHealth.Node.Downed>Знерухомлені</RimWorldAccess.GlobalHealth.Node.Downed>
  <RimWorldAccess.GlobalHealth.Node.Bleeding>Кровотеча</RimWorldAccess.GlobalHealth.Node.Bleeding>
  <RimWorldAccess.GlobalHealth.Node.Injured>Травмовані</RimWorldAccess.GlobalHealth.Node.Injured>
  <!-- Node summaries. {0} = the node's name (one of the Node strings above), {1} = how many pawns it holds, then {2} (or {1} in the One forms) = the soonest time left before bleeding out ("2 hours") or the lowest overall health ("38%"). NotSoon is used when no one in the node bleeds out within a day. -->
  <RimWorldAccess.GlobalHealth.Summary.None>{0}. Немає</RimWorldAccess.GlobalHealth.Summary.None>
  <RimWorldAccess.GlobalHealth.Summary.BleedOut>{0}. {1} персонажів, найшвидше смерть від втрати крові через {2}</RimWorldAccess.GlobalHealth.Summary.BleedOut>
  <RimWorldAccess.GlobalHealth.Summary.BleedOutOne>{0}. 1 персонаж, смерть від втрати крові через {1}</RimWorldAccess.GlobalHealth.Summary.BleedOutOne>
  <RimWorldAccess.GlobalHealth.Summary.NotSoon>{0}. {1} персонажів, безпосередньої небезпеки немає</RimWorldAccess.GlobalHealth.Summary.NotSoon>
  <RimWorldAccess.GlobalHealth.Summary.NotSoonOne>{0}. 1 персонаж, безпосередньої небезпеки немає</RimWorldAccess.GlobalHealth.Summary.NotSoonOne>
  <RimWorldAccess.GlobalHealth.Summary.LowestHealth>{0}. {1} персонажів, найнижче здоров'я: {2}</RimWorldAccess.GlobalHealth.Summary.LowestHealth>
  <RimWorldAccess.GlobalHealth.Summary.HealthOne>{0}. 1 персонаж, здоров'я: {1}</RimWorldAccess.GlobalHealth.Summary.HealthOne>
  <!-- {0} = the pawn's name with its group (one of the PawnGroup strings below), {1} = its health tag (one of the PawnHealth.Tag strings below). -->
  <RimWorldAccess.GlobalHealth.PawnRow>{0}. {1}</RimWorldAccess.GlobalHealth.PawnRow>
  <!-- After a filter checkbox is toggled. {0} = the checkbox's new state ("checked"), {1} = how many pawns are now listed. -->
  <RimWorldAccess.GlobalHealth.FilterChanged>{0}. У списку {1} персонажів.</RimWorldAccess.GlobalHealth.FilterChanged>
  <RimWorldAccess.GlobalHealth.FilterChangedOne>{0}. У списку 1 персонаж.</RimWorldAccess.GlobalHealth.FilterChangedOne>
  <RimWorldAccess.GlobalHealth.JumpUnavailable>Не вдається знайти персонажа.</RimWorldAccess.GlobalHealth.JumpUnavailable>
  <!-- Pawn health tags, spoken on health overview rows and after scanner pawns. {0} = overall health ("45%"), {1} = time left before bleeding out ("2 hours"). The bleeding words mirror the vanilla health tab: "no immediate danger" past a day, "deathless" for the Biotech gene. -->
  <RimWorldAccess.PawnHealth.Tag.Health>здоров'я: {0}</RimWorldAccess.PawnHealth.Tag.Health>
  <RimWorldAccess.PawnHealth.Tag.Downed>знерухомлено, здоров'я: {0}</RimWorldAccess.PawnHealth.Tag.Downed>
  <RimWorldAccess.PawnHealth.Tag.Bleeding>кровотеча, смерть через {1}, здоров'я: {0}</RimWorldAccess.PawnHealth.Tag.Bleeding>
  <RimWorldAccess.PawnHealth.Tag.DownedBleeding>знерухомлено, кровотеча, смерть через {1}, здоров'я: {0}</RimWorldAccess.PawnHealth.Tag.DownedBleeding>
  <RimWorldAccess.PawnHealth.Tag.BleedingNotSoon>кровотеча, безпосередньої небезпеки немає, здоров'я: {0}</RimWorldAccess.PawnHealth.Tag.BleedingNotSoon>
  <RimWorldAccess.PawnHealth.Tag.DownedBleedingNotSoon>знерухомлено, кровотеча, безпосередньої небезпеки немає, здоров'я: {0}</RimWorldAccess.PawnHealth.Tag.DownedBleedingNotSoon>
  <RimWorldAccess.PawnHealth.Tag.BleedingDeathless>кровотеча, безсмертя, здоров'я: {0}</RimWorldAccess.PawnHealth.Tag.BleedingDeathless>
  <RimWorldAccess.PawnHealth.Tag.DownedBleedingDeathless>знерухомлено, кровотеча, безсмертя, здоров'я: {0}</RimWorldAccess.PawnHealth.Tag.DownedBleedingDeathless>
  <!-- Pawn group tags, shared by the health overview and the gear menu. {0} = the pawn's short name. Wild is a pawn with no faction, like a wild man. -->
  <RimWorldAccess.PawnGroup.Colonist>{0}, колоніст</RimWorldAccess.PawnGroup.Colonist>
  <RimWorldAccess.PawnGroup.ColonyMech>{0}, механоїд колонії</RimWorldAccess.PawnGroup.ColonyMech>
  <RimWorldAccess.PawnGroup.ColonyAnimal>{0}, тварина колонії</RimWorldAccess.PawnGroup.ColonyAnimal>
  <RimWorldAccess.PawnGroup.Slave>{0}, раб</RimWorldAccess.PawnGroup.Slave>
  <RimWorldAccess.PawnGroup.Prisoner>{0}, в'язень</RimWorldAccess.PawnGroup.Prisoner>
  <RimWorldAccess.PawnGroup.Visitor>{0}, гість</RimWorldAccess.PawnGroup.Visitor>
  <RimWorldAccess.PawnGroup.Wild>{0}, дикий</RimWorldAccess.PawnGroup.Wild>
  <RimWorldAccess.PawnGroup.Hostile>{0}, ворог</RimWorldAccess.PawnGroup.Hostile>
  <!-- The group filter checkboxes in the health overview and the gear menu. Visitors also covers pawns with no faction. -->
  <RimWorldAccess.PawnGroup.FiltersRegion>Фільтри</RimWorldAccess.PawnGroup.FiltersRegion>
  <RimWorldAccess.PawnGroup.Filter.Colonists>Колоністи</RimWorldAccess.PawnGroup.Filter.Colonists>
  <RimWorldAccess.PawnGroup.Filter.ColonyAnimals>Тварини колонії</RimWorldAccess.PawnGroup.Filter.ColonyAnimals>
  <RimWorldAccess.PawnGroup.Filter.ColonyMechs>Механоїди колонії</RimWorldAccess.PawnGroup.Filter.ColonyMechs>
  <RimWorldAccess.PawnGroup.Filter.PrisonersAndSlaves>В'язні та раби</RimWorldAccess.PawnGroup.Filter.PrisonersAndSlaves>
  <RimWorldAccess.PawnGroup.Filter.Visitors>Гості</RimWorldAccess.PawnGroup.Filter.Visitors>
  <RimWorldAccess.PawnGroup.Filter.Hostiles>Вороги</RimWorldAccess.PawnGroup.Filter.Hostiles>
</LanguageData>
