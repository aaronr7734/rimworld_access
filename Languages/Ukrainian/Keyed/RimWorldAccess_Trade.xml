  <RimWorldAccess.Trade.Currency.FavorNoun>честі</RimWorldAccess.Trade.Currency.FavorNoun>
  <!-- Favor count format: {0} = integer count of favor.
       Silver uses RimWorld's float.ToStringMoney() ("$N"); we leave
       that to the game. -->
  <RimWorldAccess.Trade.Currency.FavorCount>{0} честі</RimWorldAccess.Trade.Currency.FavorCount>

