  <RimWorldAccess.Trade.Item.NotTradeable>Не продається</RimWorldAccess.Trade.Item.NotTradeable>
  <RimWorldAccess.Trade.Item.YoursAt>Ваше: {0} по {1}</RimWorldAccess.Trade.Item.YoursAt>
  <RimWorldAccess.Trade.Item.TheirsAt>Їхнє: {0} по {1}</RimWorldAccess.Trade.Item.TheirsAt>
  <RimWorldAccess.Trade.Item.YoursAtWithQuality>Ваше: {0} по {1} ({2})</RimWorldAccess.Trade.Item.YoursAtWithQuality>
  <RimWorldAccess.Trade.Item.TheirsAtWithQuality>Їхнє: {0} по {1} ({2})</RimWorldAccess.Trade.Item.TheirsAtWithQuality>
