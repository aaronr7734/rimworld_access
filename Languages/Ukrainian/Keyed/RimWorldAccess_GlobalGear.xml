<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- Global gear screen (src/Shell/Screens/GlobalGearScope.Game.cs). Holder rows use the shared PawnGroup strings in RimWorldAccess_GlobalHealth.xml. -->
  <RimWorldAccess.GlobalGear.Title>Спорядження на мапі</RimWorldAccess.GlobalGear.Title>
  <!-- Section summaries. {0} = the gear tab's section name, {1} = how many items it holds, {2} = how many pawns hold them. -->
  <RimWorldAccess.GlobalGear.Summary.None>{0}. Немає</RimWorldAccess.GlobalGear.Summary.None>
  <RimWorldAccess.GlobalGear.Summary.Items>{0}. {1} предметів, {2} носіїв</RimWorldAccess.GlobalGear.Summary.Items>
  <RimWorldAccess.GlobalGear.Summary.OneHolder>{0}. {1} предметів, 1 носій</RimWorldAccess.GlobalGear.Summary.OneHolder>
  <RimWorldAccess.GlobalGear.Summary.OneItem>{0}. 1 предмет, 1 носій</RimWorldAccess.GlobalGear.Summary.OneItem>
  <!-- {0} = the item's name, {1} = how many are held. -->
  <RimWorldAccess.GlobalGear.Item>{0} x{1}</RimWorldAccess.GlobalGear.Item>
  <!-- {0} = the stack count. -->
  <RimWorldAccess.GlobalGear.StackCount>{0} у стосі</RimWorldAccess.GlobalGear.StackCount>
  <!-- {0} = hit points as a percentage, already formatted ("43%"). -->
  <RimWorldAccess.GlobalGear.Condition>стан: {0}</RimWorldAccess.GlobalGear.Condition>
  <RimWorldAccess.GlobalGear.JumpUnavailable>Не вдається перейти до цього персонажа.</RimWorldAccess.GlobalGear.JumpUnavailable>
  <!-- After a filter checkbox is toggled. {0} = the checkbox's new state ("checked"), {1} = how many pawns now hold listed gear. -->
  <RimWorldAccess.GlobalGear.FilterChanged>{0}. У списку {1} носіїв.</RimWorldAccess.GlobalGear.FilterChanged>
  <RimWorldAccess.GlobalGear.FilterChangedOne>{0}. У списку 1 носій.</RimWorldAccess.GlobalGear.FilterChangedOne>
</LanguageData>
