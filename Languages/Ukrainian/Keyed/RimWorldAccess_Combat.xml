<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Combat module strings (src/Combat/). Three files contribute:
      - CombatLogState.cs  (Alt+B combat log viewer)
      - ShellImpactPatch.cs  (mortar/artillery impact announcements)
      - TargetingPatch.cs  (Enter-to-target, range/LOS feedback, multi-select)

    The multi-select keys (Combat.MultiSelect.*) exist as whole phrases per
    semantic case so translators can reorder subject/verb/object freely. C#
    picks which key to use based on succeeded/unchanged pawn counts. Singular
    and plural subject forms are separate keys because English needs subject-
    verb agreement ("Only Bob attacks" vs "Only Bob and Alice attack"); other
    languages can collapse or split these further in their own XML.
  -->

  <!-- Combat log (Alt+B). -->
  <RimWorldAccess.Combat.Log.NoBattleLog>Журнал бою недоступний</RimWorldAccess.Combat.Log.NoBattleLog>
  <RimWorldAccess.Combat.Log.Header>Журнал бою: {0}</RimWorldAccess.Combat.Log.Header>
  <RimWorldAccess.Combat.Log.NoEntries>Записів бою не знайдено.</RimWorldAccess.Combat.Log.NoEntries>
  <RimWorldAccess.Combat.Log.ShowingLastN>Показано останні 10 із {0} записів.</RimWorldAccess.Combat.Log.ShowingLastN>
  <RimWorldAccess.Combat.Log.Total>Усього: {0} записів.</RimWorldAccess.Combat.Log.Total>

  <!-- Shell impacts (mortars, artillery). {0} = shell source label,
       {1} = target label (Hit only), last two = impact cell x, z. -->
  <RimWorldAccess.Combat.Shell.SourceDefault>Снаряд</RimWorldAccess.Combat.Shell.SourceDefault>
  <RimWorldAccess.Combat.Shell.SourceOurs>Наш снаряд</RimWorldAccess.Combat.Shell.SourceOurs>
  <RimWorldAccess.Combat.Shell.SourceEnemy>Ворожий снаряд</RimWorldAccess.Combat.Shell.SourceEnemy>
  <RimWorldAccess.Combat.Shell.Hit>{0} влучив у ціль {1} на {2}, {3}</RimWorldAccess.Combat.Shell.Hit>
  <RimWorldAccess.Combat.Shell.Landed>{0} впав на {1}, {2}</RimWorldAccess.Combat.Shell.Landed>

  <!-- Generic target and location fallbacks. Used when target.HasThing is
       false and a labeled placeholder is needed for sentence composition. -->
  <RimWorldAccess.Combat.Target.GenericTargetLabel>ціль</RimWorldAccess.Combat.Target.GenericTargetLabel>
  <RimWorldAccess.Combat.Target.GenericLocationLabel>місце</RimWorldAccess.Combat.Target.GenericLocationLabel>

  <!-- Range/distance feedback during targeting. -->
  <RimWorldAccess.Combat.Target.NoRangeInfo>Інформація про дальність недоступна</RimWorldAccess.Combat.Target.NoRangeInfo>
  <RimWorldAccess.Combat.Target.DistanceInRange>Відстань: {0} клітинок, У МЕЖАХ ДОСЯЖНОСТІ</RimWorldAccess.Combat.Target.DistanceInRange>
  <RimWorldAccess.Combat.Target.DistanceOutOfRange>Відстань: {0} клітинок, ПОЗА МЕЖАМИ ДОСЯЖНОСТІ (макс. {1})</RimWorldAccess.Combat.Target.DistanceOutOfRange>
  <RimWorldAccess.Combat.Target.OutOfRange>Поза межами досяжності. Відстань: {0}, макс. дальність: {1}</RimWorldAccess.Combat.Target.OutOfRange>

  <!-- Target validation and errors. -->
  <RimWorldAccess.Combat.Target.InvalidPosition>Неправильне розташування цілі</RimWorldAccess.Combat.Target.InvalidPosition>
  <RimWorldAccess.Combat.Target.InvalidTarget>Неправильна ціль</RimWorldAccess.Combat.Target.InvalidTarget>
  <RimWorldAccess.Combat.Target.NotValidTarget>{0}: неправильна ціль</RimWorldAccess.Combat.Target.NotValidTarget>
  <RimWorldAccess.Combat.Target.NoValidAtCursorWithDesc>Немає допустимої цілі під курсором. {0}</RimWorldAccess.Combat.Target.NoValidAtCursorWithDesc>
  <RimWorldAccess.Combat.Target.NoActionAvailable>Немає доступної дії наведення</RimWorldAccess.Combat.Target.NoActionAvailable>
  <RimWorldAccess.Combat.Target.ErrorUsing>Помилка застосування до цілі: {0}</RimWorldAccess.Combat.Target.ErrorUsing>

  <!-- Targeting success announcements (single-select path). -->
  <RimWorldAccess.Combat.Target.Targeting>Наведення: {0}</RimWorldAccess.Combat.Target.Targeting>
  <RimWorldAccess.Combat.Target.TargetingLocation>Наведення на місце</RimWorldAccess.Combat.Target.TargetingLocation>
  <RimWorldAccess.Combat.Target.Selected>Ціль вибрано: {0}</RimWorldAccess.Combat.Target.Selected>

  <!-- Second-phase (destination) selection, e.g. Skip ability. -->
  <RimWorldAccess.Combat.Target.SelectDestination>Тепер виберіть місце призначення</RimWorldAccess.Combat.Target.SelectDestination>
  <RimWorldAccess.Combat.Target.SelectDestinationInRange>Тепер виберіть місце призначення в межах {0} клітинок</RimWorldAccess.Combat.Target.SelectDestinationInRange>

  <!-- Multi-select attack feedback. Whole-phrase keys per semantic case so
       word order and subject-verb agreement can be localized naturally.
         Everyone:  all selected pawns accepted the order.
         NoOne:     none of the selected pawns accepted the order.
         Only:      some accepted, fewer accepted than rejected.
         Except:    some rejected, fewer rejected than accepted.
       English uses singular "attacks" for the Everyone and EveryoneExcept
       forms because "everyone" takes singular agreement. Only has split
       singular/plural forms because its subject is the name list itself.
       Translators can collapse or further split these as their grammar requires.
       {0} = everyone-label from vanilla key (Except) or name-list (Only),
       {1} = name-list of the exception / attack target,
       {2} = attack target (Except key only). -->
  <RimWorldAccess.Combat.MultiSelect.EveryoneAttacks>{0} атакує: {1}</RimWorldAccess.Combat.MultiSelect.EveryoneAttacks>
  <RimWorldAccess.Combat.MultiSelect.NoOneCouldAttack>Ніхто не зміг атакувати: {0}</RimWorldAccess.Combat.MultiSelect.NoOneCouldAttack>
  <RimWorldAccess.Combat.MultiSelect.EveryoneExceptAttacks>{0}, окрім {1}, атакує: {2}</RimWorldAccess.Combat.MultiSelect.EveryoneExceptAttacks>
  <RimWorldAccess.Combat.MultiSelect.OnlyOneAttacks>Тільки {0} атакує: {1}</RimWorldAccess.Combat.MultiSelect.OnlyOneAttacks>
  <RimWorldAccess.Combat.MultiSelect.OnlyManyAttack>Тільки {0} атакують: {1}</RimWorldAccess.Combat.MultiSelect.OnlyManyAttack>
  <RimWorldAccess.Combat.ShotReport.Headline>{0}, {1} шанс влучити</RimWorldAccess.Combat.ShotReport.Headline>
  <RimWorldAccess.Combat.ShotReport.HeadlineGeneric>{0}</RimWorldAccess.Combat.ShotReport.HeadlineGeneric>
  <RimWorldAccess.Combat.ShotReport.CannotHit>{0}: влучити неможливо</RimWorldAccess.Combat.ShotReport.CannotHit>
</LanguageData>
