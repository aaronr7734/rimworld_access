  <RimWorldAccess.TwoLevel.NoButtonsDefault>Немає доступних кнопок</RimWorldAccess.TwoLevel.NoButtonsDefault>


  <!-- Generic dialog nav instructions + give-name field labels (src/UI/WindowlessDialogState.cs, DialogElementExtractor.cs). -->
  <RimWorldAccess.UI.Dialog.NavInstructions>{0} елементів. Використовуйте клавіші зі стрілками для навігації, Enter для активації, Escape для скасування.</RimWorldAccess.UI.Dialog.NavInstructions>
  <RimWorldAccess.UI.GiveName.SettlementNameLabel>Назва поселення</RimWorldAccess.UI.GiveName.SettlementNameLabel>
  <RimWorldAccess.UI.GiveName.SecondNameLabel>Друга назва</RimWorldAccess.UI.GiveName.SecondNameLabel>
  <!-- Localization guardrail (D.8) sweep — previously hardcoded English. -->
  <RimWorldAccess.UI.Dialog.FieldCannotBeEdited>{0} {1}. Не можна редагувати.</RimWorldAccess.UI.Dialog.FieldCannotBeEdited>
  <RimWorldAccess.UI.SaveMenu.NoSaveFiles>Немає доступних файлів збереження</RimWorldAccess.UI.SaveMenu.NoSaveFiles>
</LanguageData>
