  <RimWorldAccess.UI.Name.RandomizedFirst>Випадково обране ім'я: {0}</RimWorldAccess.UI.Name.RandomizedFirst>
  <RimWorldAccess.UI.Name.RandomizedSecond>Випадково обрана друга назва: {0}</RimWorldAccess.UI.Name.RandomizedSecond>
  <!-- Submit-success announcements. {0} = first name, {1} = second name. -->
  <RimWorldAccess.UI.Name.Accepted>Назву прийнято: {0}</RimWorldAccess.UI.Name.Accepted>
  <RimWorldAccess.UI.Name.AcceptedBoth>Назви прийнято: {0}, {1}</RimWorldAccess.UI.Name.AcceptedBoth>
  <RimWorldAccess.UI.Name.Renamed>Перейменовано на {0}</RimWorldAccess.UI.Name.Renamed>
  <RimWorldAccess.UI.Name.NamedSingle>Названо: {0}</RimWorldAccess.UI.Name.NamedSingle>
  <RimWorldAccess.UI.Name.NamedBoth>Названо: {0} {1}</RimWorldAccess.UI.Name.NamedBoth>

  <!-- Dialog_GiveName keyboard announcements (GiveNameDialogPatch).
       DialogIntro {0} = first prompt; the text-field keys take {0} = prompt,
       {1} = current value. -->
  <RimWorldAccess.UI.GiveName.DialogIntro>Діалог назви. {0}</RimWorldAccess.UI.GiveName.DialogIntro>
  <RimWorldAccess.UI.GiveName.NavHint>Використовуйте Tab для переходу між полями. Натисніть Enter для підтвердження.</RimWorldAccess.UI.GiveName.NavHint>
  <RimWorldAccess.UI.GiveName.TextField>Текстове поле: {0}. Поточне значення: {1}</RimWorldAccess.UI.GiveName.TextField>
  <RimWorldAccess.UI.GiveName.FirstTextField>Перше текстове поле: {0}. Поточне значення: {1}</RimWorldAccess.UI.GiveName.FirstTextField>
  <RimWorldAccess.UI.GiveName.SecondTextField>Друге текстове поле: {0}. Поточне значення: {1}</RimWorldAccess.UI.GiveName.SecondTextField>
  <RimWorldAccess.UI.GiveName.RandomizeButton>Кнопка «Випадково»</RimWorldAccess.UI.GiveName.RandomizeButton>
  <RimWorldAccess.UI.GiveName.RandomizeFirstButton>Кнопка випадкового імені</RimWorldAccess.UI.GiveName.RandomizeFirstButton>
  <RimWorldAccess.UI.GiveName.RandomizeSecondButton>Кнопка випадкової другої назви</RimWorldAccess.UI.GiveName.RandomizeSecondButton>
  <RimWorldAccess.UI.GiveName.OkButton>Кнопка ОК</RimWorldAccess.UI.GiveName.OkButton>

  <!-- Dialog_NameAllowedArea opening prompt. -->
  <RimWorldAccess.UI.NameArea.OpenPrompt>Назвіть цю дозволену область. Введіть назву і натисніть ОК або Enter, щоб продовжити.</RimWorldAccess.UI.NameArea.OpenPrompt>

  <!-- =================================================================
       TransferableQuantityHelper (caravan/trade quantity setters).
       AdjustTo and SetToZero share a "{count} {item}" phrasing. The
       SetToMax variant adds a localized "maximum" suffix and an
       optional mass tag. {0} = count, {1} = item label.
       MaxLine: {0} = count, {1} = item, {2} = mass suffix or empty.
       MassSuffix: {0} = total mass formatted to one decimal. -->
  <RimWorldAccess.UI.Transferable.QuantitySpoken>{0} {1}</RimWorldAccess.UI.Transferable.QuantitySpoken>
  <RimWorldAccess.UI.Transferable.MaxLine>{0} {1}, максимум{2}</RimWorldAccess.UI.Transferable.MaxLine>
  <RimWorldAccess.UI.Transferable.MassSuffix>, {0} кг</RimWorldAccess.UI.Transferable.MassSuffix>

  <!-- =================================================================
       MessageBox patch + ExtraMenusState + WindowlessConfirmationState.
       Cancelled is shared (used by all three). -->
  <RimWorldAccess.UI.Cancelled>Скасовано</RimWorldAccess.UI.Cancelled>
  <RimWorldAccess.UI.Extra.None>Немає доступних додаткових меню</RimWorldAccess.UI.Extra.None>

  <!-- MessageBox button prompts. {0} = accept button label, {1} = cancel button label. -->
  <RimWorldAccess.UI.MessageBox.TwoButtons>Натисніть Enter для {0}, Escape для {1}.</RimWorldAccess.UI.MessageBox.TwoButtons>
  <RimWorldAccess.UI.MessageBox.OneButton>Натисніть Enter для {0}.</RimWorldAccess.UI.MessageBox.OneButton>

  <!-- =================================================================
       Slider dialog (SliderDialogState — Dialog_Slider keyboard nav).
       OpenPrompt: {0} = current value text (from textGetter), {1} = min, {2} = max.
       Confirmed: {0} = confirmed integer value.
       Cleared: spoken when digit buffer is emptied via Backspace. -->
  <RimWorldAccess.UI.Slider.OpenPrompt>{0}. Діапазон від {1} до {2}. Вгору/Вниз для дрібної зміни, Вліво/Вправо для кроку в десять відсотків, введіть цифри і Enter, щоб встановити, Enter для підтвердження, Escape для скасування.</RimWorldAccess.UI.Slider.OpenPrompt>
  <RimWorldAccess.UI.Slider.Confirmed>Підтверджено: {0}</RimWorldAccess.UI.Slider.Confirmed>
  <RimWorldAccess.UI.Slider.Cleared>Очищено</RimWorldAccess.UI.Slider.Cleared>

  <!-- Save menu: no existing files to overwrite (save mode, Down from text field). -->
  <RimWorldAccess.UI.Save.NoExistingSaves>Немає наявних збережень для перезапису.</RimWorldAccess.UI.Save.NoExistingSaves>

  <!-- TwoLevelMenuHelper fallback messages, used when a caller does not supply
       its own context-specific text. -->
