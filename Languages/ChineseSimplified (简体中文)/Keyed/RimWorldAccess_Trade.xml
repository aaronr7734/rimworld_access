  <!-- =================================================================
       Item announcement composition for the inventory tabs.
       *.SoloAvailable: only one party has the item; {0} = count.
       *.SoloPrice: bare price line, {0} = formatted price.
       *.SoloPriceWithQuality: with price-quality suffix; {0} = price,
                              {1} = quality phrase.
       *.NotTradeable: trader will not trade this item.
       *.YoursAt / TheirsAt: shared item; {0} = count, {1} = price.
       *.YoursAtWithQuality / TheirsAtWithQuality: same plus quality;
                              {0} = count, {1} = price, {2} = quality.
       *.YoursOnly / TheirsOnly: shared but trader won't trade;
                              {0} = count.
       ================================================================= -->
  <RimWorldAccess.Trade.Item.SoloAvailable>{0} 可交易</RimWorldAccess.Trade.Item.SoloAvailable>
  <RimWorldAccess.Trade.Item.SoloPrice>{0}</RimWorldAccess.Trade.Item.SoloPrice>
  <RimWorldAccess.Trade.Item.SoloPriceWithQuality>{0}, {1}</RimWorldAccess.Trade.Item.SoloPriceWithQuality>
  <RimWorldAccess.Trade.Item.NotTradeable>不可交易</RimWorldAccess.Trade.Item.NotTradeable>
  <RimWorldAccess.Trade.Item.YoursAt>你的: {0}, 单价 {1}</RimWorldAccess.Trade.Item.YoursAt>
  <RimWorldAccess.Trade.Item.TheirsAt>对方的: {0}, 单价 {1}</RimWorldAccess.Trade.Item.TheirsAt>
  <RimWorldAccess.Trade.Item.YoursAtWithQuality>你的: {0}, 单价 {1}（{2}）</RimWorldAccess.Trade.Item.YoursAtWithQuality>
  <RimWorldAccess.Trade.Item.TheirsAtWithQuality>对方的: {0}, 单价 {1}（{2}）</RimWorldAccess.Trade.Item.TheirsAtWithQuality>
  <RimWorldAccess.Trade.Item.YoursOnly>你的: {0}</RimWorldAccess.Trade.Item.YoursOnly>
  <RimWorldAccess.Trade.Item.TheirsOnly>对方的: {0}</RimWorldAccess.Trade.Item.TheirsOnly>

