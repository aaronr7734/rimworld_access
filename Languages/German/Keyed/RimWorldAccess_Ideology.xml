<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Ideology module strings (src/Ideology/). Four files contribute:
      - IdeologyHelper.cs       (list/tree construction and announcements)
      - IdeologyTabPatch.cs     (Harmony interception — no user strings)
      - IdeologyTabState.cs     (two-panel navigation: list + details)
      - IdeologyTreeNavigation.cs (details panel tree nav, ritual sound preview)

    Most ideology content already flows through vanilla keys
    ("IdeoligionOf", "StructureMeme", "FluidIdeoTip", etc.) — those are left
    alone. The keys below cover the connective English phrases we add on top
    of the vanilla strings: faction-status parentheticals, ritual-sound preview
    hints, tab-closed announcements, and the inspectable / info-card prompts.

    Note: "Inspectable" suffix and "Choose item to inspect" live in
    RimWorldAccess_Common.xml as RimWorldAccess.InfoCard.Inspectable and
    RimWorldAccess.InfoCard.ChooseItemToInspect — every module that needs
    those phrases delegates to the shared keys.
  -->

  <!-- Faction usage suffixes for the list-panel and factions section.
       Appended parenthetically to a faction name to indicate whether the
       faction holds this ideology as primary or minor. -->
  <RimWorldAccess.Ideology.List.FactionPrimarySuffix>{0} (primär)</RimWorldAccess.Ideology.List.FactionPrimarySuffix>
  <RimWorldAccess.Ideology.List.FactionMinorSuffix>{0} (sekundär)</RimWorldAccess.Ideology.List.FactionMinorSuffix>
  <RimWorldAccess.Ideology.FactionsSection.PrimaryEntry>{0}, primär</RimWorldAccess.Ideology.FactionsSection.PrimaryEntry>
  <RimWorldAccess.Ideology.FactionsSection.MinorEntry>{0}, sekundär</RimWorldAccess.Ideology.FactionsSection.MinorEntry>

  <!-- Style-category ritual-sound preview hints. Shown in a tree node label
       so keyboard users know to expand the node and press Enter to preview
       the ritual ambience sound.
         {0} = comma-separated style names that have a sound preview
         {1} = count (Many only)
       Separate One/Many keys because English needs subject-verb agreement
       ("1 style has" vs "N styles have") and noun-plural agreement
       ("preview" vs "previews"). -->
  <RimWorldAccess.Ideology.Styles.RitualSoundHintOne>1 Stil mit Ritualgeräuschen: {0}. Pfeil nach rechts klappt die Stile aus</RimWorldAccess.Ideology.Styles.RitualSoundHintOne>
  <RimWorldAccess.Ideology.Styles.RitualSoundHintMany>{1} Stile mit Ritualgeräuschen: {0}. Pfeil nach rechts klappt die Stile aus</RimWorldAccess.Ideology.Styles.RitualSoundHintMany>

  <!-- "Enter to preview" hint appended to a RitualAmbienceSound node label so
       the user knows the Enter key will start/stop sound playback. -->
  <RimWorldAccess.Ideology.Styles.EnterToPreview>. Enter startet die Ritualgeräusche</RimWorldAccess.Ideology.Styles.EnterToPreview>

  <!-- Ritual sound toggle announcements. {0} = vanilla "RitualAmbienceSound"
       label, resolved at call time. -->
  <RimWorldAccess.Ideology.RitualSound.Playing>{0} gestartet.</RimWorldAccess.Ideology.RitualSound.Playing>
  <RimWorldAccess.Ideology.RitualSound.Stopped>{0} gestoppt.</RimWorldAccess.Ideology.RitualSound.Stopped>
  <!-- Context-menu option to start/stop the ritual sound preview in the ideoligion editor. -->

  <!-- Tab open/close composition.
         TabClosed: spoken when Escape closes the tab. {0} = tab label.
         TabEmpty: spoken when the tab opens with no visible ideologies.
                   {0} = tab label, {1} = vanilla "NoneLower" translation.
         TabItemCount: spoken after the tab label to give an overall count.
                       {0} = count, {1} = tab label (already translated). -->
  <RimWorldAccess.Ideology.Tab.Closed>{0} geschlossen.</RimWorldAccess.Ideology.Tab.Closed>
  <RimWorldAccess.Ideology.Tab.Empty>{0}. {1}.</RimWorldAccess.Ideology.Tab.Empty>
  <RimWorldAccess.Ideology.Tab.ItemCount>{0} {1}</RimWorldAccess.Ideology.Tab.ItemCount>

  <!-- Inspectable suffix and "Choose item to inspect" prompt are shared
       across modules; see RimWorldAccess.InfoCard.Inspectable and
       RimWorldAccess.InfoCard.ChooseItemToInspect in Common.xml. -->

  <!-- Fallback announcement when a selected ideology has no tree content
       (e.g. a minimal/custom ideology with no visible sections).
         {0} = ideology name, {1} = vanilla "NoneLower" translation. -->
  <RimWorldAccess.Ideology.Tree.Empty>{0}. {1}</RimWorldAccess.Ideology.Tree.Empty>

  <!-- Residual precept section label (IdeologyHelper.BuildIdeologyTree). Vanilla's own
       precept ladder (IdeoUIUtility.DoPrecepts) has no catch-all category, so there is no
       vanilla key to reuse; this covers precepts from a modded preceptClass that none of
       the nine standard sections claim, so they still reach the tree instead of vanishing. -->
  <RimWorldAccess.Ideology.OtherPrecepts>Weitere Gebote</RimWorldAccess.Ideology.OtherPrecepts>

  <!-- IdeoBuilder module strings (src/IdeoBuilder/).
       Navigation hint for the worldgen builder hub's own two-tab shell. -->
  <RimWorldAccess.Ideology.Builder.TabForIdeoList>Tab wechselt zur Liste der Ideologien</RimWorldAccess.Ideology.Builder.TabForIdeoList>

  <!-- Spoken when a section or action is disabled but has no specific reason string. -->
  <RimWorldAccess.Ideology.Builder.Unavailable>Nicht verfügbar</RimWorldAccess.Ideology.Builder.Unavailable>

  <!-- Spoken when the ] edit-menu is opened on a precept that has no editable options. -->
  <RimWorldAccess.Ideology.Builder.NoEditOptions>Nichts zu bearbeiten</RimWorldAccess.Ideology.Builder.NoEditOptions>
  <!-- Hidden display-English sweep (returned/assigned strings localized).
       The two section names are BARE names: the precept editor is a tree again, so the
       child count rides the shared expansion suffix instead of the section label. -->
  <RimWorldAccess.Ideology.Builder.PreceptSection.ActiveName>Aktive Gebote</RimWorldAccess.Ideology.Builder.PreceptSection.ActiveName>
  <RimWorldAccess.Ideology.Builder.PreceptSection.NotSetName>Nicht gesetzt</RimWorldAccess.Ideology.Builder.PreceptSection.NotSetName>
  <RimWorldAccess.Ideology.Builder.PreceptSummary>{0} aktiv, {1} nicht gesetzt</RimWorldAccess.Ideology.Builder.PreceptSummary>
  <RimWorldAccess.Ideology.Builder.PreceptCurrent>aktuell</RimWorldAccess.Ideology.Builder.PreceptCurrent>

  <!-- Action hint appended to the fluid-ideology development-points node when
       the ideoligion can be reformed right now (IdeologyHelper.BuildFluidSection). -->
  <RimWorldAccess.Ideology.PressEnterToReform>Enter reformiert die Ideologie</RimWorldAccess.Ideology.PressEnterToReform>

  <!-- Bare status-word suffixes spoken after a comma in the ideoligion builder
       (e.g. "Theist deity, removed"). One word each so translators can decline
       them; the leading ", " separator is composed in C#. -->
  <RimWorldAccess.Ideology.Builder.Status.Selected>ausgewählt</RimWorldAccess.Ideology.Builder.Status.Selected>
  <RimWorldAccess.Ideology.Builder.Status.Removed>entfernt</RimWorldAccess.Ideology.Builder.Status.Removed>
  <RimWorldAccess.Ideology.Builder.Status.Reformed>reformiert</RimWorldAccess.Ideology.Builder.Status.Reformed>
  <RimWorldAccess.Ideology.Builder.Status.Yours>deine Ideologie</RimWorldAccess.Ideology.Builder.Status.Yours>

  <!-- Discard confirmation when backing out of the ideoligion builder. -->
  <RimWorldAccess.Ideology.Builder.DiscardConfirm>Diese benutzerdefinierte Ideologie geht verloren, wenn du zurückgehst. Möchtest du fortfahren?</RimWorldAccess.Ideology.Builder.DiscardConfirm>
  <RimWorldAccess.Ideology.Builder.DiscardContinue>Fortfahren</RimWorldAccess.Ideology.Builder.DiscardContinue>
  <RimWorldAccess.Ideology.Builder.DiscardCancel>Abbrechen</RimWorldAccess.Ideology.Builder.DiscardCancel>

  <!-- Randomize-all confirmation, shown by both the worldgen hub and the Archonexus-facing
       section editor (Alt+R replaces the entire ideoligion; vanilla shows no warning). -->
  <RimWorldAccess.Ideology.Builder.RandomizeAllConfirm>Die ganze Ideologie wird zufällig neu erstellt. Möchtest du fortfahren?</RimWorldAccess.Ideology.Builder.RandomizeAllConfirm>
  <RimWorldAccess.Ideology.Builder.RandomizeAllContinue>Fortfahren</RimWorldAccess.Ideology.Builder.RandomizeAllContinue>
  <RimWorldAccess.Ideology.Builder.RandomizeAllCancel>Abbrechen</RimWorldAccess.Ideology.Builder.RandomizeAllCancel>

  <!-- IdeoBuilderScreenScope: the two regions of the worldgen builder hub. -->
  <RimWorldAccess.Ideology.Builder.EditorRegion>Ideologie</RimWorldAccess.Ideology.Builder.EditorRegion>
  <RimWorldAccess.Ideology.Builder.ListRegion>Ideologien</RimWorldAccess.Ideology.Builder.ListRegion>

  <!-- Description-lock checkbox row label (the icon-only lock button next to the narrative text
       has no vanilla label of its own — IdeoUIUtility.DoDescription, decompiled :1086-1104). -->
  <RimWorldAccess.Ideology.Builder.DescriptionLock>Beschreibung sperren</RimWorldAccess.Ideology.Builder.DescriptionLock>

  <!-- Dev-mode "+" button next to the fluid development-points row (IdeoUIUtility.DoFluidIdeo,
       decompiled :983-986); vanilla draws it as a bare "+" with no accessible label. -->
  <RimWorldAccess.Ideology.Builder.DevMaxPoints>Entwicklermodus: Entwicklungspunkte maximieren</RimWorldAccess.Ideology.Builder.DevMaxPoints>

  <!-- Label for the read-only validation/impact row at the end of the editor region (mirrors
       Page_ConfigureIdeo.DoWindowContents' bottom-right warning/impact readout). -->
  <RimWorldAccess.Ideology.Builder.StatusLabel>Status</RimWorldAccess.Ideology.Builder.StatusLabel>

  <!-- StyleItemsDialogScope (focus-ring census wave 3, slice W3-9). A category row's aggregate frequency when its
       items disagree — vanilla's own RadioButSemiOn semi-selected mark has no text label of its
       own, so this is new. -->
  <RimWorldAccess.Ideology.Builder.Appearance.MixedFrequency>Gemischt</RimWorldAccess.Ideology.Builder.Appearance.MixedFrequency>

  <!-- Gender fragment appended to an item or category row's Extras. {0} = the gender label
       ("Male"/"Female"/"Male and female"). -->
  <RimWorldAccess.Ideology.Builder.Appearance.GenderFragment>Geschlecht: {0}</RimWorldAccess.Ideology.Builder.Appearance.GenderFragment>

  <!-- IdeologyViewerScreenScope: the F12 Ideology
       tab's three regions. Kept distinct from the worldgen builder's Builder.EditorRegion/
       Builder.ListRegion keys — this tab's third region is the dev-only editor, not the builder's
       always-present one, and "Details" names the read-only tree that has no equivalent there. -->
  <RimWorldAccess.Ideology.Viewer.ListRegion>Ideologien</RimWorldAccess.Ideology.Viewer.ListRegion>
  <RimWorldAccess.Ideology.Viewer.DetailsRegion>Details</RimWorldAccess.Ideology.Viewer.DetailsRegion>
  <RimWorldAccess.Ideology.Viewer.EditorRegion>Editor</RimWorldAccess.Ideology.Viewer.EditorRegion>

  <!-- Hint suffix baked into the two injected appearance-editor tree rows (S1 follow-up finding
       #8b), the same way the Fluid section's own label bakes in PressEnterToReform above — this
       tree's formatter has no separate spoken-role mechanism. -->
  <RimWorldAccess.Ideology.Viewer.PressEnterToEdit>Enter bearbeitet die Stile</RimWorldAccess.Ideology.Viewer.PressEnterToEdit>

  <!-- IdeoReformScreenScope: the fluid-ideoligion
       reform dialog's one content region, whose name flips with the dialog's own stage. -->
  <RimWorldAccess.Ideology.Reform.ChangesRegion>Änderungen</RimWorldAccess.Ideology.Reform.ChangesRegion>
  <RimWorldAccess.Ideology.Reform.EditRegion>Bearbeiten</RimWorldAccess.Ideology.Reform.EditRegion>

</LanguageData>
