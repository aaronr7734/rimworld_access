<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Work module strings (src/Work/). Two files contribute:
      - WorkMenuState.cs  (priority grid, basic-mode list, bulk-set, search)
      - WorkMenuPatch.cs  (visual overlay rendered while the menu is open)

    The work menu has two modes: a 5-column priority grid (Manual Priority
    Mode: Priority 1..4 plus Disabled) and a single-list Basic Mode. Both
    modes speak the same item details - labelShort, skill/passion info, and
    a position suffix - composed from these keys. Column names, priority
    words, mode names and placement-context phrases are deliberately kept
    as small building blocks so translators can reorder them inside the
    composed announcements.

    Placeholders follow string.Format ({0}, {1}, ...). All dynamic data -
    pawn names, work-type labelShort, skill labels, counts, reason lists -
    comes from the game and is NOT translated in this file.

    Singular/plural keys (.One/.Many) are used where English needs
    subject-verb agreement (e.g. "1 already set" vs "3 already set");
    other languages can collapse or split these further as grammar needs.
  -->

  <!-- Menu lifecycle announcements (open, cancel, confirm).
       OpeningTitle is spoken when the menu first appears; the current
       position announcement follows it immediately. -->
  <RimWorldAccess.Work.Saved>Arbeitseinstellungen gespeichert</RimWorldAccess.Work.Saved>

  <!-- Pawn switch via Tab / Shift+Tab.
       SavedPrefix is prepended when the previous pawn had pending changes.
       {0} = previous pawn name, {1} = brief announcement for the new pawn. -->
  <RimWorldAccess.Work.PawnSwitch.SavedPrefix>{0}: Einstellungen gespeichert. {1}</RimWorldAccess.Work.PawnSwitch.SavedPrefix>

  <!-- Fallback pawn name used when LabelShort is unavailable. Rare;
       mostly defensive for null-check paths. -->
  <RimWorldAccess.Work.UnknownPawn>Unbekannt</RimWorldAccess.Work.UnknownPawn>

  <!-- Work-priority copy/paste (Ctrl+C / Ctrl+V), sharing vanilla's own
       clipboard. CopyPasteAnnouncement: {0} = the game's own Copy/Paste word,
       {1} = pawn name. NoPrioritiesCopied is the refusal when nothing has been
       copied yet. -->
  <RimWorldAccess.Work.CopyPasteAnnouncement>{0}: {1}</RimWorldAccess.Work.CopyPasteAnnouncement>
  <RimWorldAccess.Work.NoPrioritiesCopied>Keine Arbeitsprioritäten kopiert</RimWorldAccess.Work.NoPrioritiesCopied>

  <!-- Mode names. Toggle (Alt+M) announces just the new mode; the overlay
       shows the same strings in the header row. -->
  <RimWorldAccess.Work.Mode.Manual>Manueller Prioritätsmodus</RimWorldAccess.Work.Mode.Manual>
  <RimWorldAccess.Work.Mode.Basic>Einfacher Modus</RimWorldAccess.Work.Mode.Basic>

  <!-- Column names for the 5-column priority grid. Used in the spoken
       announcements, the overlay's position readout, and composed into
       phrases like "{column}: empty". -->
  <RimWorldAccess.Work.Column.Priority1>Priorität 1</RimWorldAccess.Work.Column.Priority1>
  <RimWorldAccess.Work.Column.Priority2>Priorität 2</RimWorldAccess.Work.Column.Priority2>
  <RimWorldAccess.Work.Column.Priority3>Priorität 3</RimWorldAccess.Work.Column.Priority3>
  <RimWorldAccess.Work.Column.Priority4>Priorität 4</RimWorldAccess.Work.Column.Priority4>
  <RimWorldAccess.Work.Column.Disabled>Deaktiviert</RimWorldAccess.Work.Column.Disabled>
  <RimWorldAccess.Work.Column.Unknown>Unbekannt</RimWorldAccess.Work.Column.Unknown>

  <!-- Bare priority word used inside composed announcements.
       For columns 0-3 (Priority 1-4) this is just the digit; column 4
       is the localized word "disabled". Example composition:
       "mine, 2, placed right of cooking". -->
  <RimWorldAccess.Work.PriorityWord.1>1</RimWorldAccess.Work.PriorityWord.1>
  <RimWorldAccess.Work.PriorityWord.2>2</RimWorldAccess.Work.PriorityWord.2>
  <RimWorldAccess.Work.PriorityWord.3>3</RimWorldAccess.Work.PriorityWord.3>
  <RimWorldAccess.Work.PriorityWord.4>4</RimWorldAccess.Work.PriorityWord.4>
  <RimWorldAccess.Work.PriorityWord.Disabled>deaktiviert</RimWorldAccess.Work.PriorityWord.Disabled>

  <!-- NoWorkTypeSelected: Shift+0-4 bulk set with no entry under cursor. -->
  <RimWorldAccess.Work.NoWorkTypeSelected>Kein Arbeitstyp ausgewählt</RimWorldAccess.Work.NoWorkTypeSelected>

  <!-- Single-pawn SetPriority feedback.
       AlreadyAtPriority: {0} = work labelShort, {1} = priority word
         (e.g. "mine already at 3" / "cleaning already at disabled").
       MovedToDisabled: {0} = work labelShort. Spoken when an item is
         moved to the Disabled column (no placement context follows).
       MovedToPriority: {0} = labelShort, {1} = priority word. Used when
         the new column has only one movable item, so no neighbour context.
       MovedToPriorityWithContext: {0} = labelShort, {1} = priority word,
         {2} = placement-context clause (see PlacementContext.* below). -->
  <RimWorldAccess.Work.SetPriority.AlreadyAtPriority>{0}: bereits {1}</RimWorldAccess.Work.SetPriority.AlreadyAtPriority>
  <RimWorldAccess.Work.SetPriority.MovedToDisabled>{0}, deaktiviert</RimWorldAccess.Work.SetPriority.MovedToDisabled>
  <RimWorldAccess.Work.SetPriority.MovedToPriority>{0}, {1}</RimWorldAccess.Work.SetPriority.MovedToPriority>
  <RimWorldAccess.Work.SetPriority.MovedToPriorityWithContext>{0}, {1}, {2}</RimWorldAccess.Work.SetPriority.MovedToPriorityWithContext>

  <!-- Basic Mode toggle status suffix and disabled-entry status word.
       Status.Enabled / Status.Disabled: post-priority state in Basic Mode.
       PriorityLabel: priority-label used inside the bulk-set announcement
         and the pawn-switch summary. {0} = priority number. -->
  <RimWorldAccess.Work.Status.Enabled>aktiviert</RimWorldAccess.Work.Status.Enabled>
  <RimWorldAccess.Work.Status.Disabled>deaktiviert</RimWorldAccess.Work.Status.Disabled>
  <RimWorldAccess.Work.PriorityLabel>Priorität {0}</RimWorldAccess.Work.PriorityLabel>

  <!-- Cannot-enable announcement for permanently disabled work types.
       {0} = comma-joined reasons from pawn.GetReasonsForDisabledWorkType. -->
  <RimWorldAccess.Work.CannotEnable>Aktivieren nicht möglich. Dauerhaft deaktiviert: {0}</RimWorldAccess.Work.CannotEnable>

  <!-- BuildTaskAnnouncement (composed item description).
       PermanentlyDisabledPrefix is appended after the labelShort and is
       followed by the comma-joined reasons list - no placeholder; C#
       concatenates. -->
  <RimWorldAccess.Work.Task.PermanentlyDisabledPrefix>. Dauerhaft deaktiviert: </RimWorldAccess.Work.Task.PermanentlyDisabledPrefix>
  <RimWorldAccess.Work.Task.UnskilledLabor>. Keine Fertigkeit nötig.</RimWorldAccess.Work.Task.UnskilledLabor>

  <!-- Skill level phrases.
       LevelSuffix: {0} = integer skill level. Spoken when the one relevant
         skill has the same name as the work type (no need to repeat it).
       SkillsAndLevelSuffix: {0} = skill level. Follows the comma-joined
         skill-name list built in C# (e.g. "Melee and Shooting: level 8"). -->
  <RimWorldAccess.Work.Task.LevelSuffix>. Stufe {0}</RimWorldAccess.Work.Task.LevelSuffix>
  <RimWorldAccess.Work.Task.SkillsAndLevelSuffix>: Stufe {0}</RimWorldAccess.Work.Task.SkillsAndLevelSuffix>
  <!-- Separator between the final two skill names (" and "). Kept as a
       key so languages that don't use a coordinating conjunction can
       render an empty or punctuation-only separator. -->
  <RimWorldAccess.Work.Task.SkillListAndSeparator> und </RimWorldAccess.Work.Task.SkillListAndSeparator>

  <!-- Passion suffixes appended at the end of the task announcement. -->

  <!-- Placement context announced after a SetPriority move, describing
       where the item landed inside the destination column. Consumed bare
       by MovedToPriorityWithContext.
       {0} = neighbour (or left neighbour), {1} = right neighbour. -->
  <RimWorldAccess.Work.PlacementContext.LeftOf>links von {0}</RimWorldAccess.Work.PlacementContext.LeftOf>
  <RimWorldAccess.Work.PlacementContext.RightOf>rechts von {0}</RimWorldAccess.Work.PlacementContext.RightOf>
  <RimWorldAccess.Work.PlacementContext.FirstLeftOf>an erster Stelle, links von {0}</RimWorldAccess.Work.PlacementContext.FirstLeftOf>
  <RimWorldAccess.Work.PlacementContext.LastRightOf>an letzter Stelle, rechts von {0}</RimWorldAccess.Work.PlacementContext.LastRightOf>
  <RimWorldAccess.Work.PlacementContext.Between>zwischen {0} und {1}</RimWorldAccess.Work.PlacementContext.Between>

  <!-- Bulk-set announcement (Shift+0-4: apply priority to all pawns).
       {0} = work type labelShort, {1} = priority label (e.g. "Priority 2"
       or the localized "disabled" word), {2} = comma-joined name list or
       the count for "already set".
       AlreadySetOne / AlreadySetMany split on English subject-verb
       agreement: "1 already set" vs "3 already set". -->
  <RimWorldAccess.Work.BulkSet.NoCapableColonists>{0}: Kein Kolonist kann das.</RimWorldAccess.Work.BulkSet.NoCapableColonists>
  <RimWorldAccess.Work.BulkSet.AlreadyForAll>{0}: bereits {1} bei allen Kolonisten</RimWorldAccess.Work.BulkSet.AlreadyForAll>
  <RimWorldAccess.Work.BulkSet.AlreadyForAllCapable>{0}: bereits {1} bei allen Kolonisten, die das können</RimWorldAccess.Work.BulkSet.AlreadyForAllCapable>
  <RimWorldAccess.Work.BulkSet.SetForAll>{0}: {1} für alle Kolonisten</RimWorldAccess.Work.BulkSet.SetForAll>
  <RimWorldAccess.Work.BulkSet.SetForAllExcept>{0}: {1} für alle außer {2}</RimWorldAccess.Work.BulkSet.SetForAllExcept>
  <RimWorldAccess.Work.BulkSet.SetForList>{0}: {1} für {2}</RimWorldAccess.Work.BulkSet.SetForList>
  <RimWorldAccess.Work.BulkSet.SetForListWithAlreadySetOne>{0}: {1} für {2}. {3} Kolonist hatte das schon</RimWorldAccess.Work.BulkSet.SetForListWithAlreadySetOne>
  <RimWorldAccess.Work.BulkSet.SetForListWithAlreadySetMany>{0}: {1} für {2}. {3} Kolonisten hatten das schon</RimWorldAccess.Work.BulkSet.SetForListWithAlreadySetMany>

  <!-- FormatNameList joiners. English uses Oxford-comma "A, B, and C" for
       3+ and plain "A and B" for 2; other languages can re-map the
       separators. Two/ThreePlusLast both have {0} = earlier names,
       {1} = last name. -->
  <RimWorldAccess.Work.NameList.Two>{0} und {1}</RimWorldAccess.Work.NameList.Two>
  <RimWorldAccess.Work.NameList.ThreePlusLastJoiner> und </RimWorldAccess.Work.NameList.ThreePlusLastJoiner>
  <RimWorldAccess.Work.NameList.Separator>, </RimWorldAccess.Work.NameList.Separator>

  <!-- Pawn-switch brief announcement composition (no entry case).
       {0} = pawn name, {1} = position suffix "{i} of {n}". -->
  <RimWorldAccess.Work.PawnSwitch.NoEntry>{0}. {1}</RimWorldAccess.Work.PawnSwitch.NoEntry>

  <!-- Pawn-switch brief announcement with an entry, permanently disabled.
       {0} = pawn name, {1} = work labelShort, {2} = details suffix
       (", Permanently disabled: reasons"), {3} = position suffix. -->
  <RimWorldAccess.Work.PawnSwitch.PermanentlyDisabled>{0}. {1}{2}. {3}</RimWorldAccess.Work.PawnSwitch.PermanentlyDisabled>

  <!-- Pawn-switch brief announcement with an entry and a priority.
       {0} = pawn name, {1} = work labelShort, {2} = priority label
       (localized column name or "disabled" word), {3} = details suffix,
       {4} = position suffix. -->
  <RimWorldAccess.Work.PawnSwitch.WithPriority>{0}. {1}, {2}{3}. {4}</RimWorldAccess.Work.PawnSwitch.WithPriority>

  <!-- WorkTableState lifecycle and mode announcements.
       OpeningAnnouncement: {0} = colonist count, {1} = work type count, {2} = mode string.
       FocusedViewOpening: {0} = pawn LabelShort. Spoken when focused view opens. -->
  <RimWorldAccess.Work.Table.OpeningAnnouncement>Arbeit, Tabellenansicht, {0} Kolonisten, {1} Arbeitstypen, {2}</RimWorldAccess.Work.Table.OpeningAnnouncement>
  <RimWorldAccess.Work.FocusedViewOpening>Arbeit, Einzelansicht. {0}</RimWorldAccess.Work.FocusedViewOpening>

  <!-- Table view: sort announcements.
       CannotSort: {0} = column name.
       SortedBy: {0} = column name, {1} = direction word. -->

  <!-- Table view: priority-change feedback.
       AlreadyState: {0} = pawn LabelShort, {1} = work labelShort, {2} = state label.
       SetStateForList: {0} = work labelShort, {1} = state label, {2} = name list.
       Raised/Lowered: direction words used inside RaisedForList / LoweredForList.
       RaisedForList / LoweredForList: {0} = work labelShort, {1} = name list. -->
  <RimWorldAccess.Work.Table.AlreadyState>{0}, {1}: bereits {2}</RimWorldAccess.Work.Table.AlreadyState>
  <RimWorldAccess.Work.Table.SetStateForList>{0}: {1} für {2}</RimWorldAccess.Work.Table.SetStateForList>
  <RimWorldAccess.Work.Table.Raised>erhöht</RimWorldAccess.Work.Table.Raised>
  <RimWorldAccess.Work.Table.Lowered>reduziert</RimWorldAccess.Work.Table.Lowered>
  <RimWorldAccess.Work.Table.RaisedForList>{0}: erhöht für {1}</RimWorldAccess.Work.Table.RaisedForList>
  <RimWorldAccess.Work.Table.LoweredForList>{0}: reduziert für {1}</RimWorldAccess.Work.Table.LoweredForList>

  <!-- Table view: painting announcements.
       PaintIncapable: {0} = target LabelShort, {1} = position string.
       PaintAlreadyState: {0} = target LabelShort, {1} = state label, {2} = position.
       PaintedState: {0} = target LabelShort, {1} = state label, {2} = position.
       RangeAlreadyState: {0} = work labelShort, {1} = state label.
       PaintedForList: {0} = work labelShort, {1} = state label, {2} = name list. -->
  <RimWorldAccess.Work.Table.PaintIncapable>{0}: unfähig. {1}</RimWorldAccess.Work.Table.PaintIncapable>
  <RimWorldAccess.Work.Table.PaintAlreadyState>{0}: bereits {1}. {2}</RimWorldAccess.Work.Table.PaintAlreadyState>
  <RimWorldAccess.Work.Table.PaintedState>{0}: {1}. {2}</RimWorldAccess.Work.Table.PaintedState>
  <RimWorldAccess.Work.Table.RangeAlreadyState>{0}: bereits {1} in diesem Bereich</RimWorldAccess.Work.Table.RangeAlreadyState>
  <RimWorldAccess.Work.Table.PaintedForList>{0}: {1} für {2}</RimWorldAccess.Work.Table.PaintedForList>

  <!-- Table view: reject / guard announcements.
       SelectWorkTypeFirst: no work-type column is selected.
       CannotPaintNameColumn: painting attempted on the name column.
       NoChangeFor: {0} = work labelShort; all pawns already at the target.
       SourceIncapableOf: {0} = source pawn LabelShort, {1} = work labelShort.
       CannotDo: {0} = pawn LabelShort, {1} = work labelShort, {2} = optional reason detail (": reasons" or empty). -->
  <RimWorldAccess.Work.Table.SelectWorkTypeFirst>Wähle zuerst eine Arbeitstyp-Spalte aus</RimWorldAccess.Work.Table.SelectWorkTypeFirst>
  <RimWorldAccess.Work.Table.CannotPaintNameColumn>Auf die Namensspalte kannst du keine Priorität anwenden</RimWorldAccess.Work.Table.CannotPaintNameColumn>
  <RimWorldAccess.Work.Table.NoChangeFor>{0}: keine Änderung</RimWorldAccess.Work.Table.NoChangeFor>
  <RimWorldAccess.Work.Table.SourceIncapableOf>{0}: {1} nicht möglich</RimWorldAccess.Work.Table.SourceIncapableOf>
  <RimWorldAccess.Work.Table.CannotDo>{0}: {1} nicht möglich{2}</RimWorldAccess.Work.Table.CannotDo>

  <!-- WorkMenuState: cycle-all-pawns no-change and direction feedback.
       NoChangeFor: {0} = work labelShort. Used when no pawn changed.
       RaisedForList / LoweredForList reused from Work.Table above. -->
  <RimWorldAccess.Work.Menu.NoChangeFor>{0}: keine Änderung</RimWorldAccess.Work.Menu.NoChangeFor>

  <!-- Task detail composition pieces restored/added after the merge.
       IncludesPrefix leads the comma-joined work-giver list; leading
       ". " is part of the value, matching Task.UnskilledLabor.
       IncapableWithReasons: {0} = comma-joined disabled reasons. -->
  <RimWorldAccess.Work.Task.IncludesPrefix>. Umfasst: </RimWorldAccess.Work.Task.IncludesPrefix>
  <RimWorldAccess.Work.Task.IdeologyOpposes>. Der Glaube widerspricht dieser Arbeit</RimWorldAccess.Work.Task.IdeologyOpposes>
  <RimWorldAccess.Work.Column.Name>Name</RimWorldAccess.Work.Column.Name>
  <RimWorldAccess.Work.Table.Incapable>unfähig</RimWorldAccess.Work.Table.Incapable>
  <RimWorldAccess.Work.Table.IncapableWithReasons>unfähig: {0}</RimWorldAccess.Work.Table.IncapableWithReasons>
</LanguageData>
