<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Combat module strings (src/Combat/). Three files contribute:
      - CombatLogState.cs  (Alt+B combat log viewer)
      - ShellImpactPatch.cs  (mortar/artillery impact announcements)
      - TargetingPatch.cs  (Enter-to-target, range/LOS feedback, multi-select)

    The multi-select keys (Combat.MultiSelect.*) exist as whole phrases per
    semantic case so translators can reorder subject/verb/object freely. C#
    picks which key to use based on succeeded/unchanged pawn counts. Singular
    and plural subject forms are separate keys because English needs subject-
    verb agreement ("Only Bob attacks" vs "Only Bob and Alice attack"); other
    languages can collapse or split these further in their own XML.
  -->

  <!-- Combat log (Alt+B). -->
  <RimWorldAccess.Combat.Log.NoBattleLog>Kein Kampf-Logbuch verfügbar</RimWorldAccess.Combat.Log.NoBattleLog>
  <RimWorldAccess.Combat.Log.Header>Kampf-Logbuch von {0}</RimWorldAccess.Combat.Log.Header>
  <RimWorldAccess.Combat.Log.BattleHeader>Kampf: {0}.</RimWorldAccess.Combat.Log.BattleHeader>
  <RimWorldAccess.Combat.Log.NoEntries>Keine Einträge gefunden.</RimWorldAccess.Combat.Log.NoEntries>
  <RimWorldAccess.Combat.Log.ShowingLastN>Das waren die letzten 10 von {0} Einträgen.</RimWorldAccess.Combat.Log.ShowingLastN>
  <RimWorldAccess.Combat.Log.Total>Insgesamt {0} Einträge.</RimWorldAccess.Combat.Log.Total>

  <!-- Shell impacts (mortars, artillery). {0} = shell source label,
       {1} = target label (Hit only), last two = impact cell x, z. -->
  <RimWorldAccess.Combat.Shell.SourceDefault>Eine Granate</RimWorldAccess.Combat.Shell.SourceDefault>
  <RimWorldAccess.Combat.Shell.SourceOurs>Unsere Granate</RimWorldAccess.Combat.Shell.SourceOurs>
  <RimWorldAccess.Combat.Shell.SourceEnemy>Eine feindliche Granate</RimWorldAccess.Combat.Shell.SourceEnemy>
  <RimWorldAccess.Combat.Shell.Hit>{0} hat {1} getroffen. Feld {2}, {3}</RimWorldAccess.Combat.Shell.Hit>
  <RimWorldAccess.Combat.Shell.Landed>{0} ist eingeschlagen. Feld {1}, {2}</RimWorldAccess.Combat.Shell.Landed>

  <!-- Generic target and location fallbacks. Used when target.HasThing is
       false and a labeled placeholder is needed for sentence composition. -->
  <RimWorldAccess.Combat.Target.GenericTargetLabel>Dieses Feld</RimWorldAccess.Combat.Target.GenericTargetLabel>
  <RimWorldAccess.Combat.Target.GenericLocationLabel>dieses Feld</RimWorldAccess.Combat.Target.GenericLocationLabel>

  <!-- Range/distance feedback during targeting. -->
  <RimWorldAccess.Combat.Target.NoRangeInfo>Reichweite unbekannt</RimWorldAccess.Combat.Target.NoRangeInfo>
  <RimWorldAccess.Combat.Target.DistanceInRange>{0} Felder entfernt. In Reichweite.</RimWorldAccess.Combat.Target.DistanceInRange>
  <RimWorldAccess.Combat.Target.DistanceOutOfRange>{0} Felder entfernt. Außer Reichweite, maximal {1} Felder.</RimWorldAccess.Combat.Target.DistanceOutOfRange>
  <RimWorldAccess.Combat.Target.OutOfRange>Außer Reichweite. {0} Felder entfernt, maximal {1} Felder.</RimWorldAccess.Combat.Target.OutOfRange>

  <!-- Target validation and errors. -->
  <RimWorldAccess.Combat.Target.InvalidPosition>Ungültiger Zielort</RimWorldAccess.Combat.Target.InvalidPosition>
  <RimWorldAccess.Combat.Target.InvalidTarget>Ungültiges Ziel</RimWorldAccess.Combat.Target.InvalidTarget>
  <RimWorldAccess.Combat.Target.NotValidTarget>{0} ist kein gültiges Ziel</RimWorldAccess.Combat.Target.NotValidTarget>
  <RimWorldAccess.Combat.Target.NoValidAtCursorWithDesc>Kein gültiges Ziel am Cursor. {0}</RimWorldAccess.Combat.Target.NoValidAtCursorWithDesc>
  <RimWorldAccess.Combat.Target.NoActionAvailable>Keine Aktion für die Zielauswahl verfügbar</RimWorldAccess.Combat.Target.NoActionAvailable>
  <RimWorldAccess.Combat.Target.ErrorUsing>Fehler beim Anwenden auf das Ziel: {0}</RimWorldAccess.Combat.Target.ErrorUsing>

  <!-- Targeting success announcements (single-select path). -->
  <RimWorldAccess.Combat.Target.Targeting>Ziel: {0}</RimWorldAccess.Combat.Target.Targeting>
  <RimWorldAccess.Combat.Target.TargetingLocation>Ziel: dieser Ort</RimWorldAccess.Combat.Target.TargetingLocation>
  <RimWorldAccess.Combat.Target.Selected>Ziel ausgewählt: {0}</RimWorldAccess.Combat.Target.Selected>

  <!-- Second-phase (destination) selection, e.g. Skip ability. -->
  <RimWorldAccess.Combat.Target.SelectDestination>Wähle jetzt den Zielort aus</RimWorldAccess.Combat.Target.SelectDestination>
  <RimWorldAccess.Combat.Target.SelectDestinationInRange>Wähle jetzt den Zielort aus. Reichweite: {0} Felder</RimWorldAccess.Combat.Target.SelectDestinationInRange>

  <!-- Ranged shot report: press 1 over a target with a drafted shooter
       selected. The contributing-factor breakdown is RimWorld's own localized
       ShotReport.GetTextReadout() text; we only supply the headline that
       replaces vanilla's awkward "Shot by X:" line, and the cannot-hit line.
       Headline: {0} = target label, {1} = total hit-chance percent.
       HeadlineGeneric is the fallback for miss-radius weapons (e.g. grenades)
       whose readout does not lead with a single hit-chance figure. -->
  <RimWorldAccess.Combat.ShotReport.Headline>{0}: Trefferchance {1}</RimWorldAccess.Combat.ShotReport.Headline>
  <RimWorldAccess.Combat.ShotReport.HeadlineGeneric>{0}</RimWorldAccess.Combat.ShotReport.HeadlineGeneric>
  <RimWorldAccess.Combat.ShotReport.CannotHit>{0} kann nicht getroffen werden.</RimWorldAccess.Combat.ShotReport.CannotHit>

  <!-- Multi-select attack feedback. Whole-phrase keys per semantic case so
       word order and subject-verb agreement can be localized naturally.
         Everyone:  all selected pawns accepted the order.
         NoOne:     none of the selected pawns accepted the order.
         Only:      some accepted, fewer accepted than rejected.
         Except:    some rejected, fewer rejected than accepted.
       English uses singular "attacks" for the Everyone and EveryoneExcept
       forms because "everyone" takes singular agreement. Only has split
       singular/plural forms because its subject is the name list itself.
       Translators can collapse or further split these as their grammar requires.
       {0} = everyone-label from vanilla key (Except) or name-list (Only),
       {1} = name-list of the exception / attack target,
       {2} = attack target (Except key only). -->
  <RimWorldAccess.Combat.MultiSelect.EveryoneAttacks>{0} greift {1} an</RimWorldAccess.Combat.MultiSelect.EveryoneAttacks>
  <RimWorldAccess.Combat.MultiSelect.NoOneCouldAttack>Niemand konnte {0} angreifen</RimWorldAccess.Combat.MultiSelect.NoOneCouldAttack>
  <RimWorldAccess.Combat.MultiSelect.EveryoneExceptAttacks>{0} außer {1} greift {2} an</RimWorldAccess.Combat.MultiSelect.EveryoneExceptAttacks>
  <RimWorldAccess.Combat.MultiSelect.OnlyOneAttacks>Nur {0} greift {1} an</RimWorldAccess.Combat.MultiSelect.OnlyOneAttacks>
  <RimWorldAccess.Combat.MultiSelect.OnlyManyAttack>Nur {0} greifen {1} an</RimWorldAccess.Combat.MultiSelect.OnlyManyAttack>
</LanguageData>
