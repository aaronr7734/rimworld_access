<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Shared vocabulary used by RimWorld Access helper classes. Every phrase in
    this file is emitted by a helper in src/UI, src/Map, or src/Inspection and
    represents the canonical English wording that Phase A consolidated. Each
    key is spoken many times across the mod - localizing here localizes the
    corresponding announcement everywhere it appears.

    Placeholders follow string.Format ({0}, {1}, ...). When a key has One/Many
    variants, the caller picks the form based on a count value; languages with
    additional plural classes can either keep both keys identical or split
    further using RimWorld's LanguageWorker.
  -->

  <!-- Guard preconditions (src/UI/GuardHelper.cs).
       Spoken when a state class cannot proceed because of missing game state. -->
  <RimWorldAccess.Guard.NotInGame>Kein Spiel gestartet</RimWorldAccess.Guard.NotInGame>
  <RimWorldAccess.Guard.NoMapLoaded>Keine Karte geladen</RimWorldAccess.Guard.NoMapLoaded>
  <RimWorldAccess.Guard.NoPawnSelected>Keine Person ausgewählt</RimWorldAccess.Guard.NoPawnSelected>
  <RimWorldAccess.Guard.NoItemSelected>Kein Objekt ausgewählt</RimWorldAccess.Guard.NoItemSelected>
  <RimWorldAccess.Guard.NoBuildingToConfigure>Kein Bauwerk zum Einstellen</RimWorldAccess.Guard.NoBuildingToConfigure>
  <RimWorldAccess.Guard.WorldNavigationNotActive>Weltnavigation nicht aktiv</RimWorldAccess.Guard.WorldNavigationNotActive>
  <RimWorldAccess.Guard.NoValidTileSelected>Kein gültiges Feld ausgewählt</RimWorldAccess.Guard.NoValidTileSelected>
  <RimWorldAccess.Guard.InvalidCursorPosition>Ungültige Cursorposition</RimWorldAccess.Guard.InvalidCursorPosition>

  <!-- Typeahead search (src/UI/TypeaheadSearchHelper.cs).
       Used across every menu that has type-to-find search.
       {0} = the user's search text (NoMatches).
       {0} = current 1-based match position, {1} = total matches,
       {2} = search buffer (ContextSuffix). -->
  <RimWorldAccess.Search.Cleared>Suchtext gelöscht</RimWorldAccess.Search.Cleared>
  <RimWorldAccess.Search.Prompt>Suche</RimWorldAccess.Search.Prompt>
  <RimWorldAccess.Search.Closed>Suche geschlossen</RimWorldAccess.Search.Closed>
  <RimWorldAccess.Search.NoMatches>Keine Treffer für '{0}'</RimWorldAccess.Search.NoMatches>
  <RimWorldAccess.Search.ContextSuffix>, {0} von {1} Treffern für '{2}'</RimWorldAccess.Search.ContextSuffix>

  <!-- Info card (src/Inspection/InfoCardState.cs).
       Spoken when an 'i'-style info-card action has no eligible target.
       Inspectable: suffix appended to a tree item's announcement when
       pressing Alt+I would open an info card; the leading space is part
       of the key so it joins onto whatever label precedes it.
       ChooseItemToInspect: float-menu prompt when the current item has
       multiple Defs that could be inspected. -->
  <RimWorldAccess.InfoCard.Unavailable>Keine Infokarte verfügbar</RimWorldAccess.InfoCard.Unavailable>
  <RimWorldAccess.InfoCard.Inspectable>. Infokarte verfügbar.</RimWorldAccess.InfoCard.Inspectable>
  <RimWorldAccess.InfoCard.ChooseItemToInspect>Wähle ein Objekt aus, um es zu untersuchen</RimWorldAccess.InfoCard.ChooseItemToInspect>

  <!-- Tree expansion state (src/UI/TreeNavigationHelper.cs).
       StateExpanded/StateCollapsed are the bare words, composed into the
       suffix keys. SuffixWithCountOne/Many are used when a child count is
       included; {0} = state word, {1} = child count.
       ExpandedCountOne/Many are spoken after ExpandAllSiblings collapses or
       expands several siblings in one action. -->
  <RimWorldAccess.Tree.StateExpanded>ausgeklappt</RimWorldAccess.Tree.StateExpanded>
  <RimWorldAccess.Tree.StateCollapsed>eingeklappt</RimWorldAccess.Tree.StateCollapsed>
  <RimWorldAccess.Tree.ExpansionSuffix>, {0}</RimWorldAccess.Tree.ExpansionSuffix>
  <RimWorldAccess.Tree.ExpansionSuffixWithCountOne>, {0}, {1} Objekt</RimWorldAccess.Tree.ExpansionSuffixWithCountOne>
  <RimWorldAccess.Tree.ExpansionSuffixWithCountMany>, {0}, {1} Objekte</RimWorldAccess.Tree.ExpansionSuffixWithCountMany>
  <RimWorldAccess.Tree.ExpansionSpaceSuffix> {0}</RimWorldAccess.Tree.ExpansionSpaceSuffix>
  <RimWorldAccess.Tree.ExpandedCountOne>{0} Objekt ausgeklappt</RimWorldAccess.Tree.ExpandedCountOne>
  <RimWorldAccess.Tree.ExpandedCountMany>{0} Objekte ausgeklappt</RimWorldAccess.Tree.ExpandedCountMany>
  <!-- No-op feedback for ExpandAllSiblings: everything at this level was
       already open, or nothing here can expand. -->
  <RimWorldAccess.Tree.AllAlreadyExpanded>Alle Objekte sind bereits ausgeklappt</RimWorldAccess.Tree.AllAlreadyExpanded>
  <RimWorldAccess.Tree.NoneToExpand>Hier lässt sich nichts ausklappen</RimWorldAccess.Tree.NoneToExpand>

  <!-- Two-level menu (src/UI/TwoLevelMenuHelper.cs). Used by the mod-list detail view,
       notifications, and the History Graph sub-tab. ButtonAnnouncement/Disabled and
       ButtonDisabled/Reason retired (Task 8 packet H): button focus now speaks through
       the composer's own Button role + Disabled state, and the disabled-activation
       refusal reuses the shared RimWorldAccess.Shell.GenericWindow.Disabled key. -->
  <RimWorldAccess.TwoLevel.BackToList>Zurück zur Liste</RimWorldAccess.TwoLevel.BackToList>
  <RimWorldAccess.TwoLevel.BackToListWithSuffix>Zurück zur Liste. {0}</RimWorldAccess.TwoLevel.BackToListWithSuffix>

  <!-- Menu formatting (src/UI/MenuHelper.cs).
       Position: {0} = 1-based index, {1} = total.
       LevelSuffix: {0} = indent level (1-based), appended to item announcements.
       CannotPaintColumn: tabular menus when a column cannot be paint-copied. -->
  <RimWorldAccess.Menu.Position>{0} von {1}</RimWorldAccess.Menu.Position>
  <RimWorldAccess.Menu.TabPosition>Tab {0} von {1}</RimWorldAccess.Menu.TabPosition>
  <RimWorldAccess.Menu.LevelSuffix> Ebene {0}</RimWorldAccess.Menu.LevelSuffix>
  <RimWorldAccess.Menu.CannotPaintColumn>Auf diese Spalte kannst du nichts anwenden</RimWorldAccess.Menu.CannotPaintColumn>

  <!-- Edge announcements (src/UI/MenuHelper.cs, MenuHelper.EdgeDirection).
       Spoken when navigation has reached a boundary and cannot continue. -->
  <RimWorldAccess.Edge.Top>Bereits am Anfang</RimWorldAccess.Edge.Top>
  <RimWorldAccess.Edge.Bottom>Bereits am Ende</RimWorldAccess.Edge.Bottom>
  <RimWorldAccess.Edge.First>Bereits an erster Stelle</RimWorldAccess.Edge.First>
  <RimWorldAccess.Edge.Last>Bereits an letzter Stelle</RimWorldAccess.Edge.Last>
  <RimWorldAccess.Edge.Minimum>Bereits am Minimum</RimWorldAccess.Edge.Minimum>
  <RimWorldAccess.Edge.Maximum>Bereits am Maximum</RimWorldAccess.Edge.Maximum>
  <RimWorldAccess.Edge.TopLevel>Bereits auf der obersten Ebene</RimWorldAccess.Edge.TopLevel>
  <RimWorldAccess.Edge.Zero>Bereits bei null</RimWorldAccess.Edge.Zero>
  <RimWorldAccess.Edge.Generic>Bereits am Rand</RimWorldAccess.Edge.Generic>

  <!-- Map navigation (src/Map/MapNavigationState.cs).
       JumpedTo: {0} = the target label (scanner item, menu row, etc.).
       JumpedToTarget: fallback when no label is available.
       SelectedCell: {0} = cell x, {1} = cell z. -->
  <RimWorldAccess.Map.JumpedTo>Springe zu: {0}</RimWorldAccess.Map.JumpedTo>
  <RimWorldAccess.Map.JumpedToTarget>Zum Ziel springen</RimWorldAccess.Map.JumpedToTarget>
  <RimWorldAccess.Map.SelectedCell>Feld {0}, {1} ausgewählt</RimWorldAccess.Map.SelectedCell>

  <!-- Numeric stepper (src/UI/NumericStepperHelper.cs).
       Minimum/Maximum are boundary hits (value did not change).
       ValueAtMinimum/Maximum are transitions INTO the boundary; {0} = the
       formatted value label. -->
  <RimWorldAccess.Stepper.Minimum>Minimum</RimWorldAccess.Stepper.Minimum>
  <RimWorldAccess.Stepper.Maximum>Maximum</RimWorldAccess.Stepper.Maximum>
  <RimWorldAccess.Stepper.ValueAtMinimum>{0}. Minimum erreicht</RimWorldAccess.Stepper.ValueAtMinimum>
  <RimWorldAccess.Stepper.ValueAtMaximum>{0}. Maximum erreicht</RimWorldAccess.Stepper.ValueAtMaximum>

  <!-- Generic shared labels. NameColumn is the header for a pawn-name column in
       tabular menus (skills table, assign menu). Unknown is a defensive fallback
       for an out-of-range column. Material is the generic placeholder cost word
       for a stuff-based building before a specific stuff is chosen. SortAscending/
       Descending are spoken when a table column is sorted. RenameLabeled is a
       rename gizmo label with the target's name ({0}). -->
  <RimWorldAccess.Common.NameColumn>Name</RimWorldAccess.Common.NameColumn>
  <RimWorldAccess.Common.Unknown>Unbekannt</RimWorldAccess.Common.Unknown>
  <RimWorldAccess.Common.Material>Material</RimWorldAccess.Common.Material>
  <RimWorldAccess.Common.SortAscending>aufsteigend</RimWorldAccess.Common.SortAscending>
  <RimWorldAccess.Common.SortDescending>absteigend</RimWorldAccess.Common.SortDescending>
  <RimWorldAccess.Common.RenameLabeled>{0} umbenennen</RimWorldAccess.Common.RenameLabeled>

  <!-- Where a row dragged with the mouse would land. {0} = 1-based position,
       {1} = number of rows in the list being reordered. -->
  <RimWorldAccess.Common.Drag.ReorderPosition>Position {0} von {1}</RimWorldAccess.Common.Drag.ReorderPosition>
</LanguageData>
