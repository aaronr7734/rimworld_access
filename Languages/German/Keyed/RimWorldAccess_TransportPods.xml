  <!-- Entry announcement (Open). {0} = number of pods that can be grouped
       (source pod + reachable launchers via flood fill). -->
  <RimWorldAccess.TransportPods.Selection.EnterMode>Auswahlmodus für Transportkapseln. {0} Kapseln können gruppiert werden. Gehe mit den Pfeiltasten zu den Kapseln. Die Leertaste wählt eine Kapsel aus. Enter startet das Beladen.</RimWorldAccess.TransportPods.Selection.EnterMode>

  <!-- Cancellation (Close). -->
  <RimWorldAccess.TransportPods.Selection.Cancelled>Auswahl der Transportkapseln abgebrochen</RimWorldAccess.TransportPods.Selection.Cancelled>

  <!-- Per-toggle feedback (TogglePodAtCursor). {0} = current selected count. -->
  <RimWorldAccess.TransportPods.Selection.NoPodHere>Hier ist keine Transportkapsel</RimWorldAccess.TransportPods.Selection.NoPodHere>
  <RimWorldAccess.TransportPods.Selection.NotAdjacent>Die Startrampe dieser Kapsel grenzt nicht an die Gruppe an.</RimWorldAccess.TransportPods.Selection.NotAdjacent>
  <RimWorldAccess.TransportPods.Selection.AlreadyLoading>Kapsel wird bereits beladen oder ist startbereit</RimWorldAccess.TransportPods.Selection.AlreadyLoading>
  <RimWorldAccess.TransportPods.Selection.PodSelected>Kapsel ausgewählt. {0} ausgewählt.</RimWorldAccess.TransportPods.Selection.PodSelected>
  <RimWorldAccess.TransportPods.Selection.PodDeselected>Kapsel abgewählt. {0} ausgewählt.</RimWorldAccess.TransportPods.Selection.PodDeselected>

  <!-- Confirmation errors (ConfirmSelection). -->
  <RimWorldAccess.TransportPods.Selection.NoPodsSelected>Keine Kapseln ausgewählt. Gehe mit den Pfeiltasten zu einer Kapsel und drücke die Leertaste, um die Kapsel auszuwählen.</RimWorldAccess.TransportPods.Selection.NoPodsSelected>
  <RimWorldAccess.TransportPods.Selection.PodsUnavailable>Die ausgewählten Kapseln sind nicht mehr verfügbar</RimWorldAccess.TransportPods.Selection.PodsUnavailable>
  <RimWorldAccess.TransportPods.Selection.LoadCommandMissingMayBeLoading>Der Befehl zum Beladen wurde nicht gefunden. Die Kapsel wird vielleicht schon beladen.</RimWorldAccess.TransportPods.Selection.LoadCommandMissingMayBeLoading>

  <!-- =========================================================
       TransportPodLoadingState.cs - Dialog_LoadTransporters keyboard nav.
       ========================================================= -->

  <!-- Open guards. -->
  <RimWorldAccess.TransportPods.Loading.ReflectionFailed>Das Beladen von Transportkapseln ist nach einem Spiel-Update nicht mehr barrierefrei nutzbar. Suche nach Mod-Updates.</RimWorldAccess.TransportPods.Loading.ReflectionFailed>

  <!-- Entry announcement. One/Many split so translators control pod/pods
       agreement; the pod-noun key is inlined into the sentence so word order
       stays natural across languages.
       {0} = pod count, {1} = total mass capacity. -->
  <RimWorldAccess.TransportPods.Loading.OpenAnnouncementOne>Transportkapsel beladen. {0} Kapsel, maximale Nutzlast {1} kg. Pfeil nach links und Pfeil nach rechts wechseln den Tab. Enter ändert die Menge.</RimWorldAccess.TransportPods.Loading.OpenAnnouncementOne>
  <RimWorldAccess.TransportPods.Loading.OpenAnnouncementMany>Transportkapseln beladen. {0} Kapseln, maximale Nutzlast {1} kg. Pfeil nach links und Pfeil nach rechts wechseln den Tab. Enter ändert die Menge.</RimWorldAccess.TransportPods.Loading.OpenAnnouncementMany>

  <!-- Tab navigation. -->

  <!-- Shared empty-tab feedback (spoken in multiple navigation paths). -->

  <!-- Activation and quantity actions. {0} = item label. -->
  <RimWorldAccess.TransportPods.Loading.ItemChecked>{0} ausgewählt</RimWorldAccess.TransportPods.Loading.ItemChecked>
  <RimWorldAccess.TransportPods.Loading.ItemUnchecked>{0} abgewählt</RimWorldAccess.TransportPods.Loading.ItemUnchecked>
  <RimWorldAccess.TransportPods.Loading.ItemRemoved>{0} entfernt</RimWorldAccess.TransportPods.Loading.ItemRemoved>

  <!-- Inspect results. -->
  <RimWorldAccess.TransportPods.Loading.NoItemToInspect>Kein Objekt zum Untersuchen</RimWorldAccess.TransportPods.Loading.NoItemToInspect>

  <!-- Delete/remove guard. -->
  <RimWorldAccess.TransportPods.Loading.AlreadyAtZero>Bereits auf null</RimWorldAccess.TransportPods.Loading.AlreadyAtZero>

  <!-- Reset (Alt+R). -->
  <RimWorldAccess.TransportPods.Loading.ResetAll>Alle Einträge auf null zurückgesetzt</RimWorldAccess.TransportPods.Loading.ResetAll>

  <!-- Mass summary (Tab key / AnnounceMassSummary).
       Composed from MassLine + one of OverloadedStatus/RemainingStatus.
       {0} = current usage, {1} = capacity, {2} = status clause. -->

  <!-- Summary view (Tab toggle). Empty/error states come next. -->
  <RimWorldAccess.TransportPods.Loading.SummaryNoTransporters>Keine Transportkapseln</RimWorldAccess.TransportPods.Loading.SummaryNoTransporters>
  <RimWorldAccess.TransportPods.Loading.SummaryStatsUnavailable>Werte nicht verfügbar</RimWorldAccess.TransportPods.Loading.SummaryStatsUnavailable>

  <!-- Summary item format ({item}. {position}). {0} = stat line, {1} = position. -->

