  <RimWorldAccess.TransportPods.Loading.StatMassCapacity>Maximale Nutzlast</RimWorldAccess.TransportPods.Loading.StatMassCapacity>
  <RimWorldAccess.TransportPods.Loading.StatSpeed>Geschwindigkeit</RimWorldAccess.TransportPods.Loading.StatSpeed>
  <RimWorldAccess.TransportPods.Loading.StatForaging>Gesammelte Nahrung pro Tag</RimWorldAccess.TransportPods.Loading.StatForaging>
  <RimWorldAccess.TransportPods.Loading.StatVisibility>Sichtbarkeit</RimWorldAccess.TransportPods.Loading.StatVisibility>

