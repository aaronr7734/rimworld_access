  <RimWorldAccess.TransportPods.Portal.Cancelled>{0}. Abgebrochen.</RimWorldAccess.TransportPods.Portal.Cancelled>
  <RimWorldAccess.TransportPods.Portal.FallbackEnter>Portal beladen</RimWorldAccess.TransportPods.Portal.FallbackEnter>
  <RimWorldAccess.TransportPods.Portal.FallbackLoading>Portal beladen</RimWorldAccess.TransportPods.Portal.FallbackLoading>
  <!-- Localization guardrail (D.8) sweep — previously hardcoded English. -->

  <!-- Region name for the stats section (screen-model refactor: the old
       Tab-key Summary view is now a region cycled with Tab/Shift+Tab). -->
  <RimWorldAccess.TransportPods.Loading.SummaryTab>Übersicht</RimWorldAccess.TransportPods.Loading.SummaryTab>
</LanguageData>
