<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    TransportPods module strings (src/TransportPods/). Five files contribute:
      - TransportPodHelper.cs            (pod announcement and fuel-cost formatting)
      - TransportPodPatch.cs             (custom gizmos, dialog lifecycle, keyboard-mode overlay)
      - TransportPodSelectionState.cs    (pod grouping selection mode on the map)
      - TransportPodLoadingState.cs      (Dialog_LoadTransporters keyboard navigation)
      - TransportPodLaunchState.cs       (world-map launch targeting with fuel budgeting)

    Covers both transport pods (base game) and shuttles (Royalty DLC), which
    reuse the same Dialog_LoadTransporters and CompLaunchable infrastructure.

    Strings produced by shared helpers live in the owning module:
      - GuardHelper / Edge announcements     -> RimWorldAccess_Common.xml
      - Typeahead "Search cleared"           -> RimWorldAccess_Common.xml
      - Map cursor "Invalid position"        -> RimWorldAccess_Input.xml
      - CaravanQuantityHelper "Taking X of Y, N kg, capacity limit" etc.
      - CaravanAnnouncementHelper item/search announcements
      - CaravanStatFormatter Mass/Speed/Food/Foraging/Visibility
      - CaravanInputHelper pawn-info shortcut announcements (Alt+H/M/N)
      - CaravanUIHelper helpers
      - PawnLabelHelper grouped pawn labels
    These will be localized by the World/UI modules; TransportPods delegates.

    One/Many splits exist where a bare count + noun is spoken in English, so
    translators can pick different plural classes (pod/pods). Mass and fuel
    announcements use whole-phrase keys per semantic case to keep word order
    localizable.
  -->

  <!-- =========================================================
       TransportPodHelper.cs - pod and fuel-cost announcement parts.
       ========================================================= -->

  <!-- Pod type labels. IsShuttle() picks between them for BuildPodAnnouncement
       and GetPodTypeLabel. Shuttles are Royalty DLC; transport pods are base. -->
  <RimWorldAccess.TransportPods.Pod.TypeTransportPod>Transportkapsel</RimWorldAccess.TransportPods.Pod.TypeTransportPod>
  <RimWorldAccess.TransportPods.Pod.TypeShuttle>Raumfähre</RimWorldAccess.TransportPods.Pod.TypeShuttle>

  <!-- Per-pod announcement fragments (BuildPodAnnouncement). Joined with ", ".
       {0} = formatted fuel/capacity value, {1} = 1-based index, {2} = total. -->
  <RimWorldAccess.TransportPods.Pod.Selected>AUSGEWÄHLT</RimWorldAccess.TransportPods.Pod.Selected>
  <RimWorldAccess.TransportPods.Pod.FuelLevel>Treibstoff {0}</RimWorldAccess.TransportPods.Pod.FuelLevel>
  <RimWorldAccess.TransportPods.Pod.NotConnectedToFuel>nicht an einer Startrampe angeschlossen</RimWorldAccess.TransportPods.Pod.NotConnectedToFuel>
  <RimWorldAccess.TransportPods.Pod.Capacity>maximale Nutzlast {0} kg</RimWorldAccess.TransportPods.Pod.Capacity>
  <RimWorldAccess.TransportPods.Pod.PositionInList>{0} von {1}</RimWorldAccess.TransportPods.Pod.PositionInList>

  <!-- Fuel cost announcement (BuildFuelCostAnnouncement). Shared with
       TransportPodLaunchState.GetFuelCostAnnouncementForTile. {0} = fuel cost,
       {1} = fuel available. "NoLauncher" and "Unavailable" are defensive
       fallbacks when the launchable or its props are missing. -->
  <RimWorldAccess.TransportPods.Fuel.NoLauncher>keine Startrampe</RimWorldAccess.TransportPods.Fuel.NoLauncher>
  <RimWorldAccess.TransportPods.Fuel.CostUnavailable>Treibstoffkosten nicht verfügbar</RimWorldAccess.TransportPods.Fuel.CostUnavailable>
  <RimWorldAccess.TransportPods.Fuel.NotEnough>NICHT GENUG TREIBSTOFF. Du brauchst {0} und hast nur {1}.</RimWorldAccess.TransportPods.Fuel.NotEnough>
  <RimWorldAccess.TransportPods.Fuel.CostChemfuel>{0} Sprit</RimWorldAccess.TransportPods.Fuel.CostChemfuel>
  <RimWorldAccess.TransportPods.Fuel.OutOfRange>AUSSER REICHWEITE</RimWorldAccess.TransportPods.Fuel.OutOfRange>

  <!-- =========================================================
       TransportPodPatch.cs - custom grouping gizmos and overlays.
       ========================================================= -->

  <!-- "Group all available pods" gizmo (CompTransporter_GetGizmos_Patch).
       Label: {0} = total pod count (source + all groupable).
       Desc: {0} = same count. Spoken when a sighted player reads the gizmo.
       NoGroupable: disable reason when no adjacent launchers are found;
       reused by the "Select pods to group" gizmo. -->
  <RimWorldAccess.TransportPods.Gizmo.GroupAllLabel>Alle verfügbaren Transportkapseln gruppieren ({0})</RimWorldAccess.TransportPods.Gizmo.GroupAllLabel>
  <RimWorldAccess.TransportPods.Gizmo.GroupAllDesc>Wähle alle {0} verfügbaren Transportkapseln aus und öffne das Beladefenster.</RimWorldAccess.TransportPods.Gizmo.GroupAllDesc>
  <RimWorldAccess.TransportPods.Gizmo.SelectPodsLabel>Transportkapseln zum Gruppieren wählen</RimWorldAccess.TransportPods.Gizmo.SelectPodsLabel>
  <RimWorldAccess.TransportPods.Gizmo.SelectPodsDesc>Starte den Auswahlmodus. Wähle dort die Transportkapseln aus, die gemeinsam beladen werden sollen.</RimWorldAccess.TransportPods.Gizmo.SelectPodsDesc>
  <RimWorldAccess.TransportPods.Gizmo.NoGroupable>Keine weiteren Transportkapseln mit angeschlossener Startrampe vorhanden.</RimWorldAccess.TransportPods.Gizmo.NoGroupable>

  <!-- Gizmo action results. {0} = pod count being grouped. -->
  <RimWorldAccess.TransportPods.Gizmo.LoadCommandMissing>Der Befehl zum Beladen wurde nicht gefunden</RimWorldAccess.TransportPods.Gizmo.LoadCommandMissing>
  <RimWorldAccess.TransportPods.Gizmo.GroupingForLoading>{0} Kapseln zum Beladen gruppiert</RimWorldAccess.TransportPods.Gizmo.GroupingForLoading>

  <!-- Dialog lifecycle (Window_PostClose_LoadTransporters_Patch). Spoken when
       the user closes the loading dialog without pressing Accept. -->
  <RimWorldAccess.TransportPods.Loading.Cancelled>Beladen der Transportkapseln abgebrochen</RimWorldAccess.TransportPods.Loading.Cancelled>

  <!-- Visual keyboard-mode overlay (Dialog_LoadTransporters_DoWindowContents_Patch).
       Sighted-user indicator drawn in the top-left of the loading dialog so
       testers can tell keyboard mode is active. Localized for consistency. -->
  <RimWorldAccess.TransportPods.Overlay.KeyboardModeActive>Tastaturmodus aktiv</RimWorldAccess.TransportPods.Overlay.KeyboardModeActive>
  <RimWorldAccess.TransportPods.Overlay.InstructionsLine1>Pfeil nach links/rechts: Tabs | Pfeil nach oben/unten: Einträge | Enter/Leertaste: Menge</RimWorldAccess.TransportPods.Overlay.InstructionsLine1>
  <RimWorldAccess.TransportPods.Overlay.InstructionsLine2>Tab: Nutzlast-Übersicht | Alt+I: Untersuchen | Alt+A: Akzeptieren | Esc: Abbrechen</RimWorldAccess.TransportPods.Overlay.InstructionsLine2>

  <!-- Landing-spot targeting announcement (Targeter_BeginTargeting_Announce_Patch).
       Spoken once when the drop-pod landing targeter activates. -->
  <RimWorldAccess.TransportPods.Landing.SelectLandingSpot>Wähle einen Landeplatz aus. Die Pfeiltasten bewegen den Cursor. Die Leertaste bestätigt den Landeplatz.</RimWorldAccess.TransportPods.Landing.SelectLandingSpot>

  <!-- =========================================================
       TransportPodSelectionState.cs - pod grouping selection mode.
       ========================================================= -->

