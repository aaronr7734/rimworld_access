<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Narrative Feed (speech mods campaign, src/Narrative/NarrativeFeed.Game.cs).
    Grammar keys compose one spoken line of ambient dialogue/narration; the
    caller picks the variant based on which of speaker/recipient resolved.
    {0}/{1}/{2} are already-resolved passthrough strings (pawn LabelShort,
    line text) via .Translate(args), not authored prose fragments.
  -->
  <RimWorldAccess.Narrative.LineTo>{0} zu {1}: {2}</RimWorldAccess.Narrative.LineTo>
  <RimWorldAccess.Narrative.Line>{0}: {1}</RimWorldAccess.Narrative.Line>
  <RimWorldAccess.Narrative.System>{0}</RimWorldAccess.Narrative.System>

  <!--
    The stable-read rule's shared marker (speech mods campaign S15, src/Narrative/AsyncTextStability.Game.cs).
    Spoken INSTEAD OF any in-flight streamed/generated text while an extension mod's async
    rewrite is still running, never a fragment of the real text. See Literature's book/art
    inspection-tree children (S15) and S16 Quests for riders.
  -->
  <RimWorldAccess.Narrative.StillBeingWritten>Wird noch geschrieben.</RimWorldAccess.Narrative.StillBeingWritten>

  <!-- Settings (Main Menu > Options > RimWorld Access), src/Shell/Screens/OptionsRwaCategory.Game.cs. -->
  <RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Label>Generierte Gespräche ansagen</RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Label>
  <RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Desc>Liest Gesprächszeilen vor, die von Story-Mods wie RimTalk stammen.</RimWorldAccess.Narrative.Settings.AnnouncePawnDialogue.Desc>
  <RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Label>Sprechblasen zu Interaktionen des Spiels ansagen</RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Label>
  <RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Desc>Liest die Plaudereien vor, die das Spiel selbst erzeugt. Benötigt die Mod Interaction Bubbles von Jaxe.</RimWorldAccess.Narrative.Settings.AnnounceVanillaInteractionBubbles.Desc>
  <RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Label>Gespräche auch ansagen, wenn RimTalk TTS sie vorliest</RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Label>
  <RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Desc>Wenn deaktiviert, schweigt der Screenreader, solange RimTalk TTS eine Zeile vorliest. Der Gesprächsverlauf zeichnet die Zeile trotzdem auf.</RimWorldAccess.Narrative.Settings.TtsAnnounceAnyway.Desc>

