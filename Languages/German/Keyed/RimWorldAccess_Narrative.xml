  <RimWorldAccess.Narrative.DialogueLog.LineWithTimeAgo>Vor {replace: {0}; "Tage"-"Tagen"; "Jahre"-"Jahren"; "Quartale"-"Quartalen"}. {1}</RimWorldAccess.Narrative.DialogueLog.LineWithTimeAgo>
