    grammar), not authored prose fragments.
  -->
  <RimWorldAccess.Narrative.DialogueLog.Title>Gesprächsverlauf</RimWorldAccess.Narrative.DialogueLog.Title>
  <RimWorldAccess.Narrative.DialogueLog.Opened>Gesprächsverlauf geöffnet. {0} Einträge.</RimWorldAccess.Narrative.DialogueLog.Opened>
