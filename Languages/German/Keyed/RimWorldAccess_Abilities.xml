  <RimWorldAccess.Abilities.Start.Header>{0}: Zielauswahl</RimWorldAccess.Abilities.Start.Header>
  <RimWorldAccess.Abilities.Start.TouchRange>. Berührungsreichweite</RimWorldAccess.Abilities.Start.TouchRange>
  <RimWorldAccess.Abilities.Start.Range>. Reichweite: {0} Felder</RimWorldAccess.Abilities.Start.Range>
  <RimWorldAccess.Abilities.Start.AOE>, Wirkungsradius: {0} Felder</RimWorldAccess.Abilities.Start.AOE>
  <RimWorldAccess.Abilities.Start.Psyfocus>. Psyfokus: {0}</RimWorldAccess.Abilities.Start.Psyfocus>
  <RimWorldAccess.Abilities.Start.NeuralHeat>, Neuralhitze: {0}</RimWorldAccess.Abilities.Start.NeuralHeat>
