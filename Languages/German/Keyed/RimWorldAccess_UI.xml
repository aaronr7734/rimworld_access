  <RimWorldAccess.UI.Save.InvalidSelection>Ungültige Auswahl</RimWorldAccess.UI.Save.InvalidSelection>
  <RimWorldAccess.UI.Save.NeedName>Gib dem Speicherstand einen Namen</RimWorldAccess.UI.Save.NeedName>
  <RimWorldAccess.UI.Save.CannotDeleteCreateNew>Die Zeile für den Speichernamen lässt sich nicht löschen</RimWorldAccess.UI.Save.CannotDeleteCreateNew>
  <!-- {0} = file name (stripped of extension). -->
  <!-- Row LABELS only. The mode verb stays in the label because it is the only
       thing distinguishing a save row (Enter overwrites) from a load row (Enter
       loads) once inside the list; the composer supplies position, the date-time
       rides Extras. Overwrite/Load: {0} = file name, stripped of its extension. -->

  <RimWorldAccess.UI.Save.OverwriteLabel>Überschreiben: {0}</RimWorldAccess.UI.Save.OverwriteLabel>
  <RimWorldAccess.UI.Save.LoadLabel>Laden: {0}</RimWorldAccess.UI.Save.LoadLabel>

  <!-- =================================================================
       Float menu (WindowlessFloatMenuState). The selection announcement
       differentiates between a queued action (Shift held while clicking
       a colonist order) and a normal one. {0} = option label.
       A focused row (label, disabled state, tooltip, position) renders
       through AnnouncementComposer.ComposeFocus instead of a hand-built key,
       and the typeahead search announcements now come from the shared
       ScreenScope search grammar, so the two keys those hand-built shapes
       needed are gone. What remains is the queued/normal selection wording
       and the rejection message.
       ================================================================= -->
  <RimWorldAccess.UI.FloatMenu.SelectedQueued>{1}: {0}</RimWorldAccess.UI.FloatMenu.SelectedQueued>
  <RimWorldAccess.UI.FloatMenu.Selected>Ausgewählt: {0}</RimWorldAccess.UI.FloatMenu.Selected>
  <!-- Spoken when activating a disabled float-menu option. {0} = option label. -->
  <RimWorldAccess.UI.FloatMenu.LabelUnavailable>{0}: nicht verfügbar</RimWorldAccess.UI.FloatMenu.LabelUnavailable>

  <!-- =================================================================
       Quantity menu (QuantityMenuState).
       Opened: {0} = item label.
