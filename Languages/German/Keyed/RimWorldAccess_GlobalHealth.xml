  <RimWorldAccess.GlobalHealth.PawnRow>{0}. {1}</RimWorldAccess.GlobalHealth.PawnRow>
  <!-- A pawn under Sick. {0} = the pawn's name with its group, {1} = its diseases, one sentence each: the health tab header ("Flu (major): 52%"), DiseaseThreat around a life-threatening one, then vanilla's immunity line when shown. -->
  <RimWorldAccess.GlobalHealth.SickPawnRow>{0}. {1}</RimWorldAccess.GlobalHealth.SickPawnRow>
  <RimWorldAccess.GlobalHealth.DiseaseThreat>{0}, medizinischer Notfall</RimWorldAccess.GlobalHealth.DiseaseThreat>
