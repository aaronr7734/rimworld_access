  <RimWorldAccess.GlobalHealth.Summary.None>{0}. Keine</RimWorldAccess.GlobalHealth.Summary.None>
  <RimWorldAccess.GlobalHealth.Summary.BleedOut>{0}. {1} Spielfiguren, frühestes Verbluten in {2}</RimWorldAccess.GlobalHealth.Summary.BleedOut>
