<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Shell element vocabulary (src/Shell/Elements/, blueprint section 4.5).
    The standard control words spoken for every focusable item mod-wide:
    "checkbox, checked" instead of a per-screen sentence. Spoken by
    TranslatedShellVocabulary through AnnouncementComposer; the words follow
    established screen reader terminology so users recognize them from every
    other application. Roles with no key here (menu item, tree item, table
    cell) are deliberately silent. Position and level phrases reuse
    RimWorldAccess.Menu.Position / RimWorldAccess.Menu.LevelSuffix.
  -->

  <!-- Role words -->
  <RimWorldAccess.Shell.Role.Button>Schaltfläche</RimWorldAccess.Shell.Role.Button>
  <RimWorldAccess.Shell.Role.Checkbox>Kontrollfeld</RimWorldAccess.Shell.Role.Checkbox>
  <RimWorldAccess.Shell.Role.RadioButton>Auswahlschalter</RimWorldAccess.Shell.Role.RadioButton>
  <RimWorldAccess.Shell.Role.ComboBox>Kombinationsfeld</RimWorldAccess.Shell.Role.ComboBox>
  <RimWorldAccess.Shell.Role.Slider>Schieber</RimWorldAccess.Shell.Role.Slider>
  <RimWorldAccess.Shell.Role.Stepper>Wertregler</RimWorldAccess.Shell.Role.Stepper>
  <RimWorldAccess.Shell.Role.TextField>Eingabefeld</RimWorldAccess.Shell.Role.TextField>
  <RimWorldAccess.Shell.Role.Tab>Tab</RimWorldAccess.Shell.Role.Tab>
  <RimWorldAccess.Shell.Role.Map>Karte</RimWorldAccess.Shell.Role.Map>

  <!-- State words -->
  <RimWorldAccess.Shell.State.Checked>aktiviert</RimWorldAccess.Shell.State.Checked>
  <RimWorldAccess.Shell.State.Unchecked>nicht aktiviert</RimWorldAccess.Shell.State.Unchecked>
  <RimWorldAccess.Shell.State.PartiallyChecked>teilweise aktiviert</RimWorldAccess.Shell.State.PartiallyChecked>
  <RimWorldAccess.Shell.State.Selected>ausgewählt</RimWorldAccess.Shell.State.Selected>
  <RimWorldAccess.Shell.State.NotSelected>nicht ausgewählt</RimWorldAccess.Shell.State.NotSelected>
  <RimWorldAccess.Shell.State.Expanded>ausgeklappt</RimWorldAccess.Shell.State.Expanded>
  <RimWorldAccess.Shell.State.Collapsed>eingeklappt</RimWorldAccess.Shell.State.Collapsed>
  <RimWorldAccess.Shell.State.Blank>leer</RimWorldAccess.Shell.State.Blank>
  <RimWorldAccess.Shell.State.Disabled>nicht verfügbar</RimWorldAccess.Shell.State.Disabled>
  <RimWorldAccess.Shell.State.ReadOnly>schreibgeschützt</RimWorldAccess.Shell.State.ReadOnly>
  <RimWorldAccess.Shell.State.AtMinimum>am Minimum</RimWorldAccess.Shell.State.AtMinimum>
  <RimWorldAccess.Shell.State.AtMaximum>am Maximum</RimWorldAccess.Shell.State.AtMaximum>
  <RimWorldAccess.Shell.State.ColumnHeader>Spaltenbeschriftung</RimWorldAccess.Shell.State.ColumnHeader>
  <RimWorldAccess.Shell.State.Sortable>sortierbar</RimWorldAccess.Shell.State.Sortable>
  <RimWorldAccess.Shell.State.SortedAscending>aufsteigend sortiert</RimWorldAccess.Shell.State.SortedAscending>
  <RimWorldAccess.Shell.State.SortedDescending>absteigend sortiert</RimWorldAccess.Shell.State.SortedDescending>

  <!-- ScreenScope shared screen shape (screen-model refactor): the
       automatic Toolbar region name and the empty-region word. -->
  <RimWorldAccess.Shell.Screen.ActionsRegion>Schaltflächenleiste</RimWorldAccess.Shell.Screen.ActionsRegion>
  <RimWorldAccess.Shell.Screen.ExtrasRegion>Weitere Steuerelemente</RimWorldAccess.Shell.Screen.ExtrasRegion>
  <RimWorldAccess.Shell.Screen.EmptyRegion>leer</RimWorldAccess.Shell.Screen.EmptyRegion>

  <!-- Fail-safe (B1, semantic quality campaign): spoken once when a scope's own model build
       throws, so the player is told the window went unreadable instead of finding every key
       (including Escape) silently swallowed. See ScreenScope.RefreshModel. -->
  <RimWorldAccess.Shell.ScopeFailed>Fehler in der Screenreader-Unterstützung für dieses Fenster. Drücke Escape, um das Fenster zu schließen.</RimWorldAccess.Shell.ScopeFailed>

  <!-- Band label inheritance (C1, semantic quality campaign): an unlabeled twin control that
       inherited a neighbouring control's caption (BandLabelInheritance/GenericWindowScope).
       {0} is the inherited label, {1} the 1-based ordinal ("Ideology 2"). -->
  <RimWorldAccess.Shell.BandOrdinalLabel>{0} {1}</RimWorldAccess.Shell.BandOrdinalLabel>

  <!-- Silent content swap echo (S8, meaning campaign): a captured Button whose click replaced
       the window's whole page with no dialog, no menu, and no state change on the acted row
       itself (Colony Manager Redux's "New job" button, which swaps the page to a fresh draft
       job's settings) — the honest, generic summary a keyboard user gets instead of dead
       silence. {0} is the new presentation row count. See GenericWindowScope.ResolvePendingStateChange. -->
  <RimWorldAccess.Shell.ContentChanged>Fensterinhalt geändert. {replace: ^{0} Einträge; "^1 Einträge"-"1 Eintrag"; "^"-""}.</RimWorldAccess.Shell.ContentChanged>
  <RimWorldAccess.Shell.ContentReordered>Einträge neu angeordnet.</RimWorldAccess.Shell.ContentReordered>

  <!-- Enter double-press proceed (DefaultAcceptActionId, S4c): the first Enter on an
       inert element arms this prompt instead of doing nothing; a second Enter on the
       same element fires the screen's default/proceed button. {0} is that button's label. -->
  <RimWorldAccess.Shell.Screen.PressEnterAgain>Drücke Enter erneut, um die Schaltfläche {0} auszulösen.</RimWorldAccess.Shell.Screen.PressEnterAgain>

  <!-- Shift+Enter one-chord proceed (SharedMenuGrammar.ActivateDefault, QA session 5):
       presses the screen's default/proceed button from anywhere, bypassing the focused
       control. PressingDefault is spoken BEFORE the button fires because the player
       chose not to look the button up first; {0} is that button's label. -->
  <RimWorldAccess.Shell.Screen.PressingDefault>{0} wird gedrückt.</RimWorldAccess.Shell.Screen.PressingDefault>
  <RimWorldAccess.Shell.Screen.NoDefaultButton>Dieser Bildschirm hat keine Standardschaltfläche.</RimWorldAccess.Shell.Screen.NoDefaultButton>

  <!-- Shared reorder grammar (SharedMenuGrammar.ReorderUp/Down/Left/Right,
       ScreenScope's Ctrl+Up/Down seam): the mod-wide keyboard equivalent of
       the player's drag-and-drop gesture. MovedBetween/MovedToTop/MovedToBottom
       name the item's new neighbors ({0}/{1} are neighbor labels, above then
       below); Moved is the fallback when a neighbor's label cannot be resolved.
       Whichever phrase is chosen prefixes the standard full item announcement
       ("Moved between Duster and Parka. Duster, 3 of 7."); CannotReorder is the
       refusal when the subclass's mutation vehicle vetoes the move. -->
  <RimWorldAccess.Shell.Screen.Moved>Verschoben.</RimWorldAccess.Shell.Screen.Moved>
  <RimWorldAccess.Shell.Screen.MovedBetween>Verschoben, jetzt zwischen {0} und {1}.</RimWorldAccess.Shell.Screen.MovedBetween>
  <RimWorldAccess.Shell.Screen.MovedToTop>Ganz nach oben verschoben, jetzt über {0}.</RimWorldAccess.Shell.Screen.MovedToTop>
  <RimWorldAccess.Shell.Screen.MovedToBottom>Ganz nach unten verschoben, jetzt unter {0}.</RimWorldAccess.Shell.Screen.MovedToBottom>
  <RimWorldAccess.Shell.Screen.CannotReorder>Dieser Eintrag lässt sich nicht verschieben.</RimWorldAccess.Shell.Screen.CannotReorder>

  <!-- Table regions (docs/table-model.md): the shared table grammar spoken
       by AnnouncementComposer.ComposeCell for every table in the mod.
       {0}/{1} in the position phrases are 1-based (the header row is row 1). -->
  <RimWorldAccess.Shell.Screen.TabCount>{0} Abschnitte</RimWorldAccess.Shell.Screen.TabCount>
  <RimWorldAccess.Shell.Screen.SectionPosition>Abschnitt {0} von {1}</RimWorldAccess.Shell.Screen.SectionPosition>
  <RimWorldAccess.Shell.Table.RowPosition>Zeile {0} von {1}</RimWorldAccess.Shell.Table.RowPosition>
  <RimWorldAccess.Shell.Table.ColumnPosition>Spalte {0} von {1}</RimWorldAccess.Shell.Table.ColumnPosition>
  <RimWorldAccess.Shell.Table.Dimensions>Tabelle mit {0} Spalten und {1} Zeilen</RimWorldAccess.Shell.Table.Dimensions>
  <RimWorldAccess.Shell.Table.SortedBy>Sortiert nach {0}, {1}</RimWorldAccess.Shell.Table.SortedBy>
  <RimWorldAccess.Shell.Table.SortCleared>Sortierung aufgehoben. Standardreihenfolge</RimWorldAccess.Shell.Table.SortCleared>
  <RimWorldAccess.Shell.Table.NotSortable>Diese Spalte lässt sich nicht sortieren</RimWorldAccess.Shell.Table.NotSortable>
  <RimWorldAccess.Shell.Table.SortHint>Enter sortiert nach dieser Spalte</RimWorldAccess.Shell.Table.SortHint>

  <!-- Cross-region typeahead (docs/table-model.md section 7): the locating
       frame spoken after a search jump lands in another region, and the
       fallback name for unnamed regions on generic screens ({0} is the
       1-based tab number). -->
  <RimWorldAccess.Shell.Search.NowAt>Jetzt im Abschnitt {0}</RimWorldAccess.Shell.Search.NowAt>
  <RimWorldAccess.Shell.Search.UnnamedTab>Tab {0}</RimWorldAccess.Shell.Search.UnnamedTab>

  <!-- Transfer-screen table columns (table-model T3, TransferableTableColumns).
       Vanilla shows these columns as icons with hover tooltips and has no short
       text labels for them, so the mod provides its own. DaysValue's {0} is a
       decimal day count (e.g. "3.5"); CanGraze replaces vanilla's grazing icon
       in the foraged-food column for animals that graze. -->
  <RimWorldAccess.Shell.Table.Transferable.DaysUntilRot>Tage bis zum Verrotten</RimWorldAccess.Shell.Table.Transferable.DaysUntilRot>
  <RimWorldAccess.Shell.Table.Transferable.DaysValue>{0} Tage</RimWorldAccess.Shell.Table.Transferable.DaysValue>
  <RimWorldAccess.Shell.Table.Transferable.CanGraze>Kann grasen</RimWorldAccess.Shell.Table.Transferable.CanGraze>

  <!-- Generic pawn-table tier (table-model T5, GenericPawnTableScope).
       CellNotReadable is the honest fallback for an unknown mod column's
       cell; Incapable mirrors the work tab's disabled-work meaning; Trained
       marks a completed animal training. HourRange/HourSingle format a
       timetable cell's contiguous segments: hour params are 0-23, the last
       param is the assignment label. PawnTableRegion names a pawn table
       whose main button carries no label. -->
  <RimWorldAccess.Shell.Generic.CellNotReadable>Wert nicht lesbar</RimWorldAccess.Shell.Generic.CellNotReadable>
  <RimWorldAccess.Shell.Generic.Incapable>unfähig</RimWorldAccess.Shell.Generic.Incapable>
  <RimWorldAccess.Shell.Generic.Trained>trainiert</RimWorldAccess.Shell.Generic.Trained>
  <RimWorldAccess.Shell.Generic.HourRange>Stunden {0} bis {1}: {2}</RimWorldAccess.Shell.Generic.HourRange>
  <RimWorldAccess.Shell.Generic.HourSingle>Stunde {0}: {1}</RimWorldAccess.Shell.Generic.HourSingle>
  <RimWorldAccess.Shell.Generic.PawnTableRegion>Spielfiguren</RimWorldAccess.Shell.Generic.PawnTableRegion>
  <!-- Dev-mode debug-action context menus embedded in the research menu and
       entity codex (RightBracket). Only meaningful with dev mode enabled. -->
  <!-- Dev-mode context menus embedded in the styling station, ideos tab, and
       factions tab (RightBracket). Only meaningful with dev mode enabled. On the
       styling station RightBracket is also "reset all", so its menu leads with
       Reset. -->
  <!-- Save/load file lists (RightBracket): the interact and delete actions the
       sighted player reads on the focused row's own two buttons. -->

  <!-- Shared tree chords (ShellActionInventory.Part7, the "tree"/"filterTree"
       pseudo-screens). These label the rebinding list entries for every migrated
       tree screen. -->

  <!-- Shared big-text reader (TextBufferScope): section jumps inside one block of text. -->

  <!--
    Spoken key names (KeyChordFormat, installed by ShellBootstrap). These are
    words a screen reader reads aloud inside a sentence ("press Alt plus Page
    Down"), not text drawn on screen, so they belong to the mod's spoken
    vocabulary and get translated like every other spoken word. The key suffix
    is the Unity KeyCode enum name so a binding traces to its key mechanically.
    Keys with no entry here keep the humanized enum name, which is already
    correct for letters, digits and the function row: those are never worded.
    Ctrl and Option are the two modifier words the platform chooses between
    (macOS substitutes Option for Ctrl); NumpadDigit formats the ten numeric
    keypad keys, where {0} is the digit 0 to 9.
  -->
  <RimWorldAccess.Shell.Key.Ctrl>Strg</RimWorldAccess.Shell.Key.Ctrl>
  <RimWorldAccess.Shell.Key.Option>Wahltaste</RimWorldAccess.Shell.Key.Option>
  <RimWorldAccess.Shell.Key.Command>Befehlstaste</RimWorldAccess.Shell.Key.Command>
  <RimWorldAccess.Shell.Key.Shift>Umschalt</RimWorldAccess.Shell.Key.Shift>
  <RimWorldAccess.Shell.Key.Alt>Alt</RimWorldAccess.Shell.Key.Alt>

