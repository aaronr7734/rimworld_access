  <!-- Opens the Configure Spoken Announcements screen (a real window, not this panel);
       see RimWorldAccess_AnnounceConfig.xml for that screen's own strings. -->
  <RimWorldAccess.Core.Settings.ConfigureAnnouncements.Button>Seslendirilen bildirimleri yapılandır...</RimWorldAccess.Core.Settings.ConfigureAnnouncements.Button>

  <!-- SubmenuTreeNavigation is the only checkbox with a tooltip. The label is
       deliberately whimsical ("Rashad Hates Treeviews") — translators can
       preserve the joke or replace it with something equivalent in their
       culture as long as it still telegraphs what the setting does. The
       tooltip is the canonical explanation. -->
  <RimWorldAccess.Core.Settings.SubmenuTreeNavigation.Label>Rashad ağaç görünümlerinden nefret eder (alt menü tarzı gezinme)</RimWorldAccess.Core.Settings.SubmenuTreeNavigation.Label>
  <RimWorldAccess.Core.Settings.SubmenuTreeNavigation.Tooltip>Ağaç görünümlerinin çalışma şeklini değiştirir. Bir kategoriyi genişlettiğinde o kategori kaybolur ve yalnızca öğeleri arasında gezinirsin. Geri gitmek için Sol Ok tuşuna bas. Geri döndüğünde konumun hatırlanır.</RimWorldAccess.Core.Settings.SubmenuTreeNavigation.Tooltip>

  <RimWorldAccess.Core.Settings.AnnounceSelectedPawnActivity.Label>Seçili kişinin etkinliğini seslendir</RimWorldAccess.Core.Settings.AnnounceSelectedPawnActivity.Label>
  <RimWorldAccess.Core.Settings.AnnounceSelectedPawnActivity.Desc>Seçili kişinin ne yaptığını gerçek zamanlı olarak seslendirir. Harita imlecini hareket ettirmek seslendirmeyi durdurur.</RimWorldAccess.Core.Settings.AnnounceSelectedPawnActivity.Desc>

  <RimWorldAccess.Core.Settings.ShowWhatsNew.Label>Güncelleme sonrası Yenilikler mesajını göster</RimWorldAccess.Core.Settings.ShowWhatsNew.Label>
  <RimWorldAccess.Core.Settings.ShowWhatsNew.Desc>Açıksa, RimWorld Access güncellendiğinde ana menüde Yenilikler mesajı açılır. Kapalıysa, yalnızca modun güncellendiğine dair kısa bir bildirim duyarsın ve Yenilikler'i istediğin zaman menüden açabilirsin.</RimWorldAccess.Core.Settings.ShowWhatsNew.Desc>

  <!-- Table verbosity (docs/table-model.md). The examples inside the labels
       should be adapted to match each language's actual table announcements. -->
  <!-- Spoken in place of vanilla's "mousing over a target" sentence in the shooting accuracy description. {0} = the map key that reads items and pawns at the cursor. -->
  <RimWorldAccess.Stat.ShootingAccuracy.HitChanceHint>Herhangi bir atışın isabet ihtimali, nişancıyı seçip imleci hedefin üzerine getirdikten sonra {0} tuşuna basarak dinlenebilir.</RimWorldAccess.Stat.ShootingAccuracy.HitChanceHint>
</LanguageData>
