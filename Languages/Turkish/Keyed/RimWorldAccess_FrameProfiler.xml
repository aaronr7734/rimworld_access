<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- RimWorld 1.7's frame profiler (src/Shell/Screens/FrameProfiler/). Profiler readings such as
       "median", "p99" and column headers come from the game's own window and are not translated here. -->
  <RimWorldAccess.FrameProfiler.Title>Kare profilleyici</RimWorldAccess.FrameProfiler.Title>

  <RimWorldAccess.FrameProfiler.Region.Controls>Kontroller</RimWorldAccess.FrameProfiler.Region.Controls>
  <RimWorldAccess.FrameProfiler.Region.Summary>Özet</RimWorldAccess.FrameProfiler.Region.Summary>
  <RimWorldAccess.FrameProfiler.Region.Frames>Kareler</RimWorldAccess.FrameProfiler.Region.Frames>
  <RimWorldAccess.FrameProfiler.Region.Timeline>Zaman çizelgesi</RimWorldAccess.FrameProfiler.Region.Timeline>
  <RimWorldAccess.FrameProfiler.Region.TableControls>Tablo kontrolleri</RimWorldAccess.FrameProfiler.Region.TableControls>
  <RimWorldAccess.FrameProfiler.Region.Table>Tablo</RimWorldAccess.FrameProfiler.Region.Table>
  <RimWorldAccess.FrameProfiler.Region.Threads>İş parçacıkları</RimWorldAccess.FrameProfiler.Region.Threads>
  <RimWorldAccess.FrameProfiler.Region.Settings>Ayarlar</RimWorldAccess.FrameProfiler.Region.Settings>

  <!-- Buttons the window draws as a bare symbol. -->
  <RimWorldAccess.FrameProfiler.Control.OlderFrame>Önceki kare</RimWorldAccess.FrameProfiler.Control.OlderFrame>
  <RimWorldAccess.FrameProfiler.Control.NewerFrame>Sonraki kare</RimWorldAccess.FrameProfiler.Control.NewerFrame>
  <RimWorldAccess.FrameProfiler.Control.NewestFrame>En yeni kare</RimWorldAccess.FrameProfiler.Control.NewestFrame>
  <RimWorldAccess.FrameProfiler.Control.Close>Kapat</RimWorldAccess.FrameProfiler.Control.Close>
  <RimWorldAccess.FrameProfiler.Control.ExpandAll>Tümünü genişlet</RimWorldAccess.FrameProfiler.Control.ExpandAll>
  <RimWorldAccess.FrameProfiler.Control.CollapseAll>Tümünü daralt</RimWorldAccess.FrameProfiler.Control.CollapseAll>

  <RimWorldAccess.FrameProfiler.Search>Ara</RimWorldAccess.FrameProfiler.Search>
  <RimWorldAccess.FrameProfiler.Filters>Filtreler</RimWorldAccess.FrameProfiler.Filters>
  <!-- {0} is the typed value, {1} its unit, such as "frames" or "fps". -->
  <RimWorldAccess.FrameProfiler.FieldValue>{0} {1}</RimWorldAccess.FrameProfiler.FieldValue>
  <!-- {0} is a column header drawn by the game, such as "total" or "calls". -->
  <RimWorldAccess.FrameProfiler.SortBy>{0} sütununa göre sırala</RimWorldAccess.FrameProfiler.SortBy>
  <RimWorldAccess.FrameProfiler.SortedAscending>artan sırada</RimWorldAccess.FrameProfiler.SortedAscending>
  <RimWorldAccess.FrameProfiler.SortedDescending>azalan sırada</RimWorldAccess.FrameProfiler.SortedDescending>
  <!-- {0} is the list of the selected row's ancestors, outermost first. -->
  <RimWorldAccess.FrameProfiler.Path>Yol: {0}</RimWorldAccess.FrameProfiler.Path>
  <!-- {0} is a column header drawn by the game, {1} the row's value in that column. -->
  <RimWorldAccess.FrameProfiler.Cell>{0} {1}</RimWorldAccess.FrameProfiler.Cell>
  <RimWorldAccess.FrameProfiler.PercentCell>yüzde {0}</RimWorldAccess.FrameProfiler.PercentCell>
  <RimWorldAccess.FrameProfiler.NoSearchMatch>aramayla eşleşmiyor</RimWorldAccess.FrameProfiler.NoSearchMatch>

  <RimWorldAccess.FrameProfiler.Frame>Kare {0}</RimWorldAccess.FrameProfiler.Frame>
  <RimWorldAccess.FrameProfiler.OverBudget>bütçeyi aştı</RimWorldAccess.FrameProfiler.OverBudget>
  <RimWorldAccess.FrameProfiler.Spike>ani yükselme</RimWorldAccess.FrameProfiler.Spike>
  <!-- {0}, {1}, {2}: garbage collections of generations 0, 1 and 2. -->
  <RimWorldAccess.FrameProfiler.GarbageCollections>çöp toplama {0}, {1}, {2}</RimWorldAccess.FrameProfiler.GarbageCollections>
  <RimWorldAccess.FrameProfiler.Promoted>yükseltilen {0}</RimWorldAccess.FrameProfiler.Promoted>
  <RimWorldAccess.FrameProfiler.OnePause>{0} duraklama, {1} boyunca durdu</RimWorldAccess.FrameProfiler.OnePause>
  <RimWorldAccess.FrameProfiler.Pauses>{0} duraklama, {1} boyunca durdu</RimWorldAccess.FrameProfiler.Pauses>
  <RimWorldAccess.FrameProfiler.Alloc>ayrılan {0}</RimWorldAccess.FrameProfiler.Alloc>
  <RimWorldAccess.FrameProfiler.AllocObjects>{1} nesnede ayrılan {0}</RimWorldAccess.FrameProfiler.AllocObjects>
  <RimWorldAccess.FrameProfiler.PausedBefore>bu kareden önce profilleme {0} boyunca duraklatıldı</RimWorldAccess.FrameProfiler.PausedBefore>

  <RimWorldAccess.FrameProfiler.ZoneStart>{0} anında başlar</RimWorldAccess.FrameProfiler.ZoneStart>
  <RimWorldAccess.FrameProfiler.ZoneTotal>toplam {0}</RimWorldAccess.FrameProfiler.ZoneTotal>
  <RimWorldAccess.FrameProfiler.ZoneSelf>kendi {0}</RimWorldAccess.FrameProfiler.ZoneSelf>
  <RimWorldAccess.FrameProfiler.ZoneRunning>hâlâ çalışıyor</RimWorldAccess.FrameProfiler.ZoneRunning>
  <RimWorldAccess.FrameProfiler.ThreadBusy>meşgul {0}</RimWorldAccess.FrameProfiler.ThreadBusy>
  <RimWorldAccess.FrameProfiler.Unprofiled>profillenmeyen {0}</RimWorldAccess.FrameProfiler.Unprofiled>
  <!-- {0} is the zone's name. -->
  <RimWorldAccess.FrameProfiler.RevealedInCallTree>{0} çağrı ağacında seçildi</RimWorldAccess.FrameProfiler.RevealedInCallTree>

  <!-- Runtime pauses: moments the .NET runtime stopped the game, mostly garbage collections. -->
  <RimWorldAccess.FrameProfiler.PauseLane>Çalışma zamanı duraklamaları</RimWorldAccess.FrameProfiler.PauseLane>
  <RimWorldAccess.FrameProfiler.PauseCount>bu karede {0}</RimWorldAccess.FrameProfiler.PauseCount>
  <RimWorldAccess.FrameProfiler.PauseStopped>durdu {0}</RimWorldAccess.FrameProfiler.PauseStopped>
  <RimWorldAccess.FrameProfiler.PauseWaiting>iş parçacıkları bekleniyor {0}</RimWorldAccess.FrameProfiler.PauseWaiting>
  <!-- {0} collected, {1} promoted to an older generation. -->
  <RimWorldAccess.FrameProfiler.PauseCollected>toplanan {0}, yükseltilen {1}</RimWorldAccess.FrameProfiler.PauseCollected>
  <RimWorldAccess.FrameProfiler.PauseByRuntime>çalışma zamanı iş parçacığı tetikledi</RimWorldAccess.FrameProfiler.PauseByRuntime>
  <RimWorldAccess.FrameProfiler.PauseByMainThread>ana iş parçacığı tetikledi</RimWorldAccess.FrameProfiler.PauseByMainThread>
  <RimWorldAccess.FrameProfiler.PauseByThread>{0} iş parçacığı tetikledi</RimWorldAccess.FrameProfiler.PauseByThread>

  <!-- {0} is the zone's name. -->
  <RimWorldAccess.FrameProfiler.RangeSelected>{0} bölgesinin zaman aralığı seçildi</RimWorldAccess.FrameProfiler.RangeSelected>

  <RimWorldAccess.FrameProfiler.AllThreads>Tüm iş parçacıkları</RimWorldAccess.FrameProfiler.AllThreads>
  <RimWorldAccess.FrameProfiler.ThreadsSelected>{1} içinden {0} seçili</RimWorldAccess.FrameProfiler.ThreadsSelected>

  <RimWorldAccess.FrameProfiler.Paused>Duraklatıldı</RimWorldAccess.FrameProfiler.Paused>
  <RimWorldAccess.FrameProfiler.Recording>Kayıtta</RimWorldAccess.FrameProfiler.Recording>
  <RimWorldAccess.FrameProfiler.FollowingNewest>En yeni kare takip ediliyor</RimWorldAccess.FrameProfiler.FollowingNewest>
  <RimWorldAccess.FrameProfiler.SelectionCleared>Kare seçimi temizlendi</RimWorldAccess.FrameProfiler.SelectionCleared>
  <RimWorldAccess.FrameProfiler.Copied>Satır kopyalandı</RimWorldAccess.FrameProfiler.Copied>
  <RimWorldAccess.FrameProfiler.ViewCopied>Görünüm kopyalandı</RimWorldAccess.FrameProfiler.ViewCopied>
</LanguageData>
