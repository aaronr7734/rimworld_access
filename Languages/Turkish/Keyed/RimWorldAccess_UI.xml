<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    UI module strings (src/UI/). The UI module hosts shared dialog and
    menu infrastructure used by the rest of the mod; many of its files
    (TypeaheadSearchHelper, GuardHelper, MenuHelper, TreeNavigationHelper,
    TwoLevelMenuHelper, NumericStepperHelper) were already wired through
    Common.xml in earlier phases. This file covers the remaining
    state/patch/helper files that still emit module-specific phrasing:

      - WindowlessSaveMenuState.cs       (save/load file browser)
      - WindowlessFloatMenuState.cs      (keyboard-navigable float menu)
      - WindowlessPauseMenuState.cs      (in-game pause menu)
      - WindowlessOptionsMenuState.cs    (options panel + setting hints)
      - WindowlessDialogState.cs         (generic dialog frame)
      - WindowlessConfirmationState.cs   (yes/no confirmation)
      - QuantityMenuState.cs             (numeric quantity picker)
      - GiveNameDialogPatch.cs           (Dialog_GiveName randomize/accept)
      - DialogElementExtractor.cs        (Dialog_Rename / Dialog_GiveName /
                                           Dialog_NamePawn OK feedback)
      - TransferableQuantityHelper.cs    (caravan/trade quantity setters)
      - MessageBoxScope.Game.cs          (real Dialog_MessageBox scope)
      - ExtraMenusState.cs               (extra-menus picker)
      - Dialog_NameAllowedArea.cs        (zone-area name dialog)

    Phrasing decisions:
      - The "{Label}. {Position}. No matches for '{X}'" pattern (typeahead
        no-match in pause/extra menus) is shared (Item.WithPositionNoMatches).
      - "OK", "Accept", "Cancel" button labels delegate to vanilla
        translation keys via .Translate() at the call site.
      - The "RimWorld Access" settings sub-category in the in-game options
        panel reuses the existing RimWorldAccess.Core.Settings.* keys
        (canonical wording lives in RimWorldAccess_Core.xml).

    Data such as save file names, faction names, settings category labels
    from the game (Prefs categories), modder-supplied SettingsCategory()
    text, mass values, item labels, and dialog button text extracted via
    reflection from RimWorld dialogs is NOT translated here.
  -->


  <!-- =================================================================
       Save / load menu (WindowlessSaveMenuState +
                         WindowlessDeleteConfirmationState).
       Save mode introduces a virtual "Create New Save" entry at index 0,
       so position composition has its own keys. Load mode shares
       Item.WithPosition for the basic line.
       ================================================================= -->
  <RimWorldAccess.UI.Save.NoFiles>Kayıt dosyası yok</RimWorldAccess.UI.Save.NoFiles>
  <RimWorldAccess.UI.Save.InvalidSelection>Geçersiz kayıt seçimi</RimWorldAccess.UI.Save.InvalidSelection>
  <RimWorldAccess.UI.Save.NeedName>Kayıt dosyası için isim gerekli</RimWorldAccess.UI.Save.NeedName>
  <RimWorldAccess.UI.Save.CannotDeleteCreateNew>Kayıt adı satırı silinemez</RimWorldAccess.UI.Save.CannotDeleteCreateNew>
  <!-- {0} = file name (stripped of extension). -->
  <!-- Row LABELS only (element-uniformity campaign, task 8 packet E). These
       used to be whole-row templates carrying the date and the position too;
       FileListScope now fills an ElementDescription instead, so the composer
       supplies the position and the date-time rides Extras. The mode verb stays
       in the label because it is the only thing distinguishing a save row (Enter
       overwrites) from a load row (Enter loads) once you are inside the list.
       CreateNewLabel takes no argument: the typed name is the row's VALUE.
       Overwrite/Load: {0} = file name, stripped of its extension. -->
  <RimWorldAccess.UI.Save.OverwriteLabel>Üstüne yaz: {0}</RimWorldAccess.UI.Save.OverwriteLabel>
  <RimWorldAccess.UI.Save.LoadLabel>Yükle: {0}</RimWorldAccess.UI.Save.LoadLabel>

