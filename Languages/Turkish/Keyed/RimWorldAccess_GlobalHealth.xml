<LanguageData>
  <!-- Health overview screen (src/Shell/Screens/GlobalHealthScope.Game.cs). -->
  <RimWorldAccess.GlobalHealth.Title>Sağlık genel bakışı</RimWorldAccess.GlobalHealth.Title>
  <RimWorldAccess.GlobalHealth.RegionName>Kişiler</RimWorldAccess.GlobalHealth.RegionName>
  <RimWorldAccess.GlobalHealth.Node.DownedBleeding>Etkisiz hâlde ve kanayan</RimWorldAccess.GlobalHealth.Node.DownedBleeding>
  <RimWorldAccess.GlobalHealth.Node.Downed>Etkisiz hâlde</RimWorldAccess.GlobalHealth.Node.Downed>
  <RimWorldAccess.GlobalHealth.Node.Bleeding>Kanayan</RimWorldAccess.GlobalHealth.Node.Bleeding>
  <RimWorldAccess.GlobalHealth.Node.Injured>Yaralı</RimWorldAccess.GlobalHealth.Node.Injured>
  <!-- Node summaries. {0} = the node's name (one of the Node strings above), {1} = how many pawns it holds, then {2} (or {1} in the One forms) = the soonest time left before bleeding out ("2 hours") or the lowest overall health ("38%"). NotSoon is used when no one in the node bleeds out within a day, Deathless when everyone bleeding in it has the deathless gene. -->
  <RimWorldAccess.GlobalHealth.Summary.None>{0}. Yok</RimWorldAccess.GlobalHealth.Summary.None>
  <RimWorldAccess.GlobalHealth.Summary.BleedOut>{0}. {1} kişi, en yakını {2} içinde kan kaybından ölecek</RimWorldAccess.GlobalHealth.Summary.BleedOut>
  <RimWorldAccess.GlobalHealth.Summary.BleedOutOne>{0}. 1 kişi, {1} içinde kan kaybından ölecek</RimWorldAccess.GlobalHealth.Summary.BleedOutOne>
  <RimWorldAccess.GlobalHealth.Summary.NotSoon>{0}. {1} kişi, hiçbirinin acil durumu yok</RimWorldAccess.GlobalHealth.Summary.NotSoon>
  <RimWorldAccess.GlobalHealth.Summary.NotSoonOne>{0}. 1 kişi, acil durumu yok</RimWorldAccess.GlobalHealth.Summary.NotSoonOne>
  <RimWorldAccess.GlobalHealth.Summary.Deathless>{0}. {1} kişi, hepsi ölümsüz</RimWorldAccess.GlobalHealth.Summary.Deathless>
  <RimWorldAccess.GlobalHealth.Summary.DeathlessOne>{0}. 1 kişi, ölümsüz</RimWorldAccess.GlobalHealth.Summary.DeathlessOne>
  <RimWorldAccess.GlobalHealth.Summary.LowestHealth>{0}. {1} kişi, en düşük sağlık {2}</RimWorldAccess.GlobalHealth.Summary.LowestHealth>
  <RimWorldAccess.GlobalHealth.Summary.HealthOne>{0}. 1 kişi, sağlık {1}</RimWorldAccess.GlobalHealth.Summary.HealthOne>
  <!-- {0} = the pawn's name with its group (one of the PawnGroup strings below), {1} = its health tag (one of the PawnHealth.Tag strings below). -->
  <RimWorldAccess.GlobalHealth.PawnRow>{0}. {1}</RimWorldAccess.GlobalHealth.PawnRow>
  <!-- After a filter checkbox is toggled. {0} = the checkbox's new state ("checked"), {1} = how many pawns are now listed. -->
  <RimWorldAccess.GlobalHealth.FilterChanged>{0}. {1} kişi listelendi.</RimWorldAccess.GlobalHealth.FilterChanged>
  <RimWorldAccess.GlobalHealth.FilterChangedOne>{0}. 1 kişi listelendi.</RimWorldAccess.GlobalHealth.FilterChangedOne>
  <RimWorldAccess.GlobalHealth.JumpUnavailable>Kişi bulunamıyor.</RimWorldAccess.GlobalHealth.JumpUnavailable>
  <!-- Pawn health tags, spoken on health overview rows and after scanner pawns. {0} = overall health ("45%"), {1} = time left before bleeding out ("2 hours"). The bleeding words mirror the vanilla health tab: "no immediate danger" past a day, "deathless" for the Biotech gene. -->
  <RimWorldAccess.PawnHealth.Tag.Health>sağlık {0}</RimWorldAccess.PawnHealth.Tag.Health>
  <RimWorldAccess.PawnHealth.Tag.Downed>etkisiz hâlde, sağlık {0}</RimWorldAccess.PawnHealth.Tag.Downed>
  <RimWorldAccess.PawnHealth.Tag.Bleeding>{1} içinde kan kaybından ölecek, sağlık {0}</RimWorldAccess.PawnHealth.Tag.Bleeding>
  <RimWorldAccess.PawnHealth.Tag.DownedBleeding>etkisiz hâlde, {1} içinde kan kaybından ölecek, sağlık {0}</RimWorldAccess.PawnHealth.Tag.DownedBleeding>
  <RimWorldAccess.PawnHealth.Tag.BleedingNotSoon>kanıyor, acil durumu yok, sağlık {0}</RimWorldAccess.PawnHealth.Tag.BleedingNotSoon>
