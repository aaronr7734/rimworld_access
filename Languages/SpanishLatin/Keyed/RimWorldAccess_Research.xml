<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Research module strings (src/Research/). Two state files contribute:
      - WindowlessResearchMenuState.cs  (the accessible research menu that
        replaces MainTabWindow_Research; hierarchical tree of tabs,
        status groups, and projects)
      - WindowlessResearchDetailState.cs  (the detail view opened from a
        project; tree of description, prerequisites, unlocks, dependents,
        and the start/stop action)

    Shared phrases (no info card available, already at edge, etc.) are
    delegated to RimWorldAccess_Common.xml so translators only localize
    them once. Only strings unique to the research UI live here.

    Placeholders follow string.Format ({0}, {1}, ...). One/Many key
    variants are used where English needs singular vs. plural agreement
    (e.g. "1 hidden prerequisite" vs "3 hidden prerequisites");
    translators with different plural classes can either collapse or
    split these further.
  -->

  <!-- Menu open/close announcements (WindowlessResearchMenuState). -->
  <RimWorldAccess.Research.Menu.Title>Menú de investigación</RimWorldAccess.Research.Menu.Title>
  <RimWorldAccess.Research.Menu.Closed>Menú de investigación cerrado</RimWorldAccess.Research.Menu.Closed>
  <RimWorldAccess.Research.Menu.ProjectNotAvailable>Proyecto de investigación no disponible</RimWorldAccess.Research.Menu.ProjectNotAvailable>
  <RimWorldAccess.Research.Menu.ProjectNotFound>Proyecto de investigación {0} no encontrado en el menú</RimWorldAccess.Research.Menu.ProjectNotFound>

  <!-- Root label for the built category tree. -->
  <RimWorldAccess.Research.Tree.RootLabel>Investigación</RimWorldAccess.Research.Tree.RootLabel>

  <!-- Status group labels. {0} = number of projects in the group. -->
  <RimWorldAccess.Research.Status.InProgress>En progreso ({0})</RimWorldAccess.Research.Status.InProgress>
  <RimWorldAccess.Research.Status.Available>Disponible ({0})</RimWorldAccess.Research.Status.Available>
  <RimWorldAccess.Research.Status.Completed>Completado ({0})</RimWorldAccess.Research.Status.Completed>
  <RimWorldAccess.Research.Status.Locked>Bloqueado ({0})</RimWorldAccess.Research.Status.Locked>

  <!-- Short status words used inline in labels (e.g. after prereq/dep rows). -->
  <RimWorldAccess.Research.Status.CompletedWord>Completado</RimWorldAccess.Research.Status.CompletedWord>
  <RimWorldAccess.Research.Status.AvailableWord>Disponible</RimWorldAccess.Research.Status.AvailableWord>
  <RimWorldAccess.Research.Status.LockedWord>Bloqueado</RimWorldAccess.Research.Status.LockedWord>

  <!-- Project label formatting (menu list entries).
       Cost/knowledge/progress suffixes are composed together with the
       project name by the caller. {0} = the numeric value. -->
  <RimWorldAccess.Research.Label.CostSuffix> - costo: {0}</RimWorldAccess.Research.Label.CostSuffix>
  <RimWorldAccess.Research.Label.KnowledgeSuffix> - conocimiento: {0}</RimWorldAccess.Research.Label.KnowledgeSuffix>
  <RimWorldAccess.Research.Label.ProgressSuffix> - {0}% completado</RimWorldAccess.Research.Label.ProgressSuffix>
  <RimWorldAccess.Research.Label.StatusSuffix> - {0}</RimWorldAccess.Research.Label.StatusSuffix>

  <!-- Detail view navigation (WindowlessResearchDetailState).
       BackTo: {0} = the previous research project we return to. -->
  <RimWorldAccess.Research.Detail.BackTo>Volver a {0}</RimWorldAccess.Research.Detail.BackTo>
  <RimWorldAccess.Research.Detail.ReturnedToMenu>Volviste al menú de investigación</RimWorldAccess.Research.Detail.ReturnedToMenu>

  <!-- Detail top-level node labels. -->
  <RimWorldAccess.Research.Detail.DescriptionLabel>Descripción</RimWorldAccess.Research.Detail.DescriptionLabel>
  <RimWorldAccess.Research.Detail.StartResearch>Iniciar investigación</RimWorldAccess.Research.Detail.StartResearch>
  <RimWorldAccess.Research.Detail.StopResearch>Detener investigación</RimWorldAccess.Research.Detail.StopResearch>
  <RimWorldAccess.Research.Detail.StartResearchHint>Presiona Enter para iniciar esta investigación</RimWorldAccess.Research.Detail.StartResearchHint>
  <RimWorldAccess.Research.Detail.StopResearchHint>Presiona Enter para detener esta investigación</RimWorldAccess.Research.Detail.StopResearchHint>

  <!-- Category headers inside the detail tree.
       WithCount: {0} = number of child items; None is used when empty. -->
  <RimWorldAccess.Research.Detail.PrerequisitesWithCount>Requisitos ({0} elementos)</RimWorldAccess.Research.Detail.PrerequisitesWithCount>
  <RimWorldAccess.Research.Detail.PrerequisitesNone>Requisitos (ninguno)</RimWorldAccess.Research.Detail.PrerequisitesNone>
  <RimWorldAccess.Research.Detail.UnlocksWithCount>Desbloquea ({0} elementos)</RimWorldAccess.Research.Detail.UnlocksWithCount>
  <RimWorldAccess.Research.Detail.UnlocksNone>Desbloquea (ninguno)</RimWorldAccess.Research.Detail.UnlocksNone>
  <RimWorldAccess.Research.Detail.DependentsWithCount>Dependientes ({0} elementos)</RimWorldAccess.Research.Detail.DependentsWithCount>
  <RimWorldAccess.Research.Detail.DependentsNone>Dependientes (ninguno)</RimWorldAccess.Research.Detail.DependentsNone>

  <!-- Research row inside a category (prereqs / dependents).
       {0} = project label, {1} = cost, {2} = status word. -->
  <RimWorldAccess.Research.Detail.ResearchRow>{0} - costo: {1} {2}</RimWorldAccess.Research.Detail.ResearchRow>

  <!-- Hidden prerequisite summary. AllCompleted is used when nothing is
       missing; IncompleteCount takes {0} = number still incomplete.
       HiddenOne/Many compose with the status word: {0} = count (omitted
       in One form), {1} = status word. -->
  <RimWorldAccess.Research.Detail.HiddenAllCompleted>Todo completado</RimWorldAccess.Research.Detail.HiddenAllCompleted>
  <RimWorldAccess.Research.Detail.HiddenIncompleteCount>{0} incompletos</RimWorldAccess.Research.Detail.HiddenIncompleteCount>
  <RimWorldAccess.Research.Detail.HiddenOne>1 requisito oculto - {0}</RimWorldAccess.Research.Detail.HiddenOne>
  <RimWorldAccess.Research.Detail.HiddenMany>{0} requisitos ocultos - {1}</RimWorldAccess.Research.Detail.HiddenMany>

  <!-- Prerequisite bench/facility/techprint/mechanitor/analyze/grav rows.
       Each row has an inline status tail. {0} = value or main label. -->
  <RimWorldAccess.Research.Detail.BenchAvailable>Disponible</RimWorldAccess.Research.Detail.BenchAvailable>
  <RimWorldAccess.Research.Detail.BenchNotAvailable>No disponible</RimWorldAccess.Research.Detail.BenchNotAvailable>
  <RimWorldAccess.Research.Detail.RequiresBench>Requiere mesa: {0} - {1}</RimWorldAccess.Research.Detail.RequiresBench>
  <RimWorldAccess.Research.Detail.RequiresFacility>Requiere instalación: {0}</RimWorldAccess.Research.Detail.RequiresFacility>

  <RimWorldAccess.Research.Detail.TechprintsComplete>Completo</RimWorldAccess.Research.Detail.TechprintsComplete>
  <RimWorldAccess.Research.Detail.TechprintsProgress>{0}/{1}</RimWorldAccess.Research.Detail.TechprintsProgress>
  <RimWorldAccess.Research.Detail.RequiresTechprints>Requiere planos técnicos: {0}</RimWorldAccess.Research.Detail.RequiresTechprints>

  <RimWorldAccess.Research.Detail.MechanitorMet>Cumplido</RimWorldAccess.Research.Detail.MechanitorMet>
  <RimWorldAccess.Research.Detail.MechanitorNotMet>No cumplido</RimWorldAccess.Research.Detail.MechanitorNotMet>
  <RimWorldAccess.Research.Detail.RequiresMechanitor>Requiere mecanitor - {0}</RimWorldAccess.Research.Detail.RequiresMechanitor>

  <RimWorldAccess.Research.Detail.AnalyzeComplete>Completo</RimWorldAccess.Research.Detail.AnalyzeComplete>
  <RimWorldAccess.Research.Detail.AnalyzeProgress>{0}/{1}</RimWorldAccess.Research.Detail.AnalyzeProgress>
  <RimWorldAccess.Research.Detail.RequiresAnalyzing>Requiere analizar: {0} - {1}</RimWorldAccess.Research.Detail.RequiresAnalyzing>

  <RimWorldAccess.Research.Detail.GravEngineInspected>Inspeccionado</RimWorldAccess.Research.Detail.GravEngineInspected>
  <RimWorldAccess.Research.Detail.GravEngineNotInspected>No inspeccionado</RimWorldAccess.Research.Detail.GravEngineNotInspected>
  <RimWorldAccess.Research.Detail.RequiresGravEngine>Requiere inspección del motor de gravedad - {0}</RimWorldAccess.Research.Detail.RequiresGravEngine>

  <!-- Unlocked item categories. Nouns used in labels like "(Building)". -->
  <RimWorldAccess.Research.Detail.UnlockCategoryBuilding>Construcción</RimWorldAccess.Research.Detail.UnlockCategoryBuilding>
  <RimWorldAccess.Research.Detail.UnlockCategoryPlant>Planta</RimWorldAccess.Research.Detail.UnlockCategoryPlant>
  <RimWorldAccess.Research.Detail.UnlockCategoryItem>Objeto</RimWorldAccess.Research.Detail.UnlockCategoryItem>
  <RimWorldAccess.Research.Detail.UnlockCategoryRecipe>Receta</RimWorldAccess.Research.Detail.UnlockCategoryRecipe>

  <!-- No-info-card message for non-target tree sections. -->
  <RimWorldAccess.Research.Detail.NoInfoCardForSection>No hay ficha de información para esta sección</RimWorldAccess.Research.Detail.NoInfoCardForSection>

  <!-- Description content builder (StringBuilder in BuildDescriptionContent).
       Each key is a single line in the composed text block. -->
  <RimWorldAccess.Research.Desc.ProjectLine>Proyecto: {0}</RimWorldAccess.Research.Desc.ProjectLine>
  <RimWorldAccess.Research.Desc.ResearchCost>Costo de investigación: {0}</RimWorldAccess.Research.Desc.ResearchCost>
  <RimWorldAccess.Research.Desc.KnowledgeCost>Costo de conocimiento: {0}</RimWorldAccess.Research.Desc.KnowledgeCost>
  <RimWorldAccess.Research.Desc.KnowledgeCategory>Categoría de conocimiento: {0}</RimWorldAccess.Research.Desc.KnowledgeCategory>
  <RimWorldAccess.Research.Desc.Progress>Progreso: {0}%</RimWorldAccess.Research.Desc.Progress>
  <RimWorldAccess.Research.Desc.StatusCompleted>Estado: completado</RimWorldAccess.Research.Desc.StatusCompleted>
  <RimWorldAccess.Research.Desc.StatusAvailable>Estado: disponible para investigar</RimWorldAccess.Research.Desc.StatusAvailable>
  <RimWorldAccess.Research.Desc.StatusLocked>Estado: bloqueado</RimWorldAccess.Research.Desc.StatusLocked>
  <RimWorldAccess.Research.Desc.RequiredBench>Mesa requerida: {0}</RimWorldAccess.Research.Desc.RequiredBench>
  <RimWorldAccess.Research.Desc.RequiredFacilitiesPrefix>Instalaciones requeridas: </RimWorldAccess.Research.Desc.RequiredFacilitiesPrefix>

  <!-- Research action announcements (start / stop / blocked). -->
  <RimWorldAccess.Research.Action.Stopped>Investigación de {0} detenida</RimWorldAccess.Research.Action.Stopped>
  <RimWorldAccess.Research.Action.AlreadyCompleted>{0} ya está completado</RimWorldAccess.Research.Action.AlreadyCompleted>
  <RimWorldAccess.Research.Action.MissingPrereqs>No se puede iniciar la investigación: faltan requisitos - {0}</RimWorldAccess.Research.Action.MissingPrereqs>
  <RimWorldAccess.Research.Action.NeedTechprints>No se puede iniciar la investigación: se necesitan {0} planos técnicos, solo {1} aplicados</RimWorldAccess.Research.Action.NeedTechprints>
  <RimWorldAccess.Research.Action.StudyFirst>No se puede iniciar la investigación: primero debes estudiar los elementos requeridos</RimWorldAccess.Research.Action.StudyFirst>
  <RimWorldAccess.Research.Action.Started>Investigación de {0} iniciada</RimWorldAccess.Research.Action.Started>
  <RimWorldAccess.Research.Action.StartedReplacing>Investigación de {0} iniciada. {1} detenida al {2}% de progreso.</RimWorldAccess.Research.Action.StartedReplacing>

  <!-- Missing prerequisite list fragments.
       Unknown: spoken when currentProject is null or no parts collected.
       HiddenOne/Many: {0} = count of hidden missing prereqs (omitted in One form). -->
  <RimWorldAccess.Research.MissingPrereqs.Unknown>Desconocido</RimWorldAccess.Research.MissingPrereqs.Unknown>
  <RimWorldAccess.Research.MissingPrereqs.HiddenOne>1 requisito oculto</RimWorldAccess.Research.MissingPrereqs.HiddenOne>
  <RimWorldAccess.Research.MissingPrereqs.HiddenMany>{0} requisitos ocultos</RimWorldAccess.Research.MissingPrereqs.HiddenMany>
</LanguageData>
