<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Animals module strings (src/Animals/). Five state/helper files contribute:
      - AnimalsMenuState.cs / AnimalsMenuHelper.cs  (colony animals tab)
      - WildlifeMenuState.cs / WildlifeMenuHelper.cs  (wild animals tab)
      - AutoSlaughterState.cs  (Dialog_AutoSlaughter overlay)

    Both menus use TabularMenuHelper<Pawn>, so many of their phrasings
    (cell announcements, sort feedback, paint feedback) are parallel and
    share placeholder patterns. Each state class keeps its own lifecycle
    announcements (OpeningTitle / MenuClosed) so translators can vary
    word order between the colony and wildlife variants.

    Placeholders follow string.Format ({0}, {1}, ...). Data such as animal
    names, area labels, colonist names, trainable LabelCaps, and column
    header text comes from the game and is NOT translated in this file.

    Shared phrases delegated to RimWorldAccess_Common.xml:
      - Already-at-edge / position / cannot-paint keys
      - Info card unavailable
      - Typeahead search scaffolding
    This file only contains phrases that are unique to the animals and
    wildlife tabs and to the auto-slaughter dialog.
  -->

  <!-- Shared fallback values used by both AnimalsMenuHelper and
       WildlifeMenuHelper for cells that cannot be resolved (e.g. a pawn
       with no map, a missing LifeStage). "Normal" is used for the
       MentalState column when the pawn is not in a mental state (vanilla
       shows an empty cell; we speak "Normal" for clarity). -->
  <RimWorldAccess.Animals.Value.Unknown>Desconocido</RimWorldAccess.Animals.Value.Unknown>
  <RimWorldAccess.Animals.Value.NotApplicable>N/D</RimWorldAccess.Animals.Value.NotApplicable>
  <RimWorldAccess.Animals.Value.Normal>Normal</RimWorldAccess.Animals.Value.Normal>
  <!-- BondBroken is wrapped in parentheses after the "Bonded to X" text. -->
  <RimWorldAccess.Animals.Value.BondBroken>vínculo roto</RimWorldAccess.Animals.Value.BondBroken>
  <RimWorldAccess.Animals.Value.Scheduled>Programado</RimWorldAccess.Animals.Value.Scheduled>

  <!-- Paint value labels. AnimalsMenuHelper.GetPaintValueLabel and
       WildlifeMenuHelper.GetPaintValueLabel return these for checkbox
       column paint announcements. -->
  <RimWorldAccess.Animals.Paint.Checked>marcado</RimWorldAccess.Animals.Paint.Checked>
  <RimWorldAccess.Animals.Paint.Unchecked>desmarcado</RimWorldAccess.Animals.Paint.Unchecked>

  <!-- PenStatus column values (AnimalsMenuHelper.GetPenStatus). -->
  <RimWorldAccess.Animals.Value.InPen>en el corral</RimWorldAccess.Animals.Value.InPen>
  <RimWorldAccess.Animals.Value.OutsidePen>fuera del corral</RimWorldAccess.Animals.Value.OutsidePen>
  <RimWorldAccess.Animals.Value.NoPenAssigned>sin corral asignado</RimWorldAccess.Animals.Value.NoPenAssigned>

  <!-- =================================================================
       AnimalsMenuHelper column headers (colony animals tab).
       "Name" and "Age" are hard-coded English labels that don't have
       matching vanilla translation keys; Gender/LifeStage/Pregnant etc.
       DO have vanilla keys and are resolved via .Translate() in C#.
       ================================================================= -->
  <RimWorldAccess.Animals.Column.Name>Nombre</RimWorldAccess.Animals.Column.Name>
  <RimWorldAccess.Animals.Column.Age>Edad</RimWorldAccess.Animals.Column.Age>
  <RimWorldAccess.Animals.Column.LifeStage>Etapa de vida</RimWorldAccess.Animals.Column.LifeStage>
  <RimWorldAccess.Animals.Column.SpecialTraining>Entrenamiento especial</RimWorldAccess.Animals.Column.SpecialTraining>
  <RimWorldAccess.Animals.Column.MentalState>Estado mental</RimWorldAccess.Animals.Column.MentalState>
  <RimWorldAccess.Animals.Column.BondInfo>Vínculo</RimWorldAccess.Animals.Column.BondInfo>
  <RimWorldAccess.Animals.Column.Sterile>Estéril</RimWorldAccess.Animals.Column.Sterile>
  <RimWorldAccess.Animals.Column.MedicalCare>Atención médica</RimWorldAccess.Animals.Column.MedicalCare>
  <RimWorldAccess.Animals.Column.PenStatus>Estado del corral</RimWorldAccess.Animals.Column.PenStatus>

  <!-- =================================================================
       Training status (AnimalsMenuHelper.GetTrainingStatus and
       GetSpecialTrainableStatus). Both methods share this vocabulary.
       {0} = current steps, {1} = total steps for the trainable.
       ================================================================= -->
  <RimWorldAccess.Animals.Training.CannotTrain>No se puede entrenar</RimWorldAccess.Animals.Training.CannotTrain>
  <RimWorldAccess.Animals.Training.Maintaining>Manteniendo ({0}/{1})</RimWorldAccess.Animals.Training.Maintaining>
  <RimWorldAccess.Animals.Training.NotMaintaining>Sin mantener ({0}/{1})</RimWorldAccess.Animals.Training.NotMaintaining>
  <RimWorldAccess.Animals.Training.InProgress>Entrenando ({0}/{1})</RimWorldAccess.Animals.Training.InProgress>
  <RimWorldAccess.Animals.Training.WaitingToTrain>Esperando para entrenar</RimWorldAccess.Animals.Training.WaitingToTrain>
  <RimWorldAccess.Animals.Training.WillNotTrain>No se entrenará</RimWorldAccess.Animals.Training.WillNotTrain>
  <RimWorldAccess.Animals.Training.NoSpecialAbility>Ninguno disponible</RimWorldAccess.Animals.Training.NoSpecialAbility>

  <!-- =================================================================
       AnimalsMenuState lifecycle and navigation announcements.
       ================================================================= -->
  <RimWorldAccess.Animals.Menu.NoColonyAnimals>No se encontraron animales de la colonia</RimWorldAccess.Animals.Menu.NoColonyAnimals>
  <RimWorldAccess.Animals.Menu.OpeningTitle>Menú de animales, {0} animales</RimWorldAccess.Animals.Menu.OpeningTitle>
  <RimWorldAccess.Animals.Menu.Closed>Menú de animales cerrado</RimWorldAccess.Animals.Menu.Closed>
  <RimWorldAccess.Animals.Menu.ClosedWithSummary>Menú de animales cerrado. {0}</RimWorldAccess.Animals.Menu.ClosedWithSummary>
  <RimWorldAccess.Animals.Menu.ReturnTitle>Menú de animales</RimWorldAccess.Animals.Menu.ReturnTitle>
  <RimWorldAccess.Animals.Menu.NoAnimals>Sin animales</RimWorldAccess.Animals.Menu.NoAnimals>
  <RimWorldAccess.Animals.Menu.NotOnMap>El animal no está en el mapa</RimWorldAccess.Animals.Menu.NotOnMap>

  <!-- Cell-interaction feedback for training, follow, dig/forage, etc.
       {0} = animal name (pawn.LabelShort), {1} = trainable LabelCap
       (MissingTraining uses "Dig" or "Forage" by def). -->
  <RimWorldAccess.Animals.Cell.CannotTrainInSkill>{0} no puede ser entrenado en {1}</RimWorldAccess.Animals.Cell.CannotTrainInSkill>
  <RimWorldAccess.Animals.Cell.RequiresTraining>{0} requiere entrenamiento de {1}</RimWorldAccess.Animals.Cell.RequiresTraining>
  <RimWorldAccess.Animals.Cell.HasNotLearned>{0} no ha aprendido {1}</RimWorldAccess.Animals.Cell.HasNotLearned>
  <RimWorldAccess.Animals.Cell.NoSpecialAbilities>{0} no tiene habilidades especiales</RimWorldAccess.Animals.Cell.NoSpecialAbilities>
  <RimWorldAccess.Animals.Cell.AlreadySterilized>{0} ya está esterilizado</RimWorldAccess.Animals.Cell.AlreadySterilized>
  <RimWorldAccess.Animals.Cell.BondedSlaughterWarning>{0} tiene un vínculo. Se marca para sacrificio de todos modos.</RimWorldAccess.Animals.Cell.BondedSlaughterWarning>
  <RimWorldAccess.Animals.Cell.FactionSterilizeWarning>Advertencia: {0} pertenece a {1}. Se programa la esterilización de todos modos.</RimWorldAccess.Animals.Cell.FactionSterilizeWarning>
  <RimWorldAccess.Animals.Cell.RequiresTrainingForMaster>{0} requiere entrenamiento de {1} para tener un amo</RimWorldAccess.Animals.Cell.RequiresTrainingForMaster>

  <!-- =================================================================
       Submenu (Master / AllowedArea / MedicalCare).
       "Manage Areas" is the sentinel row inserted at the top of the
       AllowedArea submenu. {0} = option label, {1} = position suffix. -->
  <RimWorldAccess.Animals.Submenu.ManageAreas>Administrar áreas</RimWorldAccess.Animals.Submenu.ManageAreas>
  <RimWorldAccess.Animals.Submenu.Option>{0}. {1}</RimWorldAccess.Animals.Submenu.Option>
  <RimWorldAccess.Animals.Submenu.OptionAnnounce>{0} ({1})</RimWorldAccess.Animals.Submenu.OptionAnnounce>

  <!-- =================================================================
       Sort feedback (shared vocabulary used by Animals and Wildlife).
       {0} = column name, {1} = "ascending"/"descending" from the
       TabularMenuHelper result. -->
  <RimWorldAccess.Animals.Sort.CannotSort>{0} no se puede ordenar</RimWorldAccess.Animals.Sort.CannotSort>
  <RimWorldAccess.Animals.Sort.Cleared>Orden restablecido, orden predeterminado</RimWorldAccess.Animals.Sort.Cleared>
  <RimWorldAccess.Animals.Sort.SortedBy>Ordenado por {0} ({1})</RimWorldAccess.Animals.Sort.SortedBy>
  <RimWorldAccess.Animals.Sort.NowAt>Ahora en {0}</RimWorldAccess.Animals.Sort.NowAt>

  <!-- =================================================================
       Single-step paint announcements (Shift+Down / Shift+Up).
       {0} = target animal name, {1} = column-specific value (area,
       master, care, or checked/unchecked), {2} = position suffix.
       AllowedArea, Master, and MedicalCare get their own phrase sets so
       word order can vary; other checkbox/training columns share the
       generic "{col} {value}" phrasing. -->
  <RimWorldAccess.Animals.Paint.Single.AreaAlreadySet>{0}: ya establecido en {1}. {2}</RimWorldAccess.Animals.Paint.Single.AreaAlreadySet>
  <RimWorldAccess.Animals.Paint.Single.AreaApplied>{0}: {1} aplicado. {2}</RimWorldAccess.Animals.Paint.Single.AreaApplied>
  <RimWorldAccess.Animals.Paint.Single.RequiresObedience>{0}: requiere {1}. {2}</RimWorldAccess.Animals.Paint.Single.RequiresObedience>
  <RimWorldAccess.Animals.Paint.Single.MasterAlready>{0}: amo ya establecido en {1}. {2}</RimWorldAccess.Animals.Paint.Single.MasterAlready>
  <RimWorldAccess.Animals.Paint.Single.MasterApplied>{0}: amo {1} aplicado. {2}</RimWorldAccess.Animals.Paint.Single.MasterApplied>
  <RimWorldAccess.Animals.Paint.Single.CannotSetMedicalCare>{0}: no se puede establecer la atención médica. {1}</RimWorldAccess.Animals.Paint.Single.CannotSetMedicalCare>
  <RimWorldAccess.Animals.Paint.Single.MedicalCareAlready>{0}: atención médica ya establecida en {1}. {2}</RimWorldAccess.Animals.Paint.Single.MedicalCareAlready>
  <RimWorldAccess.Animals.Paint.Single.MedicalCareApplied>{0}: atención médica {1} aplicada. {2}</RimWorldAccess.Animals.Paint.Single.MedicalCareApplied>
  <!-- Generic checkbox / training paint: {0} = name, {1} = column name,
       {2} = value label (checked/unchecked), {3} = position. -->
  <RimWorldAccess.Animals.Paint.Single.CellAlready>{0}: {1} ya {2}. {3}</RimWorldAccess.Animals.Paint.Single.CellAlready>
  <RimWorldAccess.Animals.Paint.Single.CellApplied>{0}: {1} {2}. {3}</RimWorldAccess.Animals.Paint.Single.CellApplied>

  <!-- Bulk paint summaries (Shift+Home / Shift+End / Ctrl+Shift+...).
       {0} = value/label, {1} = FormatNameList of changed animals.
       *AlreadyAll keys are spoken when no animal needed updating. -->
  <RimWorldAccess.Animals.Paint.Bulk.AreaApplied>Área asignable establecida en {0} para {1}</RimWorldAccess.Animals.Paint.Bulk.AreaApplied>
  <RimWorldAccess.Animals.Paint.Bulk.AreaAlreadyAll>El área asignable ya está en {0} para todos los animales</RimWorldAccess.Animals.Paint.Bulk.AreaAlreadyAll>
  <RimWorldAccess.Animals.Paint.Bulk.MasterApplied>Amo establecido en {0} para {1}</RimWorldAccess.Animals.Paint.Bulk.MasterApplied>
  <RimWorldAccess.Animals.Paint.Bulk.MasterAlreadyAll>El amo ya está en {0} para todos los animales</RimWorldAccess.Animals.Paint.Bulk.MasterAlreadyAll>
  <RimWorldAccess.Animals.Paint.Bulk.MedicalCareApplied>Atención médica establecida en {0} para {1}</RimWorldAccess.Animals.Paint.Bulk.MedicalCareApplied>
  <RimWorldAccess.Animals.Paint.Bulk.MedicalCareAlreadyAll>La atención médica ya está en {0} para todos los animales</RimWorldAccess.Animals.Paint.Bulk.MedicalCareAlreadyAll>
  <!-- Generic checkbox/training bulk: {0} = column name, {1} = value,
       {2} = name list. AlreadyAll: {0} = column name, {1} = value. -->
  <RimWorldAccess.Animals.Paint.Bulk.CellApplied>{0} establecido en {1} para {2}</RimWorldAccess.Animals.Paint.Bulk.CellApplied>
  <RimWorldAccess.Animals.Paint.Bulk.CellAlreadyAll>{0} ya está en {1} para todos los animales</RimWorldAccess.Animals.Paint.Bulk.CellAlreadyAll>

  <!-- =================================================================
       WildlifeMenuHelper column headers. Only "Name" and "Predator"
       are hard-coded here; the rest come from vanilla translation keys
       resolved in C# (DesignatorHunt, IsPredator, etc.). -->
  <RimWorldAccess.Animals.Wildlife.Column.Name>Nombre</RimWorldAccess.Animals.Wildlife.Column.Name>
  <RimWorldAccess.Animals.Wildlife.Column.Predator>Depredador</RimWorldAccess.Animals.Wildlife.Column.Predator>

  <!-- =================================================================
       WildlifeMenuState lifecycle and cell-interaction announcements. -->
  <RimWorldAccess.Animals.Wildlife.Menu.NoWildlife>No se encontró fauna salvaje en el mapa</RimWorldAccess.Animals.Wildlife.Menu.NoWildlife>
  <RimWorldAccess.Animals.Wildlife.Menu.OpeningTitle>Menú de fauna salvaje, {0} animales</RimWorldAccess.Animals.Wildlife.Menu.OpeningTitle>
  <RimWorldAccess.Animals.Wildlife.Menu.Closed>Menú de fauna salvaje cerrado</RimWorldAccess.Animals.Wildlife.Menu.Closed>
  <RimWorldAccess.Animals.Wildlife.Menu.None>Sin fauna salvaje</RimWorldAccess.Animals.Wildlife.Menu.None>
  <RimWorldAccess.Animals.Wildlife.Menu.NotOnMap>El animal no está en el mapa</RimWorldAccess.Animals.Wildlife.Menu.NotOnMap>
  <RimWorldAccess.Animals.Wildlife.Menu.CannotTame>No se puede domesticar este animal</RimWorldAccess.Animals.Wildlife.Menu.CannotTame>

  <!-- Bulk paint phrasing for wildlife (only Hunt/Tame are paintable).
       The "for all wildlife" variant mirrors the animals' "for all
       animals" phrasing so translators can keep them in sync. -->
  <RimWorldAccess.Animals.Wildlife.Paint.Bulk.CellAlreadyAll>{0} ya está en {1} para toda la fauna salvaje</RimWorldAccess.Animals.Wildlife.Paint.Bulk.CellAlreadyAll>

  <!-- =================================================================
       AutoSlaughterState (Dialog_AutoSlaughter overlay).
       Column names here are the plain English labels we speak for the
       seven columns of the limit grid; translators can reword each
       independently since they compose into the cell announcement. -->
  <RimWorldAccess.Animals.AutoSlaughter.Column.MaxTotal>Población máxima permitida</RimWorldAccess.Animals.AutoSlaughter.Column.MaxTotal>
  <RimWorldAccess.Animals.AutoSlaughter.Column.MaxMales>Máximo de machos permitidos</RimWorldAccess.Animals.AutoSlaughter.Column.MaxMales>
  <RimWorldAccess.Animals.AutoSlaughter.Column.MaxMalesYoung>Máximo de machos jóvenes permitidos</RimWorldAccess.Animals.AutoSlaughter.Column.MaxMalesYoung>
  <RimWorldAccess.Animals.AutoSlaughter.Column.MaxFemales>Máximo de hembras permitidas</RimWorldAccess.Animals.AutoSlaughter.Column.MaxFemales>
  <RimWorldAccess.Animals.AutoSlaughter.Column.MaxFemalesYoung>Máximo de hembras jóvenes permitidas</RimWorldAccess.Animals.AutoSlaughter.Column.MaxFemalesYoung>
  <RimWorldAccess.Animals.AutoSlaughter.Column.AllowPregnant>Permitir sacrificio de preñadas</RimWorldAccess.Animals.AutoSlaughter.Column.AllowPregnant>
  <RimWorldAccess.Animals.AutoSlaughter.Column.AllowBonded>Permitir sacrificio de animales con vínculo</RimWorldAccess.Animals.AutoSlaughter.Column.AllowBonded>

  <!-- Lifecycle. -->
  <RimWorldAccess.Animals.AutoSlaughter.Menu.NoAnimals>No hay animales disponibles para la configuración de sacrificio automático</RimWorldAccess.Animals.AutoSlaughter.Menu.NoAnimals>
  <RimWorldAccess.Animals.AutoSlaughter.Menu.OpeningTitle>Configuración de sacrificio automático, {0} tipos de animales</RimWorldAccess.Animals.AutoSlaughter.Menu.OpeningTitle>
  <RimWorldAccess.Animals.AutoSlaughter.Menu.Closed>Sacrificio automático cerrado</RimWorldAccess.Animals.AutoSlaughter.Menu.Closed>
  <RimWorldAccess.Animals.AutoSlaughter.Menu.ClosedWithSummary>Sacrificio automático cerrado. {0}</RimWorldAccess.Animals.AutoSlaughter.Menu.ClosedWithSummary>
  <RimWorldAccess.Animals.AutoSlaughter.Menu.NoAnimalsShort>Sin animales</RimWorldAccess.Animals.AutoSlaughter.Menu.NoAnimalsShort>

  <!-- Slaughter summary: {0} = comma-joined "{count} {species}" entries.
       The entry format itself is a key so non-English languages can
       choose a different count/noun order. -->
  <RimWorldAccess.Animals.AutoSlaughter.Summary.MarkedForSlaughter>Marcados para sacrificio: {0}</RimWorldAccess.Animals.AutoSlaughter.Summary.MarkedForSlaughter>
  <RimWorldAccess.Animals.AutoSlaughter.Summary.Entry>{0} {1}</RimWorldAccess.Animals.AutoSlaughter.Summary.Entry>

  <!-- Column-value cell strings.
       {0} = current count (for Unlimited / WithinLimit / OverLimit).
       Unlimited/WithinLimit: {0} = count, for Unlimited the max is
         implicit; WithinLimit: {0} = max, {1} = current.
       OverLimit: {0} = max, {1} = current, {2} = to-slaughter count.
       Boolean columns phrase the allowed/not-allowed state as a whole
       sentence so languages can vary phrasing freely. -->
  <RimWorldAccess.Animals.AutoSlaughter.Value.Unlimited>ilimitado. Población actual: {0}</RimWorldAccess.Animals.AutoSlaughter.Value.Unlimited>
  <RimWorldAccess.Animals.AutoSlaughter.Value.WithinLimit>{0}. Población actual: {1}</RimWorldAccess.Animals.AutoSlaughter.Value.WithinLimit>
  <RimWorldAccess.Animals.AutoSlaughter.Value.OverLimit>{0}. Población actual: {1}. {2} serán sacrificados</RimWorldAccess.Animals.AutoSlaughter.Value.OverLimit>
  <RimWorldAccess.Animals.AutoSlaughter.Value.PregnantAllowed>{0} preñadas, sacrificio permitido</RimWorldAccess.Animals.AutoSlaughter.Value.PregnantAllowed>
  <RimWorldAccess.Animals.AutoSlaughter.Value.PregnantNotAllowed>{0} preñadas, sacrificio no permitido</RimWorldAccess.Animals.AutoSlaughter.Value.PregnantNotAllowed>
  <RimWorldAccess.Animals.AutoSlaughter.Value.BondedAllowed>{0} con vínculo, sacrificio permitido</RimWorldAccess.Animals.AutoSlaughter.Value.BondedAllowed>
  <RimWorldAccess.Animals.AutoSlaughter.Value.BondedNotAllowed>{0} con vínculo, sacrificio no permitido</RimWorldAccess.Animals.AutoSlaughter.Value.BondedNotAllowed>

  <!-- Cell announcement composition.
       WithName: {0} = animal LabelCap, {1} = column name, {2} = value,
         {3} = position suffix.
       WithoutName: {0} = column name, {1} = value. -->
  <RimWorldAccess.Animals.AutoSlaughter.Cell.WithName>{0}, {1}: {2}. {3}</RimWorldAccess.Animals.AutoSlaughter.Cell.WithName>
  <RimWorldAccess.Animals.AutoSlaughter.Cell.WithoutName>{0}: {1}</RimWorldAccess.Animals.AutoSlaughter.Cell.WithoutName>

  <!-- Numeric input mode. "minus" is spoken after the user presses the
       minus key so they hear confirmation of what's in the buffer;
       "Empty" is spoken after backspacing the last character. -->
  <RimWorldAccess.Animals.AutoSlaughter.Numeric.Prompt>Escribe un número, luego presiona Entrar para confirmar o Escape para cancelar</RimWorldAccess.Animals.AutoSlaughter.Numeric.Prompt>
  <RimWorldAccess.Animals.AutoSlaughter.Numeric.Minus>menos</RimWorldAccess.Animals.AutoSlaughter.Numeric.Minus>
  <RimWorldAccess.Animals.AutoSlaughter.Numeric.Empty>Vacío</RimWorldAccess.Animals.AutoSlaughter.Numeric.Empty>
  <RimWorldAccess.Animals.AutoSlaughter.Numeric.Invalid>Número no válido. Usa menos 1 para ilimitado</RimWorldAccess.Animals.AutoSlaughter.Numeric.Invalid>
  <RimWorldAccess.Animals.AutoSlaughter.Numeric.Cancelled>Cancelado</RimWorldAccess.Animals.AutoSlaughter.Numeric.Cancelled>

  <!-- Auto-slaughter partial cell shapes (single-axis announcements).
       NameWithoutColumn: {0} = animal, {1} = value, {2} = position.
       ValueOnly: {0} = value, {1} = position. -->
  <RimWorldAccess.Animals.AutoSlaughter.Cell.NameWithoutColumn>{0}: {1}. {2}</RimWorldAccess.Animals.AutoSlaughter.Cell.NameWithoutColumn>
  <RimWorldAccess.Animals.AutoSlaughter.Cell.ValueOnly>{0}. {1}</RimWorldAccess.Animals.AutoSlaughter.Cell.ValueOnly>
</LanguageData>
