  <RimWorldAccess.TransportPods.Launch.TargetSelected>Objetivo seleccionado</RimWorldAccess.TransportPods.Launch.TargetSelected>
  <RimWorldAccess.TransportPods.Launch.DestinationWithFuel>Destino: {0} cuadros, {1}</RimWorldAccess.TransportPods.Launch.DestinationWithFuel>
  <RimWorldAccess.TransportPods.Launch.DestinationBare>Destino: {0} cuadros</RimWorldAccess.TransportPods.Launch.DestinationBare>
  <RimWorldAccess.TransportPods.Launch.ErrorSelecting>Error al seleccionar el destino</RimWorldAccess.TransportPods.Launch.ErrorSelecting>

  <!-- Cancellation. -->
