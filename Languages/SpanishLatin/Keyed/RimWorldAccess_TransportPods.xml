  <RimWorldAccess.TransportPods.Loading.CannotInspectItem>No se puede inspeccionar este elemento</RimWorldAccess.TransportPods.Loading.CannotInspectItem>

  <!-- Delete/remove guard. -->
  <RimWorldAccess.TransportPods.Loading.AlreadyAtZero>Ya está en cero</RimWorldAccess.TransportPods.Loading.AlreadyAtZero>

  <!-- Reset (Alt+R). -->
  <RimWorldAccess.TransportPods.Loading.ResetAll>Todos los elementos restablecidos a cero</RimWorldAccess.TransportPods.Loading.ResetAll>

  <!-- Mass summary (Tab key / AnnounceMassSummary).
       Composed from MassLine + one of OverloadedStatus/RemainingStatus.
       {0} = current usage, {1} = capacity, {2} = status clause. -->
  <RimWorldAccess.TransportPods.Loading.MassSummary>Masa: {0} de {1} kg. {2}</RimWorldAccess.TransportPods.Loading.MassSummary>
  <RimWorldAccess.TransportPods.Loading.MassOverloaded>SOBRECARGA de {0} kg</RimWorldAccess.TransportPods.Loading.MassOverloaded>
  <RimWorldAccess.TransportPods.Loading.MassRemaining>{0} kg restantes</RimWorldAccess.TransportPods.Loading.MassRemaining>

  <!-- Summary view (Tab toggle). Empty/error states come next. -->
  <RimWorldAccess.TransportPods.Loading.NoSummaryForDialog>No hay resumen disponible para este menú</RimWorldAccess.TransportPods.Loading.NoSummaryForDialog>
  <RimWorldAccess.TransportPods.Loading.SummaryEntry>Vista de resumen. Arriba/Abajo navega las estadísticas. Tab para regresar.</RimWorldAccess.TransportPods.Loading.SummaryEntry>
  <RimWorldAccess.TransportPods.Loading.SummaryNoData>No hay datos disponibles</RimWorldAccess.TransportPods.Loading.SummaryNoData>
  <RimWorldAccess.TransportPods.Loading.SummaryNoTransporters>Sin transportadores</RimWorldAccess.TransportPods.Loading.SummaryNoTransporters>
  <RimWorldAccess.TransportPods.Loading.SummaryStatsUnavailable>Estadísticas no disponibles</RimWorldAccess.TransportPods.Loading.SummaryStatsUnavailable>
  <RimWorldAccess.TransportPods.Loading.SummaryNoSummary>No hay datos de resumen</RimWorldAccess.TransportPods.Loading.SummaryNoSummary>

  <!-- Summary item format ({item}. {position}). {0} = stat line, {1} = position. -->
  <RimWorldAccess.TransportPods.Loading.SummaryItemAnnouncement>{0}. {1}</RimWorldAccess.TransportPods.Loading.SummaryItemAnnouncement>

  <!-- Stat-breakdown view (Alt+I in summary mode). NoBreakdown is spoken when
       the selected stat has no cached explanation (e.g. Food).
       Stat names (spoken as the breakdown window title). -->
  <RimWorldAccess.TransportPods.Loading.NoBreakdown>No hay desglose disponible para este elemento</RimWorldAccess.TransportPods.Loading.NoBreakdown>
  <RimWorldAccess.TransportPods.Loading.StatMassCapacity>Capacidad de masa</RimWorldAccess.TransportPods.Loading.StatMassCapacity>
  <RimWorldAccess.TransportPods.Loading.StatSpeed>Velocidad</RimWorldAccess.TransportPods.Loading.StatSpeed>
  <RimWorldAccess.TransportPods.Loading.StatForaging>Recolección</RimWorldAccess.TransportPods.Loading.StatForaging>
  <RimWorldAccess.TransportPods.Loading.StatVisibility>Visibilidad</RimWorldAccess.TransportPods.Loading.StatVisibility>

  <!-- =========================================================
       TransportPodLaunchState.cs - world-map launch targeting.
       ========================================================= -->

  <!-- Entry announcements (Open). -->
