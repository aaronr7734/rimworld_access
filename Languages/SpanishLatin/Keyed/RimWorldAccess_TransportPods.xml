  <RimWorldAccess.TransportPods.Portal.FallbackLoading>Cargando</RimWorldAccess.TransportPods.Portal.FallbackLoading>
  <!-- Localization guardrail (D.8) sweep — previously hardcoded English. -->
  <RimWorldAccess.TransportPods.Loading.TabSummary>{0} pestaña, {1} elementos</RimWorldAccess.TransportPods.Loading.TabSummary>
</LanguageData>
