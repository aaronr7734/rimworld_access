  <RimWorldAccess.Rituals.Psychic.Condition.Baby>bebés</RimWorldAccess.Rituals.Psychic.Condition.Baby>
  <RimWorldAccess.Rituals.Psychic.Condition.Child>niños</RimWorldAccess.Rituals.Psychic.Condition.Child>
  <RimWorldAccess.Rituals.DryadCaste.UnknownCaste>Casta desconocida</RimWorldAccess.Rituals.DryadCaste.UnknownCaste>
  <!-- Hidden display-English sweep (returned/assigned strings localized). -->
  <RimWorldAccess.Rituals.LordJob.DialogClosed>Diálogo cerrado.</RimWorldAccess.Rituals.LordJob.DialogClosed>
  <RimWorldAccess.Rituals.Quality.OutcomeChancesLabel>Probabilidades de resultado</RimWorldAccess.Rituals.Quality.OutcomeChancesLabel>
  <RimWorldAccess.Rituals.Quality.OutcomeDescriptionLabel>Descripción del resultado</RimWorldAccess.Rituals.Quality.OutcomeDescriptionLabel>
