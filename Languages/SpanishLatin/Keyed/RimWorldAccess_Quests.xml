       active messages, letters, and alerts; detail view shows the full
       letter content with extracted action buttons.
       ================================================================= -->
  <RimWorldAccess.Notifications.Menu.None>No hay notificaciones disponibles</RimWorldAccess.Notifications.Menu.None>
  <RimWorldAccess.Notifications.Menu.Closed>Menú de notificaciones cerrado</RimWorldAccess.Notifications.Menu.Closed>
  <RimWorldAccess.Notifications.Menu.NoTargetLocation>No hay ubicación de destino disponible</RimWorldAccess.Notifications.Menu.NoTargetLocation>
  <RimWorldAccess.Notifications.Menu.TargetNotValid>La ubicación de destino no es válida</RimWorldAccess.Notifications.Menu.TargetNotValid>
  <RimWorldAccess.Notifications.Menu.FailedToActivateButton>No se pudo activar el botón</RimWorldAccess.Notifications.Menu.FailedToActivateButton>
  <RimWorldAccess.Notifications.Menu.FailedToJump>No se pudo ir al destino</RimWorldAccess.Notifications.Menu.FailedToJump>
  <RimWorldAccess.Notifications.Menu.OnlyLettersDeletable>Solo se pueden eliminar las cartas</RimWorldAccess.Notifications.Menu.OnlyLettersDeletable>
  <RimWorldAccess.Notifications.Menu.CannotDeleteLetter>No se puede eliminar esta carta</RimWorldAccess.Notifications.Menu.CannotDeleteLetter>

  <!-- Type labels for notifications. Used both as the prefix of the
