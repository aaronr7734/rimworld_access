<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Prisoner module strings (src/Prisoner/). Three files contribute:
      - PrisonerTabPatch.cs    (Harmony patch, no user-facing text)
      - PrisonerTabHelper.cs   (info/stats formatting, interaction descriptions)
      - PrisonerTabState.cs    (tab navigation, section announcements, selections)

    Placeholders follow string.Format ({0}, {1}, ...). Many keys embed
    pawn names, def labels, faction names, or raw numbers/percentages that
    come from the game's own data - do not attempt to translate the
    substituted values, only the surrounding wording. Shared vocabulary
    (e.g. "No pawn selected") is sourced from RimWorldAccess_Common.xml
    through GuardHelper, so it is not duplicated here.
  -->

  <!-- Guest-tracker / identity fallbacks. Spoken when a pawn lacks the
       expected tracker component or does not belong to the expected class.
       {0} = pawn short label. -->
  <RimWorldAccess.Prisoner.Guest.NoTracker>{0}: Sin rastreador de invitado</RimWorldAccess.Prisoner.Guest.NoTracker>
  <RimWorldAccess.Prisoner.Guest.NotPrisoner>{0}: No es prisionero</RimWorldAccess.Prisoner.Guest.NotPrisoner>
  <RimWorldAccess.Prisoner.Guest.NotSlave>{0}: No es esclavo</RimWorldAccess.Prisoner.Guest.NotSlave>
  <RimWorldAccess.Prisoner.Guest.NotPrisonerOrSlave>{0} no es prisionero ni esclavo</RimWorldAccess.Prisoner.Guest.NotPrisonerOrSlave>

  <!-- Prisoner stats block. Fragments are clean phrases; the
       AnnouncementBuilder owns separators between them. -->
  <RimWorldAccess.Prisoner.Info.HeaderPrisoner>{0} - Prisionero</RimWorldAccess.Prisoner.Info.HeaderPrisoner>
  <RimWorldAccess.Prisoner.Info.HeaderSlave>{0} - Esclavo</RimWorldAccess.Prisoner.Info.HeaderSlave>

  <!-- Last recruitment attempt breakdown. -->

  <!-- Slave stats block. -->
  <RimWorldAccess.Prisoner.Slave.Suppression>Represión: {0}</RimWorldAccess.Prisoner.Slave.Suppression>

  <!-- Release relation gain summary (shared between prisoner and slave paths).
       {0} = faction name, {1} = signed goodwill change (e.g. "+3" / "-7"),
       {2} = mental state inspect line. -->

  <!-- Medical care category labels. Used in the care-level stepper. -->
  <!-- Standalone hint appended to a section announcement when entering the medical care row. -->

  <!-- Interaction mode descriptions - warning suffixes appended after the
       def's own description through AnnouncementBuilder. {0} = ideo name. -->

  <!-- Slave emancipation outcome suffixes. {0} = slave faction name. -->

  <!-- Tab open / close announcements. -->
  <RimWorldAccess.Prisoner.Tab.Closed>Pestaña de prisionero cerrada</RimWorldAccess.Prisoner.Tab.Closed>
  <RimWorldAccess.Prisoner.Tab.OpenedPrisoner>Pestaña de prisionero: {0}</RimWorldAccess.Prisoner.Tab.OpenedPrisoner>
  <RimWorldAccess.Prisoner.Tab.OpenedSlave>Pestaña de esclavo: {0}</RimWorldAccess.Prisoner.Tab.OpenedSlave>
  <RimWorldAccess.Prisoner.Tab.CurrentMode>Modo actual: {0}</RimWorldAccess.Prisoner.Tab.CurrentMode>
  <RimWorldAccess.Prisoner.Tab.NavigationHint>
Presiona Izquierda/Derecha para navegar entre secciones, Arriba/Abajo dentro de las secciones, Enter para seleccionar</RimWorldAccess.Prisoner.Tab.NavigationHint>
  <!-- Inline variant without leading newline — used when embedded in a larger announcement sentence. -->
  <RimWorldAccess.Prisoner.Tab.NavigationHintInline>Presiona Izquierda/Derecha para navegar entre secciones, Arriba/Abajo dentro de las secciones, Enter para seleccionar</RimWorldAccess.Prisoner.Tab.NavigationHintInline>

  <!-- Section announcements. {0} = count (or current mode label). -->
  <RimWorldAccess.Prisoner.Section.Information>Sección de información</RimWorldAccess.Prisoner.Section.Information>
  <RimWorldAccess.Prisoner.Section.ExclusiveModes>Modos de interacción - {0} disponibles. Actual: {1}</RimWorldAccess.Prisoner.Section.ExclusiveModes>
  <RimWorldAccess.Prisoner.Section.MedicalCare>{0} - {1} disponibles</RimWorldAccess.Prisoner.Section.MedicalCare>
  <RimWorldAccess.Prisoner.Section.SlaveModes>Modos de esclavo - {0} disponibles. Actual: {1}</RimWorldAccess.Prisoner.Section.SlaveModes>
  <RimWorldAccess.Prisoner.Section.NonExclusiveModes>Modos no exclusivos - {0} disponibles. Presiona Espacio para alternar</RimWorldAccess.Prisoner.Section.NonExclusiveModes>
  <RimWorldAccess.Prisoner.Section.IdeologySelection>Selección de ideoligión - Elige el objetivo de conversión</RimWorldAccess.Prisoner.Section.IdeologySelection>

  <!-- Item-level announcements during navigation.
       Active/Current markers are placed at the start of the item line. -->
  <RimWorldAccess.Prisoner.Item.StateOn>[ENCENDIDO]</RimWorldAccess.Prisoner.Item.StateOn>
  <RimWorldAccess.Prisoner.Item.StateOff>[APAGADO]</RimWorldAccess.Prisoner.Item.StateOff>
  <RimWorldAccess.Prisoner.Item.NonExclusiveMode>{0}: {1}. {2}</RimWorldAccess.Prisoner.Item.NonExclusiveMode>
  <RimWorldAccess.Prisoner.Item.SelectedSuffix>, seleccionado</RimWorldAccess.Prisoner.Item.SelectedSuffix>

  <!-- Selection / toggle action feedback. -->
  <RimWorldAccess.Prisoner.Action.Selected>Selección: {0}. {1}</RimWorldAccess.Prisoner.Action.Selected>
  <RimWorldAccess.Prisoner.Action.ToggleEnabled>Activado</RimWorldAccess.Prisoner.Action.ToggleEnabled>
  <RimWorldAccess.Prisoner.Action.ToggleDisabled>Desactivado</RimWorldAccess.Prisoner.Action.ToggleDisabled>
  <RimWorldAccess.Prisoner.Action.ToggleMode>{0}: {1}</RimWorldAccess.Prisoner.Action.ToggleMode>
</LanguageData>
