<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Trade module strings (src/Trade/). Two state files contribute:
      - TradeNavigationState.cs   (Dialog_Trade keyboard navigation,
                                   3 tabs, gift mode, quantity mode,
                                   numeric input, balance entry)
      - SellableItemsState.cs     (Dialog_SellableItems read-only browse)

    The two patches (TradeNavigationPatch, SellableItemsNavigationPatch)
    have no user-facing strings and are untouched. Most data flowing
    through these announcements - tradeable labels, faction names,
    trader names, item descriptions, currency counts, royal favor
    labels, and ToStringMoney output - comes from the game and is NOT
    translated here.

    Phrasing decisions:
      - "Buying"/"Selling"/"Gifting" appear in many sentence shapes, so
        each shape is its own key (Trade.Adjust.*, Trade.Pending.*,
        Trade.Max.*) rather than glue-composing the verb. This lets
        translators inflect for case/agreement per sentence.
      - Silver prices use "${0}" (matches RimWorld's ToStringMoney) and
        favor uses "{0} favor". Both go through Trade.Price.Silver/Favor
        so non-English currencies can pick a different symbol/order.
      - "favor" / "silver" appear as standalone nouns inside other
        sentences (balance, currency holdings) - separate keys.
      - Item announcements compose smaller sentence fragments joined by
        "{0}." in C#; each fragment is a key so the join character can
        be changed per language.

    Shared phrases delegated elsewhere:
      - Search.Cleared / Search.NoMatches / Position / Edge -> Common.xml
      - InfoCard / Map.JumpedTo                              -> Common.xml
      - "Cannot adjust" reasons share a single Trade.Reject.* key set
        rather than 4 separate strings.
  -->

  <!-- =================================================================
       Trade dialog lifecycle (TradeNavigationState.Open / Close /
       AcceptTrade / cancel paths).
       Open: {0} = trader name, {1} = trader kind label.
       ================================================================= -->
  <RimWorldAccess.Trade.Open.Heading>Comerciando con {0} ({1}). Alt+B para el saldo, Alt+A para aceptar.</RimWorldAccess.Trade.Open.Heading>
  <RimWorldAccess.Trade.Open.UnknownTrader>Comerciante desconocido</RimWorldAccess.Trade.Open.UnknownTrader>
  <RimWorldAccess.Trade.Open.TraderKindFallback>comerciante</RimWorldAccess.Trade.Open.TraderKindFallback>
  <RimWorldAccess.Trade.Open.NoDialog>No hay diálogo de comercio</RimWorldAccess.Trade.Open.NoDialog>
  <RimWorldAccess.Trade.Open.NoSession>No hay sesión de comercio activa</RimWorldAccess.Trade.Open.NoSession>
  <RimWorldAccess.Trade.Open.SessionNotInitialized>La sesión de comercio no se inicializó correctamente</RimWorldAccess.Trade.Open.SessionNotInitialized>
  <RimWorldAccess.Trade.Cancelled>Comercio cancelado</RimWorldAccess.Trade.Cancelled>
  <RimWorldAccess.Trade.NoItemsInCategory>No hay objetos en esta categoría</RimWorldAccess.Trade.NoItemsInCategory>

  <!-- =================================================================
       Tab / category names.
       TraderItems is composed: "{0}'s Items" with {0} = trader name.
       Tab.Empty: {0} = category name, used when the tab has 0 items.
       Tab.SwitchedTo composes the category name with a currency
       suffix: {0} = category name, {1} = currency phrase
       (Trade.Currency.YouHave / TraderHas).
       ================================================================= -->
  <RimWorldAccess.Trade.Tab.YourItems>Tus objetos</RimWorldAccess.Trade.Tab.YourItems>
  <RimWorldAccess.Trade.Tab.TraderItems>Objetos de {0}</RimWorldAccess.Trade.Tab.TraderItems>
  <RimWorldAccess.Trade.Tab.TradeSummary>Resumen del comercio</RimWorldAccess.Trade.Tab.TradeSummary>
  <RimWorldAccess.Trade.Tab.Unknown>Desconocido</RimWorldAccess.Trade.Tab.Unknown>
  <RimWorldAccess.Trade.Tab.Empty>{0} - Sin objetos</RimWorldAccess.Trade.Tab.Empty>
  <RimWorldAccess.Trade.Tab.SwitchedReturning>Resumen del comercio vacío. Volviendo a {0}</RimWorldAccess.Trade.Tab.SwitchedReturning>

  <!-- Currency holdings phrasing (Alt+B and tab-switch suffix).
       YouHave / TraderHas: {0} = formatted currency string. -->
  <RimWorldAccess.Trade.Currency.YouHave>Tienes {0}</RimWorldAccess.Trade.Currency.YouHave>
  <RimWorldAccess.Trade.Currency.TraderHas>El comerciante tiene {0}</RimWorldAccess.Trade.Currency.TraderHas>
  <RimWorldAccess.Trade.Currency.Both>Tienes {0}. El comerciante tiene {1}</RimWorldAccess.Trade.Currency.Both>
  <RimWorldAccess.Trade.Currency.None>No hay moneda disponible</RimWorldAccess.Trade.Currency.None>
  <!-- Bare nouns used inside larger sentences ("X silver", "X favor"). -->
  <RimWorldAccess.Trade.Currency.SilverNoun>plata</RimWorldAccess.Trade.Currency.SilverNoun>
  <RimWorldAccess.Trade.Currency.FavorNoun>favor</RimWorldAccess.Trade.Currency.FavorNoun>
  <!-- Favor count format: {0} = integer count of favor.
       Silver uses RimWorld's float.ToStringMoney() ("$N"); we leave
       that to the game. -->
  <RimWorldAccess.Trade.Currency.FavorCount>{0} de favor</RimWorldAccess.Trade.Currency.FavorCount>

  <!-- Price formatting (FormatPrice). Silver matches ToStringMoney's
       "$N" prefix; Favor: "{0} favor". {0} = formatted number. -->
  <RimWorldAccess.Trade.Price.Silver>${0}</RimWorldAccess.Trade.Price.Silver>
  <RimWorldAccess.Trade.Price.Favor>{0} de favor</RimWorldAccess.Trade.Price.Favor>

  <!-- =================================================================
       Quantity-adjust feedback (single-step Up/Down arrow).
       AnnounceQuantityChange composes:
         {label}: No trade  (when transfer hits zero)
         {action} {count} {label}, value {price}
       Buying/Selling/Gifting are split into action-specific keys so
       each sentence shape can vary per language.
       ================================================================= -->
  <RimWorldAccess.Trade.Adjust.NoTrade>{0}: sin intercambio</RimWorldAccess.Trade.Adjust.NoTrade>
  <RimWorldAccess.Trade.Adjust.Buying>Comprando {0} {1}, valor {2}</RimWorldAccess.Trade.Adjust.Buying>
  <RimWorldAccess.Trade.Adjust.Selling>Vendiendo {0} {1}, valor {2}</RimWorldAccess.Trade.Adjust.Selling>
  <RimWorldAccess.Trade.Adjust.Gifting>Regalando {0} {1}, valor {2}</RimWorldAccess.Trade.Adjust.Gifting>

  <!-- Max-action announcements (Home/End set to extreme).
       Reset: {0} = item label.
       Buying/Selling/Gifting: {0} = count, {1} = item label,
                                {2} = formatted price. -->
  <RimWorldAccess.Trade.Max.Reset>{0} restablecido a nada</RimWorldAccess.Trade.Max.Reset>
  <RimWorldAccess.Trade.Max.Buying>Comprando todo: {0} {1}, {2}</RimWorldAccess.Trade.Max.Buying>
  <RimWorldAccess.Trade.Max.Selling>Vendiendo todo: {0} {1}, {2}</RimWorldAccess.Trade.Max.Selling>
  <RimWorldAccess.Trade.Max.Gifting>Regalando todo: {0} {1}, {2}</RimWorldAccess.Trade.Max.Gifting>

  <!-- Reset action (Alt+R). {0} = item label. -->
  <RimWorldAccess.Trade.Reset.SingleItem>Restablecer {0}</RimWorldAccess.Trade.Reset.SingleItem>
  <RimWorldAccess.Trade.Reset.AllTrades>Todos los intercambios restablecidos</RimWorldAccess.Trade.Reset.AllTrades>
  <RimWorldAccess.Trade.Reset.CannotResetBalance>No se puede restablecer la entrada de saldo</RimWorldAccess.Trade.Reset.CannotResetBalance>

  <!-- =================================================================
       Pending-trade announcement on the list view.
       Pending.WithCount: {0} = action verb word, {1} = count.
       Pending.PriceLine: {0} = "Total"/"Value", {1} = formatted price.
       Each action ("Buying"/"Selling"/"Gifting") is a separate key so
       it can flex with grammatical case in non-English. -->
  <RimWorldAccess.Trade.Pending.ActionBuying>Comprando</RimWorldAccess.Trade.Pending.ActionBuying>
  <RimWorldAccess.Trade.Pending.ActionSelling>Vendiendo</RimWorldAccess.Trade.Pending.ActionSelling>
  <RimWorldAccess.Trade.Pending.ActionGifting>Regalando</RimWorldAccess.Trade.Pending.ActionGifting>
  <RimWorldAccess.Trade.Pending.ActionWithCount>{0} {1}</RimWorldAccess.Trade.Pending.ActionWithCount>
  <RimWorldAccess.Trade.Pending.PriceLabelTotal>Total</RimWorldAccess.Trade.Pending.PriceLabelTotal>
  <RimWorldAccess.Trade.Pending.PriceLabelValue>Valor</RimWorldAccess.Trade.Pending.PriceLabelValue>
  <RimWorldAccess.Trade.Pending.PriceLine>{0}: {1}</RimWorldAccess.Trade.Pending.PriceLine>

  <!-- =================================================================
       Item announcement composition for the inventory tabs.
       *.SoloAvailable: only one party has the item; {0} = count.
       *.SoloPrice: bare price line, {0} = formatted price.
       *.SoloPriceWithQuality: with price-quality suffix; {0} = price,
                              {1} = quality phrase.
       *.NotTradeable: trader will not trade this item.
       *.YoursAt / TheirsAt: shared item; {0} = count, {1} = price.
       *.YoursAtWithQuality / TheirsAtWithQuality: same plus quality;
                              {0} = count, {1} = price, {2} = quality.
       *.YoursOnly / TheirsOnly: shared but trader won't trade;
                              {0} = count.
       ================================================================= -->
  <RimWorldAccess.Trade.Item.SoloAvailable>{0} disponibles</RimWorldAccess.Trade.Item.SoloAvailable>
  <RimWorldAccess.Trade.Item.SoloPrice>{0}</RimWorldAccess.Trade.Item.SoloPrice>
  <RimWorldAccess.Trade.Item.SoloPriceWithQuality>{0}, {1}</RimWorldAccess.Trade.Item.SoloPriceWithQuality>
  <RimWorldAccess.Trade.Item.NotTradeable>No comerciable</RimWorldAccess.Trade.Item.NotTradeable>
  <RimWorldAccess.Trade.Item.YoursAt>Tuyo: {0} a {1}</RimWorldAccess.Trade.Item.YoursAt>
  <RimWorldAccess.Trade.Item.TheirsAt>Suyo: {0} a {1}</RimWorldAccess.Trade.Item.TheirsAt>
  <RimWorldAccess.Trade.Item.YoursAtWithQuality>Tuyo: {0} a {1} ({2})</RimWorldAccess.Trade.Item.YoursAtWithQuality>
  <RimWorldAccess.Trade.Item.TheirsAtWithQuality>Suyo: {0} a {1} ({2})</RimWorldAccess.Trade.Item.TheirsAtWithQuality>
  <RimWorldAccess.Trade.Item.YoursOnly>Tuyo: {0}</RimWorldAccess.Trade.Item.YoursOnly>
  <RimWorldAccess.Trade.Item.TheirsOnly>Suyo: {0}</RimWorldAccess.Trade.Item.TheirsOnly>

  <!-- Price quality words (GetPriceQuality). Buying = lower=better,
       Selling = higher=better; the four PriceType buckets get separate
       words for each direction. -->
  <RimWorldAccess.Trade.Quality.Buy.VeryCheap>gran oferta</RimWorldAccess.Trade.Quality.Buy.VeryCheap>
  <RimWorldAccess.Trade.Quality.Buy.Cheap>buena oferta</RimWorldAccess.Trade.Quality.Buy.Cheap>
  <RimWorldAccess.Trade.Quality.Buy.Expensive>caro</RimWorldAccess.Trade.Quality.Buy.Expensive>
  <RimWorldAccess.Trade.Quality.Buy.Exorbitant>muy caro</RimWorldAccess.Trade.Quality.Buy.Exorbitant>
  <RimWorldAccess.Trade.Quality.Sell.VeryCheap>oferta baja</RimWorldAccess.Trade.Quality.Sell.VeryCheap>
  <RimWorldAccess.Trade.Quality.Sell.Cheap>oferta pobre</RimWorldAccess.Trade.Quality.Sell.Cheap>
  <RimWorldAccess.Trade.Quality.Sell.Expensive>buena oferta</RimWorldAccess.Trade.Quality.Sell.Expensive>
  <RimWorldAccess.Trade.Quality.Sell.Exorbitant>excelente oferta</RimWorldAccess.Trade.Quality.Sell.Exorbitant>

  <!-- =================================================================
       Quantity adjustment mode.
       Mode.Adjusting is the constant marker word; {0} = upper bound.
       Each context (gift, shared, sell-only, buy-only) is a separate
       sentence so word order can vary. -->
  <RimWorldAccess.Trade.Mode.Adjusting>Ajustando</RimWorldAccess.Trade.Mode.Adjusting>
  <RimWorldAccess.Trade.Mode.GiftUpTo>Regalar hasta {0}</RimWorldAccess.Trade.Mode.GiftUpTo>
  <RimWorldAccess.Trade.Mode.SellUpTo>Vender hasta {0}</RimWorldAccess.Trade.Mode.SellUpTo>
  <RimWorldAccess.Trade.Mode.BuyUpTo>Comprar hasta {0}</RimWorldAccess.Trade.Mode.BuyUpTo>
  <RimWorldAccess.Trade.Mode.SellAndBuy>Vender hasta {0}, comprar hasta {1}</RimWorldAccess.Trade.Mode.SellAndBuy>
  <RimWorldAccess.Trade.Mode.ExitFirst>Sal primero del modo de cantidad</RimWorldAccess.Trade.Mode.ExitFirst>
  <RimWorldAccess.Trade.Mode.ExitFirstHint>Sal primero del modo de cantidad (presiona Enter o Escape)</RimWorldAccess.Trade.Mode.ExitFirstHint>

  <!-- =================================================================
       Reject / error paths.
       ================================================================= -->
  <RimWorldAccess.Trade.Reject.CannotAdjustItem>No se puede ajustar la cantidad de este objeto</RimWorldAccess.Trade.Reject.CannotAdjustItem>
  <RimWorldAccess.Trade.Reject.WillNotTrade>El comerciante no comerciará este objeto</RimWorldAccess.Trade.Reject.WillNotTrade>
  <RimWorldAccess.Trade.Reject.CannotAdjustAmount>No se puede ajustar a esta cantidad</RimWorldAccess.Trade.Reject.CannotAdjustAmount>
  <RimWorldAccess.Trade.Reject.CannotAdjustMax>No se puede ajustar al máximo</RimWorldAccess.Trade.Reject.CannotAdjustMax>
  <RimWorldAccess.Trade.Reject.CannotAdjustMin>No se puede ajustar al mínimo</RimWorldAccess.Trade.Reject.CannotAdjustMin>
  <RimWorldAccess.Trade.Reject.CannotInspect>No se puede inspeccionar este objeto</RimWorldAccess.Trade.Reject.CannotInspect>

  <!-- =================================================================
       Numeric input mode (digit/sign keys in quantity mode).
       Numeric.PromptSelling / Buying / Gifting are spoken when the
       user presses a sign key with an empty buffer.
       Numeric.Typing: {0} = current numeric buffer string.
       Numeric.Cleared / Numeric.Invalid mark transitional states. -->
  <RimWorldAccess.Trade.Numeric.PromptSelling>Vendiendo. Escribe la cantidad.</RimWorldAccess.Trade.Numeric.PromptSelling>
  <RimWorldAccess.Trade.Numeric.PromptBuying>Comprando. Escribe la cantidad.</RimWorldAccess.Trade.Numeric.PromptBuying>
  <RimWorldAccess.Trade.Numeric.PromptGifting>Regalando. Escribe la cantidad.</RimWorldAccess.Trade.Numeric.PromptGifting>
  <RimWorldAccess.Trade.Numeric.Typing>Escribiendo: {0}</RimWorldAccess.Trade.Numeric.Typing>
  <RimWorldAccess.Trade.Numeric.Cleared>Borrado</RimWorldAccess.Trade.Numeric.Cleared>
  <RimWorldAccess.Trade.Numeric.Invalid>No válido: {0}</RimWorldAccess.Trade.Numeric.Invalid>
  <!-- After a numeric edit, the announcement is composed from one of
       the *.Body keys plus the *.Suffix key.
       NoTradeBody: {0} = item label.
       BuyingBody / SellingBody / GiftingBody: {0} = action verb,
       {1} = count, {2} = item label.
       BuyingBodyWithPrice / SellingBodyWithPrice: same plus
       {3} = formatted price. Suffix: {0} = current buffer. -->
  <RimWorldAccess.Trade.Numeric.NoTradeBody>{0}: sin intercambio</RimWorldAccess.Trade.Numeric.NoTradeBody>
  <RimWorldAccess.Trade.Numeric.GiftingBody>{0} {1} {2}</RimWorldAccess.Trade.Numeric.GiftingBody>
  <RimWorldAccess.Trade.Numeric.BuyingSellingBody>{0} {1} {2} por {3}</RimWorldAccess.Trade.Numeric.BuyingSellingBody>
  <RimWorldAccess.Trade.Numeric.Suffix>. Escribiendo: {0}</RimWorldAccess.Trade.Numeric.Suffix>

  <!-- =================================================================
       Gift mode toggle and gift confirmation paths.
       ================================================================= -->
  <RimWorldAccess.Trade.Gift.CannotGiftTrader>No se puede regalar a este comerciante</RimWorldAccess.Trade.Gift.CannotGiftTrader>
  <RimWorldAccess.Trade.Gift.CannotGiftHostile>No se puede regalar a una facción hostil</RimWorldAccess.Trade.Gift.CannotGiftHostile>
  <RimWorldAccess.Trade.Gift.CannotGiftFavor>No se puede regalar al comerciar por favor real</RimWorldAccess.Trade.Gift.CannotGiftFavor>
  <RimWorldAccess.Trade.Gift.ModeGift>modo regalo</RimWorldAccess.Trade.Gift.ModeGift>
  <RimWorldAccess.Trade.Gift.ModeTrade>modo comercio</RimWorldAccess.Trade.Gift.ModeTrade>
  <RimWorldAccess.Trade.Gift.SwitchedTo>Cambiado a {0}</RimWorldAccess.Trade.Gift.SwitchedTo>
  <RimWorldAccess.Trade.Gift.NoSession>No hay sesión de regalo activa</RimWorldAccess.Trade.Gift.NoSession>
  <RimWorldAccess.Trade.Gift.NoGifts>No hay regalos que ofrecer</RimWorldAccess.Trade.Gift.NoGifts>
  <RimWorldAccess.Trade.Gift.ErrorCalculating>Error al calcular el valor del regalo</RimWorldAccess.Trade.Gift.ErrorCalculating>
  <RimWorldAccess.Trade.Gift.ErrorOffering>Error al ofrecer los regalos</RimWorldAccess.Trade.Gift.ErrorOffering>
  <!-- Gift completion: {0} = goodwill change (positive integer). -->
  <RimWorldAccess.Trade.Gift.Offered>Regalos ofrecidos, buena voluntad +{0}</RimWorldAccess.Trade.Gift.Offered>

  <!-- =================================================================
       Accept-trade path.
       ================================================================= -->
  <RimWorldAccess.Trade.Accept.NoDeal>No hay intercambio que realizar</RimWorldAccess.Trade.Accept.NoDeal>
  <RimWorldAccess.Trade.Accept.WarnTraderShortFunds>Advertencia: el comerciante no tiene suficiente plata. Confirma para continuar de todos modos.</RimWorldAccess.Trade.Accept.WarnTraderShortFunds>
  <!-- {0} = AcceptanceReport.Reason. -->
  <RimWorldAccess.Trade.Accept.CannotComplete>No se puede completar el intercambio: {0}</RimWorldAccess.Trade.Accept.CannotComplete>
  <RimWorldAccess.Trade.Accept.Completed>Intercambio completado con éxito</RimWorldAccess.Trade.Accept.Completed>
  <RimWorldAccess.Trade.Accept.NoItemsToTrade>No hay objetos que intercambiar</RimWorldAccess.Trade.Accept.NoItemsToTrade>

  <!-- =================================================================
       Balance entry (last row of Trade Summary tab).
       Net balance gets one key per direction (Spending / Receiving /
       Balanced); the currency noun is supplied as {1}, count as {0}.
       In gift mode the row is the goodwill delta; if no faction info
       is available, GiftBalanceFallback is spoken.
       Position suffix is appended in C# via PositionSuffix. -->
  <RimWorldAccess.Trade.Balance.Spending>Saldo neto: gastando {0} de {1}</RimWorldAccess.Trade.Balance.Spending>
  <RimWorldAccess.Trade.Balance.Receiving>Saldo neto: recibiendo {0} de {1}</RimWorldAccess.Trade.Balance.Receiving>
  <RimWorldAccess.Trade.Balance.Balanced>Saldo neto: intercambio equilibrado</RimWorldAccess.Trade.Balance.Balanced>
  <RimWorldAccess.Trade.Balance.Goodwill>Buena voluntad +{0}</RimWorldAccess.Trade.Balance.Goodwill>
  <RimWorldAccess.Trade.Balance.GiftFallback>Saldo del modo regalo</RimWorldAccess.Trade.Balance.GiftFallback>
  <!-- Position suffix appended after the balance text; {0} = body,
       {1} = position phrase. -->
  <RimWorldAccess.Trade.Balance.WithPosition>{0}. {1}</RimWorldAccess.Trade.Balance.WithPosition>

  <!-- =================================================================
       Detailed announcement (Tab key for full inventory + price).
       Each line is a separate key so commas/colons can localize.
       *.PriceLine: {0} = price (caller pre-formats with one decimal),
                    {1} = currency noun. -->
  <RimWorldAccess.Trade.Detail.YouHave>Tienes: {0}</RimWorldAccess.Trade.Detail.YouHave>
  <RimWorldAccess.Trade.Detail.TraderHas>El comerciante tiene: {0}</RimWorldAccess.Trade.Detail.TraderHas>
  <RimWorldAccess.Trade.Detail.SellPrice>Precio de venta: {0} de {1} cada uno</RimWorldAccess.Trade.Detail.SellPrice>
  <RimWorldAccess.Trade.Detail.BuyPrice>Precio de compra: {0} de {1} cada uno</RimWorldAccess.Trade.Detail.BuyPrice>
  <!-- {0} = action word ("Buying"/"Selling"), {1} = count,
       {2} = total cost (caller F0-formatted), {3} = currency noun. -->
  <RimWorldAccess.Trade.Detail.CurrentTrade>Intercambio actual: {0} {1} por {2} de {3}</RimWorldAccess.Trade.Detail.CurrentTrade>

  <!-- Price-breakdown popup (Tab in trader/colony list).
       PriceTitleBuy / Sell: {0} = clean item label. -->
  <RimWorldAccess.Trade.Detail.PriceTitleBuy>Precio de compra: {0}</RimWorldAccess.Trade.Detail.PriceTitleBuy>
  <RimWorldAccess.Trade.Detail.PriceTitleSell>Precio de venta: {0}</RimWorldAccess.Trade.Detail.PriceTitleSell>
  <RimWorldAccess.Trade.Detail.NotInGiftMode>El desglose de precios no está disponible en el modo regalo</RimWorldAccess.Trade.Detail.NotInGiftMode>
  <RimWorldAccess.Trade.Detail.NoPriceInfo>No hay información de precios disponible</RimWorldAccess.Trade.Detail.NoPriceInfo>

  <!-- =================================================================
       Sellable items dialog (SellableItemsState).
       Dialog_SellableItems is a separate, simpler read-only browser.
       ================================================================= -->
  <RimWorldAccess.Sellable.Open.NoDialog>No hay diálogo</RimWorldAccess.Sellable.Open.NoDialog>
  <RimWorldAccess.Sellable.Open.Closed>Cerrado</RimWorldAccess.Sellable.Open.Closed>
  <RimWorldAccess.Sellable.Open.Controls>Cambiar pestañas: izquierda, derecha. Navegar: arriba, abajo.</RimWorldAccess.Sellable.Open.Controls>
  <RimWorldAccess.Sellable.Open.TraderFallback>Comerciante</RimWorldAccess.Sellable.Open.TraderFallback>
