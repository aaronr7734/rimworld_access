<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- HospitalityGuestTabAdapter: Hospitality's Guest inspect tab. Labels and tooltips are the
       mod's own keys; these cover only what the mod draws without a string of its own. -->
  <RimWorldAccess.Compat.Hospitality.GuestTabName>Huésped</RimWorldAccess.Compat.Hospitality.GuestTabName>
  <!-- A progress bar: {0} = the label drawn beside it, {1} = how full the bar is, as a percent. -->
  <RimWorldAccess.Compat.Hospitality.BarLine>{0} {1}</RimWorldAccess.Compat.Hospitality.BarLine>
  <RimWorldAccess.Compat.Hospitality.DefaultsApplied>Aplicado a todos los visitantes actuales y futuros.</RimWorldAccess.Compat.Hospitality.DefaultsApplied>
  <RimWorldAccess.Compat.Hospitality.ActionFailed>La acción falló.</RimWorldAccess.Compat.Hospitality.ActionFailed>
  <!-- HospitalitySocialBarsExtender: the coloured bars Hospitality paints behind colonist rows on a guest's Social tab.
       {0} = colonist, {1} = the guest's opinion of them, {2} = how full the bar is. -->
  <RimWorldAccess.Compat.Hospitality.FriendshipBars>Amistades de reclutamiento</RimWorldAccess.Compat.Hospitality.FriendshipBars>
  <RimWorldAccess.Compat.Hospitality.FriendBar>{0}: opinión {1}, amistad {2}</RimWorldAccess.Compat.Hospitality.FriendBar>
  <RimWorldAccess.Compat.Hospitality.EnemyBar>{0}: opinión {1}, rivalidad {2}</RimWorldAccess.Compat.Hospitality.EnemyBar>
  <RimWorldAccess.Compat.Hospitality.NoFriendshipBars>Aún no hay opiniones de colonos.</RimWorldAccess.Compat.Hospitality.NoFriendshipBars>

  <!-- GastronomyRestaurantTabAdapter: Gastronomy's Dining tab on a cash register. -->
  <RimWorldAccess.Compat.Gastronomy.TabName>Comedor</RimWorldAccess.Compat.Gastronomy.TabName>
  <RimWorldAccess.Compat.Gastronomy.RestaurantPicker>Restaurante</RimWorldAccess.Compat.Gastronomy.RestaurantPicker>
  <RimWorldAccess.Compat.Gastronomy.RestaurantAdded>{0} agregado.</RimWorldAccess.Compat.Gastronomy.RestaurantAdded>
  <!-- One stocked meal: {0} = count, {1} = meal name, {2} = price. -->
  <RimWorldAccess.Compat.Gastronomy.StockEntry>{0}x {1} ({2})</RimWorldAccess.Compat.Gastronomy.StockEntry>
  <RimWorldAccess.Compat.Gastronomy.NoDebts>No hay cuentas sin pagar.</RimWorldAccess.Compat.Gastronomy.NoDebts>
  <RimWorldAccess.Compat.Gastronomy.DebtCleared>Cuenta saldada.</RimWorldAccess.Compat.Gastronomy.DebtCleared>
  <RimWorldAccess.Compat.Gastronomy.MenuFilter>Menú</RimWorldAccess.Compat.Gastronomy.MenuFilter>

  <!-- StorefrontStoreTabAdapter: Hospitality: Storefront's Shop tab on a cash register. -->
  <RimWorldAccess.Compat.Storefront.TabName>Tienda</RimWorldAccess.Compat.Storefront.TabName>
  <!-- One stocked item: {0} = count, {1} = item name. -->
  <RimWorldAccess.Compat.Storefront.StockEntry>{0}x {1}</RimWorldAccess.Compat.Storefront.StockEntry>
  <RimWorldAccess.Compat.Storefront.StockLine>Existencias: {0}</RimWorldAccess.Compat.Storefront.StockLine>
  <RimWorldAccess.Compat.Storefront.NoStock>Existencias: ninguna.</RimWorldAccess.Compat.Storefront.NoStock>
  <RimWorldAccess.Compat.Storefront.StoreFilter>Artículos en venta</RimWorldAccess.Compat.Storefront.StoreFilter>
</LanguageData>
