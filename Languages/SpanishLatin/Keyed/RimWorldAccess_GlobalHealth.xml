<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- Health overview screen (src/Shell/Screens/GlobalHealthScope.Game.cs). -->
  <RimWorldAccess.GlobalHealth.Title>Resumen de salud</RimWorldAccess.GlobalHealth.Title>
  <RimWorldAccess.GlobalHealth.RegionName>Personajes</RimWorldAccess.GlobalHealth.RegionName>
  <RimWorldAccess.GlobalHealth.Node.DownedBleeding>Derribados y sangrando</RimWorldAccess.GlobalHealth.Node.DownedBleeding>
  <RimWorldAccess.GlobalHealth.Node.Downed>Derribados</RimWorldAccess.GlobalHealth.Node.Downed>
  <RimWorldAccess.GlobalHealth.Node.Bleeding>Sangrando</RimWorldAccess.GlobalHealth.Node.Bleeding>
  <RimWorldAccess.GlobalHealth.Node.Injured>Heridos</RimWorldAccess.GlobalHealth.Node.Injured>
  <!-- Node summaries. {0} = the node's name (one of the Node strings above), {1} = how many pawns it holds, then {2} (or {1} in the One forms) = the soonest time left before bleeding out ("2 hours") or the lowest overall health ("38%"). NotSoon is used when no one in the node bleeds out within a day. -->
  <RimWorldAccess.GlobalHealth.Summary.None>{0}. Ninguno</RimWorldAccess.GlobalHealth.Summary.None>
  <RimWorldAccess.GlobalHealth.Summary.BleedOut>{0}. {1} personajes, el primero se desangra en {2}</RimWorldAccess.GlobalHealth.Summary.BleedOut>
  <RimWorldAccess.GlobalHealth.Summary.BleedOutOne>{0}. 1 personaje, se desangra en {1}</RimWorldAccess.GlobalHealth.Summary.BleedOutOne>
  <RimWorldAccess.GlobalHealth.Summary.NotSoon>{0}. {1} personajes, ninguno en peligro inmediato</RimWorldAccess.GlobalHealth.Summary.NotSoon>
  <RimWorldAccess.GlobalHealth.Summary.NotSoonOne>{0}. 1 personaje, sin peligro inmediato</RimWorldAccess.GlobalHealth.Summary.NotSoonOne>
  <RimWorldAccess.GlobalHealth.Summary.LowestHealth>{0}. {1} personajes, salud mínima {2}</RimWorldAccess.GlobalHealth.Summary.LowestHealth>
  <RimWorldAccess.GlobalHealth.Summary.HealthOne>{0}. 1 personaje, salud {1}</RimWorldAccess.GlobalHealth.Summary.HealthOne>
  <!-- {0} = the pawn's name with its group (one of the PawnGroup strings below), {1} = its health tag (one of the PawnHealth.Tag strings below). -->
  <RimWorldAccess.GlobalHealth.PawnRow>{0}. {1}</RimWorldAccess.GlobalHealth.PawnRow>
  <!-- After a filter checkbox is toggled. {0} = the checkbox's new state ("checked"), {1} = how many pawns are now listed. -->
  <RimWorldAccess.GlobalHealth.FilterChanged>{0}. {1} personajes en la lista.</RimWorldAccess.GlobalHealth.FilterChanged>
  <RimWorldAccess.GlobalHealth.FilterChangedOne>{0}. 1 personaje en la lista.</RimWorldAccess.GlobalHealth.FilterChangedOne>
  <RimWorldAccess.GlobalHealth.JumpUnavailable>No se puede localizar al personaje.</RimWorldAccess.GlobalHealth.JumpUnavailable>
  <!-- Pawn health tags, spoken on health overview rows and after scanner pawns. {0} = overall health ("45%"), {1} = time left before bleeding out ("2 hours"). The bleeding words mirror the vanilla health tab: "no immediate danger" past a day, "deathless" for the Biotech gene. -->
  <RimWorldAccess.PawnHealth.Tag.Health>salud {0}</RimWorldAccess.PawnHealth.Tag.Health>
  <RimWorldAccess.PawnHealth.Tag.Downed>derribado, salud {0}</RimWorldAccess.PawnHealth.Tag.Downed>
  <RimWorldAccess.PawnHealth.Tag.Bleeding>se desangra en {1}, salud {0}</RimWorldAccess.PawnHealth.Tag.Bleeding>
  <RimWorldAccess.PawnHealth.Tag.DownedBleeding>derribado, se desangra en {1}, salud {0}</RimWorldAccess.PawnHealth.Tag.DownedBleeding>
  <RimWorldAccess.PawnHealth.Tag.BleedingNotSoon>sangrando, sin peligro inmediato, salud {0}</RimWorldAccess.PawnHealth.Tag.BleedingNotSoon>
  <RimWorldAccess.PawnHealth.Tag.DownedBleedingNotSoon>derribado, sangrando, sin peligro inmediato, salud {0}</RimWorldAccess.PawnHealth.Tag.DownedBleedingNotSoon>
  <RimWorldAccess.PawnHealth.Tag.BleedingDeathless>sangrando, inmortal, salud {0}</RimWorldAccess.PawnHealth.Tag.BleedingDeathless>
  <RimWorldAccess.PawnHealth.Tag.DownedBleedingDeathless>derribado, sangrando, inmortal, salud {0}</RimWorldAccess.PawnHealth.Tag.DownedBleedingDeathless>
  <!-- Pawn group tags, shared by the health overview and the gear menu. {0} = the pawn's short name. Wild is a pawn with no faction, like a wild man. -->
  <RimWorldAccess.PawnGroup.Colonist>{0}, colono</RimWorldAccess.PawnGroup.Colonist>
  <RimWorldAccess.PawnGroup.ColonyMech>{0}, mecanoide de la colonia</RimWorldAccess.PawnGroup.ColonyMech>
  <RimWorldAccess.PawnGroup.ColonyAnimal>{0}, animal de la colonia</RimWorldAccess.PawnGroup.ColonyAnimal>
  <RimWorldAccess.PawnGroup.Slave>{0}, esclavo</RimWorldAccess.PawnGroup.Slave>
  <RimWorldAccess.PawnGroup.Prisoner>{0}, prisionero</RimWorldAccess.PawnGroup.Prisoner>
  <RimWorldAccess.PawnGroup.Visitor>{0}, visitante</RimWorldAccess.PawnGroup.Visitor>
  <RimWorldAccess.PawnGroup.Wild>{0}, salvaje</RimWorldAccess.PawnGroup.Wild>
  <RimWorldAccess.PawnGroup.Hostile>{0}, hostil</RimWorldAccess.PawnGroup.Hostile>
  <!-- The group filter checkboxes in the health overview and the gear menu. Visitors also covers pawns with no faction. -->
  <RimWorldAccess.PawnGroup.FiltersRegion>Filtros</RimWorldAccess.PawnGroup.FiltersRegion>
  <RimWorldAccess.PawnGroup.Filter.Colonists>Colonos</RimWorldAccess.PawnGroup.Filter.Colonists>
