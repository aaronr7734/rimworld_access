<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Rituals module strings (src/Rituals/). Four files contribute:
      - RitualPatch.cs           (dialog-lifecycle Harmony patches, on-screen indicator)
      - RitualState.cs           (three-mode navigation: RoleList, PawnSelection, QualityStats)
      - RitualStatFormatter.cs   (role / pawn / quality announcement composition)
      - RitualTreeBuilder.cs     (role-list, pawn-list, and quality-factor construction)

    This is Ideology-DLC ritual-setup content (Dialog_BeginRitual). Ritual
    names, role names, outcome labels, pawn names, and quality-factor labels
    are data from the game and flow through as placeholders.

    Gravship-launch checkbox strings (forceVisitorsToLeave, boardColonyAnimals,
    boardColonyMechs) are sourced from the Gravships module and localized in
    RimWorldAccess_Gravships.xml — they are NOT duplicated here. The Rituals
    module reads those labels/tooltips via their translation keys.

    Guard-style messages ("Search cleared") delegate to the shared Common keys.

    One/Many splits exist for English subject-verb agreement (role/roles,
    candidate/candidates) — translators can collapse or split further.
  -->

  <!-- Dialog lifecycle (RitualPatch.cs). -->
  <RimWorldAccess.Rituals.Dialog.KeyboardModeIndicator>Клавиатурный режим включён</RimWorldAccess.Rituals.Dialog.KeyboardModeIndicator>

  <!-- Opening announcement (RitualState.Open).
       Begin: {0} = ritual name (e.g., "Wedding", "Funeral").
       Warning: {0} = blocking-issue text joined with periods.
       RoleCount One/Many: {0} = role count. English splits singular "role"
       from plural "roles".
       OpenInstructions: one-time instruction line appended to the opener. -->
  <RimWorldAccess.Rituals.Open.Begin>Начать: {0}.</RimWorldAccess.Rituals.Open.Begin>
  <RimWorldAccess.Rituals.Open.Warning>Внимание: {0}</RimWorldAccess.Rituals.Open.Warning>
  <RimWorldAccess.Rituals.Open.RoleCountOne>{0} роль.</RimWorldAccess.Rituals.Open.RoleCountOne>
  <RimWorldAccess.Rituals.Open.RoleCountMany>{0_numCase ? роль : роли : ролей}.</RimWorldAccess.Rituals.Open.RoleCountMany>
  <RimWorldAccess.Rituals.Open.Instructions>Вверх и вниз для навигации, Enter для назначения персонажей, Tab для статистики качества, Alt+S для начала.</RimWorldAccess.Rituals.Open.Instructions>

  <!-- Expected-quality summary, used both at dialog-open and in the quality
       stats list (RitualState.GetExpectedQualitySummary,
       RitualStatFormatter.FormatQualitySummary).
       Single: {0} = single percentage (min == max).
       Range:  {0} = min percentage, {1} = max percentage. -->

  <!-- Role announcement composition (RitualStatFormatter.FormatRoleAnnouncement).
       The role/spectator label is emitted first, followed by one of the count
       clauses below, followed by optional Required/Locked suffixes.
       AssignedOfMax: {0} = assigned count, {1} = max count.
       AssignedOptional: {0} = assigned count (role has maxCount == 0).
       AssignedUnlimited: {0} = assigned count (role has maxCount == -1). -->
  <RimWorldAccess.Rituals.Role.AssignedOfMax>назначено {0} из {1}</RimWorldAccess.Rituals.Role.AssignedOfMax>
  <RimWorldAccess.Rituals.Role.AssignedOptional>назначено {0}, по желанию</RimWorldAccess.Rituals.Role.AssignedOptional>
  <RimWorldAccess.Rituals.Role.AssignedUnlimited>назначено {0}</RimWorldAccess.Rituals.Role.AssignedUnlimited>
  <RimWorldAccess.Rituals.Role.Required>, обязательно</RimWorldAccess.Rituals.Role.Required>
  <RimWorldAccess.Rituals.Role.Locked>, заблокировано</RimWorldAccess.Rituals.Role.Locked>

  <!-- Gravship checkbox state words (RitualStatFormatter.FormatCheckboxAnnouncement,
       RitualState.ToggleGravshipCheckbox). The checkbox LABEL and TOOLTIP
       themselves are sourced from RimWorldAccess_Gravships.xml. -->
  <RimWorldAccess.Rituals.Checkbox.Checked>отмечено</RimWorldAccess.Rituals.Checkbox.Checked>
  <RimWorldAccess.Rituals.Checkbox.Unchecked>не отмечено</RimWorldAccess.Rituals.Checkbox.Unchecked>
  <RimWorldAccess.Rituals.Checkbox.Toggled>{0}: {1}.</RimWorldAccess.Rituals.Checkbox.Toggled>

  <!-- Pawn announcement fragments (RitualStatFormatter.FormatPawnAnnouncement). -->
  <RimWorldAccess.Rituals.Pawn.ForcedCannotChange>принудительно, нельзя изменить</RimWorldAccess.Rituals.Pawn.ForcedCannotChange>
  <RimWorldAccess.Rituals.Pawn.Selected>Выбрано</RimWorldAccess.Rituals.Pawn.Selected>
  <RimWorldAccess.Rituals.Pawn.CannotAssignReason>нельзя назначить: {0}</RimWorldAccess.Rituals.Pawn.CannotAssignReason>

  <!-- Stat / skill disability marker used in suitability-info strings
       (RitualStatFormatter.FormatPawnSuitability). Spoken as
       "<StatLabel>: Disabled" when the pawn cannot use that stat/skill. -->
  <RimWorldAccess.Rituals.Pawn.StatDisabled>Недоступно</RimWorldAccess.Rituals.Pawn.StatDisabled>

  <!-- Quality-factor status suffixes (RitualStatFormatter.FormatQualityFactor).
       Appended to "{Label}: {Change}." when Change doesn't already provide
       context and the factor isn't informational. -->
  <RimWorldAccess.Rituals.Quality.UncertainOutcome>Неопределённый исход.</RimWorldAccess.Rituals.Quality.UncertainOutcome>
  <RimWorldAccess.Rituals.Quality.Bonus>Бонус.</RimWorldAccess.Rituals.Quality.Bonus>
  <RimWorldAccess.Rituals.Quality.Penalty>Штраф.</RimWorldAccess.Rituals.Quality.Penalty>
  <RimWorldAccess.Rituals.Quality.NotMet>Не выполнено.</RimWorldAccess.Rituals.Quality.NotMet>

  <!-- Quality-factor list construction (RitualTreeBuilder.BuildQualityStatsList,
       RitualState.BuildQualityStatsList).
       UnknownFactor: fallback when a QualityFactor has no label.
       ExpectedQualityLabel: row label for the summary row appended after all
       factors. ExpectedQualitySummaryTooltip: description for that row. -->
  <RimWorldAccess.Rituals.Quality.UnknownFactor>Неизвестно</RimWorldAccess.Rituals.Quality.UnknownFactor>
  <RimWorldAccess.Rituals.Quality.ExpectedQualityLabel>Ожидаемое качество</RimWorldAccess.Rituals.Quality.ExpectedQualityLabel>

  <!-- No-data fallbacks (RitualState.BuildQualityStatsList).
       NoQualityFactorsLabel: row label when a ritual has zero quality factors.
       NoQualityFactorsTooltip: description spoken via Alt+I. -->
  <RimWorldAccess.Rituals.Quality.Unavailable>Статистика качества недоступна</RimWorldAccess.Rituals.Quality.Unavailable>

  <!-- Location row prepended to the quality-stats list (RitualState.BuildQualityStatsList,
       GetLocationDescription). The "Location" label is the row title; the
       room/outdoors suffixes compose the value. -->
  <RimWorldAccess.Rituals.Quality.LocationLabel>Место</RimWorldAccess.Rituals.Quality.LocationLabel>
  <RimWorldAccess.Rituals.Location.InRoom>в помещении: {0}</RimWorldAccess.Rituals.Location.InRoom>
  <RimWorldAccess.Rituals.Location.Outdoors>на улице</RimWorldAccess.Rituals.Location.Outdoors>
  <RimWorldAccess.Rituals.Location.Cell>Клетка ({0}, {1})</RimWorldAccess.Rituals.Location.Cell>

  <!-- Fluid-ideology development points (RitualState.AddIdeologyDevelopmentPoints).
       Header row announcing the section. FluidIdeologyTag is the parenthetical
       appended to the header's Change column. -->
  <RimWorldAccess.Rituals.Quality.DevelopmentPointsLabel>Очки развития</RimWorldAccess.Rituals.Quality.DevelopmentPointsLabel>
  <RimWorldAccess.Rituals.Quality.FluidIdeologyTag>(гибкая вера)</RimWorldAccess.Rituals.Quality.FluidIdeologyTag>
  <RimWorldAccess.Rituals.Quality.DevelopmentPointsTooltip>Очки, начисляемые вашей гибкой вере в зависимости от исхода ритуала.</RimWorldAccess.Rituals.Quality.DevelopmentPointsTooltip>

  <!-- Role-list / pawn-list / quality-stats empty announcements
       (RitualState.AnnounceCurrentRole/Pawn/QualityStat). -->
  <RimWorldAccess.Rituals.Empty.NoRoles>Нет доступных ролей.</RimWorldAccess.Rituals.Empty.NoRoles>
  <RimWorldAccess.Rituals.Empty.NoPawns>Нет доступных персонажей.</RimWorldAccess.Rituals.Empty.NoPawns>
  <RimWorldAccess.Rituals.Empty.NoQualityFactorsAvailable>Нет доступных факторов качества.</RimWorldAccess.Rituals.Empty.NoQualityFactorsAvailable>

  <!-- Fallback labels used by RitualTreeBuilder when game data is missing. -->
  <RimWorldAccess.Rituals.Fallback.Spectators>Зрители</RimWorldAccess.Rituals.Fallback.Spectators>
  <RimWorldAccess.Rituals.Fallback.Role>роль</RimWorldAccess.Rituals.Fallback.Role>

  <!-- Pawn-selection mode transitions (RitualState.EnterPawnSelection / ExitPawnSelection).
       EnterInstructions: {0} = role label, {1} = candidate-count clause below.
       CandidateCountOne/Many: {0} = count; split for English "1 candidate" vs
       "N candidates". -->
  <RimWorldAccess.Rituals.PawnSelection.NoEligiblePawns>Нет подходящих персонажей для этой роли.</RimWorldAccess.Rituals.PawnSelection.NoEligiblePawns>
  <RimWorldAccess.Rituals.PawnSelection.CandidateCountOne>{0} кандидат</RimWorldAccess.Rituals.PawnSelection.CandidateCountOne>
  <RimWorldAccess.Rituals.PawnSelection.CandidateCountMany>{0_numCase ? кандидат : кандидата : кандидатов}</RimWorldAccess.Rituals.PawnSelection.CandidateCountMany>
  <RimWorldAccess.Rituals.PawnSelection.EnterInstructions>Выбор персонажа для роли: {0}. {1}. Пробел для переключения выбора, Enter для подтверждения, Escape для отмены.</RimWorldAccess.Rituals.PawnSelection.EnterInstructions>
