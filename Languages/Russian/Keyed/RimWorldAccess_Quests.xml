       {1} = next type label, {2} = next item label, {3} = position. -->
  <RimWorldAccess.Notifications.Action.DeletedNoneRemaining>Удалено: {0}. Уведомлений больше нет</RimWorldAccess.Notifications.Action.DeletedNoneRemaining>
  <RimWorldAccess.Notifications.Action.DeletedNextItem>Удалено: {0}. {1}: {2}. {3}</RimWorldAccess.Notifications.Action.DeletedNextItem>

  <!-- Target descriptions used by Notifications.Button.JumpTo and
