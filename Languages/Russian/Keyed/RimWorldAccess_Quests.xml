  <RimWorldAccess.Notifications.Target.Generic>место назначения</RimWorldAccess.Notifications.Target.Generic>
  <RimWorldAccess.Notifications.Target.LocationFallback>место</RimWorldAccess.Notifications.Target.LocationFallback>
  <RimWorldAccess.Notifications.Target.Unknown>неизвестное место</RimWorldAccess.Notifications.Target.Unknown>
  <RimWorldAccess.Notifications.Target.WorldLocation>место на карте мира</RimWorldAccess.Notifications.Target.WorldLocation>
  <RimWorldAccess.Notifications.Target.Thing>объект</RimWorldAccess.Notifications.Target.Thing>
  <RimWorldAccess.Notifications.Target.Position>позиция {0}, {1}</RimWorldAccess.Notifications.Target.Position>

  <!-- Localization guardrail (D.8) sweep — previously hardcoded English. -->
</LanguageData>
