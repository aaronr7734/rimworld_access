  <RimWorldAccess.Notifications.Button.JumpToWithIndex>Перейти к: {0} ({1} из {2})</RimWorldAccess.Notifications.Button.JumpToWithIndex>

  <!-- Action feedback strings spoken after a button completes. {0} =
       button label echoed back so the user hears confirmation. -->
  <RimWorldAccess.Notifications.Action.AlertActivated>Оповещение активировано</RimWorldAccess.Notifications.Action.AlertActivated>
  <RimWorldAccess.Notifications.Action.ActivatedNoneRemaining>Активировано: {0}. Уведомлений больше нет</RimWorldAccess.Notifications.Action.ActivatedNoneRemaining>
