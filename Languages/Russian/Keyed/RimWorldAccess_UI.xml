  <RimWorldAccess.UI.FloatMenu.Selected>{0}: выбрано</RimWorldAccess.UI.FloatMenu.Selected>
  <!-- Suffix appended to a disabled option label; active-search branch only
       (the no-search focus announcement speaks the standard disabled state
