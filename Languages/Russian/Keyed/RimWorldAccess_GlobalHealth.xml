<LanguageData>
  <!-- Health overview screen (src/Shell/Screens/GlobalHealthScope.Game.cs). -->
  <RimWorldAccess.GlobalHealth.Title>Обзор здоровья</RimWorldAccess.GlobalHealth.Title>
  <RimWorldAccess.GlobalHealth.RegionName>Персонажи</RimWorldAccess.GlobalHealth.RegionName>
  <RimWorldAccess.GlobalHealth.Node.DownedBleeding>Обездвижены и с кровотечением</RimWorldAccess.GlobalHealth.Node.DownedBleeding>
  <RimWorldAccess.GlobalHealth.Node.Downed>Обездвижены</RimWorldAccess.GlobalHealth.Node.Downed>
  <RimWorldAccess.GlobalHealth.Node.Bleeding>С кровотечением</RimWorldAccess.GlobalHealth.Node.Bleeding>
  <RimWorldAccess.GlobalHealth.Node.Injured>Ранены</RimWorldAccess.GlobalHealth.Node.Injured>
  <!-- Node summaries. {0} = the node's name (one of the Node strings above), {1} = how many pawns it holds, then {2} (or {1} in the One forms) = the soonest time left before bleeding out ("2 hours") or the lowest overall health ("38%"). NotSoon is used when no one in the node bleeds out within a day. -->
  <RimWorldAccess.GlobalHealth.Summary.None>{0}. Нет</RimWorldAccess.GlobalHealth.Summary.None>
  <RimWorldAccess.GlobalHealth.Summary.BleedOut>{0}. {1_numCase ? персонаж : персонажа : персонажей}, ближайший истечёт кровью через {2}</RimWorldAccess.GlobalHealth.Summary.BleedOut>
  <RimWorldAccess.GlobalHealth.Summary.BleedOutOne>{0}. 1 персонаж, истечёт кровью через {1}</RimWorldAccess.GlobalHealth.Summary.BleedOutOne>
  <RimWorldAccess.GlobalHealth.Summary.NotSoon>{0}. {1_numCase ? персонаж : персонажа : персонажей}, никому не грозит немедленная опасность</RimWorldAccess.GlobalHealth.Summary.NotSoon>
  <RimWorldAccess.GlobalHealth.Summary.NotSoonOne>{0}. 1 персонаж, нет немедленной опасности</RimWorldAccess.GlobalHealth.Summary.NotSoonOne>
  <RimWorldAccess.GlobalHealth.Summary.LowestHealth>{0}. {1_numCase ? персонаж : персонажа : персонажей}, наименьшее здоровье {2}</RimWorldAccess.GlobalHealth.Summary.LowestHealth>
  <RimWorldAccess.GlobalHealth.Summary.HealthOne>{0}. 1 персонаж, здоровье {1}</RimWorldAccess.GlobalHealth.Summary.HealthOne>
  <!-- {0} = the pawn's name with its group (one of the PawnGroup strings below), {1} = its health tag (one of the PawnHealth.Tag strings below). -->
  <RimWorldAccess.GlobalHealth.PawnRow>{0}. {1}</RimWorldAccess.GlobalHealth.PawnRow>
  <!-- After a filter checkbox is toggled. {0} = the checkbox's new state ("checked"), {1} = how many pawns are now listed. -->
  <RimWorldAccess.GlobalHealth.FilterChanged>{0}. Персонажей в списке: {1}.</RimWorldAccess.GlobalHealth.FilterChanged>
  <RimWorldAccess.GlobalHealth.FilterChangedOne>{0}. В списке 1 персонаж.</RimWorldAccess.GlobalHealth.FilterChangedOne>
  <RimWorldAccess.GlobalHealth.JumpUnavailable>Не удаётся найти персонажа.</RimWorldAccess.GlobalHealth.JumpUnavailable>
  <!-- Pawn health tags, spoken on health overview rows and after scanner pawns. {0} = overall health ("45%"), {1} = time left before bleeding out ("2 hours"). The bleeding words mirror the vanilla health tab: "no immediate danger" past a day, "deathless" for the Biotech gene. -->
  <RimWorldAccess.PawnHealth.Tag.Health>здоровье {0}</RimWorldAccess.PawnHealth.Tag.Health>
  <RimWorldAccess.PawnHealth.Tag.Downed>обездвижен, здоровье {0}</RimWorldAccess.PawnHealth.Tag.Downed>
  <RimWorldAccess.PawnHealth.Tag.Bleeding>истекает кровью, осталось {1}, здоровье {0}</RimWorldAccess.PawnHealth.Tag.Bleeding>
  <RimWorldAccess.PawnHealth.Tag.DownedBleeding>обездвижен, истекает кровью, осталось {1}, здоровье {0}</RimWorldAccess.PawnHealth.Tag.DownedBleeding>
  <RimWorldAccess.PawnHealth.Tag.BleedingNotSoon>кровотечение, неопасное, здоровье {0}</RimWorldAccess.PawnHealth.Tag.BleedingNotSoon>
  <RimWorldAccess.PawnHealth.Tag.DownedBleedingNotSoon>обездвижен, кровотечение, неопасное, здоровье {0}</RimWorldAccess.PawnHealth.Tag.DownedBleedingNotSoon>
  <RimWorldAccess.PawnHealth.Tag.BleedingDeathless>кровотечение, несмертный, здоровье {0}</RimWorldAccess.PawnHealth.Tag.BleedingDeathless>
  <RimWorldAccess.PawnHealth.Tag.DownedBleedingDeathless>обездвижен, кровотечение, несмертный, здоровье {0}</RimWorldAccess.PawnHealth.Tag.DownedBleedingDeathless>
  <!-- Pawn group tags, shared by the health overview and the gear menu. {0} = the pawn's short name. Wild is a pawn with no faction, like a wild man. -->
  <RimWorldAccess.PawnGroup.Colonist>{0}, поселенец</RimWorldAccess.PawnGroup.Colonist>
  <RimWorldAccess.PawnGroup.ColonyMech>{0}, механоид поселения</RimWorldAccess.PawnGroup.ColonyMech>
