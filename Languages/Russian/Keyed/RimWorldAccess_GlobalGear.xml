<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- Global gear screen (src/Shell/Screens/GlobalGearScope.Game.cs). Holder rows use the shared PawnGroup strings in RimWorldAccess_GlobalHealth.xml. -->
  <RimWorldAccess.GlobalGear.Title>Снаряжение на карте</RimWorldAccess.GlobalGear.Title>
  <!-- Section summaries. {0} = the gear tab's section name, {1} = how many items it holds, {2} = how many pawns hold them. -->
  <RimWorldAccess.GlobalGear.Summary.None>{0}. Нет</RimWorldAccess.GlobalGear.Summary.None>
  <RimWorldAccess.GlobalGear.Summary.Items>{0}. {1_numCase ? предмет : предмета : предметов}, {2_numCase ? владелец : владельца : владельцев}</RimWorldAccess.GlobalGear.Summary.Items>
  <RimWorldAccess.GlobalGear.Summary.OneHolder>{0}. {1_numCase ? предмет : предмета : предметов}, 1 владелец</RimWorldAccess.GlobalGear.Summary.OneHolder>
  <RimWorldAccess.GlobalGear.Summary.OneItem>{0}. 1 предмет, 1 владелец</RimWorldAccess.GlobalGear.Summary.OneItem>
  <!-- {0} = the item's name, {1} = how many are held. -->
  <RimWorldAccess.GlobalGear.Item>{0} x{1}</RimWorldAccess.GlobalGear.Item>
  <!-- {0} = the stack count. -->
  <RimWorldAccess.GlobalGear.StackCount>{0} в стопке</RimWorldAccess.GlobalGear.StackCount>
  <!-- {0} = hit points as a percentage, already formatted ("43%"). -->
  <RimWorldAccess.GlobalGear.Condition>прочность {0}</RimWorldAccess.GlobalGear.Condition>
  <RimWorldAccess.GlobalGear.JumpUnavailable>Невозможно перейти к этому персонажу.</RimWorldAccess.GlobalGear.JumpUnavailable>
  <!-- After a filter checkbox is toggled. {0} = the checkbox's new state ("checked"), {1} = how many pawns now hold listed gear. -->
  <RimWorldAccess.GlobalGear.FilterChanged>{0}. Владельцев в списке: {1}.</RimWorldAccess.GlobalGear.FilterChanged>
  <RimWorldAccess.GlobalGear.FilterChangedOne>{0}. В списке 1 владелец.</RimWorldAccess.GlobalGear.FilterChangedOne>
</LanguageData>
