  <RimWorldAccess.Abilities.State.NoJumpTargeting>Наведение прыжка не активно</RimWorldAccess.Abilities.State.NoJumpTargeting>

  <!-- Enter-confirmation validation errors. Spoken by TargetingPatch when an
