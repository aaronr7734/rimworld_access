<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Abilities module strings (src/Abilities/). Six files contribute:
      - AbilityTargetingHelper.cs  (helpers that build most announcement text)
      - AbilityTargetingPatch.cs   (Harmony hooks on Targeter.BeginTargeting)
      - AbilityTargetingState.cs   (psycast/ability map targeting)
      - JumpTargetingState.cs      (Jump Pack / Locust Armor jumping)
      - ItemTargetingState.cs      (CompTargetable/CompUsable items)
      - WorldAbilityTargetingState.cs (Farskip etc.)

    The targeting validation errors (out-of-range, line-of-sight, not-a-valid-
    target) are produced here and then spoken by src/Combat/TargetingPatch.cs;
    a handful of shared phrases (Out of range, Targeting: {0}, Invalid cursor
    position, No valid tile selected, World navigation not active) are pulled
    from RimWorldAccess_Common.xml and RimWorldAccess_Combat.xml instead of
    being re-declared.

    Placeholders follow string.Format. Whole-phrase keys are preferred for any
    composite sentence whose wording or word order should be free to vary by
    language. One/Many splits are only used where English agreement actually
    differs; single-form keys rely on each language's LanguageWorker.
  -->

  <!-- Fallback labels used when the specific target/equipment/ability can't
       be named. Spoken inline inside larger sentences, so keep them lowercase
       like the nouns they substitute for ("Jumping to ground", not "Jumping
       to Ground"). -->
  <RimWorldAccess.Abilities.Label.Unknown>неизвестно</RimWorldAccess.Abilities.Label.Unknown>
  <RimWorldAccess.Abilities.Label.Invalid>недопустимо</RimWorldAccess.Abilities.Label.Invalid>
  <RimWorldAccess.Abilities.Label.Location>место</RimWorldAccess.Abilities.Label.Location>
  <RimWorldAccess.Abilities.Label.Ground>земля</RimWorldAccess.Abilities.Label.Ground>
  <RimWorldAccess.Abilities.Label.Target>цель</RimWorldAccess.Abilities.Label.Target>
  <RimWorldAccess.Abilities.Label.Item>предмет</RimWorldAccess.Abilities.Label.Item>
  <RimWorldAccess.Abilities.Label.Permit>разрешение</RimWorldAccess.Abilities.Label.Permit>
  <RimWorldAccess.Abilities.Label.Jump>Прыжок</RimWorldAccess.Abilities.Label.Jump>

  <!-- Target-requirement phrases, substituted into "No {requirement} at
       cursor" and similar sentences. The trailing "valid target" form is the
       fallback; translators may want distinct words depending on context. -->
  <RimWorldAccess.Abilities.TargetKind.Unknown>неизвестно</RimWorldAccess.Abilities.TargetKind.Unknown>
  <RimWorldAccess.Abilities.TargetKind.LocationOrPawn>место или персонаж</RimWorldAccess.Abilities.TargetKind.LocationOrPawn>
  <RimWorldAccess.Abilities.TargetKind.Pawn>персонаж</RimWorldAccess.Abilities.TargetKind.Pawn>
  <RimWorldAccess.Abilities.TargetKind.HumanlikePawn>гуманоид</RimWorldAccess.Abilities.TargetKind.HumanlikePawn>
  <RimWorldAccess.Abilities.TargetKind.Animal>животное</RimWorldAccess.Abilities.TargetKind.Animal>
  <RimWorldAccess.Abilities.TargetKind.BuildingOrStructure>сооружение или постройка</RimWorldAccess.Abilities.TargetKind.BuildingOrStructure>
  <RimWorldAccess.Abilities.TargetKind.ValidTarget>подходящая цель</RimWorldAccess.Abilities.TargetKind.ValidTarget>

  <!-- Initial ability-targeting announcement, built up piecewise by
       AbilityTargetingHelper.BuildTargetingStartAnnouncement. {0} = ability
       label; other placeholders are inserted as their own fragments so that
       the sentence reads naturally even when some pieces are omitted. -->
  <RimWorldAccess.Abilities.Start.Fallback>Наведение способности</RimWorldAccess.Abilities.Start.Fallback>
  <RimWorldAccess.Abilities.Start.Header>Наведение: {0}</RimWorldAccess.Abilities.Start.Header>
  <RimWorldAccess.Abilities.Start.TouchRange>. Контактная дальность</RimWorldAccess.Abilities.Start.TouchRange>
  <RimWorldAccess.Abilities.Start.Range>. Дальность: {0_numCase ? клетка : клетки : клеток}</RimWorldAccess.Abilities.Start.Range>
  <RimWorldAccess.Abilities.Start.AOE>, радиус поражения: {0_numCase ? клетка : клетки : клеток}</RimWorldAccess.Abilities.Start.AOE>
  <RimWorldAccess.Abilities.Start.Psyfocus>. Пси-концентрация: {0}</RimWorldAccess.Abilities.Start.Psyfocus>
  <RimWorldAccess.Abilities.Start.NeuralHeat>, нейроперегрев: {0}</RimWorldAccess.Abilities.Start.NeuralHeat>
  <RimWorldAccess.Abilities.Start.HintAoe>. Нажмите R, чтобы проверить расстояние и прямую видимость, T, чтобы увидеть поражаемые цели.</RimWorldAccess.Abilities.Start.HintAoe>
  <RimWorldAccess.Abilities.Start.HintSingle>. Нажмите R, чтобы проверить расстояние и прямую видимость.</RimWorldAccess.Abilities.Start.HintSingle>

  <!-- Range/LOS/target feedback built by AbilityTargetingHelper.
       BuildRangeInfoAnnouncement. {0} = distance; {1} = max range.
       InRange/OutOfRange forms are dedicated so translators can reorder
       subject, distance, and verdict freely; NoTargetAtCursor takes the
       target-kind word as {0}. -->
  <RimWorldAccess.Abilities.Range.NoAbilityActive>Нет активной способности</RimWorldAccess.Abilities.Range.NoAbilityActive>
  <RimWorldAccess.Abilities.Range.Distance>Расстояние: {0_numCase ? клетка : клетки : клеток}</RimWorldAccess.Abilities.Range.Distance>
  <RimWorldAccess.Abilities.Range.InRange>, В ПРЕДЕЛАХ ДАЛЬНОСТИ</RimWorldAccess.Abilities.Range.InRange>
  <RimWorldAccess.Abilities.Range.OutOfRange>, ВНЕ ДАЛЬНОСТИ (макс. {0})</RimWorldAccess.Abilities.Range.OutOfRange>
  <RimWorldAccess.Abilities.Range.InRangeTouch>, В ПРЕДЕЛАХ ДАЛЬНОСТИ (контакт)</RimWorldAccess.Abilities.Range.InRangeTouch>
  <RimWorldAccess.Abilities.Range.MustBeAdjacent>, нужно вплотную (контактная дальность)</RimWorldAccess.Abilities.Range.MustBeAdjacent>
  <RimWorldAccess.Abilities.Range.NoLineOfSight>, НЕТ ПРЯМОЙ ВИДИМОСТИ</RimWorldAccess.Abilities.Range.NoLineOfSight>
  <RimWorldAccess.Abilities.Range.NoTargetAtCursor>. Нет цели под курсором: {0}</RimWorldAccess.Abilities.Range.NoTargetAtCursor>

  <!-- Affected-target preview (T key). The AOE list uses whole-phrase One/Many
       keys because English agreement differs (one target: "Target: Bob"; many:
       "Affected: 3 - Bob, Alice, ..."). NoValidTargetsAoe/NoValidTargetSingle
       explain what the ability actually needs. -->
  <RimWorldAccess.Abilities.Affected.NoValidTargetsAoe>Нет подходящих целей. Этой способности нужна цель: {0}, затем она поражает других в радиусе {1_numCase ? клетка : клетки : клеток}</RimWorldAccess.Abilities.Affected.NoValidTargetsAoe>
  <RimWorldAccess.Abilities.Affected.NoValidTargetSingle>Нет подходящей цели под курсором. Этой способности нужна цель: {0}</RimWorldAccess.Abilities.Affected.NoValidTargetSingle>
  <RimWorldAccess.Abilities.Affected.NoPawnsInRadius>Нет персонажей в радиусе поражения</RimWorldAccess.Abilities.Affected.NoPawnsInRadius>
  <RimWorldAccess.Abilities.Affected.TargetOne>Цель: {0}</RimWorldAccess.Abilities.Affected.TargetOne>
  <RimWorldAccess.Abilities.Affected.CountPrefix>Поражаются: {0} - {1}</RimWorldAccess.Abilities.Affected.CountPrefix>
  <RimWorldAccess.Abilities.Affected.AndMore>, и ещё {0}</RimWorldAccess.Abilities.Affected.AndMore>

  <!-- Immunity message. {0} = pawn label. -->
  <RimWorldAccess.Abilities.Immunity.Psychic>{0}: иммунитет к психическим эффектам</RimWorldAccess.Abilities.Immunity.Psychic>

