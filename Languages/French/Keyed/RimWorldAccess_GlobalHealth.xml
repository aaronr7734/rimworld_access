  <RimWorldAccess.PawnGroup.FiltersRegion>Filtres</RimWorldAccess.PawnGroup.FiltersRegion>
  <RimWorldAccess.PawnGroup.Filter.Colonists>Colons</RimWorldAccess.PawnGroup.Filter.Colonists>
