<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- RimWorld 1.7's frame profiler (src/Shell/Screens/FrameProfiler/). Profiler readings such as
       "median", "p99" and column headers come from the game's own window and are not translated here. -->
  <RimWorldAccess.FrameProfiler.Title>Profileur d'images</RimWorldAccess.FrameProfiler.Title>

  <RimWorldAccess.FrameProfiler.Region.Controls>Commandes</RimWorldAccess.FrameProfiler.Region.Controls>
  <RimWorldAccess.FrameProfiler.Region.Summary>Résumé</RimWorldAccess.FrameProfiler.Region.Summary>
  <RimWorldAccess.FrameProfiler.Region.Frames>Images</RimWorldAccess.FrameProfiler.Region.Frames>
  <RimWorldAccess.FrameProfiler.Region.Timeline>Chronologie</RimWorldAccess.FrameProfiler.Region.Timeline>
  <RimWorldAccess.FrameProfiler.Region.TableControls>Commandes du tableau</RimWorldAccess.FrameProfiler.Region.TableControls>
  <RimWorldAccess.FrameProfiler.Region.Table>Tableau</RimWorldAccess.FrameProfiler.Region.Table>
  <RimWorldAccess.FrameProfiler.Region.Threads>Threads</RimWorldAccess.FrameProfiler.Region.Threads>
  <RimWorldAccess.FrameProfiler.Region.Settings>Paramètres</RimWorldAccess.FrameProfiler.Region.Settings>

  <!-- Buttons the window draws as a bare symbol. -->
  <RimWorldAccess.FrameProfiler.Control.OlderFrame>Image précédente</RimWorldAccess.FrameProfiler.Control.OlderFrame>
  <RimWorldAccess.FrameProfiler.Control.NewerFrame>Image suivante</RimWorldAccess.FrameProfiler.Control.NewerFrame>
  <RimWorldAccess.FrameProfiler.Control.NewestFrame>Dernière image</RimWorldAccess.FrameProfiler.Control.NewestFrame>
  <RimWorldAccess.FrameProfiler.Control.Close>Fermer</RimWorldAccess.FrameProfiler.Control.Close>
  <RimWorldAccess.FrameProfiler.Control.ExpandAll>Tout développer</RimWorldAccess.FrameProfiler.Control.ExpandAll>
  <RimWorldAccess.FrameProfiler.Control.CollapseAll>Tout réduire</RimWorldAccess.FrameProfiler.Control.CollapseAll>

  <RimWorldAccess.FrameProfiler.Search>Rechercher</RimWorldAccess.FrameProfiler.Search>
  <RimWorldAccess.FrameProfiler.Filters>Filtres</RimWorldAccess.FrameProfiler.Filters>
  <!-- {0} is the typed value, {1} its unit, such as "frames" or "fps". -->
  <RimWorldAccess.FrameProfiler.FieldValue>{0} {1}</RimWorldAccess.FrameProfiler.FieldValue>
  <!-- {0} is a column header drawn by the game, such as "total" or "calls". -->
  <RimWorldAccess.FrameProfiler.SortBy>Trier par {0}</RimWorldAccess.FrameProfiler.SortBy>
  <RimWorldAccess.FrameProfiler.SortedAscending>tri croissant</RimWorldAccess.FrameProfiler.SortedAscending>
  <RimWorldAccess.FrameProfiler.SortedDescending>tri décroissant</RimWorldAccess.FrameProfiler.SortedDescending>
  <!-- {0} is the list of the selected row's ancestors, outermost first. -->
  <RimWorldAccess.FrameProfiler.Path>Chemin : {0}</RimWorldAccess.FrameProfiler.Path>
  <!-- {0} is a column header drawn by the game, {1} the row's value in that column. -->
  <RimWorldAccess.FrameProfiler.Cell>{0} {1}</RimWorldAccess.FrameProfiler.Cell>
  <RimWorldAccess.FrameProfiler.PercentCell>{0} pour cent</RimWorldAccess.FrameProfiler.PercentCell>
  <RimWorldAccess.FrameProfiler.NoSearchMatch>ne correspond pas à la recherche</RimWorldAccess.FrameProfiler.NoSearchMatch>

  <RimWorldAccess.FrameProfiler.Frame>Image {0}</RimWorldAccess.FrameProfiler.Frame>
  <RimWorldAccess.FrameProfiler.OverBudget>budget dépassé</RimWorldAccess.FrameProfiler.OverBudget>
  <RimWorldAccess.FrameProfiler.Spike>pic</RimWorldAccess.FrameProfiler.Spike>
  <!-- {0}, {1}, {2}: garbage collections of generations 0, 1 and 2. -->
  <RimWorldAccess.FrameProfiler.GarbageCollections>collectes du ramasse-miettes {0}, {1}, {2}</RimWorldAccess.FrameProfiler.GarbageCollections>
  <RimWorldAccess.FrameProfiler.Promoted>promu {0}</RimWorldAccess.FrameProfiler.Promoted>
  <RimWorldAccess.FrameProfiler.OnePause>{0} pause, arrêt de {1}</RimWorldAccess.FrameProfiler.OnePause>
  <RimWorldAccess.FrameProfiler.Pauses>{0} pauses, arrêt de {1}</RimWorldAccess.FrameProfiler.Pauses>
  <RimWorldAccess.FrameProfiler.Alloc>alloué {0}</RimWorldAccess.FrameProfiler.Alloc>
  <RimWorldAccess.FrameProfiler.AllocObjects>alloué {0} en {1} objets</RimWorldAccess.FrameProfiler.AllocObjects>
  <RimWorldAccess.FrameProfiler.PausedBefore>profilage en pause pendant {0} avant cette image</RimWorldAccess.FrameProfiler.PausedBefore>

  <RimWorldAccess.FrameProfiler.ZoneStart>débute à {0}</RimWorldAccess.FrameProfiler.ZoneStart>
  <RimWorldAccess.FrameProfiler.ZoneTotal>total {0}</RimWorldAccess.FrameProfiler.ZoneTotal>
  <RimWorldAccess.FrameProfiler.ZoneSelf>propre {0}</RimWorldAccess.FrameProfiler.ZoneSelf>
  <RimWorldAccess.FrameProfiler.ZoneRunning>toujours en cours</RimWorldAccess.FrameProfiler.ZoneRunning>
  <RimWorldAccess.FrameProfiler.ThreadBusy>occupé {0}</RimWorldAccess.FrameProfiler.ThreadBusy>
  <RimWorldAccess.FrameProfiler.Unprofiled>non profilé {0}</RimWorldAccess.FrameProfiler.Unprofiled>
  <!-- {0} is the zone's name. -->
  <RimWorldAccess.FrameProfiler.RevealedInCallTree>{0} sélectionné dans l'arbre d'appels</RimWorldAccess.FrameProfiler.RevealedInCallTree>

  <!-- Runtime pauses: moments the .NET runtime stopped the game, mostly garbage collections. -->
  <RimWorldAccess.FrameProfiler.PauseLane>Pauses du runtime</RimWorldAccess.FrameProfiler.PauseLane>
  <RimWorldAccess.FrameProfiler.PauseCount>{0} dans cette image</RimWorldAccess.FrameProfiler.PauseCount>
  <RimWorldAccess.FrameProfiler.PauseStopped>arrêt de {0}</RimWorldAccess.FrameProfiler.PauseStopped>
  <RimWorldAccess.FrameProfiler.PauseWaiting>attente des threads {0}</RimWorldAccess.FrameProfiler.PauseWaiting>
  <!-- {0} collected, {1} promoted to an older generation. -->
  <RimWorldAccess.FrameProfiler.PauseCollected>collecté {0}, promu {1}</RimWorldAccess.FrameProfiler.PauseCollected>
  <RimWorldAccess.FrameProfiler.PauseByRuntime>déclenchée par un thread du runtime</RimWorldAccess.FrameProfiler.PauseByRuntime>
  <RimWorldAccess.FrameProfiler.PauseByMainThread>déclenchée par le thread principal</RimWorldAccess.FrameProfiler.PauseByMainThread>
  <RimWorldAccess.FrameProfiler.PauseByThread>déclenchée par le thread {0}</RimWorldAccess.FrameProfiler.PauseByThread>

  <!-- {0} is the zone's name. -->
  <RimWorldAccess.FrameProfiler.RangeSelected>Plage de temps de {0} sélectionnée</RimWorldAccess.FrameProfiler.RangeSelected>

  <RimWorldAccess.FrameProfiler.AllThreads>Tous les threads</RimWorldAccess.FrameProfiler.AllThreads>
  <RimWorldAccess.FrameProfiler.ThreadsSelected>{0} sur {1} sélectionnés</RimWorldAccess.FrameProfiler.ThreadsSelected>

  <RimWorldAccess.FrameProfiler.Paused>En pause</RimWorldAccess.FrameProfiler.Paused>
  <RimWorldAccess.FrameProfiler.Recording>Enregistrement</RimWorldAccess.FrameProfiler.Recording>
  <RimWorldAccess.FrameProfiler.FollowingNewest>Suivi de la dernière image</RimWorldAccess.FrameProfiler.FollowingNewest>
  <RimWorldAccess.FrameProfiler.SelectionCleared>Sélection d'image effacée</RimWorldAccess.FrameProfiler.SelectionCleared>
  <RimWorldAccess.FrameProfiler.Copied>Ligne copiée</RimWorldAccess.FrameProfiler.Copied>
  <RimWorldAccess.FrameProfiler.ViewCopied>Vue copiée</RimWorldAccess.FrameProfiler.ViewCopied>
</LanguageData>
