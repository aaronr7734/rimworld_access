<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Colony Manager Redux compatibility strings (src/Compat/ColonyManagerRedux/).
    Only OUR OWN wording lives here. Everything the mod names, it names itself
    at runtime: tab labels and their disabled reasons, job labels and target
    lists, the stamp tooltips for a suspended or completed job, the progress
    bar's status text, and the update interval's own label are all read live
    from the mod's tabs, jobs and triggers.
  -->

  <!-- The two typed content components: the mod's icon strip, and the job list
       of whichever tab it has selected. The third component, the window's own
       buttons, is named by the shared shell. -->
  <RimWorldAccess.Cmr.TabsRegion>Onglets du gestionnaire</RimWorldAccess.Cmr.TabsRegion>
  <RimWorldAccess.Cmr.JobsRegion>Tâches</RimWorldAccess.Cmr.JobsRegion>

  <!-- Spoken once after switching tab. {0} = the tab's own label. -->
  <RimWorldAccess.Cmr.TabSwitched>Onglet {0}.</RimWorldAccess.Cmr.TabSwitched>

  <!-- A job row's state, one of these four, spoken ahead of the mod's own
       tooltip for that state. "Suspended by an error" is the state the mod
       shows with an error box around the row rather than a plain paused stamp;
       "Not managed" is a job that exists but was never handed to the manager. -->
  <RimWorldAccess.Cmr.Suspended>Suspendu</RimWorldAccess.Cmr.Suspended>
  <RimWorldAccess.Cmr.SuspendedByError>Suspendu par une erreur</RimWorldAccess.Cmr.SuspendedByError>
  <RimWorldAccess.Cmr.Completed>Cible atteinte</RimWorldAccess.Cmr.Completed>
  <RimWorldAccess.Cmr.NotManaged>Non géré</RimWorldAccess.Cmr.NotManaged>
  <RimWorldAccess.Cmr.Active>Actif</RimWorldAccess.Cmr.Active>

  <!-- Spoken when the Manage! toolbar button commits a job to the manager, the
       moment its state turns from "Not managed" to managed. -->
  <RimWorldAccess.Cmr.NowManaged>Désormais géré</RimWorldAccess.Cmr.NowManaged>

  <!-- The clock zone of a job row: how long since the manager last worked the
       job, and how often it is due to. {0} = a period ("2 days") for the
       first, the mod's own interval label ("daily") for the second. -->
  <RimWorldAccess.Cmr.NeverUpdated>Jamais mis à jour</RimWorldAccess.Cmr.NeverUpdated>
  <RimWorldAccess.Cmr.UpdatedAgo>Mis à jour il y a {0}</RimWorldAccess.Cmr.UpdatedAgo>
  <RimWorldAccess.Cmr.ChecksInterval>Vérifie {0}</RimWorldAccess.Cmr.ChecksInterval>

  <!-- Spoken after suspending or resuming a job. {0} = the job's own label. -->
  <RimWorldAccess.Cmr.JobSuspended>Suspendu : {0}.</RimWorldAccess.Cmr.JobSuspended>
  <RimWorldAccess.Cmr.JobUnsuspended>De nouveau actif : {0}.</RimWorldAccess.Cmr.JobUnsuspended>

  <!-- The selected job's settings column. The mod draws it with no heading of its
       own (the headings inside it, one per group of settings, are the mod's and
       are spoken as they are crossed); the animal column next to it carries the
       mod's own "Allowed animals" heading, so that region needs no key here. -->
  <RimWorldAccess.Cmr.OptionsRegion>Options</RimWorldAccess.Cmr.OptionsRegion>

  <!-- The two icon buttons over the animal list, which the mod draws with no
       hover text of any kind: the refresh arrows and the padlock. -->
  <RimWorldAccess.Cmr.Hunting.RefreshAnimals>Actualiser la liste des animaux</RimWorldAccess.Cmr.Hunting.RefreshAnimals>
  <RimWorldAccess.Cmr.Hunting.AnimalsRefreshed>Liste des animaux actualisée.</RimWorldAccess.Cmr.Hunting.AnimalsRefreshed>
  <RimWorldAccess.Cmr.Hunting.LockAnimalsToMap>Limiter la liste aux animaux de cette carte</RimWorldAccess.Cmr.Hunting.LockAnimalsToMap>
  <!-- The Overview tab's controls above its job list (search box, group-by button,
       collapse-all button, job type filter icons), which the mod draws as one strip
       with no heading of its own. -->
  <RimWorldAccess.Cmr.Overview.ListOptionsRegion>Options de la liste de tâches</RimWorldAccess.Cmr.Overview.ListOptionsRegion>
  <!-- The Overview search box, which the mod draws with only a magnifier icon. -->
  <RimWorldAccess.Cmr.Overview.Search>Rechercher des tâches</RimWorldAccess.Cmr.Overview.Search>
  <!-- The delete icon beside a reserved stock row, which has only a tooltip.
       {0} is the mod's own tooltip ("Reset to the default reserved stock amount" or
       "Remove this job's reserved stock amount"), {1} the ingredient. -->
  <RimWorldAccess.Cmr.Production.ReservedStockAction>{0}: {1}</RimWorldAccess.Cmr.Production.ReservedStockAction>
  <!-- Keyboard twin of the modifier-click line the mod adds to every shortcut row's
       tooltip ("Ctrl+click: allow only these" and so on). {0} is the key that plays
       Ctrl on this platform (Ctrl, or Command on a Mac). -->
  <RimWorldAccess.Cmr.Shortcuts.ModifiersTip>{0}+Entrée : autoriser uniquement ceux-ci. Maj+Entrée : autoriser aussi ceux-ci. Alt+Entrée : cesser d'autoriser ceux-ci.</RimWorldAccess.Cmr.Shortcuts.ModifiersTip>

  <!-- The three controls the mod's threshold details window draws around its item
       filter, none of which it labels: a button showing only a comparison glyph,
       a bare number field beside it, and a grid of stockpile cells. The window's
       own name, its filter tree, the operator names and their explanations, and
       every stockpile cell's label are all the mod's own. The target-count key
       also names every threshold tab's unnamed slider row, one phrase for one
       control everywhere it appears. -->
  <RimWorldAccess.Cmr.Threshold.OperatorRow>Comparaison</RimWorldAccess.Cmr.Threshold.OperatorRow>
  <RimWorldAccess.Cmr.Threshold.TargetCountRow>Nombre cible</RimWorldAccess.Cmr.Threshold.TargetCountRow>
  <RimWorldAccess.Cmr.Threshold.StockpileRow>Quantité dans</RimWorldAccess.Cmr.Threshold.StockpileRow>

  <!-- The claw icon on an animal's row, which the mod draws without hover text.
       It marks an animal likely to turn on its hunter; how likely is already in
       the mod's own aggressiveness line, read out with the rest of the row. -->
  <RimWorldAccess.Cmr.Hunting.RevengeRisk>Risque de vengeance</RimWorldAccess.Cmr.Hunting.RevengeRisk>

  <!-- The Forestry, Foraging and Mining clones of the Hunting rows above: the
       tooltipless refresh and padlock icons over each tab's own list. Mining's
       buildings column has only a padlock, no refresh icon of its own; the
       minerals column's refresh already covers both lists. -->
  <RimWorldAccess.Cmr.Forestry.RefreshTrees>Actualiser la liste des arbres</RimWorldAccess.Cmr.Forestry.RefreshTrees>
  <RimWorldAccess.Cmr.Forestry.TreesRefreshed>Liste des arbres actualisée.</RimWorldAccess.Cmr.Forestry.TreesRefreshed>
  <RimWorldAccess.Cmr.Forestry.LockTreesToMap>Limiter la liste aux arbres de cette carte</RimWorldAccess.Cmr.Forestry.LockTreesToMap>

  <RimWorldAccess.Cmr.Foraging.RefreshPlants>Actualiser la liste des plantes</RimWorldAccess.Cmr.Foraging.RefreshPlants>
  <RimWorldAccess.Cmr.Foraging.PlantsRefreshed>Liste des plantes actualisée.</RimWorldAccess.Cmr.Foraging.PlantsRefreshed>
  <RimWorldAccess.Cmr.Foraging.LockPlantsToMap>Limiter la liste aux plantes de cette carte</RimWorldAccess.Cmr.Foraging.LockPlantsToMap>

  <RimWorldAccess.Cmr.Mining.RefreshMinerals>Actualiser la liste des minéraux</RimWorldAccess.Cmr.Mining.RefreshMinerals>
  <RimWorldAccess.Cmr.Mining.MineralsRefreshed>Liste des minéraux actualisée.</RimWorldAccess.Cmr.Mining.MineralsRefreshed>
  <RimWorldAccess.Cmr.Mining.LockMineralsToMap>Limiter la liste aux minéraux de cette carte</RimWorldAccess.Cmr.Mining.LockMineralsToMap>
  <RimWorldAccess.Cmr.Mining.LockBuildingsToMap>Limiter la liste aux bâtiments de cette carte</RimWorldAccess.Cmr.Mining.LockBuildingsToMap>

  <!-- The Livestock tab. Our wording only: everything the mod names uses the mod's own
       keys. The "{0}" of the first three is the mod's own whole-phrase age and sex label
       ("adult female"), composed by its own AgeAndSexExtensions.GetLabel. -->
  <RimWorldAccess.Cmr.Livestock.JobOpened>Tâche ouverte pour configuration : {0}.</RimWorldAccess.Cmr.Livestock.JobOpened>
  <RimWorldAccess.Cmr.Livestock.CountTarget>Nombre cible pour {0}</RimWorldAccess.Cmr.Livestock.CountTarget>
  <RimWorldAccess.Cmr.Livestock.RestrictAreaRow>Zone pour {0}</RimWorldAccess.Cmr.Livestock.RestrictAreaRow>

  <!-- The five area strips the mod draws under a send-to-area toggle with no label of their own. -->
  <RimWorldAccess.Cmr.Livestock.CullingAreaRow>Zone d'abattage</RimWorldAccess.Cmr.Livestock.CullingAreaRow>
  <RimWorldAccess.Cmr.Livestock.MilkingAreaRow>Zone de traite</RimWorldAccess.Cmr.Livestock.MilkingAreaRow>
  <RimWorldAccess.Cmr.Livestock.ShearingAreaRow>Zone de tonte</RimWorldAccess.Cmr.Livestock.ShearingAreaRow>
  <RimWorldAccess.Cmr.Livestock.TrainingAreaRow>Zone de dressage</RimWorldAccess.Cmr.Livestock.TrainingAreaRow>
  <RimWorldAccess.Cmr.Livestock.TrainedAreaRow>Zone des animaux dressés</RimWorldAccess.Cmr.Livestock.TrainedAreaRow>

  <!-- The Production tab. Our wording only: everything the mod names uses the mod's own keys. -->
  <RimWorldAccess.Cmr.Production.JobOpened>Tâche ouverte pour configuration : {0}.</RimWorldAccess.Cmr.Production.JobOpened>
  <RimWorldAccess.Cmr.Production.WorkbenchAreaRow>Zone d'atelier</RimWorldAccess.Cmr.Production.WorkbenchAreaRow>

  <!-- The row that follows an ingredient with a producer link: {0} is the ingredient's own label. -->
  <RimWorldAccess.Cmr.Production.SupplyLinkRow>Lien d'approvisionnement pour {0}</RimWorldAccess.Cmr.Production.SupplyLinkRow>

  <!-- Spoken after jumping to a linked job from either side of the LinkedJobs section. -->
  <RimWorldAccess.Cmr.Production.LinkedJobSelected>Sélectionné : {0}.</RimWorldAccess.Cmr.Production.LinkedJobSelected>

  <!-- A linked consumer that currently covers nothing still reports its demand; the mod's own
       "Supplies: {0} (needs {1})" line would read as a bare "Supplies:" there. -->
  <RimWorldAccess.Cmr.Production.LinkedRow.Demand>Besoin de {0}</RimWorldAccess.Cmr.Production.LinkedRow.Demand>

  <!-- The Overview tab. The workers region normally carries the selected work type's own gerund
       (the mod's own table header); the key below is only its fallback, and the one-row region
       over it holds the jump the sighted row's tab icon performs. -->
  <RimWorldAccess.Cmr.Overview.SelectedJobRegion>Tâche sélectionnée</RimWorldAccess.Cmr.Overview.SelectedJobRegion>
  <RimWorldAccess.Cmr.Overview.WorkersRegion>Travailleurs</RimWorldAccess.Cmr.Overview.WorkersRegion>

  <!-- The Logs tab. A job row there is the mod's log filter (its click selects a job to filter
       by, and re-clicking clears it), so Enter on a job row speaks one of these two. -->
  <RimWorldAccess.Cmr.Logs.LogsRegion>Journaux</RimWorldAccess.Cmr.Logs.LogsRegion>
  <RimWorldAccess.Cmr.Logs.FilterApplied>Affichage des journaux pour {0}.</RimWorldAccess.Cmr.Logs.FilterApplied>
  <RimWorldAccess.Cmr.Logs.FilterCleared>Affichage de tous les journaux.</RimWorldAccess.Cmr.Logs.FilterCleared>

  <!-- The Import/Export tab. Region names for its three unlabeled panels, our names for the
       per-file rows whose buttons the mod labels without naming their target file, the bare
       name field, and the export button's disabled reason (sighted players see it greyed). -->
  <RimWorldAccess.Cmr.ImportExport.ModeRegion>Mode</RimWorldAccess.Cmr.ImportExport.ModeRegion>
  <RimWorldAccess.Cmr.ImportExport.FilesRegion>Fichiers enregistrés</RimWorldAccess.Cmr.ImportExport.FilesRegion>
  <RimWorldAccess.Cmr.ImportExport.ExportRegion>Exportation</RimWorldAccess.Cmr.ImportExport.ExportRegion>
  <RimWorldAccess.Cmr.ImportExport.DeleteRow>Supprimer {0}</RimWorldAccess.Cmr.ImportExport.DeleteRow>
  <RimWorldAccess.Cmr.ImportExport.SetDefaultRow>Définir {0} comme modèle par défaut</RimWorldAccess.Cmr.ImportExport.SetDefaultRow>
  <RimWorldAccess.Cmr.ImportExport.FileNameRow>Nom du fichier</RimWorldAccess.Cmr.ImportExport.FileNameRow>
  <RimWorldAccess.Cmr.ImportExport.ExportNeedsSelection>Sélectionnez d'abord au moins une tâche.</RimWorldAccess.Cmr.ImportExport.ExportNeedsSelection>

  <!-- The Power tab. Its three panels are graphs with legends; the legends and the period
       control are the readable data, and these name the three panels the mod leaves unnamed. -->
  <RimWorldAccess.Cmr.Power.OverallRegion>Vue d'ensemble de l'énergie</RimWorldAccess.Cmr.Power.OverallRegion>
  <RimWorldAccess.Cmr.Power.ConsumptionRegion>Consommation</RimWorldAccess.Cmr.Power.ConsumptionRegion>
  <RimWorldAccess.Cmr.Power.ProductionRegion>Production</RimWorldAccess.Cmr.Power.ProductionRegion>
</LanguageData>
