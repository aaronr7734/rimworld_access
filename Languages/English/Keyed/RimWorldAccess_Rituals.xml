<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Rituals module strings (src/Rituals/). Four files contribute:
      - RitualPatch.cs           (dialog-lifecycle Harmony patches, on-screen indicator)
      - RitualState.cs           (three-mode navigation: RoleList, PawnSelection, QualityStats)
      - RitualStatFormatter.cs   (role / pawn / quality announcement composition)
      - RitualTreeBuilder.cs     (role-list, pawn-list, and quality-factor construction)

    This is Ideology-DLC ritual-setup content (Dialog_BeginRitual). Ritual
    names, role names, outcome labels, pawn names, and quality-factor labels
    are data from the game and flow through as placeholders.

    Gravship-launch checkbox strings (forceVisitorsToLeave, boardColonyAnimals,
    boardColonyMechs) are sourced from the Gravships module and localized in
    RimWorldAccess_Gravships.xml — they are NOT duplicated here. The Rituals
    module reads those labels/tooltips via their translation keys.

    Guard-style messages ("Search cleared") delegate to the shared Common keys.

    One/Many splits exist for English subject-verb agreement (role/roles,
    candidate/candidates) — translators can collapse or split further.
  -->

  <!-- Dialog lifecycle (RitualPatch.cs). -->
  <RimWorldAccess.Rituals.Dialog.Closed>Ritual dialog closed.</RimWorldAccess.Rituals.Dialog.Closed>
  <RimWorldAccess.Rituals.Dialog.KeyboardModeIndicator>Keyboard Mode Active</RimWorldAccess.Rituals.Dialog.KeyboardModeIndicator>

  <!-- Opening announcement (RitualState.Open).
       Begin: {0} = ritual name (e.g., "Wedding", "Funeral").
       Warning: {0} = blocking-issue text joined with periods.
       RoleCount One/Many: {0} = role count. English splits singular "role"
       from plural "roles".
       OpenInstructions: one-time instruction line appended to the opener. -->
  <RimWorldAccess.Rituals.Open.Begin>Begin {0}.</RimWorldAccess.Rituals.Open.Begin>
  <RimWorldAccess.Rituals.Open.Warning>Warning: {0}</RimWorldAccess.Rituals.Open.Warning>
  <RimWorldAccess.Rituals.Open.RoleCountOne>{0} role.</RimWorldAccess.Rituals.Open.RoleCountOne>
  <RimWorldAccess.Rituals.Open.RoleCountMany>{0} roles.</RimWorldAccess.Rituals.Open.RoleCountMany>
  <RimWorldAccess.Rituals.Open.Instructions>Up/Down to navigate, Enter to assign pawns, Tab for quality stats, Alt+S to start.</RimWorldAccess.Rituals.Open.Instructions>

  <!-- Expected-quality summary, used both at dialog-open and in the quality
       stats list (RitualState.GetExpectedQualitySummary,
       RitualStatFormatter.FormatQualitySummary).
       Single: {0} = single percentage (min == max).
       Range:  {0} = min percentage, {1} = max percentage. -->
  <RimWorldAccess.Rituals.Open.ExpectedQualitySingle>Expected quality: {0}.</RimWorldAccess.Rituals.Open.ExpectedQualitySingle>
  <RimWorldAccess.Rituals.Open.ExpectedQualityRange>Expected quality: {0} to {1}.</RimWorldAccess.Rituals.Open.ExpectedQualityRange>
  <RimWorldAccess.Rituals.Quality.ExpectedQualitySingle>Expected Quality: {0}.</RimWorldAccess.Rituals.Quality.ExpectedQualitySingle>
  <RimWorldAccess.Rituals.Quality.ExpectedQualityRange>Expected Quality: {0} to {1}.</RimWorldAccess.Rituals.Quality.ExpectedQualityRange>

  <!-- Role announcement composition (RitualStatFormatter.FormatRoleAnnouncement).
       The role/spectator label is emitted first, followed by one of the count
       clauses below, followed by optional Required/Locked suffixes.
       AssignedOfMax: {0} = assigned count, {1} = max count.
       AssignedOptional: {0} = assigned count (role has maxCount == 0).
       AssignedUnlimited: {0} = assigned count (role has maxCount == -1). -->
  <RimWorldAccess.Rituals.Role.AssignedOfMax>{0} assigned of {1} max</RimWorldAccess.Rituals.Role.AssignedOfMax>
  <RimWorldAccess.Rituals.Role.AssignedOptional>{0} assigned, optional</RimWorldAccess.Rituals.Role.AssignedOptional>
  <RimWorldAccess.Rituals.Role.AssignedUnlimited>{0} assigned</RimWorldAccess.Rituals.Role.AssignedUnlimited>
  <RimWorldAccess.Rituals.Role.Required>, required</RimWorldAccess.Rituals.Role.Required>
  <RimWorldAccess.Rituals.Role.Locked>, locked</RimWorldAccess.Rituals.Role.Locked>

  <!-- Gravship checkbox state words (RitualStatFormatter.FormatCheckboxAnnouncement,
       RitualState.ToggleGravshipCheckbox). The checkbox LABEL and TOOLTIP
       themselves are sourced from RimWorldAccess_Gravships.xml. -->
  <RimWorldAccess.Rituals.Checkbox.Checked>checked</RimWorldAccess.Rituals.Checkbox.Checked>
  <RimWorldAccess.Rituals.Checkbox.Unchecked>unchecked</RimWorldAccess.Rituals.Checkbox.Unchecked>
  <RimWorldAccess.Rituals.Checkbox.Toggled>{0}: {1}.</RimWorldAccess.Rituals.Checkbox.Toggled>

  <!-- Pawn announcement fragments (RitualStatFormatter.FormatPawnAnnouncement). -->
  <RimWorldAccess.Rituals.Pawn.ForcedCannotChange>forced, cannot change</RimWorldAccess.Rituals.Pawn.ForcedCannotChange>
  <RimWorldAccess.Rituals.Pawn.Selected>Selected</RimWorldAccess.Rituals.Pawn.Selected>
  <RimWorldAccess.Rituals.Pawn.CannotAssignReason>cannot assign: {0}</RimWorldAccess.Rituals.Pawn.CannotAssignReason>

  <!-- Stat / skill disability marker used in suitability-info strings
       (RitualStatFormatter.FormatPawnSuitability). Spoken as
       "<StatLabel>: Disabled" when the pawn cannot use that stat/skill. -->
  <RimWorldAccess.Rituals.Pawn.StatDisabled>Disabled</RimWorldAccess.Rituals.Pawn.StatDisabled>

  <!-- Quality-factor status suffixes (RitualStatFormatter.FormatQualityFactor).
       Appended to "{Label}: {Change}." when Change doesn't already provide
       context and the factor isn't informational. -->
  <RimWorldAccess.Rituals.Quality.UncertainOutcome>Uncertain outcome.</RimWorldAccess.Rituals.Quality.UncertainOutcome>
  <RimWorldAccess.Rituals.Quality.Bonus>Bonus.</RimWorldAccess.Rituals.Quality.Bonus>
  <RimWorldAccess.Rituals.Quality.Penalty>Penalty.</RimWorldAccess.Rituals.Quality.Penalty>
  <RimWorldAccess.Rituals.Quality.NotMet>Not met.</RimWorldAccess.Rituals.Quality.NotMet>

  <!-- Quality-factor list construction (RitualTreeBuilder.BuildQualityStatsList,
       RitualState.BuildQualityStatsList).
       UnknownFactor: fallback when a QualityFactor has no label.
       ExpectedQualityLabel: row label for the summary row appended after all
       factors. ExpectedQualitySummaryTooltip: description for that row. -->
  <RimWorldAccess.Rituals.Quality.UnknownFactor>Unknown</RimWorldAccess.Rituals.Quality.UnknownFactor>
  <RimWorldAccess.Rituals.Quality.ExpectedQualityLabel>Expected Quality</RimWorldAccess.Rituals.Quality.ExpectedQualityLabel>
  <RimWorldAccess.Rituals.Quality.ExpectedQualityTooltip>The overall expected quality of this ritual based on all factors.</RimWorldAccess.Rituals.Quality.ExpectedQualityTooltip>

  <!-- No-data fallbacks (RitualState.BuildQualityStatsList).
       NoQualityFactorsLabel: row label when a ritual has zero quality factors.
       NoQualityFactorsTooltip: description spoken via Alt+I. -->
  <RimWorldAccess.Rituals.Quality.NoQualityFactorsLabel>No quality factors</RimWorldAccess.Rituals.Quality.NoQualityFactorsLabel>
  <RimWorldAccess.Rituals.Quality.NoQualityFactorsTooltip>This ritual does not have quality factors that affect its outcome.</RimWorldAccess.Rituals.Quality.NoQualityFactorsTooltip>
  <RimWorldAccess.Rituals.Quality.Unavailable>Quality stats unavailable</RimWorldAccess.Rituals.Quality.Unavailable>

  <!-- Location row prepended to the quality-stats list (RitualState.BuildQualityStatsList,
       GetLocationDescription). The "Location" label is the row title; the
       room/outdoors suffixes compose the value. -->
  <RimWorldAccess.Rituals.Quality.LocationLabel>Location</RimWorldAccess.Rituals.Quality.LocationLabel>
  <RimWorldAccess.Rituals.Location.InRoom>in {0}</RimWorldAccess.Rituals.Location.InRoom>
  <RimWorldAccess.Rituals.Location.Outdoors>outdoors</RimWorldAccess.Rituals.Location.Outdoors>
  <RimWorldAccess.Rituals.Location.Cell>Cell ({0}, {1})</RimWorldAccess.Rituals.Location.Cell>

  <!-- Fluid-ideology development points (RitualState.AddIdeologyDevelopmentPoints).
       Header row announcing the section. FluidIdeologyTag is the parenthetical
       appended to the header's Change column. -->
  <RimWorldAccess.Rituals.Quality.DevelopmentPointsLabel>Development Points</RimWorldAccess.Rituals.Quality.DevelopmentPointsLabel>
  <RimWorldAccess.Rituals.Quality.FluidIdeologyTag>(Fluid ideology)</RimWorldAccess.Rituals.Quality.FluidIdeologyTag>
  <RimWorldAccess.Rituals.Quality.DevelopmentPointsTooltip>Points awarded to your fluid ideology based on ritual outcome.</RimWorldAccess.Rituals.Quality.DevelopmentPointsTooltip>

  <!-- Role-list / pawn-list / quality-stats empty announcements
       (RitualState.AnnounceCurrentRole/Pawn/QualityStat). -->
  <RimWorldAccess.Rituals.Empty.NoRoles>No roles available.</RimWorldAccess.Rituals.Empty.NoRoles>
  <RimWorldAccess.Rituals.Empty.NoPawns>No pawns available.</RimWorldAccess.Rituals.Empty.NoPawns>
  <RimWorldAccess.Rituals.Empty.NoQualityFactorsAvailable>No quality factors available.</RimWorldAccess.Rituals.Empty.NoQualityFactorsAvailable>

  <!-- Fallback labels used by RitualTreeBuilder when game data is missing. -->
  <RimWorldAccess.Rituals.Fallback.Spectators>Spectators</RimWorldAccess.Rituals.Fallback.Spectators>
  <RimWorldAccess.Rituals.Fallback.Ritual>Ritual</RimWorldAccess.Rituals.Fallback.Ritual>
  <RimWorldAccess.Rituals.Fallback.Role>role</RimWorldAccess.Rituals.Fallback.Role>

  <!-- Pawn-selection mode transitions (RitualState.EnterPawnSelection / ExitPawnSelection).
       EnterInstructions: {0} = role label, {1} = candidate-count clause below.
       CandidateCountOne/Many: {0} = count; split for English "1 candidate" vs
       "N candidates". -->
  <RimWorldAccess.Rituals.PawnSelection.NoRoleSelected>No role selected.</RimWorldAccess.Rituals.PawnSelection.NoRoleSelected>
  <RimWorldAccess.Rituals.PawnSelection.RoleLocked>Role is locked. All assigned pawns are required by the ritual.</RimWorldAccess.Rituals.PawnSelection.RoleLocked>
  <RimWorldAccess.Rituals.PawnSelection.NoEligiblePawns>No eligible pawns for this role.</RimWorldAccess.Rituals.PawnSelection.NoEligiblePawns>
  <RimWorldAccess.Rituals.PawnSelection.CandidateCountOne>{0} candidate</RimWorldAccess.Rituals.PawnSelection.CandidateCountOne>
  <RimWorldAccess.Rituals.PawnSelection.CandidateCountMany>{0} candidates</RimWorldAccess.Rituals.PawnSelection.CandidateCountMany>
  <RimWorldAccess.Rituals.PawnSelection.EnterInstructions>Selecting pawn for {0}. {1}. Space to toggle selection, Enter to confirm, Escape to cancel.</RimWorldAccess.Rituals.PawnSelection.EnterInstructions>
  <RimWorldAccess.Rituals.PawnSelection.Cancelled>Cancelled. Returned to role list.</RimWorldAccess.Rituals.PawnSelection.Cancelled>
  <RimWorldAccess.Rituals.PawnSelection.Confirmed>Selection confirmed. Returned to role list.</RimWorldAccess.Rituals.PawnSelection.Confirmed>

  <!-- Pawn assignment feedback (RitualState.TogglePawnAssignment).
       Forced/CannotAssign/CannotAssignReason: {0} = pawn name, {1} = reason.
       Selected / Deselected: {0} = pawn name. NowAt: {0} = pawn name (spoken
       after the list reorders so the user knows their cursor's current row). -->
  <RimWorldAccess.Rituals.Pawn.IsForced>{0} is forced for this role and cannot be changed.</RimWorldAccess.Rituals.Pawn.IsForced>
  <RimWorldAccess.Rituals.Pawn.CannotAssignWithReason>Cannot assign {0}. {1}</RimWorldAccess.Rituals.Pawn.CannotAssignWithReason>
  <RimWorldAccess.Rituals.Pawn.CannotAssign>Cannot assign {0}.</RimWorldAccess.Rituals.Pawn.CannotAssign>
  <RimWorldAccess.Rituals.Pawn.SelectedName>{0} selected.</RimWorldAccess.Rituals.Pawn.SelectedName>
  <RimWorldAccess.Rituals.Pawn.DeselectedName>{0} deselected.</RimWorldAccess.Rituals.Pawn.DeselectedName>
  <RimWorldAccess.Rituals.Pawn.NowAt>Now at: {0}</RimWorldAccess.Rituals.Pawn.NowAt>

  <!-- Quality-stats mode transitions (RitualState.ToggleQualityStatsView).
       ReturnedToRoleList / ReturnedToPawnSelection: spoken on Tab/Escape back.
       FactorsCountOne/Many: {0} = factor count; split for English "1 factor"
       vs "N factors" (used inside the two Instructions keys below). Note: we
       keep Instructions as a whole-sentence key so translators can reorder
       subject/verb/object freely. -->
  <RimWorldAccess.Rituals.QualityStats.ReturnedToRoleList>Returned to role list.</RimWorldAccess.Rituals.QualityStats.ReturnedToRoleList>
  <RimWorldAccess.Rituals.QualityStats.ReturnedToPawnSelection>Returned to pawn selection for {0}.</RimWorldAccess.Rituals.QualityStats.ReturnedToPawnSelection>
  <RimWorldAccess.Rituals.QualityStats.InstructionsOne>Quality stats. {0} factor. Up/Down to navigate, Alt+I for breakdown, Tab to return.</RimWorldAccess.Rituals.QualityStats.InstructionsOne>
  <RimWorldAccess.Rituals.QualityStats.InstructionsMany>Quality stats. {0} factors. Up/Down to navigate, Alt+I for breakdown, Tab to return.</RimWorldAccess.Rituals.QualityStats.InstructionsMany>
  <RimWorldAccess.Rituals.QualityStats.HeaderOne>Quality stats. {0} factor.</RimWorldAccess.Rituals.QualityStats.HeaderOne>
  <RimWorldAccess.Rituals.QualityStats.HeaderMany>Quality stats. {0} factors.</RimWorldAccess.Rituals.QualityStats.HeaderMany>

  <!-- Quality breakdown (Alt+I in QualityStats, RitualState.OpenQualityStatBreakdown). -->
  <RimWorldAccess.Rituals.QualityStats.BreakdownWithTooltip>{0}. {1}</RimWorldAccess.Rituals.QualityStats.BreakdownWithTooltip>
  <RimWorldAccess.Rituals.QualityStats.NoBreakdown>No detailed breakdown available for this factor.</RimWorldAccess.Rituals.QualityStats.NoBreakdown>

  <!-- Start ritual (RitualState.StartRitual). -->
  <RimWorldAccess.Rituals.Start.NoDialog>No ritual dialog open.</RimWorldAccess.Rituals.Start.NoDialog>
  <RimWorldAccess.Rituals.Start.CannotStart>Cannot start ritual. {0}</RimWorldAccess.Rituals.Start.CannotStart>

  <!-- Blocking issues surfaced during Open (RitualState.GetBlockingIssues).
       DraftedParticipants is spoken when any assigned participant is drafted. -->
  <RimWorldAccess.Rituals.Warning.DraftedParticipants>Some participants are drafted.</RimWorldAccess.Rituals.Warning.DraftedParticipants>
</LanguageData>
</content>
</invoke>