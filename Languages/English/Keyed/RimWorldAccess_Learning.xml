<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Learning module strings (src/Learning/). Two files contribute:
      - LearningHelperState.cs  (? key; windowless menu over the Learning Helper)
      - LearningHelperPatch.cs  (announces newly-activated tutorial concepts)

    The feature title and the two button labels ("Mark as learned", "Already
    learned") come from vanilla keys (LearningHelper, MarkLearned,
    AlreadyLearned) and are referenced directly via .Translate() rather than
    re-keyed here. ConceptDef.LabelCap and ConceptDef.HelpTextAdjusted (lesson
    titles and body text) are also vanilla data and are injected as
    placeholders; they are NOT translated in this file.

    Placeholder convention: {0} is the primary substitution (usually the
    vanilla "LearningHelper" title, a lesson name, or a count). Keys with
    multiple placeholders are documented above the block that uses them.
  -->

  <!-- Status announcements when the menu opens or is toggled.
       DisabledSuffix is spoken when adaptive training is off / tutorial mode
       is on. The C# composes it after the vanilla "LearningHelper" title
       so the user hears "Learning helper disabled". -->
  <RimWorldAccess.Learning.DisabledSuffix>disabled</RimWorldAccess.Learning.DisabledSuffix>
  <RimWorldAccess.Learning.Closed>{0} closed</RimWorldAccess.Learning.Closed>

  <!-- Menu opening / Tab-toggle announcements.
       {0} = vanilla "LearningHelper" title.
       AllLessonsCount additionally takes {1} = total concept count. -->
  <RimWorldAccess.Learning.OpeningTitle>{0}</RimWorldAccess.Learning.OpeningTitle>
  <RimWorldAccess.Learning.OpeningNoActive>{0}. No active lessons. Press Tab to browse all lessons.</RimWorldAccess.Learning.OpeningNoActive>
  <RimWorldAccess.Learning.AllLessonsCount>{0}. All lessons, {1} total</RimWorldAccess.Learning.AllLessonsCount>
  <RimWorldAccess.Learning.ActiveLessons>{0}. Active lessons</RimWorldAccess.Learning.ActiveLessons>

  <!-- Empty-list announcements. NoActive is also spoken after returning to
       an empty list when leaving detail view. -->
  <RimWorldAccess.Learning.NoLessonsAvailable>No lessons available</RimWorldAccess.Learning.NoLessonsAvailable>
  <RimWorldAccess.Learning.NoActive>No active lessons. Press Tab to browse all lessons.</RimWorldAccess.Learning.NoActive>
  <RimWorldAccess.Learning.NoActiveRemaining>No active lessons remaining. Press Tab to browse all lessons.</RimWorldAccess.Learning.NoActiveRemaining>

  <!-- Button feedback.
       MarkLearnedConfirmation is spoken immediately after the "Mark as
       learned" button is pressed. {0} = vanilla "MarkLearned" label.
       Example result: "Mark as learned. 100%". -->
  <RimWorldAccess.Learning.MarkLearnedConfirmation>{0}. 100%</RimWorldAccess.Learning.MarkLearnedConfirmation>
  <RimWorldAccess.Learning.ButtonActivationFailed>Failed to activate button</RimWorldAccess.Learning.ButtonActivationFailed>

  <!-- Typeahead search context suffix used only by the Learning menu.
       {0} = the user's current search buffer. Other menus use the generic
       RimWorldAccess.Search.ContextSuffix key; Learning uses this simpler
       form because its announcement does not yet include a match position. -->
  <RimWorldAccess.Learning.SearchSuffix> Search: '{0}'</RimWorldAccess.Learning.SearchSuffix>

  <!-- TwoLevelMenuHelper boundary messages (Learning-scoped).
       Passed as the endOfItemMessage / startOfItemMessage / openFirstMessage
       arguments when the helper is constructed. -->
  <RimWorldAccess.Learning.EndOfLesson>End of lesson</RimWorldAccess.Learning.EndOfLesson>
  <RimWorldAccess.Learning.StartOfLesson>Start of lesson</RimWorldAccess.Learning.StartOfLesson>
  <RimWorldAccess.Learning.OpenLessonFirst>Press Enter to open lesson first</RimWorldAccess.Learning.OpenLessonFirst>

  <!-- Fallback when a ConceptDef has no help text (should be rare - vanilla
       concepts always ship with HelpTextAdjusted). -->
  <RimWorldAccess.Learning.NoHelpText>No help text available</RimWorldAccess.Learning.NoHelpText>

  <!-- Patch announcement: fires when the game auto-activates a new concept.
       {0} = vanilla "LearningHelper" title, {1} = the concept's LabelCap. -->
  <RimWorldAccess.Learning.NewLessonAnnouncement>{0}: {1}</RimWorldAccess.Learning.NewLessonAnnouncement>
</LanguageData>
</content>
</invoke>