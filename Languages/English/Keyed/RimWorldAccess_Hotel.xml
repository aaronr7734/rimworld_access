<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- HospitalityGuestTabAdapter: Hospitality's Guest inspect tab. Labels and tooltips are the
       mod's own keys; these cover only what the mod draws without a string of its own. -->
  <RimWorldAccess.Compat.Hospitality.GuestTabName>Guest</RimWorldAccess.Compat.Hospitality.GuestTabName>
  <!-- A progress bar: {0} = the label drawn beside it, {1} = how full the bar is, as a percent. -->
  <RimWorldAccess.Compat.Hospitality.BarLine>{0} {1}</RimWorldAccess.Compat.Hospitality.BarLine>
  <RimWorldAccess.Compat.Hospitality.DefaultsApplied>Applied to all current and future visitors.</RimWorldAccess.Compat.Hospitality.DefaultsApplied>
  <RimWorldAccess.Compat.Hospitality.ActionFailed>Action failed.</RimWorldAccess.Compat.Hospitality.ActionFailed>
  <!-- HospitalitySocialBarsExtender: the coloured bars Hospitality paints behind colonist rows on a guest's Social tab.
       {0} = colonist, {1} = the guest's opinion of them, {2} = how full the bar is. -->
  <RimWorldAccess.Compat.Hospitality.FriendshipBars>Recruitment friendships</RimWorldAccess.Compat.Hospitality.FriendshipBars>
  <RimWorldAccess.Compat.Hospitality.FriendBar>{0}: opinion {1}, friendship {2}</RimWorldAccess.Compat.Hospitality.FriendBar>
  <RimWorldAccess.Compat.Hospitality.EnemyBar>{0}: opinion {1}, rivalry {2}</RimWorldAccess.Compat.Hospitality.EnemyBar>
  <RimWorldAccess.Compat.Hospitality.NoFriendshipBars>No colonist opinions yet.</RimWorldAccess.Compat.Hospitality.NoFriendshipBars>

  <!-- GastronomyRestaurantTabAdapter: Gastronomy's Dining tab on a cash register. -->
  <RimWorldAccess.Compat.Gastronomy.TabName>Dining</RimWorldAccess.Compat.Gastronomy.TabName>
  <RimWorldAccess.Compat.Gastronomy.RestaurantPicker>Restaurant</RimWorldAccess.Compat.Gastronomy.RestaurantPicker>
  <RimWorldAccess.Compat.Gastronomy.RestaurantAdded>Added {0}.</RimWorldAccess.Compat.Gastronomy.RestaurantAdded>
  <!-- One stocked meal: {0} = count, {1} = meal name, {2} = price. -->
  <RimWorldAccess.Compat.Gastronomy.StockEntry>{0}x {1} ({2})</RimWorldAccess.Compat.Gastronomy.StockEntry>
  <RimWorldAccess.Compat.Gastronomy.NoDebts>No unpaid bills.</RimWorldAccess.Compat.Gastronomy.NoDebts>
  <RimWorldAccess.Compat.Gastronomy.DebtCleared>Bill cleared.</RimWorldAccess.Compat.Gastronomy.DebtCleared>
  <RimWorldAccess.Compat.Gastronomy.MenuFilter>Menu</RimWorldAccess.Compat.Gastronomy.MenuFilter>

  <!-- StorefrontStoreTabAdapter: Hospitality: Storefront's Shop tab on a cash register. -->
  <RimWorldAccess.Compat.Storefront.TabName>Shop</RimWorldAccess.Compat.Storefront.TabName>
  <!-- One stocked item: {0} = count, {1} = item name. -->
  <RimWorldAccess.Compat.Storefront.StockEntry>{0}x {1}</RimWorldAccess.Compat.Storefront.StockEntry>
  <RimWorldAccess.Compat.Storefront.StockLine>Stock: {0}</RimWorldAccess.Compat.Storefront.StockLine>
  <RimWorldAccess.Compat.Storefront.NoStock>Stock: nothing.</RimWorldAccess.Compat.Storefront.NoStock>
  <RimWorldAccess.Compat.Storefront.StoreFilter>Items for sale</RimWorldAccess.Compat.Storefront.StoreFilter>
</LanguageData>
