  <!-- Refuelable component menu (src/Building/RefuelableComponentState.cs).
       Drives a small menu over CompRefuelable showing current fuel status,
       optional auto-refuel toggle, optional adjustable target. Vanilla keys
       used: ConfiguredTargetFuelLevel for the inspect-status line, and the
       def's FuelLabel/outOfFuelMessage for fuel-type-specific wording.

       AutoRefuel and ToggleValue are split into On/Off whole-phrase variants
       per the "no glue particles" rule (the colon-separator pattern is
       English-specific; languages may want to drop it or reorder).
       FuelStatusLine: {0} = capitalized fuel label, {1} = current fuel,
       {2} = capacity. RemainingTimeSuffix: {0} = formatted time period.
       OutOfFuelSuffix: {0} = the def's outOfFuelMessage. -->
  <RimWorldAccess.Building.Refuel.NoFuelComponent>Building does not have fuel system</RimWorldAccess.Building.Refuel.NoFuelComponent>
  <RimWorldAccess.Building.Refuel.OptionViewStatus>View detailed fuel status</RimWorldAccess.Building.Refuel.OptionViewStatus>
  <RimWorldAccess.Building.Refuel.AutoRefuelOn>Auto-refuel: on</RimWorldAccess.Building.Refuel.AutoRefuelOn>
  <RimWorldAccess.Building.Refuel.AutoRefuelOff>Auto-refuel: off</RimWorldAccess.Building.Refuel.AutoRefuelOff>
  <RimWorldAccess.Building.Refuel.ToggleValueOn>on</RimWorldAccess.Building.Refuel.ToggleValueOn>
  <RimWorldAccess.Building.Refuel.ToggleValueOff>off</RimWorldAccess.Building.Refuel.ToggleValueOff>
