<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Building module: construction, zones, areas, building components,
    storage linking, shape placement. Strings are emitted from src/Building/.

    Placeholders follow string.Format ({0}, {1}, ...). Keys for status
    announcements compose via AnnouncementBuilder (period-separated by
    default) so each key is a clean phrase fragment without trailing
    punctuation or embedded "\n" — the builder owns separators.

    Vanilla key reuse: where vanilla supplies the noun ("Yes"/"No",
    "On"/"Off", "BrokenDown", "NoPower", "TargetTemperature",
    "DesignatorUninstall", "CommandToggleDoorHoldOpen",
    "PowerConsumptionHigh"/"Low"/"Off", "ConfiguredTargetFuelLevel",
    "FuelLabel" via the def, etc.) we resolve those at speak-time
    rather than duplicating the noun in this file.
  -->

  <!-- Breakdown status (src/Building/BreakdownableComponentState.cs).
       Read-only view describing CompBreakdownable status. Composed via
       AnnouncementBuilder; vanilla "BrokenDown" supplies the broken-status
       noun. -->
  <RimWorldAccess.Building.Breakdown.NoBreakdownComponent>Building cannot break down</RimWorldAccess.Building.Breakdown.NoBreakdownComponent>
  <RimWorldAccess.Building.Breakdown.StatusBrokenDown>Status: Broken down</RimWorldAccess.Building.Breakdown.StatusBrokenDown>
  <RimWorldAccess.Building.Breakdown.NeedsRepair>This building requires repair before it can function</RimWorldAccess.Building.Breakdown.NeedsRepair>
  <RimWorldAccess.Building.Breakdown.RepairSkill>A colonist with the Construction skill can repair it</RimWorldAccess.Building.Breakdown.RepairSkill>
  <RimWorldAccess.Building.Breakdown.StatusOperational>Status: Operational</RimWorldAccess.Building.Breakdown.StatusOperational>
  <RimWorldAccess.Building.Breakdown.OperationalDescription>This building is functioning normally</RimWorldAccess.Building.Breakdown.OperationalDescription>
  <RimWorldAccess.Building.Breakdown.BreakdownsOverTime>Buildings with breakdown components can break down over time</RimWorldAccess.Building.Breakdown.BreakdownsOverTime>
  <RimWorldAccess.Building.Breakdown.UnpoweredImmune>Note: Building is not powered. Unpowered buildings do not break down</RimWorldAccess.Building.Breakdown.UnpoweredImmune>

  <!-- Forbid/allow controls (src/Building/ForbidControlState.cs).
       Toggles CompForbiddable. Status-row keys compose with the building
       label via AnnouncementBuilder.
       LabelStatus: {0} = building label, {1} = StatusForbidden/StatusAllowed. -->
  <RimWorldAccess.Building.Forbid.NoForbidComponent>Item cannot be forbidden</RimWorldAccess.Building.Forbid.NoForbidComponent>
  <RimWorldAccess.Building.Forbid.StatusForbidden>Forbidden</RimWorldAccess.Building.Forbid.StatusForbidden>
  <RimWorldAccess.Building.Forbid.StatusAllowed>Allowed</RimWorldAccess.Building.Forbid.StatusAllowed>
  <RimWorldAccess.Building.Forbid.LabelStatus>{0} - Status: {1}</RimWorldAccess.Building.Forbid.LabelStatus>
  <RimWorldAccess.Building.Forbid.DetailStatusForbidden>Status: Forbidden</RimWorldAccess.Building.Forbid.DetailStatusForbidden>
  <RimWorldAccess.Building.Forbid.DetailNoInteract>Colonists will not interact with this item</RimWorldAccess.Building.Forbid.DetailNoInteract>
  <RimWorldAccess.Building.Forbid.DetailNoHaulUseEquip>They will not haul, use, or equip it</RimWorldAccess.Building.Forbid.DetailNoHaulUseEquip>
  <RimWorldAccess.Building.Forbid.DetailStatusAllowed>Status: Allowed</RimWorldAccess.Building.Forbid.DetailStatusAllowed>
  <RimWorldAccess.Building.Forbid.DetailCanInteract>Colonists can interact with this item normally</RimWorldAccess.Building.Forbid.DetailCanInteract>

  <!-- Door controls (src/Building/DoorControlState.cs).
       Toggles Building_Door.holdOpenInt. Vanilla supplies the
       "Hold open" command label (CommandToggleDoorHoldOpen) and the
       "On"/"Off" booleans.
       LabelStatusOpenness: {0} = door label, {1} = HoldOpenWithValue,
       {2} = CurrentlyOpen/Closed. -->
  <RimWorldAccess.Building.Door.NotADoor>Building is not a door</RimWorldAccess.Building.Door.NotADoor>
  <RimWorldAccess.Building.Door.HoldOpenAccessError>Error: Could not access door hold-open setting</RimWorldAccess.Building.Door.HoldOpenAccessError>
  <RimWorldAccess.Building.Door.HoldOpenWithValue>{0}: {1}</RimWorldAccess.Building.Door.HoldOpenWithValue>
  <RimWorldAccess.Building.Door.CurrentlyOpen>(Currently open)</RimWorldAccess.Building.Door.CurrentlyOpen>
  <RimWorldAccess.Building.Door.CurrentlyClosed>(Currently closed)</RimWorldAccess.Building.Door.CurrentlyClosed>
  <RimWorldAccess.Building.Door.LabelStatusOpenness>{0} - {1} {2}</RimWorldAccess.Building.Door.LabelStatusOpenness>
  <RimWorldAccess.Building.Door.DetailStateOpen>Currently: Open</RimWorldAccess.Building.Door.DetailStateOpen>
  <RimWorldAccess.Building.Door.DetailStateClosed>Currently: Closed</RimWorldAccess.Building.Door.DetailStateClosed>
  <RimWorldAccess.Building.Door.DetailPoweredFast>Status: Powered - opens faster</RimWorldAccess.Building.Door.DetailPoweredFast>
  <RimWorldAccess.Building.Door.DetailNoPowerSlow>Status: No power - opens slower</RimWorldAccess.Building.Door.DetailNoPowerSlow>
  <RimWorldAccess.Building.Door.DetailManual>Status: Manual door (no power required)</RimWorldAccess.Building.Door.DetailManual>

  <!-- Power switch / flickable controls (src/Building/FlickableComponentState.cs).
       Toggles CompFlickable. Power consumption suffixes use {0} = wattage.
       LabelPowerSwitch: {0} = building label, {1} = vanilla "On"/"Off". -->
  <RimWorldAccess.Building.Flickable.NoFlickComponent>Building does not have power control</RimWorldAccess.Building.Flickable.NoFlickComponent>
  <RimWorldAccess.Building.Flickable.AlreadyOn>Power is already on</RimWorldAccess.Building.Flickable.AlreadyOn>
  <RimWorldAccess.Building.Flickable.AlreadyOff>Power is already off</RimWorldAccess.Building.Flickable.AlreadyOff>
  <RimWorldAccess.Building.Flickable.LabelPowerStatus>{0} - Power: {1}</RimWorldAccess.Building.Flickable.LabelPowerStatus>
  <RimWorldAccess.Building.Flickable.NoPowerAvailableSuffix> (No power available)</RimWorldAccess.Building.Flickable.NoPowerAvailableSuffix>
  <RimWorldAccess.Building.Flickable.ConsumingSuffix> - Consuming: {0}W</RimWorldAccess.Building.Flickable.ConsumingSuffix>
  <RimWorldAccess.Building.Flickable.ProducingSuffix> - Producing: {0}W</RimWorldAccess.Building.Flickable.ProducingSuffix>
  <RimWorldAccess.Building.Flickable.LabelPowerSwitch>{0} - Power switch: {1}</RimWorldAccess.Building.Flickable.LabelPowerSwitch>
  <RimWorldAccess.Building.Flickable.DetailConnected>Connected to power grid</RimWorldAccess.Building.Flickable.DetailConnected>
  <RimWorldAccess.Building.Flickable.DetailActiveSuffix> - Active</RimWorldAccess.Building.Flickable.DetailActiveSuffix>
  <RimWorldAccess.Building.Flickable.DetailNoPowerSuffix> - No power available</RimWorldAccess.Building.Flickable.DetailNoPowerSuffix>
  <RimWorldAccess.Building.Flickable.DetailSwitchedOffSuffix> - Switched off</RimWorldAccess.Building.Flickable.DetailSwitchedOffSuffix>
  <RimWorldAccess.Building.Flickable.DetailNotConnected>Not connected to power grid</RimWorldAccess.Building.Flickable.DetailNotConnected>
  <RimWorldAccess.Building.Flickable.DetailConsuming>Consuming: {0}W</RimWorldAccess.Building.Flickable.DetailConsuming>
  <RimWorldAccess.Building.Flickable.DetailProducing>Producing: {0}W</RimWorldAccess.Building.Flickable.DetailProducing>

  <!-- Uninstall designation (src/Building/UninstallControlState.cs).
       Toggles DesignationDefOf.Uninstall on minifiable buildings. Vanilla
       "DesignatorUninstall" / "DesignatorUninstallDesc" supply the verb;
       these keys are the announcement-shaped wrappers. -->
  <RimWorldAccess.Building.Uninstall.NotMinifiable>Building cannot be uninstalled</RimWorldAccess.Building.Uninstall.NotMinifiable>
  <RimWorldAccess.Building.Uninstall.DesignationRemoved>{0} - Uninstall designation removed</RimWorldAccess.Building.Uninstall.DesignationRemoved>
  <RimWorldAccess.Building.Uninstall.InstantlyUninstalled>{0} - Instantly uninstalled</RimWorldAccess.Building.Uninstall.InstantlyUninstalled>
  <RimWorldAccess.Building.Uninstall.DesignatedForUninstall>{0} - Designated for uninstall</RimWorldAccess.Building.Uninstall.DesignatedForUninstall>
  <RimWorldAccess.Building.Uninstall.LabelStatusDesignated>{0} - Status: Designated for uninstall</RimWorldAccess.Building.Uninstall.LabelStatusDesignated>
  <RimWorldAccess.Building.Uninstall.LabelStatusNotDesignated>{0} - Status: Not designated</RimWorldAccess.Building.Uninstall.LabelStatusNotDesignated>
  <RimWorldAccess.Building.Uninstall.DetailDesignated>Status: Designated for uninstall</RimWorldAccess.Building.Uninstall.DetailDesignated>
  <RimWorldAccess.Building.Uninstall.DetailDisassemblerTip>A colonist with the Construction skill will disassemble this</RimWorldAccess.Building.Uninstall.DetailDisassemblerTip>
  <RimWorldAccess.Building.Uninstall.DetailMinifiedTip>The building will be converted to a minified item that can be moved</RimWorldAccess.Building.Uninstall.DetailMinifiedTip>
  <RimWorldAccess.Building.Uninstall.DetailNotDesignated>Status: Not designated for uninstall</RimWorldAccess.Building.Uninstall.DetailNotDesignated>
  <RimWorldAccess.Building.Uninstall.DetailCanUninstallTip>This building can be uninstalled to create a portable item</RimWorldAccess.Building.Uninstall.DetailCanUninstallTip>
  <RimWorldAccess.Building.Uninstall.DetailHotkeyTip>Press Space or Enter to designate for uninstall</RimWorldAccess.Building.Uninstall.DetailHotkeyTip>

  <!-- Temperature control (src/Building/TempControlMenuState.cs).
       Adjusts CompTempControl.TargetTemperature. Vanilla "PowerConsumptionOff",
       "PowerConsumptionHigh", "PowerConsumptionLow" supply the power-mode
       words; the "_X power" / "_off" wording is the announcement suffix.
       LabelTarget: {0} = building label, {1} = formatted target temperature,
       {2} = power mode suffix (may be empty). -->
  <RimWorldAccess.Building.Temp.NoTempComponent>Building does not have temperature control</RimWorldAccess.Building.Temp.NoTempComponent>
  <RimWorldAccess.Building.Temp.LabelTarget>{0} - Target: {1}{2}</RimWorldAccess.Building.Temp.LabelTarget>
  <RimWorldAccess.Building.Temp.PowerModeOffSuffix> - Off</RimWorldAccess.Building.Temp.PowerModeOffSuffix>
  <RimWorldAccess.Building.Temp.PowerModeHighSuffix> - High power</RimWorldAccess.Building.Temp.PowerModeHighSuffix>
  <RimWorldAccess.Building.Temp.PowerModeLowSuffix> - Low power</RimWorldAccess.Building.Temp.PowerModeLowSuffix>

</LanguageData>
