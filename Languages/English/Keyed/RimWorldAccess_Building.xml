  <RimWorldAccess.Building.Refuel.RemainingTimeSuffix> ({0})</RimWorldAccess.Building.Refuel.RemainingTimeSuffix>
  <RimWorldAccess.Building.Refuel.FuelTypeLabel>Fuel type: {0}</RimWorldAccess.Building.Refuel.FuelTypeLabel>

  <!-- Rename modal results (src/Building/{Pen,Zone,Storage}RenameState.cs).
       The "Renamed to {0}" success key is shared with the rest of the mod
       via RimWorldAccess.UI.Name.Renamed; only the cancel/error/validation
       phrasings vary per renamable type, so those live here.

       NameAlreadyUsedByZone / NameAlreadyUsedByGroup are validator messages
       returned to the text-input layer in an AcceptanceReport — they appear
       to the user as the rejection reason.
       {0} = the conflicting name. -->
  <RimWorldAccess.Building.Rename.Cancelled>Rename cancelled</RimWorldAccess.Building.Rename.Cancelled>
