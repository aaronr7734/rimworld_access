  <!-- {0} = file name (stripped of extension). -->
  <!-- Row LABELS only. The mode verb stays in the label because it is the only
       thing distinguishing a save row (Enter overwrites) from a load row (Enter
       loads) once inside the list; the composer supplies position, the date-time
       rides Extras. Overwrite/Load: {0} = file name, stripped of its extension. -->

  <RimWorldAccess.UI.Save.OverwriteLabel>Overwrite: {0}</RimWorldAccess.UI.Save.OverwriteLabel>
  <RimWorldAccess.UI.Save.LoadLabel>Load: {0}</RimWorldAccess.UI.Save.LoadLabel>

