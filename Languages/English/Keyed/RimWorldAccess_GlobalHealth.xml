<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- Health overview screen (src/Shell/Screens/GlobalHealthScope.Game.cs). -->
  <RimWorldAccess.GlobalHealth.Title>Health overview</RimWorldAccess.GlobalHealth.Title>
  <RimWorldAccess.GlobalHealth.RegionName>Pawns</RimWorldAccess.GlobalHealth.RegionName>
  <RimWorldAccess.GlobalHealth.Node.DownedBleeding>Downed and bleeding</RimWorldAccess.GlobalHealth.Node.DownedBleeding>
  <RimWorldAccess.GlobalHealth.Node.Downed>Downed</RimWorldAccess.GlobalHealth.Node.Downed>
  <RimWorldAccess.GlobalHealth.Node.Bleeding>Bleeding</RimWorldAccess.GlobalHealth.Node.Bleeding>
  <RimWorldAccess.GlobalHealth.Node.Injured>Injured</RimWorldAccess.GlobalHealth.Node.Injured>
  <!-- Node summaries. {0} = the node's name (one of the Node strings above), {1} = how many pawns it holds, then {2} (or {1} in the One forms) = the soonest time left before bleeding out ("2 hours") or the lowest overall health ("38%"). NotSoon is used when no one in the node bleeds out within a day. -->
  <RimWorldAccess.GlobalHealth.Summary.None>{0}. None</RimWorldAccess.GlobalHealth.Summary.None>
  <RimWorldAccess.GlobalHealth.Summary.BleedOut>{0}. {1} pawns, soonest bleeds out in {2}</RimWorldAccess.GlobalHealth.Summary.BleedOut>
  <RimWorldAccess.GlobalHealth.Summary.BleedOutOne>{0}. 1 pawn, bleeds out in {1}</RimWorldAccess.GlobalHealth.Summary.BleedOutOne>
  <RimWorldAccess.GlobalHealth.Summary.NotSoon>{0}. {1} pawns, none in immediate danger</RimWorldAccess.GlobalHealth.Summary.NotSoon>
  <RimWorldAccess.GlobalHealth.Summary.NotSoonOne>{0}. 1 pawn, no immediate danger</RimWorldAccess.GlobalHealth.Summary.NotSoonOne>
  <RimWorldAccess.GlobalHealth.Summary.LowestHealth>{0}. {1} pawns, lowest {2} health</RimWorldAccess.GlobalHealth.Summary.LowestHealth>
  <RimWorldAccess.GlobalHealth.Summary.HealthOne>{0}. 1 pawn, {1} health</RimWorldAccess.GlobalHealth.Summary.HealthOne>
  <!-- {0} = the pawn's name with its group (one of the PawnGroup strings below), {1} = its health tag (one of the PawnHealth.Tag strings below). -->
  <RimWorldAccess.GlobalHealth.PawnRow>{0}. {1}</RimWorldAccess.GlobalHealth.PawnRow>
  <!-- After a filter checkbox is toggled. {0} = the checkbox's new state ("checked"), {1} = how many pawns are now listed. -->
  <RimWorldAccess.GlobalHealth.FilterChanged>{0}. {1} pawns listed.</RimWorldAccess.GlobalHealth.FilterChanged>
  <RimWorldAccess.GlobalHealth.FilterChangedOne>{0}. 1 pawn listed.</RimWorldAccess.GlobalHealth.FilterChangedOne>
  <RimWorldAccess.GlobalHealth.JumpUnavailable>The pawn cannot be located.</RimWorldAccess.GlobalHealth.JumpUnavailable>
  <!-- Pawn health tags, spoken on health overview rows and after scanner pawns. {0} = overall health ("45%"), {1} = time left before bleeding out ("2 hours"). The bleeding words mirror the vanilla health tab: "no immediate danger" past a day, "deathless" for the Biotech gene. -->
  <RimWorldAccess.PawnHealth.Tag.Health>{0} health</RimWorldAccess.PawnHealth.Tag.Health>
  <RimWorldAccess.PawnHealth.Tag.Downed>downed, {0} health</RimWorldAccess.PawnHealth.Tag.Downed>
  <RimWorldAccess.PawnHealth.Tag.Bleeding>bleeding out in {1}, {0} health</RimWorldAccess.PawnHealth.Tag.Bleeding>
  <RimWorldAccess.PawnHealth.Tag.DownedBleeding>downed, bleeding out in {1}, {0} health</RimWorldAccess.PawnHealth.Tag.DownedBleeding>
  <RimWorldAccess.PawnHealth.Tag.BleedingNotSoon>bleeding, no immediate danger, {0} health</RimWorldAccess.PawnHealth.Tag.BleedingNotSoon>
  <RimWorldAccess.PawnHealth.Tag.DownedBleedingNotSoon>downed, bleeding, no immediate danger, {0} health</RimWorldAccess.PawnHealth.Tag.DownedBleedingNotSoon>
  <RimWorldAccess.PawnHealth.Tag.BleedingDeathless>bleeding, deathless, {0} health</RimWorldAccess.PawnHealth.Tag.BleedingDeathless>
  <RimWorldAccess.PawnHealth.Tag.DownedBleedingDeathless>downed, bleeding, deathless, {0} health</RimWorldAccess.PawnHealth.Tag.DownedBleedingDeathless>
  <!-- Pawn group tags, shared by the health overview and the gear menu. {0} = the pawn's short name. Wild is a pawn with no faction, like a wild man. -->
  <RimWorldAccess.PawnGroup.Colonist>{0}, colonist</RimWorldAccess.PawnGroup.Colonist>
  <RimWorldAccess.PawnGroup.ColonyMech>{0}, colony mech</RimWorldAccess.PawnGroup.ColonyMech>
  <RimWorldAccess.PawnGroup.ColonyAnimal>{0}, colony animal</RimWorldAccess.PawnGroup.ColonyAnimal>
  <RimWorldAccess.PawnGroup.Slave>{0}, slave</RimWorldAccess.PawnGroup.Slave>
  <RimWorldAccess.PawnGroup.Prisoner>{0}, prisoner</RimWorldAccess.PawnGroup.Prisoner>
  <RimWorldAccess.PawnGroup.Visitor>{0}, visitor</RimWorldAccess.PawnGroup.Visitor>
  <RimWorldAccess.PawnGroup.Wild>{0}, wild</RimWorldAccess.PawnGroup.Wild>
  <RimWorldAccess.PawnGroup.Hostile>{0}, hostile</RimWorldAccess.PawnGroup.Hostile>
  <!-- The group filter checkboxes in the health overview and the gear menu. Visitors also covers pawns with no faction. -->
  <RimWorldAccess.PawnGroup.FiltersRegion>Filters</RimWorldAccess.PawnGroup.FiltersRegion>
  <RimWorldAccess.PawnGroup.Filter.Colonists>Colonists</RimWorldAccess.PawnGroup.Filter.Colonists>
  <RimWorldAccess.PawnGroup.Filter.ColonyAnimals>Colony animals</RimWorldAccess.PawnGroup.Filter.ColonyAnimals>
  <RimWorldAccess.PawnGroup.Filter.ColonyMechs>Colony mechanoids</RimWorldAccess.PawnGroup.Filter.ColonyMechs>
  <RimWorldAccess.PawnGroup.Filter.PrisonersAndSlaves>Prisoners and slaves</RimWorldAccess.PawnGroup.Filter.PrisonersAndSlaves>
  <RimWorldAccess.PawnGroup.Filter.Visitors>Visitors</RimWorldAccess.PawnGroup.Filter.Visitors>
  <RimWorldAccess.PawnGroup.Filter.Hostiles>Hostiles</RimWorldAccess.PawnGroup.Filter.Hostiles>
</LanguageData>
