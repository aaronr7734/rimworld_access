  <RimWorldAccess.Shell.Glyph.OpenInspector>Open inspector</RimWorldAccess.Shell.Glyph.OpenInspector>
  <RimWorldAccess.Shell.Glyph.ToggleLog>Toggle log</RimWorldAccess.Shell.Glyph.ToggleLog>

  <!-- Coverage-gaps packet: Dialog_ChooseColor / Dialog_SelectXenogerm. -->
  <RimWorldAccess.Shell.ChooseColor.RegionName>Colors</RimWorldAccess.Shell.ChooseColor.RegionName>

  <!-- The vanilla color-picker family (allowed-area and glower pickers): region names for
       ColorPickerScope. -->
  <RimWorldAccess.Shell.ColorPicker.PaletteRegion>Color palette</RimWorldAccess.Shell.ColorPicker.PaletteRegion>
  <RimWorldAccess.Shell.ColorPicker.AdjustRegion>Fine adjustment</RimWorldAccess.Shell.ColorPicker.AdjustRegion>
  <RimWorldAccess.Shell.ColorPicker.ReadbackRegion>Current selection</RimWorldAccess.Shell.ColorPicker.ReadbackRegion>
  <RimWorldAccess.Shell.SelectXenogerm.RegionName>Xenogerms</RimWorldAccess.Shell.SelectXenogerm.RegionName>
  <RimWorldAccess.Shell.SelectXenogerm.MoreGenes>and {0} more genes</RimWorldAccess.Shell.SelectXenogerm.MoreGenes>

  <!-- Action label keys (Shell.Action.*) are inert until the rebind UI exists — see
