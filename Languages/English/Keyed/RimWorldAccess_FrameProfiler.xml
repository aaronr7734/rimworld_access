<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- RimWorld 1.7's frame profiler (src/Shell/Screens/FrameProfiler/). Profiler readings such as
       "median", "p99" and column headers come from the game's own window and are not translated here. -->
  <RimWorldAccess.FrameProfiler.Title>Frame profiler</RimWorldAccess.FrameProfiler.Title>

  <RimWorldAccess.FrameProfiler.Region.Controls>Controls</RimWorldAccess.FrameProfiler.Region.Controls>
  <RimWorldAccess.FrameProfiler.Region.Summary>Summary</RimWorldAccess.FrameProfiler.Region.Summary>
  <RimWorldAccess.FrameProfiler.Region.Frames>Frames</RimWorldAccess.FrameProfiler.Region.Frames>
  <RimWorldAccess.FrameProfiler.Region.Timeline>Timeline</RimWorldAccess.FrameProfiler.Region.Timeline>
  <RimWorldAccess.FrameProfiler.Region.TableControls>Table controls</RimWorldAccess.FrameProfiler.Region.TableControls>
  <RimWorldAccess.FrameProfiler.Region.Table>Table</RimWorldAccess.FrameProfiler.Region.Table>
  <RimWorldAccess.FrameProfiler.Region.Threads>Threads</RimWorldAccess.FrameProfiler.Region.Threads>
  <RimWorldAccess.FrameProfiler.Region.Settings>Settings</RimWorldAccess.FrameProfiler.Region.Settings>

  <!-- Buttons the window draws as a bare symbol. -->
  <RimWorldAccess.FrameProfiler.Control.OlderFrame>Older frame</RimWorldAccess.FrameProfiler.Control.OlderFrame>
  <RimWorldAccess.FrameProfiler.Control.NewerFrame>Newer frame</RimWorldAccess.FrameProfiler.Control.NewerFrame>
  <RimWorldAccess.FrameProfiler.Control.NewestFrame>Newest frame</RimWorldAccess.FrameProfiler.Control.NewestFrame>
  <RimWorldAccess.FrameProfiler.Control.Close>Close</RimWorldAccess.FrameProfiler.Control.Close>
  <RimWorldAccess.FrameProfiler.Control.ExpandAll>Expand all</RimWorldAccess.FrameProfiler.Control.ExpandAll>
  <RimWorldAccess.FrameProfiler.Control.CollapseAll>Collapse all</RimWorldAccess.FrameProfiler.Control.CollapseAll>

  <RimWorldAccess.FrameProfiler.Search>Search</RimWorldAccess.FrameProfiler.Search>
  <RimWorldAccess.FrameProfiler.Filters>Filters</RimWorldAccess.FrameProfiler.Filters>
  <!-- {0} is the typed value, {1} its unit, such as "frames" or "fps". -->
  <RimWorldAccess.FrameProfiler.FieldValue>{0} {1}</RimWorldAccess.FrameProfiler.FieldValue>
  <!-- {0} is a column header drawn by the game, such as "total" or "calls". -->
  <RimWorldAccess.FrameProfiler.SortBy>Sort by {0}</RimWorldAccess.FrameProfiler.SortBy>
  <RimWorldAccess.FrameProfiler.SortedAscending>sorted ascending</RimWorldAccess.FrameProfiler.SortedAscending>
  <RimWorldAccess.FrameProfiler.SortedDescending>sorted descending</RimWorldAccess.FrameProfiler.SortedDescending>
  <!-- {0} is the list of the selected row's ancestors, outermost first. -->
  <RimWorldAccess.FrameProfiler.Path>Path: {0}</RimWorldAccess.FrameProfiler.Path>
  <!-- {0} is a column header drawn by the game, {1} the row's value in that column. -->
  <RimWorldAccess.FrameProfiler.Cell>{0} {1}</RimWorldAccess.FrameProfiler.Cell>
  <RimWorldAccess.FrameProfiler.PercentCell>{0} percent</RimWorldAccess.FrameProfiler.PercentCell>
  <RimWorldAccess.FrameProfiler.NoSearchMatch>does not match the search</RimWorldAccess.FrameProfiler.NoSearchMatch>

  <RimWorldAccess.FrameProfiler.Frame>Frame {0}</RimWorldAccess.FrameProfiler.Frame>
  <RimWorldAccess.FrameProfiler.OverBudget>over budget</RimWorldAccess.FrameProfiler.OverBudget>
  <RimWorldAccess.FrameProfiler.Spike>spike</RimWorldAccess.FrameProfiler.Spike>
  <!-- {0}, {1}, {2}: garbage collections of generations 0, 1 and 2. -->
  <RimWorldAccess.FrameProfiler.GarbageCollections>garbage collections {0}, {1}, {2}</RimWorldAccess.FrameProfiler.GarbageCollections>
  <RimWorldAccess.FrameProfiler.Promoted>promoted {0}</RimWorldAccess.FrameProfiler.Promoted>
  <RimWorldAccess.FrameProfiler.OnePause>{0} pause, stopped for {1}</RimWorldAccess.FrameProfiler.OnePause>
  <RimWorldAccess.FrameProfiler.Pauses>{0} pauses, stopped for {1}</RimWorldAccess.FrameProfiler.Pauses>
  <RimWorldAccess.FrameProfiler.Alloc>allocated {0}</RimWorldAccess.FrameProfiler.Alloc>
  <RimWorldAccess.FrameProfiler.AllocObjects>allocated {0} in {1} objects</RimWorldAccess.FrameProfiler.AllocObjects>
  <RimWorldAccess.FrameProfiler.PausedBefore>profiling paused for {0} before this frame</RimWorldAccess.FrameProfiler.PausedBefore>

  <RimWorldAccess.FrameProfiler.ZoneStart>starts at {0}</RimWorldAccess.FrameProfiler.ZoneStart>
  <RimWorldAccess.FrameProfiler.ZoneTotal>total {0}</RimWorldAccess.FrameProfiler.ZoneTotal>
  <RimWorldAccess.FrameProfiler.ZoneSelf>self {0}</RimWorldAccess.FrameProfiler.ZoneSelf>
  <RimWorldAccess.FrameProfiler.ZoneRunning>still running</RimWorldAccess.FrameProfiler.ZoneRunning>
  <RimWorldAccess.FrameProfiler.ThreadBusy>busy {0}</RimWorldAccess.FrameProfiler.ThreadBusy>
  <RimWorldAccess.FrameProfiler.Unprofiled>unprofiled {0}</RimWorldAccess.FrameProfiler.Unprofiled>
  <!-- {0} is the zone's name. -->
  <RimWorldAccess.FrameProfiler.RevealedInCallTree>{0} selected in the call tree</RimWorldAccess.FrameProfiler.RevealedInCallTree>

  <!-- Runtime pauses: moments the .NET runtime stopped the game, mostly garbage collections. -->
  <RimWorldAccess.FrameProfiler.PauseLane>Runtime pauses</RimWorldAccess.FrameProfiler.PauseLane>
  <RimWorldAccess.FrameProfiler.PauseCount>{0} in this frame</RimWorldAccess.FrameProfiler.PauseCount>
  <RimWorldAccess.FrameProfiler.PauseStopped>stopped {0}</RimWorldAccess.FrameProfiler.PauseStopped>
  <RimWorldAccess.FrameProfiler.PauseWaiting>waiting for threads {0}</RimWorldAccess.FrameProfiler.PauseWaiting>
  <!-- {0} collected, {1} promoted to an older generation. -->
  <RimWorldAccess.FrameProfiler.PauseCollected>collected {0}, promoted {1}</RimWorldAccess.FrameProfiler.PauseCollected>
  <RimWorldAccess.FrameProfiler.PauseByRuntime>triggered by a runtime thread</RimWorldAccess.FrameProfiler.PauseByRuntime>
  <RimWorldAccess.FrameProfiler.PauseByMainThread>triggered by the main thread</RimWorldAccess.FrameProfiler.PauseByMainThread>
  <RimWorldAccess.FrameProfiler.PauseByThread>triggered by thread {0}</RimWorldAccess.FrameProfiler.PauseByThread>

  <!-- {0} is the zone's name. -->
  <RimWorldAccess.FrameProfiler.RangeSelected>Selected the time span of {0}</RimWorldAccess.FrameProfiler.RangeSelected>

  <RimWorldAccess.FrameProfiler.AllThreads>All threads</RimWorldAccess.FrameProfiler.AllThreads>
  <RimWorldAccess.FrameProfiler.ThreadsSelected>{0} of {1} selected</RimWorldAccess.FrameProfiler.ThreadsSelected>

  <RimWorldAccess.FrameProfiler.Paused>Paused</RimWorldAccess.FrameProfiler.Paused>
  <RimWorldAccess.FrameProfiler.Recording>Recording</RimWorldAccess.FrameProfiler.Recording>
  <RimWorldAccess.FrameProfiler.FollowingNewest>Following the newest frame</RimWorldAccess.FrameProfiler.FollowingNewest>
  <RimWorldAccess.FrameProfiler.SelectionCleared>Frame selection cleared</RimWorldAccess.FrameProfiler.SelectionCleared>
  <RimWorldAccess.FrameProfiler.Copied>Row copied</RimWorldAccess.FrameProfiler.Copied>
  <RimWorldAccess.FrameProfiler.ViewCopied>View copied</RimWorldAccess.FrameProfiler.ViewCopied>
</LanguageData>
