<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Abilities module strings (src/Abilities/). Six files contribute:
      - AbilityTargetingHelper.cs  (helpers that build most announcement text)
      - AbilityTargetingPatch.cs   (Harmony hooks on Targeter.BeginTargeting)
      - AbilityTargetingState.cs   (psycast/ability map targeting)
      - JumpTargetingState.cs      (Jump Pack / Locust Armor jumping)
      - ItemTargetingState.cs      (CompTargetable/CompUsable items)
      - WorldAbilityTargetingState.cs (Farskip etc.)

    The targeting validation errors (out-of-range, line-of-sight, not-a-valid-
    target) are produced here and then spoken by src/Combat/TargetingPatch.cs;
    a handful of shared phrases (Out of range, Targeting: {0}, Invalid cursor
    position, No valid tile selected, World navigation not active) are pulled
    from RimWorldAccess_Common.xml and RimWorldAccess_Combat.xml instead of
    being re-declared.

    Placeholders follow string.Format. Whole-phrase keys are preferred for any
    composite sentence whose wording or word order should be free to vary by
    language. One/Many splits are only used where English agreement actually
    differs; single-form keys rely on each language's LanguageWorker.
  -->

  <!-- Fallback labels used when the specific target/equipment/ability can't
       be named. Spoken inline inside larger sentences, so keep them lowercase
       like the nouns they substitute for ("Jumping to ground", not "Jumping
       to Ground"). -->
  <RimWorldAccess.Abilities.Label.Unknown>unknown</RimWorldAccess.Abilities.Label.Unknown>
  <RimWorldAccess.Abilities.Label.Invalid>invalid</RimWorldAccess.Abilities.Label.Invalid>
  <RimWorldAccess.Abilities.Label.Location>location</RimWorldAccess.Abilities.Label.Location>
  <RimWorldAccess.Abilities.Label.Ground>ground</RimWorldAccess.Abilities.Label.Ground>
  <RimWorldAccess.Abilities.Label.Target>target</RimWorldAccess.Abilities.Label.Target>
  <RimWorldAccess.Abilities.Label.Item>item</RimWorldAccess.Abilities.Label.Item>
  <RimWorldAccess.Abilities.Label.Permit>permit</RimWorldAccess.Abilities.Label.Permit>
  <RimWorldAccess.Abilities.Label.Jump>Jump</RimWorldAccess.Abilities.Label.Jump>

  <!-- Target-requirement phrases, substituted into "No {requirement} at
       cursor" and similar sentences. The trailing "valid target" form is the
       fallback; translators may want distinct words depending on context. -->
  <RimWorldAccess.Abilities.TargetKind.Unknown>unknown</RimWorldAccess.Abilities.TargetKind.Unknown>
  <RimWorldAccess.Abilities.TargetKind.LocationOrPawn>location or pawn</RimWorldAccess.Abilities.TargetKind.LocationOrPawn>
  <RimWorldAccess.Abilities.TargetKind.Pawn>pawn</RimWorldAccess.Abilities.TargetKind.Pawn>
  <RimWorldAccess.Abilities.TargetKind.HumanlikePawn>humanlike pawn</RimWorldAccess.Abilities.TargetKind.HumanlikePawn>
  <RimWorldAccess.Abilities.TargetKind.Animal>animal</RimWorldAccess.Abilities.TargetKind.Animal>
  <RimWorldAccess.Abilities.TargetKind.BuildingOrStructure>building or structure</RimWorldAccess.Abilities.TargetKind.BuildingOrStructure>
  <RimWorldAccess.Abilities.TargetKind.ValidTarget>valid target</RimWorldAccess.Abilities.TargetKind.ValidTarget>

  <!-- Initial ability-targeting announcement, built up piecewise by
       AbilityTargetingHelper.BuildTargetingStartAnnouncement. {0} = ability
       label; other placeholders are inserted as their own fragments so that
       the sentence reads naturally even when some pieces are omitted. -->
  <RimWorldAccess.Abilities.Start.Fallback>Ability targeting</RimWorldAccess.Abilities.Start.Fallback>
  <RimWorldAccess.Abilities.Start.Header>{0} targeting</RimWorldAccess.Abilities.Start.Header>
  <RimWorldAccess.Abilities.Start.TouchRange>. Touch range</RimWorldAccess.Abilities.Start.TouchRange>
  <RimWorldAccess.Abilities.Start.Range>. Range: {0} tiles</RimWorldAccess.Abilities.Start.Range>
  <RimWorldAccess.Abilities.Start.AOE>, AOE radius: {0} tiles</RimWorldAccess.Abilities.Start.AOE>
  <RimWorldAccess.Abilities.Start.Psyfocus>. Psyfocus: {0}</RimWorldAccess.Abilities.Start.Psyfocus>
  <RimWorldAccess.Abilities.Start.NeuralHeat>, Neural heat: {0}</RimWorldAccess.Abilities.Start.NeuralHeat>
  <RimWorldAccess.Abilities.Start.HintAoe>. Press R to check distance and line of sight, T to see affected targets.</RimWorldAccess.Abilities.Start.HintAoe>
  <RimWorldAccess.Abilities.Start.HintSingle>. Press R to check distance and line of sight.</RimWorldAccess.Abilities.Start.HintSingle>

  <!-- Range/LOS/target feedback built by AbilityTargetingHelper.
       BuildRangeInfoAnnouncement. {0} = distance; {1} = max range.
       InRange/OutOfRange forms are dedicated so translators can reorder
       subject, distance, and verdict freely; NoTargetAtCursor takes the
       target-kind word as {0}. -->
  <RimWorldAccess.Abilities.Range.NoAbilityActive>No ability active</RimWorldAccess.Abilities.Range.NoAbilityActive>
  <RimWorldAccess.Abilities.Range.Distance>Distance: {0} tiles</RimWorldAccess.Abilities.Range.Distance>
  <RimWorldAccess.Abilities.Range.InRange>, IN RANGE</RimWorldAccess.Abilities.Range.InRange>
  <RimWorldAccess.Abilities.Range.OutOfRange>, OUT OF RANGE (max {0})</RimWorldAccess.Abilities.Range.OutOfRange>
  <RimWorldAccess.Abilities.Range.InRangeTouch>, IN RANGE (touch)</RimWorldAccess.Abilities.Range.InRangeTouch>
  <RimWorldAccess.Abilities.Range.MustBeAdjacent>, must be adjacent (touch range)</RimWorldAccess.Abilities.Range.MustBeAdjacent>
  <RimWorldAccess.Abilities.Range.NoLineOfSight>, NO LINE OF SIGHT</RimWorldAccess.Abilities.Range.NoLineOfSight>
  <RimWorldAccess.Abilities.Range.NoTargetAtCursor>. No {0} at cursor</RimWorldAccess.Abilities.Range.NoTargetAtCursor>

  <!-- Affected-target preview (T key). The AOE list uses whole-phrase One/Many
       keys because English agreement differs (one target: "Target: Bob"; many:
       "Affected: 3 - Bob, Alice, ..."). NoValidTargetsAoe/NoValidTargetSingle
       explain what the ability actually needs. -->
  <RimWorldAccess.Abilities.Affected.NoValidTargetsAoe>No valid targets. This ability requires targeting a {0}, then affects others within {1} tile radius</RimWorldAccess.Abilities.Affected.NoValidTargetsAoe>
  <RimWorldAccess.Abilities.Affected.NoValidTargetSingle>No valid target at cursor. This ability requires a {0}</RimWorldAccess.Abilities.Affected.NoValidTargetSingle>
  <RimWorldAccess.Abilities.Affected.NoPawnsInRadius>No pawns within AOE radius</RimWorldAccess.Abilities.Affected.NoPawnsInRadius>
  <RimWorldAccess.Abilities.Affected.TargetOne>Target: {0}</RimWorldAccess.Abilities.Affected.TargetOne>
  <RimWorldAccess.Abilities.Affected.CountPrefix>Affected: {0} - {1}</RimWorldAccess.Abilities.Affected.CountPrefix>
  <RimWorldAccess.Abilities.Affected.AndMore>, and {0} more</RimWorldAccess.Abilities.Affected.AndMore>

  <!-- Immunity message. {0} = pawn label. -->
  <RimWorldAccess.Abilities.Immunity.Psychic>{0} is immune to psychic effects</RimWorldAccess.Abilities.Immunity.Psychic>

  <!-- Map targeting state messages (R/T spoken when state is inactive or the
       cursor is junk). NoAbilityTargeting/NoJumpTargeting are distinct so a
       future rewording can disambiguate them. -->
  <RimWorldAccess.Abilities.State.NoAbilityTargeting>No ability targeting active</RimWorldAccess.Abilities.State.NoAbilityTargeting>
  <RimWorldAccess.Abilities.State.NoJumpTargeting>No jump targeting active</RimWorldAccess.Abilities.State.NoJumpTargeting>

  <!-- Enter-confirmation validation errors. Spoken by TargetingPatch when an
       ability/jump rejects the cursor. Range/LOS errors reuse the Combat
       module keys (Combat.Target.OutOfRange and the existing
       Combat.Target.NotValidTarget pattern). -->
  <RimWorldAccess.Abilities.Validate.LineOfSight>No line of sight to target</RimWorldAccess.Abilities.Validate.LineOfSight>
  <RimWorldAccess.Abilities.Validate.NoPawnAoeNearby>No pawn at cursor. Nearby targets: {0}. Move cursor directly onto a pawn to target them</RimWorldAccess.Abilities.Validate.NoPawnAoeNearby>
  <RimWorldAccess.Abilities.Validate.NoPawnAoeRadius>No pawn at cursor. This AOE ability requires targeting a pawn directly, then affects others within {0} tiles</RimWorldAccess.Abilities.Validate.NoPawnAoeRadius>
  <RimWorldAccess.Abilities.Validate.NoValidAtCursor>No {0} at cursor. Move cursor onto a valid target</RimWorldAccess.Abilities.Validate.NoValidAtCursor>

  <!-- Success announcement for map ability targeting (sighted-equivalent of
       the targeted confirmation beep). Uses whole-phrase keys per case so
       One/Many pawn counts can inflect the verb as each language requires. -->
  <RimWorldAccess.Abilities.Success.TargetingLocation>Targeting: {0}</RimWorldAccess.Abilities.Success.TargetingLocation>
  <RimWorldAccess.Abilities.Success.TargetingLocationNoPawns>Targeting location. No pawns in radius</RimWorldAccess.Abilities.Success.TargetingLocationNoPawns>
  <RimWorldAccess.Abilities.Success.TargetingOne>Targeting: {0}</RimWorldAccess.Abilities.Success.TargetingOne>
  <RimWorldAccess.Abilities.Success.TargetingMany>Targeting {0} pawns: {1}</RimWorldAccess.Abilities.Success.TargetingMany>

  <!-- Jump targeting (Jump Pack, Locust Armor). Per-tile validity prefixes
       ({0}) are prepended to cursor announcements during arrow navigation,
       so they end with ", ". Longer "Cannot jump here: ..." forms are
       Enter-confirmation errors. -->
  <RimWorldAccess.Abilities.Jump.Start>{0} targeting. Range: {1} tiles</RimWorldAccess.Abilities.Jump.Start>
  <RimWorldAccess.Abilities.Jump.Charges>. {0}/{1} charges</RimWorldAccess.Abilities.Jump.Charges>
  <RimWorldAccess.Abilities.Jump.HintR>. Press R to check distance and line of sight.</RimWorldAccess.Abilities.Jump.HintR>

  <RimWorldAccess.Abilities.Jump.InvalidTargetFallback>, invalid jump target</RimWorldAccess.Abilities.Jump.InvalidTargetFallback>
  <RimWorldAccess.Abilities.Jump.InvalidReasonSuffix>, {0}</RimWorldAccess.Abilities.Jump.InvalidReasonSuffix>
  <RimWorldAccess.Abilities.Jump.ValidSuffix>, valid jump target</RimWorldAccess.Abilities.Jump.ValidSuffix>

  <!-- Per-tile validity prefixes spoken when arrow navigating during jump
       targeting. Each ends with ", " so the following cell name reads
       smoothly. -->
  <RimWorldAccess.Abilities.Jump.PrefixInvalid>Invalid, </RimWorldAccess.Abilities.Jump.PrefixInvalid>
  <RimWorldAccess.Abilities.Jump.PrefixOutOfRange>Out of range, </RimWorldAccess.Abilities.Jump.PrefixOutOfRange>
  <RimWorldAccess.Abilities.Jump.PrefixNoLineOfSight>No line of sight, </RimWorldAccess.Abilities.Jump.PrefixNoLineOfSight>
  <RimWorldAccess.Abilities.Jump.PrefixImpassable>Impassable, </RimWorldAccess.Abilities.Jump.PrefixImpassable>
  <RimWorldAccess.Abilities.Jump.PrefixFogged>Fogged, </RimWorldAccess.Abilities.Jump.PrefixFogged>
  <RimWorldAccess.Abilities.Jump.PrefixClosedDoor>Closed door, </RimWorldAccess.Abilities.Jump.PrefixClosedDoor>
  <RimWorldAccess.Abilities.Jump.PrefixNotWalkable>Not walkable, </RimWorldAccess.Abilities.Jump.PrefixNotWalkable>
  <RimWorldAccess.Abilities.Jump.PrefixCanJump>Can jump, </RimWorldAccess.Abilities.Jump.PrefixCanJump>

  <!-- Short inline reasons appended to the R-key detailed announcement.
       Lowercase - they follow a comma inside a sentence. -->
  <RimWorldAccess.Abilities.Jump.ReasonImpassable>impassable terrain</RimWorldAccess.Abilities.Jump.ReasonImpassable>
  <RimWorldAccess.Abilities.Jump.ReasonFogged>fogged area</RimWorldAccess.Abilities.Jump.ReasonFogged>
  <RimWorldAccess.Abilities.Jump.ReasonClosedDoor>closed door</RimWorldAccess.Abilities.Jump.ReasonClosedDoor>
  <RimWorldAccess.Abilities.Jump.ReasonNotWalkable>not walkable</RimWorldAccess.Abilities.Jump.ReasonNotWalkable>

  <!-- Enter-confirmation validation errors for jump targeting. Composed with
       a leading "Cannot jump here:" to stay distinct from similar non-jump
       error messages. Distance/range shared format: {0} = distance,
       {1} = max. -->
  <RimWorldAccess.Abilities.Jump.ErrorInvalidPosition>Invalid target position</RimWorldAccess.Abilities.Jump.ErrorInvalidPosition>
  <RimWorldAccess.Abilities.Jump.ErrorOutOfRange>Out of range. Distance: {0} tiles, max range: {1}</RimWorldAccess.Abilities.Jump.ErrorOutOfRange>
  <RimWorldAccess.Abilities.Jump.ErrorLineOfSight>No line of sight to target</RimWorldAccess.Abilities.Jump.ErrorLineOfSight>
  <RimWorldAccess.Abilities.Jump.ErrorImpassable>Cannot jump here: impassable terrain</RimWorldAccess.Abilities.Jump.ErrorImpassable>
  <RimWorldAccess.Abilities.Jump.ErrorFogged>Cannot jump here: fogged area</RimWorldAccess.Abilities.Jump.ErrorFogged>
  <RimWorldAccess.Abilities.Jump.ErrorClosedDoor>Cannot jump here: closed door</RimWorldAccess.Abilities.Jump.ErrorClosedDoor>
  <RimWorldAccess.Abilities.Jump.ErrorNotWalkable>Cannot jump here: not walkable</RimWorldAccess.Abilities.Jump.ErrorNotWalkable>
  <RimWorldAccess.Abilities.Jump.ErrorNoCharges>No charges remaining</RimWorldAccess.Abilities.Jump.ErrorNoCharges>
  <RimWorldAccess.Abilities.Jump.ErrorAlreadyQueued>Jump already queued</RimWorldAccess.Abilities.Jump.ErrorAlreadyQueued>

  <!-- Jump success announcement ({0} = terrain/location label, e.g. "gravel"
       or the Label.Location fallback). -->
  <RimWorldAccess.Abilities.Jump.SuccessTo>Jumping to {0}</RimWorldAccess.Abilities.Jump.SuccessTo>
  <RimWorldAccess.Abilities.Jump.SuccessBare>Jumping</RimWorldAccess.Abilities.Jump.SuccessBare>

  <!-- Item targeting (CompTargetable / CompUsable / float-menu callbacks).
       Start announcements include the item label and the game's own
       mouse-attached instruction text. Selection/Fallback labels are spoken
       when a float-menu caller doesn't provide one. -->
  <RimWorldAccess.Abilities.Item.StartWithInstruction>{0}: {1}. Navigate with arrow keys, Enter to confirm.</RimWorldAccess.Abilities.Item.StartWithInstruction>
  <RimWorldAccess.Abilities.Item.StartCallback>{0}. Navigate with arrow keys, Enter to confirm, Escape to cancel.</RimWorldAccess.Abilities.Item.StartCallback>
  <RimWorldAccess.Abilities.Item.DefaultInstruction>Select a target</RimWorldAccess.Abilities.Item.DefaultInstruction>
  <RimWorldAccess.Abilities.Item.InferPawn>Select pawn to target</RimWorldAccess.Abilities.Item.InferPawn>
  <RimWorldAccess.Abilities.Item.InferBuilding>Select building to target</RimWorldAccess.Abilities.Item.InferBuilding>
  <RimWorldAccess.Abilities.Item.InferItem>Select item to target</RimWorldAccess.Abilities.Item.InferItem>
  <RimWorldAccess.Abilities.Item.InferLocation>Select location</RimWorldAccess.Abilities.Item.InferLocation>

  <!-- Item targeting success/error. The two success forms differ because
       "Using {item} on {target}" requires more context than the bare
       "Target selected" fallback. -->
  <RimWorldAccess.Abilities.Item.SuccessUsing>Using {0} on {1}</RimWorldAccess.Abilities.Item.SuccessUsing>
  <RimWorldAccess.Abilities.Item.SuccessSelected>Target selected: {0}</RimWorldAccess.Abilities.Item.SuccessSelected>
  <RimWorldAccess.Abilities.Item.NoTargetAtCursor>No valid target at cursor</RimWorldAccess.Abilities.Item.NoTargetAtCursor>

  <!-- Permit targeting (RoyalTitlePermitWorker_Targeted). {0} = permit
       label. -->
  <RimWorldAccess.Abilities.Permit.Start>Select a target for {0}. Navigate with arrow keys, Enter to confirm.</RimWorldAccess.Abilities.Permit.Start>

  <!-- World ability targeting (Farskip, etc.). Start sentence is composed
       from pieces so "Bringing N: names." can be omitted; TargetingStart
       holds the leading header, BringingOne/Many inject the AOE passenger
       list when present, and SelectDestination is the tail call to action. -->
  <RimWorldAccess.Abilities.World.TargetingStart>{0} world targeting.</RimWorldAccess.Abilities.World.TargetingStart>
  <RimWorldAccess.Abilities.World.BringingOne> Bringing {0}: {1}.</RimWorldAccess.Abilities.World.BringingOne>
  <RimWorldAccess.Abilities.World.BringingMany> Bringing {0}: {1}.</RimWorldAccess.Abilities.World.BringingMany>
  <RimWorldAccess.Abilities.World.SelectDestination> Select destination tile.</RimWorldAccess.Abilities.World.SelectDestination>

  <!-- World targeter runtime errors and confirmation/cancel announcements. -->
  <RimWorldAccess.Abilities.World.NotActive>World targeter not active</RimWorldAccess.Abilities.World.NotActive>
  <RimWorldAccess.Abilities.World.CannotAccessAction>Cannot access world targeter action</RimWorldAccess.Abilities.World.CannotAccessAction>
  <RimWorldAccess.Abilities.World.NoActionAvailable>No targeting action available</RimWorldAccess.Abilities.World.NoActionAvailable>
  <RimWorldAccess.Abilities.World.TargetSelected>Target selected</RimWorldAccess.Abilities.World.TargetSelected>
  <RimWorldAccess.Abilities.World.ErrorSelecting>Error selecting destination</RimWorldAccess.Abilities.World.ErrorSelecting>
  <RimWorldAccess.Abilities.World.Cancelled>Ability targeting cancelled</RimWorldAccess.Abilities.World.Cancelled>
  <RimWorldAccess.Abilities.World.InvalidTarget>Invalid target</RimWorldAccess.Abilities.World.InvalidTarget>
</LanguageData>
