<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Map module strings (src/Map/). Covers cursor navigation, the
    scanner system (categories, items, search filter), tile info
    readouts, time/weather announcements, bookmarks, go-to dialog,
    and the play-settings overlay menu.

    Phrasing decisions:
      - Cursor and scanner readouts compose many small fragments
        (label, distance, direction, bulk position, region size).
        Each composed shape is its own key so translators can
        reorder fragments instead of relying on C# concatenation.
      - "{N} tiles {direction}" stays as a parameterized key. The
        direction words come from Map.Direction.* and are bare
        nouns, since the same word also appears in cell-side
        descriptions ("fuel port east", "watch from north").
      - Door "(open)" / "(closed)" suffixes appear in both
        TileInfoHelper and ScannerLabelBuilder. Both delegate to
        Map.Label.WithDoorOpen / WithDoorClosed so the parenthesis
        style is editable in one place.
      - PlaySettings toggle labels are split into one key per
        semantic case (Auto-Rebuild on / Auto-Rebuild off / Auto-
        Rebuild enabled / Auto-Rebuild disabled) rather than glue-
        composing the noun with " enabled" / ": On".
      - Game data flowing through these announcements (def labels,
        designation labels, pawn names, terrain labels, room roles,
        ToStringMoney/ToStringPercent output, vanilla ClockTime/
        Weather/ClockDate labels) is NOT translated here - the game
        already provides localized strings.

    Shared phrases delegated elsewhere:
      - Map.JumpedTo / Map.SelectedCell        -> Common.xml
      - Search.NoMatches / Search.Cleared       -> Common.xml
      - Edge.* (boundary announcements)         -> Common.xml
      - Cancel button label                     -> vanilla "Cancel"
  -->

  <!-- =================================================================
       Compass directions (ScannerDirectionHelper, BookmarkHelper).
       Bare nouns composed into "{N} tiles {direction}" and into
       building-cell descriptions ("fuel port {direction}",
       "watch from {direction}", "Interact from {direction}", etc.).
       ================================================================= -->
  <RimWorldAccess.Map.Direction.North>North</RimWorldAccess.Map.Direction.North>
  <RimWorldAccess.Map.Direction.Northeast>Northeast</RimWorldAccess.Map.Direction.Northeast>
  <RimWorldAccess.Map.Direction.East>East</RimWorldAccess.Map.Direction.East>
  <RimWorldAccess.Map.Direction.Southeast>Southeast</RimWorldAccess.Map.Direction.Southeast>
  <RimWorldAccess.Map.Direction.South>South</RimWorldAccess.Map.Direction.South>
  <RimWorldAccess.Map.Direction.Southwest>Southwest</RimWorldAccess.Map.Direction.Southwest>
  <RimWorldAccess.Map.Direction.West>West</RimWorldAccess.Map.Direction.West>
  <RimWorldAccess.Map.Direction.Northwest>Northwest</RimWorldAccess.Map.Direction.Northwest>
  <!-- Lowercase forms used inside building-cell descriptions
       (e.g. "fuel port east", "Watch from south"). The capitalized
       variants above are spoken on their own; these compose into
       larger phrases. -->
  <RimWorldAccess.Map.Direction.Lower.North>north</RimWorldAccess.Map.Direction.Lower.North>
  <RimWorldAccess.Map.Direction.Lower.Northeast>northeast</RimWorldAccess.Map.Direction.Lower.Northeast>
  <RimWorldAccess.Map.Direction.Lower.East>east</RimWorldAccess.Map.Direction.Lower.East>
  <RimWorldAccess.Map.Direction.Lower.Southeast>southeast</RimWorldAccess.Map.Direction.Lower.Southeast>
  <RimWorldAccess.Map.Direction.Lower.South>south</RimWorldAccess.Map.Direction.Lower.South>
  <RimWorldAccess.Map.Direction.Lower.Southwest>southwest</RimWorldAccess.Map.Direction.Lower.Southwest>
  <RimWorldAccess.Map.Direction.Lower.West>west</RimWorldAccess.Map.Direction.Lower.West>
  <RimWorldAccess.Map.Direction.Lower.Northwest>northwest</RimWorldAccess.Map.Direction.Lower.Northwest>

  <!-- =================================================================
       Generic label fragments shared by ScannerLabelBuilder,
       TileInfoHelper, and other map readouts.
       ================================================================= -->
  <!-- Spoken when a thing/zone/room reference is null or unrecognized. -->
  <RimWorldAccess.Map.Label.Unknown>Unknown</RimWorldAccess.Map.Label.Unknown>
  <!-- Fallback when a Thing's label getter throws (e.g. corrupted
       Blueprint_Install with a missing minified item). -->
  <RimWorldAccess.Map.Label.Corrupted>Corrupted object</RimWorldAccess.Map.Label.Corrupted>
  <!-- Generic "label (defLabel)" pattern, e.g. "monument marker
       (haul)" or "concrete (smoothed)". {0} = primary label,
       {1} = the secondary def/category label. -->
  <RimWorldAccess.Map.Label.Suffixed>{0} ({1})</RimWorldAccess.Map.Label.Suffixed>
  <!-- Door state annotation. {0} = the door's label. -->
  <RimWorldAccess.Map.Label.WithDoorOpen>{0} (open)</RimWorldAccess.Map.Label.WithDoorOpen>
  <RimWorldAccess.Map.Label.WithDoorClosed>{0} (closed)</RimWorldAccess.Map.Label.WithDoorClosed>

  <!-- =================================================================
       Bookmark slots (BookmarkHelper).
       {0} = slot number (0-9, the user's typed digit).
       Set:        {0} = slot, {1} = TileInfoHelper.GetTileSummary().
       Jumped:     {0} = TileInfoHelper.GetTileSummary() at target.
       PeekHere:   {0} = tile summary at target (cursor is already
                   on the bookmarked tile).
       PeekDirection: {0} = tile summary, {1} = distance (already
                      formatted with no decimals), {2} = direction.
       ================================================================= -->
  <RimWorldAccess.Map.Bookmark.Set>Bookmark {0} set: {1}</RimWorldAccess.Map.Bookmark.Set>
  <RimWorldAccess.Map.Bookmark.NotSet>Bookmark {0} not set</RimWorldAccess.Map.Bookmark.NotSet>
  <RimWorldAccess.Map.Bookmark.Invalid>Bookmark {0} invalid</RimWorldAccess.Map.Bookmark.Invalid>
  <RimWorldAccess.Map.Bookmark.Jumped>Jumped. {0}</RimWorldAccess.Map.Bookmark.Jumped>
  <RimWorldAccess.Map.Bookmark.PeekHere>{0}, here</RimWorldAccess.Map.Bookmark.PeekHere>
  <RimWorldAccess.Map.Bookmark.PeekDirection>{0}, {1} tiles {2}</RimWorldAccess.Map.Bookmark.PeekDirection>

  <!-- =================================================================
       Cover info (CoverHelper.GetCoverInfo).
       Spoken as part of pawn announcements when a drafted player
       pawn or a hostile pawn has cover nearby.
       Behind: {0} = cover def label, {1} = block-chance percent
               string (already formatted by ToStringPercent).
       NoCoverLower: vanilla key reused via .Translate().
       ================================================================= -->
  <RimWorldAccess.Map.Cover.Behind>behind {0} (blocks {1})</RimWorldAccess.Map.Cover.Behind>

  <!-- =================================================================
       Tile detail hotkeys (DetailInfoPatch keys 1-7).
       UnknownKey is a defensive fallback that should never reach a
       user in normal play.
       ================================================================= -->
  <RimWorldAccess.Map.Detail.UnknownKey>Unknown key</RimWorldAccess.Map.Detail.UnknownKey>

  <!-- =================================================================
       Go-to dialog (GoToState, Ctrl+G).
       Open: {0} = current cursor x, {1} = current cursor z.
       FieldX/FieldZ: announced when the user moves between fields.
       Deleted: {0} = the deleted character (echo).
       ================================================================= -->
  <RimWorldAccess.Map.GoTo.Open>Go to. Currently at {0}, {1}</RimWorldAccess.Map.GoTo.Open>
  <RimWorldAccess.Map.GoTo.FieldX>X</RimWorldAccess.Map.GoTo.FieldX>
  <RimWorldAccess.Map.GoTo.FieldZ>Z</RimWorldAccess.Map.GoTo.FieldZ>
  <RimWorldAccess.Map.GoTo.InvalidX>Invalid X coordinate</RimWorldAccess.Map.GoTo.InvalidX>
  <RimWorldAccess.Map.GoTo.InvalidZ>Invalid Z coordinate</RimWorldAccess.Map.GoTo.InvalidZ>
  <RimWorldAccess.Map.GoTo.Cancelled>Cancelled</RimWorldAccess.Map.GoTo.Cancelled>
  <!-- Backspace echo, shared between GoToState and ScannerSearchState.
       {0} = the deleted character. -->
  <RimWorldAccess.Map.Input.Deleted>Deleted {0}</RimWorldAccess.Map.Input.Deleted>

  <!-- =================================================================
       Map switching and pawn cycling (MapNavigationPatch,
       ThingSelectionUtilityPatch). Triggered by Shift+. / Shift+, to
       cycle maps and by . / , to cycle player pawns on the active map.
       NewMapWithHint: spoken once when the user reaches a new map for
                      the first time and a second map exists.
                      {0} = map name, {1} = total map count.
       NewMapTotal:    same shape but the user has already seen the hint.
       MapClosedOne / MapClosedMany: spoken on map removal.
       SwitchOnlyOne / SwitchFailed: error fallbacks for Shift+./,
       SwitchNoPawns: {0} = target map name.
       SwitchWithInfo: {0} = target map name, {1} = presence info
                        (e.g. "3 colonists, 2 mechs") generated by
                        PawnSelectionState.
       ================================================================= -->
  <RimWorldAccess.Map.NewMap.WithHint>New map: {0}. You now have {1} maps. Use Shift+Period and Shift+Comma to switch between them.</RimWorldAccess.Map.NewMap.WithHint>
  <RimWorldAccess.Map.NewMap.Total>New map: {0}. {1} maps total.</RimWorldAccess.Map.NewMap.Total>
  <RimWorldAccess.Map.MapClosed.One>Map closed. One map remaining.</RimWorldAccess.Map.MapClosed.One>
  <RimWorldAccess.Map.MapClosed.Many>Map closed. {0} maps remaining.</RimWorldAccess.Map.MapClosed.Many>
  <RimWorldAccess.Map.Switch.OnlyOne>Only one map available</RimWorldAccess.Map.Switch.OnlyOne>
  <RimWorldAccess.Map.Switch.Failed>Could not switch maps</RimWorldAccess.Map.Switch.Failed>
  <RimWorldAccess.Map.Switch.NoPawns>Now at {0}. No player pawns here.</RimWorldAccess.Map.Switch.NoPawns>
  <RimWorldAccess.Map.Switch.WithInfo>Now at {0} ({1})</RimWorldAccess.Map.Switch.WithInfo>

  <!-- Pawn cycling (. / , without Shift, filtered to the current map).
       NoMechs / NoColonists: nothing to cycle to.
       Idle: fallback when GetJobReport() returns empty.
       Selection: {0} = pawn label, {1} = current job.
       SelectionWithCover: {0} = pawn label, {1} = cover info,
                           {2} = current job. -->
  <RimWorldAccess.Map.Pawn.NoMechs>No mechs on this map</RimWorldAccess.Map.Pawn.NoMechs>
  <RimWorldAccess.Map.Pawn.NoColonists>No colonists on this map</RimWorldAccess.Map.Pawn.NoColonists>
  <RimWorldAccess.Map.Pawn.Idle>Idle</RimWorldAccess.Map.Pawn.Idle>
  <RimWorldAccess.Map.Pawn.Selection>{0} - {1}</RimWorldAccess.Map.Pawn.Selection>
  <RimWorldAccess.Map.Pawn.SelectionWithCover>{0}, {1} - {2}</RimWorldAccess.Map.Pawn.SelectionWithCover>

  <!-- =================================================================
       Performance announcement (PerformanceAnnouncementState, Shift+T).
       Speed: {0} = speed name (Map.Time.Speed.*), {1} = actual TPS,
              {2} = target TPS, {3} = percent (0-100).
       SpeedSlowed: same shape with the threat slowdown clause baked in.
       ================================================================= -->
  <RimWorldAccess.Map.Performance.Unavailable>Performance data not available</RimWorldAccess.Map.Performance.Unavailable>
  <RimWorldAccess.Map.Performance.Speed>{0} speed, {1} of {2} ticks per second, {3} percent</RimWorldAccess.Map.Performance.Speed>
  <RimWorldAccess.Map.Performance.SpeedSlowed>{0} speed, slowed by threat, {1} of {2} ticks per second, {3} percent</RimWorldAccess.Map.Performance.SpeedSlowed>
  <!-- "Game paused" is spoken by both the performance announcer and
       the time-control patch when the user pauses. -->
  <RimWorldAccess.Map.Game.Paused>Game paused</RimWorldAccess.Map.Game.Paused>

  <!-- =================================================================
       Play-settings menu (PlaySettingsMenuState, opened from gizmo bar).
       Each toggle has four whole-phrase keys: option label in either
       state, plus the post-toggle confirmation in either direction.
       Splitting avoids glue-composing "Auto-Rebuild" + ": " + "On".
       ================================================================= -->
  <RimWorldAccess.Map.PlaySettings.AutoRebuild.LabelOn>Auto-Rebuild: On</RimWorldAccess.Map.PlaySettings.AutoRebuild.LabelOn>
  <RimWorldAccess.Map.PlaySettings.AutoRebuild.LabelOff>Auto-Rebuild: Off</RimWorldAccess.Map.PlaySettings.AutoRebuild.LabelOff>
  <RimWorldAccess.Map.PlaySettings.AutoRebuild.Enabled>Auto-Rebuild enabled</RimWorldAccess.Map.PlaySettings.AutoRebuild.Enabled>
  <RimWorldAccess.Map.PlaySettings.AutoRebuild.Disabled>Auto-Rebuild disabled</RimWorldAccess.Map.PlaySettings.AutoRebuild.Disabled>
  <RimWorldAccess.Map.PlaySettings.AutoHomeArea.LabelOn>Auto-Expand Home Area: On</RimWorldAccess.Map.PlaySettings.AutoHomeArea.LabelOn>
  <RimWorldAccess.Map.PlaySettings.AutoHomeArea.LabelOff>Auto-Expand Home Area: Off</RimWorldAccess.Map.PlaySettings.AutoHomeArea.LabelOff>
  <RimWorldAccess.Map.PlaySettings.AutoHomeArea.Enabled>Auto-Expand Home Area enabled</RimWorldAccess.Map.PlaySettings.AutoHomeArea.Enabled>
  <RimWorldAccess.Map.PlaySettings.AutoHomeArea.Disabled>Auto-Expand Home Area disabled</RimWorldAccess.Map.PlaySettings.AutoHomeArea.Disabled>
  <!-- The Cancel option label reuses vanilla "Cancel".Translate(). -->

  <!-- =================================================================
       Time announcement (TimeAnnouncementState, T).
       Composed sentence: "{Time}: {timeString}, {Weather}: {weatherLabel},
       {Date}: {dateString}, Season: {seasonLabel}, Days passed: {N days}".
       ClockTime / Weather / ClockDate are vanilla labels obtained via
       .Translate() at the call site; the section glue and the bare
       Season / DaysPassed labels live here.
       ================================================================= -->
  <RimWorldAccess.Map.Time.Unavailable>Time information not available</RimWorldAccess.Map.Time.Unavailable>
  <!-- 12-hour and 24-hour formatting. {0} = display hour, {1} =
       minute (already 2-digit padded), {2} = AM/PM word. -->
  <RimWorldAccess.Map.Time.Hour12>{0}:{1} {2}</RimWorldAccess.Map.Time.Hour12>
  <RimWorldAccess.Map.Time.Hour24>{0}:{1}</RimWorldAccess.Map.Time.Hour24>
  <!-- Section join. SectionFirst is used for the leading element of
       the sentence ("Time: 8:00 AM"); SectionAppend is used for every
       subsequent element (", Weather: Clear", ", Date: ...").
       {0} = label (vanilla "ClockTime"/"Weather"/"ClockDate"),
       {1} = value (the formatted time string, weather label,
       date string). -->
  <RimWorldAccess.Map.Time.SectionFirst>{0}: {1}</RimWorldAccess.Map.Time.SectionFirst>
  <RimWorldAccess.Map.Time.SectionAppend>, {0}: {1}</RimWorldAccess.Map.Time.SectionAppend>
  <!-- Standalone section labels for which vanilla has no exact key
       (Season is referenced as a noun by itself, days-passed phrases
       come from "Period1Day"/"PeriodDays").
       {0} = season label, {0} = days phrase ("1 day", "5 days"). -->
  <RimWorldAccess.Map.Time.SeasonAppend>, Season: {0}</RimWorldAccess.Map.Time.SeasonAppend>
  <RimWorldAccess.Map.Time.DaysPassedAppend>, Days passed: {0}</RimWorldAccess.Map.Time.DaysPassedAppend>

  <!-- =================================================================
       Time speed announcer (TimeControlAccessibilityPatch).
       Announcement composes a localized speed name into "Time speed:
       {0}". Paused gets a dedicated phrase ("Game paused", shared
       with Map.Game.Paused).
       Threat slowdown messages are surfaced through Messages.Message
       (so NotificationAccessibilityPatch already speaks them).
       ================================================================= -->
  <RimWorldAccess.Map.Time.SpeedAnnouncement>Time speed: {0}</RimWorldAccess.Map.Time.SpeedAnnouncement>
  <RimWorldAccess.Map.Time.Speed.Paused>Paused</RimWorldAccess.Map.Time.Speed.Paused>
  <RimWorldAccess.Map.Time.Speed.Normal>Normal</RimWorldAccess.Map.Time.Speed.Normal>
  <RimWorldAccess.Map.Time.Speed.Fast>Fast</RimWorldAccess.Map.Time.Speed.Fast>
  <RimWorldAccess.Map.Time.Speed.Superfast>Superfast</RimWorldAccess.Map.Time.Speed.Superfast>
  <RimWorldAccess.Map.Time.Speed.Ultrafast>Ultrafast</RimWorldAccess.Map.Time.Speed.Ultrafast>
  <RimWorldAccess.Map.Time.Threat.Slowed>Game slowed down by presence of threat.</RimWorldAccess.Map.Time.Threat.Slowed>
  <RimWorldAccess.Map.Time.Threat.Passed>Threat passed. Game speed resumed.</RimWorldAccess.Map.Time.Threat.Passed>

  <!-- =================================================================
       Jump-mode navigation (MapNavigationState).
       PageUp/PageDown cycles between modes; Ctrl+arrows jumps in the
       active mode.
       Distance:        {0} = the new preset jump distance (in tiles).
       PresetDistanceMode: {0} = the preset jump distance.
       Boundary / NoWallFound / AlreadyAdjacent: spoken when the jump
       cannot proceed.
       ================================================================= -->
  <RimWorldAccess.Map.Jump.Distance>Jump distance: {0}</RimWorldAccess.Map.Jump.Distance>
  <RimWorldAccess.Map.Jump.MinimumDistance>Minimum distance</RimWorldAccess.Map.Jump.MinimumDistance>
  <RimWorldAccess.Map.Jump.Mode.Terrain>Jump mode: Terrain</RimWorldAccess.Map.Jump.Mode.Terrain>
  <RimWorldAccess.Map.Jump.Mode.Buildings>Jump mode: Buildings</RimWorldAccess.Map.Jump.Mode.Buildings>
  <RimWorldAccess.Map.Jump.Mode.Geysers>Jump mode: Geysers</RimWorldAccess.Map.Jump.Mode.Geysers>
  <RimWorldAccess.Map.Jump.Mode.HarvestableTrees>Jump mode: Harvestable Trees</RimWorldAccess.Map.Jump.Mode.HarvestableTrees>
  <RimWorldAccess.Map.Jump.Mode.MinableTiles>Jump mode: Mineable Tiles</RimWorldAccess.Map.Jump.Mode.MinableTiles>
  <RimWorldAccess.Map.Jump.Mode.PresetDistance>Jump mode: Preset distance, {0} tiles</RimWorldAccess.Map.Jump.Mode.PresetDistance>
  <RimWorldAccess.Map.Jump.Mode.AdjacentToWall>Jump mode: Adjacent to Wall</RimWorldAccess.Map.Jump.Mode.AdjacentToWall>
  <RimWorldAccess.Map.Jump.Mode.Unknown>Jump mode: Unknown</RimWorldAccess.Map.Jump.Mode.Unknown>
  <RimWorldAccess.Map.Jump.Boundary>Map boundary</RimWorldAccess.Map.Jump.Boundary>
  <RimWorldAccess.Map.Jump.AlreadyAdjacent>Already adjacent to wall</RimWorldAccess.Map.Jump.AlreadyAdjacent>
  <RimWorldAccess.Map.Jump.NoWallFound>No wall found</RimWorldAccess.Map.Jump.NoWallFound>

  <!-- =================================================================
       Map display name fallback (MapNavigationState.GetMapDisplayName).
       Used in map-switch announcements and map-changed notifications
       when the map's parent has no readable label.
       Numbered: {0} = the map's unique numeric ID.
       ================================================================= -->
  <RimWorldAccess.Map.Display.Numbered>Map {0}</RimWorldAccess.Map.Display.Numbered>

  <!-- =================================================================
       Scanner search overlay (ScannerSearchState, Z key).
       Activated:    spoken when search mode opens.
       NowFiltering: {0} = the confirmed query; spoken on Enter.
       CategoryName: {0} = active query; used as the temporary scanner
                     category label, NOT spoken on its own.
       RestoredFilter: {0} = previous filter restored on cancel.
       NoResults / NoMatches: empty-result feedback. NoMatches reuses
                              the shared Common Search.NoMatches key
                              when announced from search input mode.
       Result.One/Many: {0} = first result label, {1} = total count.
       ================================================================= -->
  <RimWorldAccess.Map.Search.Activated>Search</RimWorldAccess.Map.Search.Activated>
  <RimWorldAccess.Map.Search.NowFiltering>Scanner now filtering {0}</RimWorldAccess.Map.Search.NowFiltering>
  <RimWorldAccess.Map.Search.CategoryName>Search: {0}</RimWorldAccess.Map.Search.CategoryName>
  <RimWorldAccess.Map.Search.RestoredFilter>Search cancelled. Restored filter: {0}</RimWorldAccess.Map.Search.RestoredFilter>
  <RimWorldAccess.Map.Search.Cancelled>Search cancelled</RimWorldAccess.Map.Search.Cancelled>
  <RimWorldAccess.Map.Search.FilterCleared>Search filter cleared</RimWorldAccess.Map.Search.FilterCleared>
  <RimWorldAccess.Map.Search.NoMap>No map available</RimWorldAccess.Map.Search.NoMap>
  <RimWorldAccess.Map.Search.WorldNavInactive>World navigation not active</RimWorldAccess.Map.Search.WorldNavInactive>
  <RimWorldAccess.Map.Search.NoResults>No results</RimWorldAccess.Map.Search.NoResults>
  <RimWorldAccess.Map.Search.Result.One>{0}, 1 result</RimWorldAccess.Map.Search.Result.One>
  <RimWorldAccess.Map.Search.Result.Many>{0}, {1} results</RimWorldAccess.Map.Search.Result.Many>

  <!-- =================================================================
       Scanner state (ScannerState). Drives Page Up/Page Down navigation
       through scanner items, plus the Ctrl/Shift modifiers for category
       and subcategory switching.
       ================================================================= -->
  <!-- Auto-jump toggle (Alt+Home). Whole-phrase split per direction. -->
  <RimWorldAccess.Map.Scanner.AutoJumpEnabled>Auto-jump mode enabled</RimWorldAccess.Map.Scanner.AutoJumpEnabled>
  <RimWorldAccess.Map.Scanner.AutoJumpDisabled>Auto-jump mode disabled</RimWorldAccess.Map.Scanner.AutoJumpDisabled>

  <!-- No-move guard (Home key): cursor is already on the target tile.
       AlreadyAt:       {0} = item label (e.g. "silver lode").
       AlreadyAtCenter: {0} = item label — cursor is specifically at the
                        center of a multi-tile patch. -->
  <RimWorldAccess.Map.Scanner.AlreadyAt>Already at {0}</RimWorldAccess.Map.Scanner.AlreadyAt>
  <RimWorldAccess.Map.Scanner.AlreadyAtCenter>Already at center of {0}</RimWorldAccess.Map.Scanner.AlreadyAtCenter>

  <!-- Error and edge announcements during scanner navigation. -->
  <RimWorldAccess.Map.Scanner.NotInitialized>Map navigation not initialized</RimWorldAccess.Map.Scanner.NotInitialized>
  <RimWorldAccess.Map.Scanner.NoActiveMap>No active map</RimWorldAccess.Map.Scanner.NoActiveMap>
  <RimWorldAccess.Map.Scanner.NoItems>No items found on map</RimWorldAccess.Map.Scanner.NoItems>
  <RimWorldAccess.Map.Scanner.ItemGone>Item no longer exists</RimWorldAccess.Map.Scanner.ItemGone>
  <RimWorldAccess.Map.Scanner.NoItemSelected>No item selected</RimWorldAccess.Map.Scanner.NoItemSelected>
  <RimWorldAccess.Map.Scanner.EmptyCategory>No items in this category</RimWorldAccess.Map.Scanner.EmptyCategory>

  <!-- Category / subcategory switch announcements.
       One/Many split for the item count.
       {0} = localized category or subcategory name (see CatName.* /
       SubName.* below), {1} = item count. -->
  <RimWorldAccess.Map.Scanner.CategoryAnnouncementOne>{0} - 1 item</RimWorldAccess.Map.Scanner.CategoryAnnouncementOne>
  <RimWorldAccess.Map.Scanner.CategoryAnnouncementMany>{0} - {1} items</RimWorldAccess.Map.Scanner.CategoryAnnouncementMany>

  <!-- End-key distance/direction readout. -->
  <RimWorldAccess.Map.Scanner.DistanceDirection>{0} tiles {1}</RimWorldAccess.Map.Scanner.DistanceDirection>
  <RimWorldAccess.Map.Scanner.Here>here</RimWorldAccess.Map.Scanner.Here>

  <!-- Item announcement composition (cursor-jumped to a scanner item).
       The bare announcement is one of:
         WithDirection: {0} = label, {1} = distance, {2} = direction.
         Here:          {0} = label.
       Optional suffixes are appended in this order:
         LocationSuffix:  " {0}" — pawn location context (in jail, etc.).
         CommaSuffix:     ", {0}" — cover info OR activity.
         BulkSuffix:      ", {0} of {1}" — bulk index inside group.
       Each suffix is its own key so a translator can change the
       separator (space vs comma) without editing C#. -->
  <RimWorldAccess.Map.Scanner.Item.WithDirection>{0}, {1} tiles {2}</RimWorldAccess.Map.Scanner.Item.WithDirection>
  <RimWorldAccess.Map.Scanner.Item.Here>{0}, here</RimWorldAccess.Map.Scanner.Item.Here>
  <RimWorldAccess.Map.Scanner.Item.LocationSuffix> {0}</RimWorldAccess.Map.Scanner.Item.LocationSuffix>
  <RimWorldAccess.Map.Scanner.Item.CommaSuffix>, {0}</RimWorldAccess.Map.Scanner.Item.CommaSuffix>
  <RimWorldAccess.Map.Scanner.Item.BulkSuffix>, {0} of {1}</RimWorldAccess.Map.Scanner.Item.BulkSuffix>

  <!-- Bulk-mode (Alt+PageUp/Down) announcements. Each shape is a
       whole phrase.
       TerrainBulk:   {0} = label, {1} = position, {2} = total.
       WithDirectionBulk: {0} = label, {1} = distance, {2} = direction,
                          {3} = position, {4} = total.
       HereBulk:      {0} = label, {1} = position, {2} = total. -->
  <RimWorldAccess.Map.Scanner.Item.TerrainBulk>{0} - {1} of {2}</RimWorldAccess.Map.Scanner.Item.TerrainBulk>
  <RimWorldAccess.Map.Scanner.Item.WithDirectionBulk>{0}, {1} tiles {2}, {3} of {4}</RimWorldAccess.Map.Scanner.Item.WithDirectionBulk>
  <RimWorldAccess.Map.Scanner.Item.HereBulk>{0}, here, {1} of {2}</RimWorldAccess.Map.Scanner.Item.HereBulk>

  <!-- Terrain region announcement (deep ore, contiguous-terrain bulk
       groups).
       WithDirection: {0} = label, {1} = size description,
                      {2} = distance, {3} = direction.
       Here:          {0} = label, {1} = size description.
       AreaSuffix:    ", area {0} of {1}" — appended when the item has
                      multiple terrain regions.
       SizeWithQuantity: {0} = tile count, {1} = total quantity,
                         {2} = ore def label. Used for deep ore deposits.
       DepositLabel: "{0} deposit" — used to label a deep ore region.
                     {0} = ore def label. -->
  <RimWorldAccess.Map.Scanner.Region.WithDirection>{0}: {1}, {2} tiles {3}</RimWorldAccess.Map.Scanner.Region.WithDirection>
  <RimWorldAccess.Map.Scanner.Region.Here>{0}: {1}, here</RimWorldAccess.Map.Scanner.Region.Here>
  <RimWorldAccess.Map.Scanner.Region.AreaSuffix>, area {0} of {1}</RimWorldAccess.Map.Scanner.Region.AreaSuffix>
  <RimWorldAccess.Map.Scanner.Region.SizeWithQuantity>{0} tiles ({1} {2})</RimWorldAccess.Map.Scanner.Region.SizeWithQuantity>
  <RimWorldAccess.Map.Scanner.DeepOre.Deposit>{0} deposit</RimWorldAccess.Map.Scanner.DeepOre.Deposit>

  <!-- Localized scanner category names (announced when navigating
       Ctrl+PageUp/Down). Internal Name strings stay in English so
