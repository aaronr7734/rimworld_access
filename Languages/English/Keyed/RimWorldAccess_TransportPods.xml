  <RimWorldAccess.TransportPods.Launch.FuelStatusRange>Max range: {0} tiles.</RimWorldAccess.TransportPods.Launch.FuelStatusRange>
  <RimWorldAccess.TransportPods.Launch.FuelStatusUnlimited>Unlimited range.</RimWorldAccess.TransportPods.Launch.FuelStatusUnlimited>
</LanguageData>
