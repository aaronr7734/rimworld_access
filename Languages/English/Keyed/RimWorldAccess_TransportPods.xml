  <RimWorldAccess.TransportPods.Launch.DestinationBare>Destination: {0} tiles</RimWorldAccess.TransportPods.Launch.DestinationBare>
  <RimWorldAccess.TransportPods.Launch.ErrorSelecting>Error selecting destination</RimWorldAccess.TransportPods.Launch.ErrorSelecting>

