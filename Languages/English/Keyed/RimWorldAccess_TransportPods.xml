<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    TransportPods module strings (src/TransportPods/). Five files contribute:
      - TransportPodHelper.cs            (pod announcement and fuel-cost formatting)
      - TransportPodPatch.cs             (custom gizmos, dialog lifecycle, keyboard-mode overlay)
      - TransportPodSelectionState.cs    (pod grouping selection mode on the map)
      - TransportPodLoadingState.cs      (Dialog_LoadTransporters keyboard navigation)
      - TransportPodLaunchState.cs       (world-map launch targeting with fuel budgeting)

    Covers both transport pods (base game) and shuttles (Royalty DLC), which
    reuse the same Dialog_LoadTransporters and CompLaunchable infrastructure.

    Strings produced by shared helpers live in the owning module:
      - GuardHelper / Edge announcements     -> RimWorldAccess_Common.xml
      - Typeahead "Search cleared"           -> RimWorldAccess_Common.xml
      - Map cursor "Invalid position"        -> RimWorldAccess_Input.xml
      - CaravanQuantityHelper "Taking X of Y, N kg, capacity limit" etc.
      - CaravanAnnouncementHelper item/search announcements
      - CaravanStatFormatter Mass/Speed/Food/Foraging/Visibility
      - CaravanInputHelper pawn-info shortcut announcements (Alt+H/M/N)
      - CaravanUIHelper helpers
      - PawnLabelHelper grouped pawn labels
    These will be localized by the World/UI modules; TransportPods delegates.

    One/Many splits exist where a bare count + noun is spoken in English, so
    translators can pick different plural classes (pod/pods). Mass and fuel
    announcements use whole-phrase keys per semantic case to keep word order
    localizable.
  -->

  <!-- =========================================================
       TransportPodHelper.cs - pod and fuel-cost announcement parts.
       ========================================================= -->

  <!-- Pod type labels. IsShuttle() picks between them for BuildPodAnnouncement
       and GetPodTypeLabel. Shuttles are Royalty DLC; transport pods are base. -->
  <RimWorldAccess.TransportPods.Pod.TypeTransportPod>Transport pod</RimWorldAccess.TransportPods.Pod.TypeTransportPod>
  <RimWorldAccess.TransportPods.Pod.TypeShuttle>Shuttle</RimWorldAccess.TransportPods.Pod.TypeShuttle>

  <!-- Per-pod announcement fragments (BuildPodAnnouncement). Joined with ", ".
       {0} = formatted fuel/capacity value, {1} = 1-based index, {2} = total. -->
  <RimWorldAccess.TransportPods.Pod.Selected>SELECTED</RimWorldAccess.TransportPods.Pod.Selected>
  <RimWorldAccess.TransportPods.Pod.FuelLevel>fuel {0}</RimWorldAccess.TransportPods.Pod.FuelLevel>
  <RimWorldAccess.TransportPods.Pod.NotConnectedToFuel>not connected to fuel</RimWorldAccess.TransportPods.Pod.NotConnectedToFuel>
  <RimWorldAccess.TransportPods.Pod.Capacity>capacity {0} kg</RimWorldAccess.TransportPods.Pod.Capacity>
  <RimWorldAccess.TransportPods.Pod.PositionInList>{0} of {1}</RimWorldAccess.TransportPods.Pod.PositionInList>

  <!-- Fuel cost announcement (BuildFuelCostAnnouncement). Shared with
       TransportPodLaunchState.GetFuelCostAnnouncementForTile. {0} = fuel cost,
       {1} = fuel available. "NoLauncher" and "Unavailable" are defensive
       fallbacks when the launchable or its props are missing. -->
  <RimWorldAccess.TransportPods.Fuel.NoLauncher>no launcher</RimWorldAccess.TransportPods.Fuel.NoLauncher>
  <RimWorldAccess.TransportPods.Fuel.CostUnavailable>fuel cost unavailable</RimWorldAccess.TransportPods.Fuel.CostUnavailable>
  <RimWorldAccess.TransportPods.Fuel.NotEnough>NOT ENOUGH FUEL, need {0}, have {1}</RimWorldAccess.TransportPods.Fuel.NotEnough>
  <RimWorldAccess.TransportPods.Fuel.CostChemfuel>{0} chemfuel</RimWorldAccess.TransportPods.Fuel.CostChemfuel>
  <RimWorldAccess.TransportPods.Fuel.OutOfRange>OUT OF RANGE</RimWorldAccess.TransportPods.Fuel.OutOfRange>

  <!-- =========================================================
       TransportPodPatch.cs - custom grouping gizmos and overlays.
       ========================================================= -->

  <!-- "Group all available pods" gizmo (CompTransporter_GetGizmos_Patch).
       Label: {0} = total pod count (source + all groupable).
       Desc: {0} = same count. Spoken when a sighted player reads the gizmo.
       NoGroupable: disable reason when no adjacent launchers are found;
       reused by the "Select pods to group" gizmo. -->
  <RimWorldAccess.TransportPods.Gizmo.GroupAllLabel>Group all available pods ({0})</RimWorldAccess.TransportPods.Gizmo.GroupAllLabel>
  <RimWorldAccess.TransportPods.Gizmo.GroupAllDesc>Select all {0} available transport pods and open the loading dialog.</RimWorldAccess.TransportPods.Gizmo.GroupAllDesc>
  <RimWorldAccess.TransportPods.Gizmo.SelectPodsLabel>Select pods to group</RimWorldAccess.TransportPods.Gizmo.SelectPodsLabel>
  <RimWorldAccess.TransportPods.Gizmo.SelectPodsDesc>Enter pod selection mode to choose which transport pods to group together for loading.</RimWorldAccess.TransportPods.Gizmo.SelectPodsDesc>
  <RimWorldAccess.TransportPods.Gizmo.NoGroupable>No other transport pods with connected launchers to group with.</RimWorldAccess.TransportPods.Gizmo.NoGroupable>

  <!-- Gizmo action results. {0} = pod count being grouped. -->
  <RimWorldAccess.TransportPods.Gizmo.LoadCommandMissing>Could not find load command</RimWorldAccess.TransportPods.Gizmo.LoadCommandMissing>
  <RimWorldAccess.TransportPods.Gizmo.GroupingForLoading>Grouping {0} pods for loading</RimWorldAccess.TransportPods.Gizmo.GroupingForLoading>

  <!-- Dialog lifecycle (Window_PostClose_LoadTransporters_Patch). Spoken when
       the user closes the loading dialog without pressing Accept. -->
  <RimWorldAccess.TransportPods.Loading.Cancelled>Transport pod loading cancelled</RimWorldAccess.TransportPods.Loading.Cancelled>

  <!-- Visual keyboard-mode overlay (Dialog_LoadTransporters_DoWindowContents_Patch).
       Sighted-user indicator drawn in the top-left of the loading dialog so
       testers can tell keyboard mode is active. Localized for consistency. -->
  <RimWorldAccess.TransportPods.Overlay.KeyboardModeActive>Keyboard Mode Active</RimWorldAccess.TransportPods.Overlay.KeyboardModeActive>
  <RimWorldAccess.TransportPods.Overlay.InstructionsLine1>Left/Right: Tabs | Up/Down: Items | Enter/Space: Quantity</RimWorldAccess.TransportPods.Overlay.InstructionsLine1>
  <RimWorldAccess.TransportPods.Overlay.InstructionsLine2>Tab: Mass Summary | Alt+I: Inspect | Alt+A: Accept | Esc: Cancel</RimWorldAccess.TransportPods.Overlay.InstructionsLine2>

  <!-- Landing-spot targeting announcement (Targeter_BeginTargeting_Announce_Patch).
       Spoken once when the drop-pod landing targeter activates. -->
  <RimWorldAccess.TransportPods.Landing.SelectLandingSpot>Select landing spot. Use arrow keys to navigate, Space to confirm.</RimWorldAccess.TransportPods.Landing.SelectLandingSpot>

  <!-- =========================================================
       TransportPodSelectionState.cs - pod grouping selection mode.
       ========================================================= -->

  <!-- Initialization errors. -->
  <RimWorldAccess.TransportPods.Selection.NoPodSelected>No pod selected</RimWorldAccess.TransportPods.Selection.NoPodSelected>

  <!-- Entry announcement (Open). {0} = number of pods that can be grouped
       (source pod + reachable launchers via flood fill). -->
  <RimWorldAccess.TransportPods.Selection.EnterMode>Pod selection mode. {0} pods can be grouped. Arrow to pods, Space to select, Enter to load.</RimWorldAccess.TransportPods.Selection.EnterMode>

  <!-- Cancellation (Close). -->
  <RimWorldAccess.TransportPods.Selection.Cancelled>Pod selection cancelled</RimWorldAccess.TransportPods.Selection.Cancelled>

  <!-- Per-toggle feedback (TogglePodAtCursor). {0} = current selected count. -->
  <RimWorldAccess.TransportPods.Selection.NoPodHere>No transport pod here</RimWorldAccess.TransportPods.Selection.NoPodHere>
  <RimWorldAccess.TransportPods.Selection.NotAdjacent>This pod's launcher is not adjacent to the group.</RimWorldAccess.TransportPods.Selection.NotAdjacent>
  <RimWorldAccess.TransportPods.Selection.AlreadyLoading>Pod is already loading or ready to launch</RimWorldAccess.TransportPods.Selection.AlreadyLoading>
  <RimWorldAccess.TransportPods.Selection.PodSelected>Pod selected. {0} selected</RimWorldAccess.TransportPods.Selection.PodSelected>
  <RimWorldAccess.TransportPods.Selection.PodDeselected>Pod deselected. {0} selected</RimWorldAccess.TransportPods.Selection.PodDeselected>

  <!-- Confirmation errors (ConfirmSelection). -->
  <RimWorldAccess.TransportPods.Selection.NoPodsSelected>No pods selected. Arrow to pods and press Space to select.</RimWorldAccess.TransportPods.Selection.NoPodsSelected>
  <RimWorldAccess.TransportPods.Selection.PodsUnavailable>Selected pods are no longer available</RimWorldAccess.TransportPods.Selection.PodsUnavailable>
  <RimWorldAccess.TransportPods.Selection.LoadCommandMissingMayBeLoading>Could not find load command. Pod may already be loading.</RimWorldAccess.TransportPods.Selection.LoadCommandMissingMayBeLoading>

  <!-- =========================================================
       TransportPodLoadingState.cs - Dialog_LoadTransporters keyboard nav.
       ========================================================= -->

  <!-- Open guards. -->
  <RimWorldAccess.TransportPods.Loading.NoDialog>No loading dialog available</RimWorldAccess.TransportPods.Loading.NoDialog>
  <RimWorldAccess.TransportPods.Loading.ReflectionFailed>Transport pod loading accessibility unavailable due to game update. Please check for mod updates.</RimWorldAccess.TransportPods.Loading.ReflectionFailed>

  <!-- Entry announcement. One/Many split so translators control pod/pods
       agreement; the pod-noun key is inlined into the sentence so word order
       stays natural across languages.
       {0} = pod count, {1} = total mass capacity. -->
  <RimWorldAccess.TransportPods.Loading.PodNounOne>pod</RimWorldAccess.TransportPods.Loading.PodNounOne>
  <RimWorldAccess.TransportPods.Loading.PodNounMany>pods</RimWorldAccess.TransportPods.Loading.PodNounMany>
  <RimWorldAccess.TransportPods.Loading.OpenAnnouncementOne>Load transport pod. {0} pod, {1} kg capacity. Left/Right for tabs, Enter to adjust.</RimWorldAccess.TransportPods.Loading.OpenAnnouncementOne>
  <RimWorldAccess.TransportPods.Loading.OpenAnnouncementMany>Load transport pods. {0} pods, {1} kg capacity. Left/Right for tabs, Enter to adjust.</RimWorldAccess.TransportPods.Loading.OpenAnnouncementMany>

  <!-- Tab navigation. -->
  <RimWorldAccess.TransportPods.Loading.TabPawns>Pawns</RimWorldAccess.TransportPods.Loading.TabPawns>
  <RimWorldAccess.TransportPods.Loading.TabItems>Items</RimWorldAccess.TransportPods.Loading.TabItems>
  <RimWorldAccess.TransportPods.Loading.TabAnnouncement>{0} tab, {1} items</RimWorldAccess.TransportPods.Loading.TabAnnouncement>
  <RimWorldAccess.TransportPods.Loading.ReturnedToTab>Returned to {0} tab</RimWorldAccess.TransportPods.Loading.ReturnedToTab>

  <!-- Shared empty-tab feedback (spoken in multiple navigation paths). -->
  <RimWorldAccess.TransportPods.Loading.NoItemsInTab>No items in this tab</RimWorldAccess.TransportPods.Loading.NoItemsInTab>

  <!-- Activation and quantity actions. {0} = item label. -->
  <RimWorldAccess.TransportPods.Loading.ItemChecked>{0} checked</RimWorldAccess.TransportPods.Loading.ItemChecked>
  <RimWorldAccess.TransportPods.Loading.ItemUnchecked>{0} unchecked</RimWorldAccess.TransportPods.Loading.ItemUnchecked>
  <RimWorldAccess.TransportPods.Loading.ItemRemoved>{0} removed</RimWorldAccess.TransportPods.Loading.ItemRemoved>

  <!-- Inspect results. -->
  <RimWorldAccess.TransportPods.Loading.NoItemToInspect>No item to inspect</RimWorldAccess.TransportPods.Loading.NoItemToInspect>
  <RimWorldAccess.TransportPods.Loading.CannotInspectItem>Cannot inspect this item</RimWorldAccess.TransportPods.Loading.CannotInspectItem>

  <!-- Reset (Alt+R). -->
  <RimWorldAccess.TransportPods.Loading.ResetAll>All items reset to zero</RimWorldAccess.TransportPods.Loading.ResetAll>

  <!-- Mass summary (Tab key / AnnounceMassSummary).
       Composed from MassLine + one of OverloadedStatus/RemainingStatus.
       {0} = current usage, {1} = capacity, {2} = status clause. -->
  <RimWorldAccess.TransportPods.Loading.MassSummary>Mass: {0} of {1} kg. {2}</RimWorldAccess.TransportPods.Loading.MassSummary>
  <RimWorldAccess.TransportPods.Loading.MassOverloaded>OVERLOADED by {0} kg</RimWorldAccess.TransportPods.Loading.MassOverloaded>
  <RimWorldAccess.TransportPods.Loading.MassRemaining>{0} kg remaining</RimWorldAccess.TransportPods.Loading.MassRemaining>

  <!-- Summary view (Tab toggle). Empty/error states come next. -->
  <RimWorldAccess.TransportPods.Loading.SummaryEntry>Summary view. Up/Down navigates stats. Tab to return.</RimWorldAccess.TransportPods.Loading.SummaryEntry>
  <RimWorldAccess.TransportPods.Loading.SummaryNoData>No data available</RimWorldAccess.TransportPods.Loading.SummaryNoData>
  <RimWorldAccess.TransportPods.Loading.SummaryNoTransporters>No transporters</RimWorldAccess.TransportPods.Loading.SummaryNoTransporters>
  <RimWorldAccess.TransportPods.Loading.SummaryStatsUnavailable>Stats unavailable</RimWorldAccess.TransportPods.Loading.SummaryStatsUnavailable>
  <RimWorldAccess.TransportPods.Loading.SummaryNoSummary>No summary data</RimWorldAccess.TransportPods.Loading.SummaryNoSummary>

  <!-- Summary item format ({item}. {position}). {0} = stat line, {1} = position. -->
  <RimWorldAccess.TransportPods.Loading.SummaryItemAnnouncement>{0}. {1}</RimWorldAccess.TransportPods.Loading.SummaryItemAnnouncement>

  <!-- Stat-breakdown view (Alt+I in summary mode). NoBreakdown is spoken when
       the selected stat has no cached explanation (e.g. Food).
       Stat names (spoken as the breakdown window title). -->
  <RimWorldAccess.TransportPods.Loading.NoBreakdown>No breakdown available for this item</RimWorldAccess.TransportPods.Loading.NoBreakdown>
  <RimWorldAccess.TransportPods.Loading.StatMassCapacity>Mass Capacity</RimWorldAccess.TransportPods.Loading.StatMassCapacity>
  <RimWorldAccess.TransportPods.Loading.StatSpeed>Speed</RimWorldAccess.TransportPods.Loading.StatSpeed>
  <RimWorldAccess.TransportPods.Loading.StatForaging>Foraging</RimWorldAccess.TransportPods.Loading.StatForaging>
  <RimWorldAccess.TransportPods.Loading.StatVisibility>Visibility</RimWorldAccess.TransportPods.Loading.StatVisibility>

  <!-- =========================================================
       TransportPodLaunchState.cs - world-map launch targeting.
       ========================================================= -->

  <!-- Entry announcements (Open). -->
  <RimWorldAccess.TransportPods.Launch.OpenWithFuel>Launch targeting. {0} chemfuel available, max range {1} tiles. Use scanner to browse destinations.</RimWorldAccess.TransportPods.Launch.OpenWithFuel>
  <RimWorldAccess.TransportPods.Launch.OpenWithRange>Launch targeting. Max range {0} tiles. Use scanner to browse destinations.</RimWorldAccess.TransportPods.Launch.OpenWithRange>
  <RimWorldAccess.TransportPods.Launch.OpenUnlimited>Launch targeting. Unlimited range. Use scanner to browse destinations.</RimWorldAccess.TransportPods.Launch.OpenUnlimited>

