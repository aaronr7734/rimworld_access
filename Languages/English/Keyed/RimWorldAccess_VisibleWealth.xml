  <RimWorldAccess.Compat.VisibleWealth.InParent>In {0}</RimWorldAccess.Compat.VisibleWealth.InParent>
  <RimWorldAccess.Compat.VisibleWealth.NotMatching>Does not match the search</RimWorldAccess.Compat.VisibleWealth.NotMatching>
  <RimWorldAccess.Compat.VisibleWealth.ChartLockedWhileSearching>The pie chart can't be opened or closed while searching</RimWorldAccess.Compat.VisibleWealth.ChartLockedWhileSearching>
  <!-- The pause menu's mod toolbar entry. {0} = the window's name, {1} = a key chord. -->
  <RimWorldAccess.Compat.VisibleWealth.OpenWithHotkey>{0}, hotkey {1}</RimWorldAccess.Compat.VisibleWealth.OpenWithHotkey>
  <!-- {0} = a key name. -->
  <RimWorldAccess.Compat.VisibleWealth.ShiftChord>Shift+{0}</RimWorldAccess.Compat.VisibleWealth.ShiftChord>
