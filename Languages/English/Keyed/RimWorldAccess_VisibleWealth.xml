  <RimWorldAccess.Compat.VisibleWealth.PercentOption>Percentages</RimWorldAccess.Compat.VisibleWealth.PercentOption>
  <!-- Flat list column headers. -->
  <RimWorldAccess.Compat.VisibleWealth.ItemColumn>Item</RimWorldAccess.Compat.VisibleWealth.ItemColumn>
  <RimWorldAccess.Compat.VisibleWealth.ValueColumn>Value</RimWorldAccess.Compat.VisibleWealth.ValueColumn>
  <RimWorldAccess.Compat.VisibleWealth.PercentColumn>Percent</RimWorldAccess.Compat.VisibleWealth.PercentColumn>
