  <RimWorldAccess.Compat.VisibleWealth.OverviewRegion>Summary</RimWorldAccess.Compat.VisibleWealth.OverviewRegion>
  <RimWorldAccess.Compat.VisibleWealth.NestedRegion>Wealth by category</RimWorldAccess.Compat.VisibleWealth.NestedRegion>
  <RimWorldAccess.Compat.VisibleWealth.FlatRegion>Wealth list</RimWorldAccess.Compat.VisibleWealth.FlatRegion>
  <RimWorldAccess.Compat.VisibleWealth.SliceRegion>Pie chart slices</RimWorldAccess.Compat.VisibleWealth.SliceRegion>
  <RimWorldAccess.Compat.VisibleWealth.OptionsRegion>Chart options</RimWorldAccess.Compat.VisibleWealth.OptionsRegion>
  <RimWorldAccess.Compat.VisibleWealth.Search>Search</RimWorldAccess.Compat.VisibleWealth.Search>
