  <RimWorldAccess.Compat.VisibleWealth.PercentOfTotal>{0} of total wealth</RimWorldAccess.Compat.VisibleWealth.PercentOfTotal>
  <RimWorldAccess.Compat.VisibleWealth.PercentOfParent>{0} of {1}</RimWorldAccess.Compat.VisibleWealth.PercentOfParent>
