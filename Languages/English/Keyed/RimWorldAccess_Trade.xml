<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Trade module strings (src/Trade/). Two state files contribute:
      - TradeNavigationState.cs   (Dialog_Trade keyboard navigation,
                                   3 tabs, gift mode, quantity mode,
                                   numeric input, balance entry)
      - SellableItemsState.cs     (Dialog_SellableItems read-only browse)

    The two patches (TradeNavigationPatch, SellableItemsNavigationPatch)
    have no user-facing strings and are untouched. Most data flowing
    through these announcements - tradeable labels, faction names,
    trader names, item descriptions, currency counts, royal favor
    labels, and ToStringMoney output - comes from the game and is NOT
    translated here.

    Phrasing decisions:
      - "Buying"/"Selling"/"Gifting" appear in many sentence shapes, so
        each shape is its own key (Trade.Adjust.*, Trade.Pending.*,
        Trade.Max.*) rather than glue-composing the verb. This lets
        translators inflect for case/agreement per sentence.
      - Silver prices use "${0}" (matches RimWorld's ToStringMoney) and
        favor uses "{0} favor". Both go through Trade.Price.Silver/Favor
        so non-English currencies can pick a different symbol/order.
      - "favor" / "silver" appear as standalone nouns inside other
        sentences (balance, currency holdings) - separate keys.
      - Item announcements compose smaller sentence fragments joined by
        "{0}." in C#; each fragment is a key so the join character can
        be changed per language.

    Shared phrases delegated elsewhere:
      - Search.Cleared / Search.NoMatches / Position / Edge -> Common.xml
      - InfoCard / Map.JumpedTo                              -> Common.xml
      - "Cannot adjust" reasons share a single Trade.Reject.* key set
        rather than 4 separate strings.
  -->

  <!-- =================================================================
       Trade dialog lifecycle (TradeNavigationState.Open / Close /
       AcceptTrade / cancel paths).
       Open: {0} = trader name, {1} = trader kind label.
       ================================================================= -->
  <RimWorldAccess.Trade.Open.Heading>Trading with {0} ({1}). Alt+B for balance, Alt+A to accept.</RimWorldAccess.Trade.Open.Heading>
  <RimWorldAccess.Trade.Open.UnknownTrader>Unknown Trader</RimWorldAccess.Trade.Open.UnknownTrader>
  <RimWorldAccess.Trade.Open.TraderKindFallback>trader</RimWorldAccess.Trade.Open.TraderKindFallback>
  <RimWorldAccess.Trade.Open.NoDialog>No trade dialog</RimWorldAccess.Trade.Open.NoDialog>
  <RimWorldAccess.Trade.Open.NoSession>No active trade session</RimWorldAccess.Trade.Open.NoSession>
  <RimWorldAccess.Trade.Open.SessionNotInitialized>Trade session not properly initialized</RimWorldAccess.Trade.Open.SessionNotInitialized>
  <RimWorldAccess.Trade.Cancelled>Trade cancelled</RimWorldAccess.Trade.Cancelled>
  <RimWorldAccess.Trade.NoItemsInCategory>No items in this category</RimWorldAccess.Trade.NoItemsInCategory>

  <!-- =================================================================
       Tab / category names.
       TraderItems is composed: "{0}'s Items" with {0} = trader name.
       Tab.Empty: {0} = category name, used when the tab has 0 items.
       Tab.SwitchedTo composes the category name with a currency
       suffix: {0} = category name, {1} = currency phrase
       (Trade.Currency.YouHave / TraderHas).
       ================================================================= -->
  <RimWorldAccess.Trade.Tab.YourItems>Your Items</RimWorldAccess.Trade.Tab.YourItems>
  <RimWorldAccess.Trade.Tab.TraderItems>{0}'s Items</RimWorldAccess.Trade.Tab.TraderItems>
  <RimWorldAccess.Trade.Tab.TradeSummary>Trade Summary</RimWorldAccess.Trade.Tab.TradeSummary>
  <RimWorldAccess.Trade.Tab.Unknown>Unknown</RimWorldAccess.Trade.Tab.Unknown>
  <RimWorldAccess.Trade.Tab.Empty>{0} - No items</RimWorldAccess.Trade.Tab.Empty>
  <RimWorldAccess.Trade.Tab.SwitchedReturning>Trade Summary empty. Returning to {0}</RimWorldAccess.Trade.Tab.SwitchedReturning>

  <!-- Currency holdings phrasing (Alt+B and tab-switch suffix).
       YouHave / TraderHas: {0} = formatted currency string. -->
  <RimWorldAccess.Trade.Currency.YouHave>You have {0}</RimWorldAccess.Trade.Currency.YouHave>
  <RimWorldAccess.Trade.Currency.TraderHas>Trader has {0}</RimWorldAccess.Trade.Currency.TraderHas>
  <RimWorldAccess.Trade.Currency.Both>You have {0}. Trader has {1}</RimWorldAccess.Trade.Currency.Both>
  <RimWorldAccess.Trade.Currency.None>No currency available</RimWorldAccess.Trade.Currency.None>
  <!-- Bare nouns used inside larger sentences ("X silver", "X favor"). -->
  <RimWorldAccess.Trade.Currency.SilverNoun>silver</RimWorldAccess.Trade.Currency.SilverNoun>
  <RimWorldAccess.Trade.Currency.FavorNoun>favor</RimWorldAccess.Trade.Currency.FavorNoun>
  <!-- Favor count format: {0} = integer count of favor.
       Silver uses RimWorld's float.ToStringMoney() ("$N"); we leave
       that to the game. -->
  <RimWorldAccess.Trade.Currency.FavorCount>{0} favor</RimWorldAccess.Trade.Currency.FavorCount>

  <!-- Price formatting (FormatPrice). Silver matches ToStringMoney's
       "$N" prefix; Favor: "{0} favor". {0} = formatted number. -->
  <RimWorldAccess.Trade.Price.Silver>${0}</RimWorldAccess.Trade.Price.Silver>
  <RimWorldAccess.Trade.Price.Favor>{0} favor</RimWorldAccess.Trade.Price.Favor>

  <!-- =================================================================
       Quantity-adjust feedback (single-step Up/Down arrow).
       AnnounceQuantityChange composes:
         {label}: No trade  (when transfer hits zero)
         {action} {count} {label}, value {price}
       Buying/Selling/Gifting are split into action-specific keys so
       each sentence shape can vary per language.
       ================================================================= -->
  <RimWorldAccess.Trade.Adjust.NoTrade>{0}: No trade</RimWorldAccess.Trade.Adjust.NoTrade>
  <RimWorldAccess.Trade.Adjust.Buying>Buying {0} {1}, value {2}</RimWorldAccess.Trade.Adjust.Buying>
  <RimWorldAccess.Trade.Adjust.Selling>Selling {0} {1}, value {2}</RimWorldAccess.Trade.Adjust.Selling>
  <RimWorldAccess.Trade.Adjust.Gifting>Gifting {0} {1}, value {2}</RimWorldAccess.Trade.Adjust.Gifting>

  <!-- Max-action announcements (Home/End set to extreme).
       Reset: {0} = item label.
       Buying/Selling/Gifting: {0} = count, {1} = item label,
                                {2} = formatted price. -->
  <RimWorldAccess.Trade.Max.Reset>Reset {0} to none</RimWorldAccess.Trade.Max.Reset>
  <RimWorldAccess.Trade.Max.Buying>Buying all {0} {1}, {2}</RimWorldAccess.Trade.Max.Buying>
  <RimWorldAccess.Trade.Max.Selling>Selling all {0} {1}, {2}</RimWorldAccess.Trade.Max.Selling>
  <RimWorldAccess.Trade.Max.Gifting>Gifting all {0} {1}, {2}</RimWorldAccess.Trade.Max.Gifting>

  <!-- Reset action (Alt+R). {0} = item label. -->
  <RimWorldAccess.Trade.Reset.SingleItem>Reset {0}</RimWorldAccess.Trade.Reset.SingleItem>
  <RimWorldAccess.Trade.Reset.AllTrades>All trades reset</RimWorldAccess.Trade.Reset.AllTrades>
  <RimWorldAccess.Trade.Reset.CannotResetBalance>Cannot reset balance entry</RimWorldAccess.Trade.Reset.CannotResetBalance>

  <!-- =================================================================
       Pending-trade announcement on the list view.
       Pending.WithCount: {0} = action verb word, {1} = count.
       Pending.PriceLine: {0} = "Total"/"Value", {1} = formatted price.
       Each action ("Buying"/"Selling"/"Gifting") is a separate key so
       it can flex with grammatical case in non-English. -->
  <RimWorldAccess.Trade.Pending.ActionBuying>Buying</RimWorldAccess.Trade.Pending.ActionBuying>
  <RimWorldAccess.Trade.Pending.ActionSelling>Selling</RimWorldAccess.Trade.Pending.ActionSelling>
  <RimWorldAccess.Trade.Pending.ActionGifting>Gifting</RimWorldAccess.Trade.Pending.ActionGifting>
  <RimWorldAccess.Trade.Pending.ActionWithCount>{0} {1}</RimWorldAccess.Trade.Pending.ActionWithCount>
  <RimWorldAccess.Trade.Pending.PriceLabelTotal>Total</RimWorldAccess.Trade.Pending.PriceLabelTotal>
  <RimWorldAccess.Trade.Pending.PriceLabelValue>Value</RimWorldAccess.Trade.Pending.PriceLabelValue>
  <RimWorldAccess.Trade.Pending.PriceLine>{0}: {1}</RimWorldAccess.Trade.Pending.PriceLine>

  <!-- =================================================================
       Item announcement composition for the inventory tabs.
       *.SoloAvailable: only one party has the item; {0} = count.
       *.SoloPrice: bare price line, {0} = formatted price.
       *.SoloPriceWithQuality: with price-quality suffix; {0} = price,
                              {1} = quality phrase.
       *.NotTradeable: trader will not trade this item.
       *.YoursAt / TheirsAt: shared item; {0} = count, {1} = price.
       *.YoursAtWithQuality / TheirsAtWithQuality: same plus quality;
                              {0} = count, {1} = price, {2} = quality.
       *.YoursOnly / TheirsOnly: shared but trader won't trade;
                              {0} = count.
       ================================================================= -->
  <RimWorldAccess.Trade.Item.SoloAvailable>{0} available</RimWorldAccess.Trade.Item.SoloAvailable>
  <RimWorldAccess.Trade.Item.SoloPrice>{0}</RimWorldAccess.Trade.Item.SoloPrice>
  <RimWorldAccess.Trade.Item.SoloPriceWithQuality>{0}, {1}</RimWorldAccess.Trade.Item.SoloPriceWithQuality>
  <RimWorldAccess.Trade.Item.NotTradeable>Not tradeable</RimWorldAccess.Trade.Item.NotTradeable>
  <RimWorldAccess.Trade.Item.YoursAt>Yours: {0} at {1}</RimWorldAccess.Trade.Item.YoursAt>
  <RimWorldAccess.Trade.Item.TheirsAt>Theirs: {0} at {1}</RimWorldAccess.Trade.Item.TheirsAt>
  <RimWorldAccess.Trade.Item.YoursAtWithQuality>Yours: {0} at {1} ({2})</RimWorldAccess.Trade.Item.YoursAtWithQuality>
  <RimWorldAccess.Trade.Item.TheirsAtWithQuality>Theirs: {0} at {1} ({2})</RimWorldAccess.Trade.Item.TheirsAtWithQuality>
  <RimWorldAccess.Trade.Item.YoursOnly>Yours: {0}</RimWorldAccess.Trade.Item.YoursOnly>
  <RimWorldAccess.Trade.Item.TheirsOnly>Theirs: {0}</RimWorldAccess.Trade.Item.TheirsOnly>

  <!-- Price quality words (GetPriceQuality). Buying = lower=better,
       Selling = higher=better; the four PriceType buckets get separate
       words for each direction. -->
  <RimWorldAccess.Trade.Quality.Buy.VeryCheap>great deal</RimWorldAccess.Trade.Quality.Buy.VeryCheap>
  <RimWorldAccess.Trade.Quality.Buy.Cheap>good deal</RimWorldAccess.Trade.Quality.Buy.Cheap>
  <RimWorldAccess.Trade.Quality.Buy.Expensive>pricey</RimWorldAccess.Trade.Quality.Buy.Expensive>
  <RimWorldAccess.Trade.Quality.Buy.Exorbitant>very expensive</RimWorldAccess.Trade.Quality.Buy.Exorbitant>
  <RimWorldAccess.Trade.Quality.Sell.VeryCheap>poor offer</RimWorldAccess.Trade.Quality.Sell.VeryCheap>
  <RimWorldAccess.Trade.Quality.Sell.Cheap>low offer</RimWorldAccess.Trade.Quality.Sell.Cheap>
  <RimWorldAccess.Trade.Quality.Sell.Expensive>good offer</RimWorldAccess.Trade.Quality.Sell.Expensive>
  <RimWorldAccess.Trade.Quality.Sell.Exorbitant>great offer</RimWorldAccess.Trade.Quality.Sell.Exorbitant>

  <!-- =================================================================
       Quantity adjustment mode.
       Mode.Adjusting is the constant marker word; {0} = upper bound.
       Each context (gift, shared, sell-only, buy-only) is a separate
       sentence so word order can vary. -->
  <RimWorldAccess.Trade.Mode.Adjusting>Adjusting</RimWorldAccess.Trade.Mode.Adjusting>
  <RimWorldAccess.Trade.Mode.GiftUpTo>Gift up to {0}</RimWorldAccess.Trade.Mode.GiftUpTo>
  <RimWorldAccess.Trade.Mode.SellUpTo>Sell up to {0}</RimWorldAccess.Trade.Mode.SellUpTo>
  <RimWorldAccess.Trade.Mode.BuyUpTo>Buy up to {0}</RimWorldAccess.Trade.Mode.BuyUpTo>
  <RimWorldAccess.Trade.Mode.SellAndBuy>Sell up to {0}, buy up to {1}</RimWorldAccess.Trade.Mode.SellAndBuy>
  <RimWorldAccess.Trade.Mode.ExitFirst>Exit quantity mode first</RimWorldAccess.Trade.Mode.ExitFirst>
  <RimWorldAccess.Trade.Mode.ExitFirstHint>Exit quantity mode first (press Enter or Escape)</RimWorldAccess.Trade.Mode.ExitFirstHint>

  <!-- =================================================================
       Reject / error paths.
       ================================================================= -->
  <RimWorldAccess.Trade.Reject.CannotAdjustItem>Cannot adjust quantity for this item</RimWorldAccess.Trade.Reject.CannotAdjustItem>
  <RimWorldAccess.Trade.Reject.WillNotTrade>Trader will not trade this item</RimWorldAccess.Trade.Reject.WillNotTrade>
  <RimWorldAccess.Trade.Reject.CannotAdjustAmount>Cannot adjust to this amount</RimWorldAccess.Trade.Reject.CannotAdjustAmount>
  <RimWorldAccess.Trade.Reject.CannotAdjustMax>Cannot adjust to maximum</RimWorldAccess.Trade.Reject.CannotAdjustMax>
  <RimWorldAccess.Trade.Reject.CannotAdjustMin>Cannot adjust to minimum</RimWorldAccess.Trade.Reject.CannotAdjustMin>
  <RimWorldAccess.Trade.Reject.CannotInspect>Cannot inspect this item</RimWorldAccess.Trade.Reject.CannotInspect>

  <!-- =================================================================
       Numeric input mode (digit/sign keys in quantity mode).
       Numeric.PromptSelling / Buying / Gifting are spoken when the
       user presses a sign key with an empty buffer.
       Numeric.Typing: {0} = current numeric buffer string.
       Numeric.Cleared / Numeric.Invalid mark transitional states. -->
  <RimWorldAccess.Trade.Numeric.PromptSelling>Selling. Type quantity.</RimWorldAccess.Trade.Numeric.PromptSelling>
  <RimWorldAccess.Trade.Numeric.PromptBuying>Buying. Type quantity.</RimWorldAccess.Trade.Numeric.PromptBuying>
  <RimWorldAccess.Trade.Numeric.PromptGifting>Gifting. Type quantity.</RimWorldAccess.Trade.Numeric.PromptGifting>
  <RimWorldAccess.Trade.Numeric.Typing>Typing: {0}</RimWorldAccess.Trade.Numeric.Typing>
  <RimWorldAccess.Trade.Numeric.Cleared>Cleared</RimWorldAccess.Trade.Numeric.Cleared>
  <RimWorldAccess.Trade.Numeric.Invalid>Invalid: {0}</RimWorldAccess.Trade.Numeric.Invalid>
  <!-- After a numeric edit, the announcement is composed from one of
       the *.Body keys plus the *.Suffix key.
       NoTradeBody: {0} = item label.
       BuyingBody / SellingBody / GiftingBody: {0} = action verb,
       {1} = count, {2} = item label.
       BuyingBodyWithPrice / SellingBodyWithPrice: same plus
       {3} = formatted price. Suffix: {0} = current buffer. -->
  <RimWorldAccess.Trade.Numeric.NoTradeBody>{0}: No trade</RimWorldAccess.Trade.Numeric.NoTradeBody>
  <RimWorldAccess.Trade.Numeric.GiftingBody>{0} {1} {2}</RimWorldAccess.Trade.Numeric.GiftingBody>
  <RimWorldAccess.Trade.Numeric.BuyingSellingBody>{0} {1} {2} for {3}</RimWorldAccess.Trade.Numeric.BuyingSellingBody>
  <RimWorldAccess.Trade.Numeric.Suffix>. Typing: {0}</RimWorldAccess.Trade.Numeric.Suffix>

  <!-- =================================================================
       Gift mode toggle and gift confirmation paths.
       ================================================================= -->
  <RimWorldAccess.Trade.Gift.CannotGiftTrader>Cannot gift to this trader</RimWorldAccess.Trade.Gift.CannotGiftTrader>
  <RimWorldAccess.Trade.Gift.CannotGiftHostile>Cannot gift to hostile faction</RimWorldAccess.Trade.Gift.CannotGiftHostile>
  <RimWorldAccess.Trade.Gift.CannotGiftFavor>Cannot gift when trading for royal favor</RimWorldAccess.Trade.Gift.CannotGiftFavor>
  <RimWorldAccess.Trade.Gift.ModeGift>gift mode</RimWorldAccess.Trade.Gift.ModeGift>
  <RimWorldAccess.Trade.Gift.ModeTrade>trade mode</RimWorldAccess.Trade.Gift.ModeTrade>
  <RimWorldAccess.Trade.Gift.SwitchedTo>Switched to {0}</RimWorldAccess.Trade.Gift.SwitchedTo>
  <RimWorldAccess.Trade.Gift.NoSession>No gift session active</RimWorldAccess.Trade.Gift.NoSession>
  <RimWorldAccess.Trade.Gift.NoGifts>No gifts to offer</RimWorldAccess.Trade.Gift.NoGifts>
  <RimWorldAccess.Trade.Gift.ErrorCalculating>Error calculating gift value</RimWorldAccess.Trade.Gift.ErrorCalculating>
  <RimWorldAccess.Trade.Gift.ErrorOffering>Error offering gifts</RimWorldAccess.Trade.Gift.ErrorOffering>
  <!-- Gift completion: {0} = goodwill change (positive integer). -->
  <RimWorldAccess.Trade.Gift.Offered>Gifts offered, goodwill +{0}</RimWorldAccess.Trade.Gift.Offered>

  <!-- =================================================================
       Accept-trade path.
       ================================================================= -->
  <RimWorldAccess.Trade.Accept.NoDeal>No trade to execute</RimWorldAccess.Trade.Accept.NoDeal>
  <RimWorldAccess.Trade.Accept.WarnTraderShortFunds>Warning: Trader does not have enough silver. Confirm to proceed anyway.</RimWorldAccess.Trade.Accept.WarnTraderShortFunds>
  <!-- {0} = AcceptanceReport.Reason. -->
  <RimWorldAccess.Trade.Accept.CannotComplete>Cannot complete trade: {0}</RimWorldAccess.Trade.Accept.CannotComplete>
  <RimWorldAccess.Trade.Accept.Completed>Trade completed successfully</RimWorldAccess.Trade.Accept.Completed>
  <RimWorldAccess.Trade.Accept.NoItemsToTrade>No items to trade</RimWorldAccess.Trade.Accept.NoItemsToTrade>

  <!-- =================================================================
       Balance entry (last row of Trade Summary tab).
       Net balance gets one key per direction (Spending / Receiving /
       Balanced); the currency noun is supplied as {1}, count as {0}.
       In gift mode the row is the goodwill delta; if no faction info
       is available, GiftBalanceFallback is spoken.
       Position suffix is appended in C# via PositionSuffix. -->
  <RimWorldAccess.Trade.Balance.Spending>Net balance: Spending {0} {1}</RimWorldAccess.Trade.Balance.Spending>
  <RimWorldAccess.Trade.Balance.Receiving>Net balance: Receiving {0} {1}</RimWorldAccess.Trade.Balance.Receiving>
  <RimWorldAccess.Trade.Balance.Balanced>Net balance: Balanced trade</RimWorldAccess.Trade.Balance.Balanced>
  <RimWorldAccess.Trade.Balance.Goodwill>Goodwill +{0}</RimWorldAccess.Trade.Balance.Goodwill>
  <RimWorldAccess.Trade.Balance.GiftFallback>Gift mode balance</RimWorldAccess.Trade.Balance.GiftFallback>
  <!-- Position suffix appended after the balance text; {0} = body,
       {1} = position phrase. -->
  <RimWorldAccess.Trade.Balance.WithPosition>{0}. {1}</RimWorldAccess.Trade.Balance.WithPosition>

  <!-- =================================================================
       Detailed announcement (Tab key for full inventory + price).
       Each line is a separate key so commas/colons can localize.
       *.PriceLine: {0} = price (caller pre-formats with one decimal),
                    {1} = currency noun. -->
  <RimWorldAccess.Trade.Detail.YouHave>You have: {0}</RimWorldAccess.Trade.Detail.YouHave>
  <RimWorldAccess.Trade.Detail.TraderHas>Trader has: {0}</RimWorldAccess.Trade.Detail.TraderHas>
  <RimWorldAccess.Trade.Detail.SellPrice>Sell price: {0} {1} each</RimWorldAccess.Trade.Detail.SellPrice>
  <RimWorldAccess.Trade.Detail.BuyPrice>Buy price: {0} {1} each</RimWorldAccess.Trade.Detail.BuyPrice>
  <!-- {0} = action word ("Buying"/"Selling"), {1} = count,
       {2} = total cost (caller F0-formatted), {3} = currency noun. -->
  <RimWorldAccess.Trade.Detail.CurrentTrade>Current trade: {0} {1} for {2} {3}</RimWorldAccess.Trade.Detail.CurrentTrade>

  <!-- Price-breakdown popup (Tab in trader/colony list).
       PriceTitleBuy / Sell: {0} = clean item label. -->
  <RimWorldAccess.Trade.Detail.PriceTitleBuy>Buy Price: {0}</RimWorldAccess.Trade.Detail.PriceTitleBuy>
  <RimWorldAccess.Trade.Detail.PriceTitleSell>Sell Price: {0}</RimWorldAccess.Trade.Detail.PriceTitleSell>
  <RimWorldAccess.Trade.Detail.NotInGiftMode>Price breakdown not available in gift mode</RimWorldAccess.Trade.Detail.NotInGiftMode>
  <RimWorldAccess.Trade.Detail.NoPriceInfo>No price information available</RimWorldAccess.Trade.Detail.NoPriceInfo>

  <!-- =================================================================
       Sellable items dialog (SellableItemsState).
       Dialog_SellableItems is a separate, simpler read-only browser.
       ================================================================= -->
  <RimWorldAccess.Sellable.Open.NoDialog>No dialog</RimWorldAccess.Sellable.Open.NoDialog>
  <RimWorldAccess.Sellable.Open.Closed>Closed</RimWorldAccess.Sellable.Open.Closed>
  <RimWorldAccess.Sellable.Open.Controls>Switch tabs: Left, Right. Navigate: Up, Down.</RimWorldAccess.Sellable.Open.Controls>
  <RimWorldAccess.Sellable.Open.TraderFallback>Trader</RimWorldAccess.Sellable.Open.TraderFallback>
  <!-- {0} = trader name, {1} = restock phrase (may be empty),
       {2} = "{count} categories" phrase, {3} = controls phrase. -->
  <RimWorldAccess.Sellable.Open.Heading>{0} will buy. {1}{2}. {3}</RimWorldAccess.Sellable.Open.Heading>
  <!-- Restock variants. NextRestock: {0} = days, pre-formatted with
       one decimal place by the caller (e.g. "2.5"). -->
  <RimWorldAccess.Sellable.Restock.NextRestock>Next restock: {0} days. </RimWorldAccess.Sellable.Restock.NextRestock>
  <RimWorldAccess.Sellable.Restock.NotVisited>Not visited yet. </RimWorldAccess.Sellable.Restock.NotVisited>
  <RimWorldAccess.Sellable.Restock.Restocked>Restocked since last visit. </RimWorldAccess.Sellable.Restock.Restocked>
  <!-- One/Many split for category count phrase. -->
  <RimWorldAccess.Sellable.Open.CategoriesOne>1 category</RimWorldAccess.Sellable.Open.CategoriesOne>
  <RimWorldAccess.Sellable.Open.CategoriesMany>{0} categories</RimWorldAccess.Sellable.Open.CategoriesMany>

  <!-- Tab switch + selection.
       TabSwitch: {0} = tab name, {1} = item count.
       The empty case ("No items") shares the global key. -->
  <RimWorldAccess.Sellable.Tab.SwitchOne>{0}. 1 item.</RimWorldAccess.Sellable.Tab.SwitchOne>
