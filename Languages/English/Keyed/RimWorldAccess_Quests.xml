<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Quests module strings (src/Quests/). Five files contribute:
      - QuestMenuState.cs           (windowless quest browser)
      - NotificationMenuState.cs    (messages/letters/alerts viewer)
      - QuestRewardHelper.cs        (reward extraction + reward prefs)
      - NotificationAccessibilityPatch.cs  (live message/letter/alert
                                            announcements as they arrive)
      - QuestMenuPatch.cs           (no user strings)

    The quest list and detail views, the reward-choice float menu, the
    reward-preferences panel, and the notification menu's two-level
    navigation all live here. Many phrasings are split into One/Many
    pairs (1 quest vs N quests, 1 star vs N stars) so plural agreement
    survives translation.

    Shared phrases delegated elsewhere:
      - Position / Edge / Search / InfoCard.Unavailable -> Common.xml
      - "Jumped to {target}"                            -> Common.xml
      - "Accept", "Delete", "Close", "Activate", "Open",
        "Difficulty", "JumpToLocation", "ViewRelatedQuest",
        "QuestExpiresIn", "AvailableQuests"/"ActiveQuests"/
        "HistoricalQuests", "Goodwill"                  -> vanilla keys

    Data such as quest names, faction names, reward item labels,
    target locations, ticks-to-period strings, sign-formatted
    numbers, and royal favor labels (faction.def.royalFavorLabel)
    comes from the game and is NOT translated in this file.
  -->

  <!-- =================================================================
       Live notification announcements (NotificationAccessibilityPatch).
       Spoken when a Message, Letter, or Alert arrives in-game so screen
       reader users hear the event without opening the notification menu.
       {0} = the cleaned text/label of the notification.
       ================================================================= -->
  <RimWorldAccess.Notification.LiveMessage>Message: {0}</RimWorldAccess.Notification.LiveMessage>
  <RimWorldAccess.Notification.LiveLetter>Letter: {0}</RimWorldAccess.Notification.LiveLetter>
  <RimWorldAccess.Notification.LiveAlert>Alert: {0}</RimWorldAccess.Notification.LiveAlert>

  <!-- =================================================================
       Quest menu lifecycle (QuestMenuState.Open / Close / OpenAndSelect).
       OpenInstructions is the one-time orientation message spoken when
       the menu opens; it is suffixed with the first quest's announcement
       or the empty-tab message. {0} = first quest announcement, or tab
       summary, depending on context.
       ================================================================= -->
  <RimWorldAccess.Quests.Menu.OpenInstructions>Quest menu. Alt+A to accept, Alt+D to dismiss. Enter to arrow through quest details.</RimWorldAccess.Quests.Menu.OpenInstructions>
  <RimWorldAccess.Quests.Menu.Title>Quest menu</RimWorldAccess.Quests.Menu.Title>
  <RimWorldAccess.Quests.Menu.Closed>Quest menu closed</RimWorldAccess.Quests.Menu.Closed>
  <RimWorldAccess.Quests.Menu.QuestNoLongerAvailable>Quest no longer available</RimWorldAccess.Quests.Menu.QuestNoLongerAvailable>
  <RimWorldAccess.Quests.Menu.NoQuestsInTab>No quests in this tab</RimWorldAccess.Quests.Menu.NoQuestsInTab>
  <RimWorldAccess.Quests.Menu.NoQuestSelected>No quest selected</RimWorldAccess.Quests.Menu.NoQuestSelected>
  <RimWorldAccess.Quests.Menu.FailedToActivateButton>Failed to activate button</RimWorldAccess.Quests.Menu.FailedToActivateButton>

  <!-- =================================================================
       Quest tabs. Available/Active/Historical (vanilla provides the
       short labels; we suffix "Quests" because the screen-reader
       announcement uses the tab in a sentence).
       Tab.WithCountOne / Many / NoQuests build the per-tab summary
       sentence; {0} = tab label, {1} = count (Many only).
       ================================================================= -->
  <RimWorldAccess.Quests.Tab.Available>Available Quests</RimWorldAccess.Quests.Tab.Available>
  <RimWorldAccess.Quests.Tab.Active>Active Quests</RimWorldAccess.Quests.Tab.Active>
  <RimWorldAccess.Quests.Tab.Historical>Historical Quests</RimWorldAccess.Quests.Tab.Historical>
  <RimWorldAccess.Quests.Tab.Generic>Quests</RimWorldAccess.Quests.Tab.Generic>
  <RimWorldAccess.Quests.Tab.WithCountOne>{0} tab - 1 quest</RimWorldAccess.Quests.Tab.WithCountOne>
  <RimWorldAccess.Quests.Tab.WithCountMany>{0} tab - {1} quests</RimWorldAccess.Quests.Tab.WithCountMany>
  <RimWorldAccess.Quests.Tab.NoQuests>{0} tab - No quests</RimWorldAccess.Quests.Tab.NoQuests>

  <!-- =================================================================
       Status words, used both in the list-view name suffix
       ("{name}, Dismissed") and in the detail-view header
       ("Quest: {name} (Active)"). Available/Active spell out the
       NotYetAccepted/Ongoing states for the screen reader. -->
  <RimWorldAccess.Quests.Status.Available>Available</RimWorldAccess.Quests.Status.Available>
  <RimWorldAccess.Quests.Status.Active>Active</RimWorldAccess.Quests.Status.Active>
  <RimWorldAccess.Quests.Status.Dismissed>Dismissed</RimWorldAccess.Quests.Status.Dismissed>
  <RimWorldAccess.Quests.Status.Completed>Completed</RimWorldAccess.Quests.Status.Completed>
  <RimWorldAccess.Quests.Status.Failed>Failed</RimWorldAccess.Quests.Status.Failed>
  <RimWorldAccess.Quests.Status.Expired>Expired</RimWorldAccess.Quests.Status.Expired>

  <!-- =================================================================
       List-view announcement composition (BuildQuestAnnouncement).
       NameWithStatus appends a status word to the quest name; the bare
       Name case has no suffix and is spoken directly.
       StarsOne/Many is the difficulty rating; CharitySuffix is appended
       when quest.charity is true.
       ExpiresIn / AcceptedAgo / AgoOnly are the short time-info phrases
       (no colon, terse - distinct from the detail-view variants below).
       Rewards: {0} = compact reward summary string. -->
  <RimWorldAccess.Quests.List.NameWithStatus>{0}, {1}</RimWorldAccess.Quests.List.NameWithStatus>
  <RimWorldAccess.Quests.List.StarsOne>1 star</RimWorldAccess.Quests.List.StarsOne>
  <RimWorldAccess.Quests.List.StarsMany>{0} stars</RimWorldAccess.Quests.List.StarsMany>
  <RimWorldAccess.Quests.List.CharitySuffix>, charity quest</RimWorldAccess.Quests.List.CharitySuffix>
  <RimWorldAccess.Quests.List.ExpiresIn>Expires in {0}</RimWorldAccess.Quests.List.ExpiresIn>
  <RimWorldAccess.Quests.List.AcceptedAgo>Accepted {0} ago</RimWorldAccess.Quests.List.AcceptedAgo>
  <RimWorldAccess.Quests.List.AgoOnly>{0} ago</RimWorldAccess.Quests.List.AgoOnly>
  <RimWorldAccess.Quests.List.RewardsSummary>Rewards: {0}</RimWorldAccess.Quests.List.RewardsSummary>

  <!-- =================================================================
       Detail-view content lines (BuildDetailContentLines). These take
       the same data as the list-view phrases but use a longer "label:"
       layout because each line stands on its own.
       DifficultyOne/Many: {0} = star count (Many only); CharitySuffix
       is appended in the same fashion as the list view.
       ExpiresIn / AcceptedAgo: {0} = ToStringTicksToPeriod output.
       Status: {0} = outcome status word (Completed/Failed/Expired).
       Finished: {0} = ticks-since-cleanup formatted period. -->
  <RimWorldAccess.Quests.Detail.HeaderStatus>Quest: {0} ({1})</RimWorldAccess.Quests.Detail.HeaderStatus>
  <RimWorldAccess.Quests.Detail.DifficultyOne>Difficulty: 1 star</RimWorldAccess.Quests.Detail.DifficultyOne>
  <RimWorldAccess.Quests.Detail.DifficultyMany>Difficulty: {0} stars</RimWorldAccess.Quests.Detail.DifficultyMany>
  <RimWorldAccess.Quests.Detail.CharitySuffix> (Charity quest)</RimWorldAccess.Quests.Detail.CharitySuffix>
  <RimWorldAccess.Quests.Detail.ExpiresIn>Expires in: {0}</RimWorldAccess.Quests.Detail.ExpiresIn>
  <RimWorldAccess.Quests.Detail.AcceptedAgo>Accepted: {0} ago</RimWorldAccess.Quests.Detail.AcceptedAgo>
  <RimWorldAccess.Quests.Detail.Status>Status: {0}</RimWorldAccess.Quests.Detail.Status>
  <RimWorldAccess.Quests.Detail.Finished>Finished: {0} ago</RimWorldAccess.Quests.Detail.Finished>
  <RimWorldAccess.Quests.Detail.StartOfDetails>Start of quest details</RimWorldAccess.Quests.Detail.StartOfDetails>
  <RimWorldAccess.Quests.Detail.EndOfDetails>End of quest details</RimWorldAccess.Quests.Detail.EndOfDetails>
  <RimWorldAccess.Quests.Detail.OpenFirst>Press Enter to open quest details first</RimWorldAccess.Quests.Detail.OpenFirst>
  <RimWorldAccess.Quests.Detail.ChooseItemToInspect>Choose item to inspect</RimWorldAccess.Quests.Detail.ChooseItemToInspect>

  <!-- =================================================================
       Detail-view button labels (PopulateQuestButtons).
       AcceptChoice: {0} = 1-based choice index, {1} = reward description.
       AcceptWithRewards: {0} = reward description.
       JumpToTarget: {0} = target label (CameraJumper.CanJump returned a
       valid label); JumpToLocation has no label and falls back. -->
  <RimWorldAccess.Quests.Button.Accept>Accept</RimWorldAccess.Quests.Button.Accept>
  <RimWorldAccess.Quests.Button.AcceptWithRewards>Accept: {0}</RimWorldAccess.Quests.Button.AcceptWithRewards>
  <RimWorldAccess.Quests.Button.AcceptChoice>Accept Choice {0}: {1}</RimWorldAccess.Quests.Button.AcceptChoice>
  <RimWorldAccess.Quests.Button.Dismiss>Dismiss</RimWorldAccess.Quests.Button.Dismiss>
  <RimWorldAccess.Quests.Button.Resume>Resume</RimWorldAccess.Quests.Button.Resume>
  <RimWorldAccess.Quests.Button.Delete>Delete</RimWorldAccess.Quests.Button.Delete>
  <RimWorldAccess.Quests.Button.JumpToLocation>Jump to location</RimWorldAccess.Quests.Button.JumpToLocation>
  <RimWorldAccess.Quests.Button.JumpToTarget>Jump to {0}</RimWorldAccess.Quests.Button.JumpToTarget>

  <!-- =================================================================
       Action result announcements after the user accepts/dismisses/
       deletes a quest. {0} = quest name (StripTags applied).
       AcceptedWithRewards: {0} = reward description string.
       AcceptedWithPawn: {0} = colonist's LabelShort.
       CannotAcceptReason: {0} = QuestUtility.CanAcceptQuest's report.
       NotAvailableToAccept: spoken when the quest moved out of
       NotYetAccepted between the user's keypress and our handler. -->
  <RimWorldAccess.Quests.Action.CannotAccept>Cannot accept quest</RimWorldAccess.Quests.Action.CannotAccept>
  <RimWorldAccess.Quests.Action.NotAvailableToAccept>Quest is not available to accept</RimWorldAccess.Quests.Action.NotAvailableToAccept>
  <RimWorldAccess.Quests.Action.CannotAcceptReason>Cannot accept: {0}</RimWorldAccess.Quests.Action.CannotAcceptReason>
  <RimWorldAccess.Quests.Action.AcceptedQuest>Accepted quest: {0}</RimWorldAccess.Quests.Action.AcceptedQuest>
  <RimWorldAccess.Quests.Action.AcceptedWithRewards>Accepted quest with: {0}</RimWorldAccess.Quests.Action.AcceptedWithRewards>
  <RimWorldAccess.Quests.Action.AcceptedWithPawn>Accepted quest with {0}</RimWorldAccess.Quests.Action.AcceptedWithPawn>
  <RimWorldAccess.Quests.Action.DismissedQuest>Dismissed quest: {0}</RimWorldAccess.Quests.Action.DismissedQuest>
  <RimWorldAccess.Quests.Action.ResumedQuest>Resumed quest: {0}</RimWorldAccess.Quests.Action.ResumedQuest>
  <RimWorldAccess.Quests.Action.DeletedQuest>Deleted quest: {0}</RimWorldAccess.Quests.Action.DeletedQuest>
  <RimWorldAccess.Quests.Action.NoEligibleColonists>No eligible colonists to accept this quest</RimWorldAccess.Quests.Action.NoEligibleColonists>
  <RimWorldAccess.Quests.Action.SelectColonist>Select a colonist to accept this quest</RimWorldAccess.Quests.Action.SelectColonist>
  <!-- Eligible-colonist label suffix when the pawn holds royalty:
       {0} = pawn LabelShort, {1} = title label. -->
  <RimWorldAccess.Quests.Action.PawnWithTitle>{0} ({1})</RimWorldAccess.Quests.Action.PawnWithTitle>

  <!-- =================================================================
       Reward-choice float menu (multi-choice quests). The float menu
       is opened by Alt+A on a quest with QuestPart_Choice and 2+
       choices; Choose announces the prompt before WindowlessFloatMenu
       opens. NoItemsToInspect is spoken when Alt+I is pressed but the
       chosen reward has no inspectable Things or Factions. -->
  <RimWorldAccess.Quests.RewardChoice.Prompt>Choose a reward</RimWorldAccess.Quests.RewardChoice.Prompt>
  <RimWorldAccess.Quests.RewardChoice.NoItemsToInspect>No items to inspect</RimWorldAccess.Quests.RewardChoice.NoItemsToInspect>
  <RimWorldAccess.Quests.RewardChoice.BackToList>Back to quest list</RimWorldAccess.Quests.RewardChoice.BackToList>

  <!-- =================================================================
       Reward preferences panel (Tab in the quest list). Toggles
       per-faction acceptance of royal-favor and goodwill rewards.
       Status words (checked / unchecked) compose into the per-faction
       label below; relation phrasing is also a key so translators can
       reorder "currently {amount}, {relation}". -->
  <RimWorldAccess.Quests.Pref.Title>Reward preferences</RimWorldAccess.Quests.Pref.Title>
  <RimWorldAccess.Quests.Pref.QuestList>Quest list</RimWorldAccess.Quests.Pref.QuestList>
  <RimWorldAccess.Quests.Pref.None>No reward preferences available</RimWorldAccess.Quests.Pref.None>
  <RimWorldAccess.Quests.Pref.Checked>checked</RimWorldAccess.Quests.Pref.Checked>
  <RimWorldAccess.Quests.Pref.Unchecked>unchecked</RimWorldAccess.Quests.Pref.Unchecked>
  <!-- Royal-favor row: {0} = faction.Name, {1} = royal favor label
       (CapitalizeFirst), {2} = checked/unchecked. -->
  <RimWorldAccess.Quests.Pref.RoyalFavorRow>{0}: Accept {1}, {2}</RimWorldAccess.Quests.Pref.RoyalFavorRow>
  <!-- Goodwill row: {0} = faction.Name, {1} = checked/unchecked,
       {2} = relation phrase (built from RelationPhrase below). -->
  <RimWorldAccess.Quests.Pref.GoodwillRow>{0}: Accept Goodwill, {1}, {2}</RimWorldAccess.Quests.Pref.GoodwillRow>
  <!-- Relation phrase: {0} = signed goodwill amount, {1} = relation
       kind label cap (Ally/Neutral/Hostile/etc., from vanilla). -->
  <RimWorldAccess.Quests.Pref.RelationPhrase>currently {0}, {1}</RimWorldAccess.Quests.Pref.RelationPhrase>
  <!-- Pref-row position suffix: {0} = built row label,
       {1} = position string from MenuHelper.FormatPosition. -->
  <RimWorldAccess.Quests.Pref.RowWithPosition>{0}. {1}</RimWorldAccess.Quests.Pref.RowWithPosition>

  <!-- =================================================================
       Reward extraction (QuestRewardHelper). Builds the reward detail
       lines and the compact reward description used in list views and
       button labels. The "indent" prefix ("  ") is hard-coded in the
       helper so each reward item line is visually grouped under its
       header line; the indent is preserved in keys here. -->
  <RimWorldAccess.Quests.Reward.NoRewards>No rewards</RimWorldAccess.Quests.Reward.NoRewards>
  <RimWorldAccess.Quests.Reward.MultipleChoices>Multiple reward choices available</RimWorldAccess.Quests.Reward.MultipleChoices>
  <RimWorldAccess.Quests.Reward.RewardsHeader>Rewards:</RimWorldAccess.Quests.Reward.RewardsHeader>
  <RimWorldAccess.Quests.Reward.ChoicesHeader>Reward choices (choose one to accept):</RimWorldAccess.Quests.Reward.ChoicesHeader>
  <!-- {0} = 1-based choice index. -->
  <RimWorldAccess.Quests.Reward.ChoiceLabel>Choice {0}:</RimWorldAccess.Quests.Reward.ChoiceLabel>

  <!-- Item formatting for both the detail-view lines and the compact
       summary. ItemWithCount: {0} = count, {1} = capitalized label;
       ItemSingle: {0} = capitalized label. -->
  <RimWorldAccess.Quests.Reward.ItemWithCount>{0}x {1}</RimWorldAccess.Quests.Reward.ItemWithCount>
  <RimWorldAccess.Quests.Reward.ItemSingle>{0}</RimWorldAccess.Quests.Reward.ItemSingle>
  <RimWorldAccess.Quests.Reward.ItemsFallback>Items</RimWorldAccess.Quests.Reward.ItemsFallback>
  <RimWorldAccess.Quests.Reward.ItemFallback>Item</RimWorldAccess.Quests.Reward.ItemFallback>

  <!-- Goodwill / royal-favor reward composition. {0} = signed amount
       (ToStringWithSign), {1} = faction.Name, {2} = favor label
       (royal favor only; CapitalizeFirst applied at callsite). -->
  <RimWorldAccess.Quests.Reward.Goodwill>{0} goodwill with {1}</RimWorldAccess.Quests.Reward.Goodwill>
  <RimWorldAccess.Quests.Reward.RoyalFavor>{0} {1} with {2}</RimWorldAccess.Quests.Reward.RoyalFavor>

  <!-- Pawn reward variants. PawnHidden has no name (details are
       hidden); PawnWithName: {0} = pawn LabelShort. -->
  <RimWorldAccess.Quests.Reward.PawnHidden>Pawn (details hidden)</RimWorldAccess.Quests.Reward.PawnHidden>
  <RimWorldAccess.Quests.Reward.PawnWithName>Pawn: {0}</RimWorldAccess.Quests.Reward.PawnWithName>
  <RimWorldAccess.Quests.Reward.PawnGeneric>Pawn</RimWorldAccess.Quests.Reward.PawnGeneric>

  <!-- Total market value line, appended once per reward set if the
       sum is positive. {0} = ToStringMoney("F0") result. -->
  <RimWorldAccess.Quests.Reward.TotalValue>Total value: {0}</RimWorldAccess.Quests.Reward.TotalValue>

  <!-- Indent applied to detail-view reward item lines. Stays as a
       key so non-English layouts can use a different prefix or none. -->
  <RimWorldAccess.Quests.Reward.LineIndent>  </RimWorldAccess.Quests.Reward.LineIndent>

  <!-- =================================================================
       Notification menu (NotificationMenuState). List view shows all
       active messages, letters, and alerts; detail view shows the full
       letter content with extracted action buttons.
       ================================================================= -->
  <RimWorldAccess.Notifications.Menu.None>No notifications available</RimWorldAccess.Notifications.Menu.None>
  <RimWorldAccess.Notifications.Menu.Closed>Notification menu closed</RimWorldAccess.Notifications.Menu.Closed>
  <RimWorldAccess.Notifications.Menu.NoTargetLocation>No target location available</RimWorldAccess.Notifications.Menu.NoTargetLocation>
  <RimWorldAccess.Notifications.Menu.TargetNotValid>Target location is not valid</RimWorldAccess.Notifications.Menu.TargetNotValid>
  <RimWorldAccess.Notifications.Menu.FailedToActivateButton>Failed to activate button</RimWorldAccess.Notifications.Menu.FailedToActivateButton>
  <RimWorldAccess.Notifications.Menu.FailedToJump>Failed to jump to target</RimWorldAccess.Notifications.Menu.FailedToJump>
  <RimWorldAccess.Notifications.Menu.OnlyLettersDeletable>Only letters can be deleted</RimWorldAccess.Notifications.Menu.OnlyLettersDeletable>
  <RimWorldAccess.Notifications.Menu.CannotDeleteLetter>Cannot delete this letter</RimWorldAccess.Notifications.Menu.CannotDeleteLetter>

  <!-- Type labels for notifications. Used both as the prefix of the
       list-view announcement ("Letter: <label>") and inside the
       detail-view header. -->
  <RimWorldAccess.Notifications.Type.Message>Message</RimWorldAccess.Notifications.Type.Message>
  <RimWorldAccess.Notifications.Type.Letter>Letter</RimWorldAccess.Notifications.Type.Letter>
  <RimWorldAccess.Notifications.Type.Alert>Alert</RimWorldAccess.Notifications.Type.Alert>
  <RimWorldAccess.Notifications.Type.Unknown>Unknown</RimWorldAccess.Notifications.Type.Unknown>

  <!-- List-view announcement composition. {0} = type label, {1} =
       notification label, {2} = position string. -->
  <RimWorldAccess.Notifications.List.LineWithPosition>{0}: {1}. {2}</RimWorldAccess.Notifications.List.LineWithPosition>
  <RimWorldAccess.Notifications.List.HeaderInDetail>{0}: {1}</RimWorldAccess.Notifications.List.HeaderInDetail>

  <!-- Detail navigation markers (parallel to Quests.Detail.Start /
       EndOfDetails - separate keys so word order can vary). -->
  <RimWorldAccess.Notifications.Detail.StartOfLetter>Start of letter</RimWorldAccess.Notifications.Detail.StartOfLetter>
  <RimWorldAccess.Notifications.Detail.EndOfLetter>End of letter</RimWorldAccess.Notifications.Detail.EndOfLetter>

  <!-- Action button labels extracted from letters and alerts. -->
  <RimWorldAccess.Notifications.Button.OpenGrowthMoment>Open growth moment</RimWorldAccess.Notifications.Button.OpenGrowthMoment>
  <RimWorldAccess.Notifications.Button.ViewChoices>View choices</RimWorldAccess.Notifications.Button.ViewChoices>
  <RimWorldAccess.Notifications.Button.OpenResearch>Open Research</RimWorldAccess.Notifications.Button.OpenResearch>
  <RimWorldAccess.Notifications.Button.Activate>Activate</RimWorldAccess.Notifications.Button.Activate>
  <!-- Single-target jump button: {0} = target description. -->
  <RimWorldAccess.Notifications.Button.JumpTo>Jump to {0}</RimWorldAccess.Notifications.Button.JumpTo>
  <!-- Multi-target jump button: {0} = target description, {1} = 1-based
       index, {2} = total target count (capped at 5). -->
  <RimWorldAccess.Notifications.Button.JumpToWithIndex>Jump to {0} ({1} of {2})</RimWorldAccess.Notifications.Button.JumpToWithIndex>

  <!-- Action feedback strings spoken after a button completes. {0} =
       button label echoed back so the user hears confirmation. -->
  <RimWorldAccess.Notifications.Action.AlertActivated>Alert activated</RimWorldAccess.Notifications.Action.AlertActivated>
  <RimWorldAccess.Notifications.Action.ActivatedNoneRemaining>Activated {0}. No notifications remaining</RimWorldAccess.Notifications.Action.ActivatedNoneRemaining>
  <RimWorldAccess.Notifications.Action.ActivatedBackToList>Activated {0}. Back to list</RimWorldAccess.Notifications.Action.ActivatedBackToList>
  <RimWorldAccess.Notifications.Action.OpeningInfoCard>Opening info card for {0}</RimWorldAccess.Notifications.Action.OpeningInfoCard>
  <!-- Delete-letter feedback. {0} = deleted letter label.
       DeletedNoneRemaining is spoken when the deletion empties the
       list; DeletedNextItem composes the next item announcement.
       {1} = next type label, {2} = next item label, {3} = position. -->
  <RimWorldAccess.Notifications.Action.DeletedNoneRemaining>Deleted {0}. No notifications remaining</RimWorldAccess.Notifications.Action.DeletedNoneRemaining>
  <RimWorldAccess.Notifications.Action.DeletedNextItem>Deleted {0}. {1}: {2}. {3}</RimWorldAccess.Notifications.Action.DeletedNextItem>

  <!-- Target descriptions used by Notifications.Button.JumpTo and
       MapNavigationState.SpeakJumpedTo. Position: {0} = cell.x,
       {1} = cell.z. -->
  <RimWorldAccess.Notifications.Target.Generic>target location</RimWorldAccess.Notifications.Target.Generic>
  <RimWorldAccess.Notifications.Target.LocationFallback>location</RimWorldAccess.Notifications.Target.LocationFallback>
  <RimWorldAccess.Notifications.Target.Unknown>unknown location</RimWorldAccess.Notifications.Target.Unknown>
  <RimWorldAccess.Notifications.Target.WorldLocation>world location</RimWorldAccess.Notifications.Target.WorldLocation>
  <RimWorldAccess.Notifications.Target.Thing>thing</RimWorldAccess.Notifications.Target.Thing>
  <RimWorldAccess.Notifications.Target.Position>position {0}, {1}</RimWorldAccess.Notifications.Target.Position>

</LanguageData>
