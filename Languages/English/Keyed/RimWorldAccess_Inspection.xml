  <RimWorldAccess.Inspection.Building.BillTarget>Target: {0}</RimWorldAccess.Inspection.Building.BillTarget>
  <RimWorldAccess.Inspection.Building.BillMode>Mode: {0}</RimWorldAccess.Inspection.Building.BillMode>
  <RimWorldAccess.Inspection.Building.BillSuspended>({0})</RimWorldAccess.Inspection.Building.BillSuspended>
