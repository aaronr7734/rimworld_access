  <RimWorldAccess.Inspection.Building.NoBills>No bills queued.</RimWorldAccess.Inspection.Building.NoBills>
  <RimWorldAccess.Inspection.Building.BillsHeader>Bills ({0}):</RimWorldAccess.Inspection.Building.BillsHeader>
