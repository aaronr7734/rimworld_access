  <!-- Storage settings menu (StorageSettingsMenuState +
       StorageSettingsMenuPatch) and the parallel ThingFilterMenuState
       (used by BillConfigState ingredient filters and the storage
       sub-states in InspectionTreeBuilder). Both states render the
       same filter-tree shape and share these keys: top-level menu
       item labels and the summaries spoken as the user navigates the
       filter tree, plus the result announcements after editing the
       range submenu and after expand-all-siblings. Vanilla
       StoragePriority labels and category labels come from the game
       and are used as data placeholders. The "expanded" / "collapsed"
       tree state words and the "Expanded N item(s)" announcements
       after * delegate to Common.Tree.* keys. The "Already at top
       level" boundary announcement delegates to Common.Edge.TopLevel
       via MenuHelper.SpeakAlreadyAtEdge. -->
  <!-- Top-level menu rows. PriorityLabel: {0} = capitalized priority
       label. RangeLabel.HitPoints: {0} = min %, {1} = max %.
       RangeLabel.Quality: {0} = min QualityCategory, {1} = max
       QualityCategory. -->
  <RimWorldAccess.Inspection.Storage.PriorityLabel>Priority: {0}</RimWorldAccess.Inspection.Storage.PriorityLabel>
  <RimWorldAccess.Inspection.Storage.ClearAll>Clear All</RimWorldAccess.Inspection.Storage.ClearAll>
  <RimWorldAccess.Inspection.Storage.AllowAll>Allow All</RimWorldAccess.Inspection.Storage.AllowAll>
  <RimWorldAccess.Inspection.Storage.RangeLabel.HitPoints>Hit Points: {0} - {1}</RimWorldAccess.Inspection.Storage.RangeLabel.HitPoints>
  <RimWorldAccess.Inspection.Storage.RangeLabel.Quality>Quality: {0} - {1}</RimWorldAccess.Inspection.Storage.RangeLabel.Quality>

  <!-- Toggle result. {0} = item / category label; the state words are
       split into one whole-phrase key per (state, capitalization) so
       word order can vary per language. CategoryWithSummary is spoken
       on category navigation: {0} = label, {1} = summary text built by
       ThingFilterHelper.FormatCategorySummary, {2} = expand state
       (Common.Tree.StateExpanded / StateCollapsed). LabelWithExpandState
       handles categories whose summary cannot be computed; {0} = label,
       {1} = expand state. ItemAllowState applies to ThingDef and
       SpecialFilter rows; {0} = label, {1} = the lowercase state. -->
  <RimWorldAccess.Inspection.Storage.ToggleResultAllowed>{0}: Allowed</RimWorldAccess.Inspection.Storage.ToggleResultAllowed>
  <RimWorldAccess.Inspection.Storage.ToggleResultDisallowed>{0}: Disallowed</RimWorldAccess.Inspection.Storage.ToggleResultDisallowed>
  <RimWorldAccess.Inspection.Storage.CategoryWithSummary>{0}. {1}, {2}</RimWorldAccess.Inspection.Storage.CategoryWithSummary>
  <RimWorldAccess.Inspection.Storage.LabelWithExpandState>{0} {1}</RimWorldAccess.Inspection.Storage.LabelWithExpandState>
  <RimWorldAccess.Inspection.Storage.ItemAllowed>{0}. allowed</RimWorldAccess.Inspection.Storage.ItemAllowed>
  <RimWorldAccess.Inspection.Storage.ItemDisallowed>{0}. disallowed</RimWorldAccess.Inspection.Storage.ItemDisallowed>

  <!-- Category summary phrases (ThingFilterHelper.FormatCategorySummary).
       Spoken as the {1} placeholder of CategoryWithSummary above and
       composed into the search-context announcement. The summary
       reports from the minority perspective: AllAllowed / AllDisallowed
       cover the trivial cases; the four except-* forms cover mixed
       categories where a few items diverge from the majority.
       AllowedExceptList: {0} = comma-joined names of disallowed items.
       DisallowedExceptList: {0} = comma-joined names of allowed items.
       AllowedExceptCount: {0} = count of disallowed items (always > 10
       in practice). DisallowedExceptCount: {0} = count of allowed items
       (also always > 10). Each except-* form is one whole-phrase key
       so the comma + "except: " glue can vary per language and the
       except-list / except-count distinction does not have to share
       wording. -->
  <RimWorldAccess.Inspection.Storage.Summary.AllAllowed>allowed</RimWorldAccess.Inspection.Storage.Summary.AllAllowed>
  <RimWorldAccess.Inspection.Storage.Summary.AllDisallowed>disallowed</RimWorldAccess.Inspection.Storage.Summary.AllDisallowed>
  <RimWorldAccess.Inspection.Storage.Summary.AllowedExceptList>allowed, except: {0}</RimWorldAccess.Inspection.Storage.Summary.AllowedExceptList>
  <RimWorldAccess.Inspection.Storage.Summary.DisallowedExceptList>disallowed, except: {0}</RimWorldAccess.Inspection.Storage.Summary.DisallowedExceptList>
  <RimWorldAccess.Inspection.Storage.Summary.AllowedExceptCount>allowed, except for {0} items</RimWorldAccess.Inspection.Storage.Summary.AllowedExceptCount>
  <RimWorldAccess.Inspection.Storage.Summary.DisallowedExceptCount>disallowed, except for {0} items</RimWorldAccess.Inspection.Storage.Summary.DisallowedExceptCount>

