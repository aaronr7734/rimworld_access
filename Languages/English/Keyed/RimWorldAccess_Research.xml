<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Research module strings (src/Research/). Two state files contribute:
      - WindowlessResearchMenuState.cs  (the accessible research menu that
        replaces MainTabWindow_Research; hierarchical tree of tabs,
        status groups, and projects)
      - WindowlessResearchDetailState.cs  (the detail view opened from a
        project; tree of description, prerequisites, unlocks, dependents,
        and the start/stop action)

    Shared phrases (no info card available, already at edge, etc.) are
    delegated to RimWorldAccess_Common.xml so translators only localize
    them once. Only strings unique to the research UI live here.

    Placeholders follow string.Format ({0}, {1}, ...). One/Many key
    variants are used where English needs singular vs. plural agreement
    (e.g. "1 hidden prerequisite" vs "3 hidden prerequisites");
    translators with different plural classes can either collapse or
    split these further.
  -->

  <!-- Menu open/close announcements (WindowlessResearchMenuState). -->
  <RimWorldAccess.Research.Menu.Title>Research menu</RimWorldAccess.Research.Menu.Title>
  <RimWorldAccess.Research.Menu.Closed>Research menu closed</RimWorldAccess.Research.Menu.Closed>
  <RimWorldAccess.Research.Menu.ProjectNotAvailable>Research project not available</RimWorldAccess.Research.Menu.ProjectNotAvailable>
  <RimWorldAccess.Research.Menu.ProjectNotFound>Research project {0} not found in menu</RimWorldAccess.Research.Menu.ProjectNotFound>

  <!-- Root label for the built category tree. -->
  <RimWorldAccess.Research.Tree.RootLabel>Research</RimWorldAccess.Research.Tree.RootLabel>

  <!-- Status group labels. {0} = number of projects in the group. -->
  <RimWorldAccess.Research.Status.InProgress>In Progress ({0})</RimWorldAccess.Research.Status.InProgress>
  <RimWorldAccess.Research.Status.Available>Available ({0})</RimWorldAccess.Research.Status.Available>
  <RimWorldAccess.Research.Status.Completed>Completed ({0})</RimWorldAccess.Research.Status.Completed>
  <RimWorldAccess.Research.Status.Locked>Locked ({0})</RimWorldAccess.Research.Status.Locked>

  <!-- Short status words used inline in labels (e.g. after prereq/dep rows). -->
  <RimWorldAccess.Research.Status.CompletedWord>Completed</RimWorldAccess.Research.Status.CompletedWord>
  <RimWorldAccess.Research.Status.AvailableWord>Available</RimWorldAccess.Research.Status.AvailableWord>
  <RimWorldAccess.Research.Status.LockedWord>Locked</RimWorldAccess.Research.Status.LockedWord>

  <!-- Project label formatting (menu list entries).
       Cost/knowledge/progress suffixes are composed together with the
       project name by the caller. {0} = the numeric value. -->
  <RimWorldAccess.Research.Label.CostSuffix> - cost: {0}</RimWorldAccess.Research.Label.CostSuffix>
  <RimWorldAccess.Research.Label.KnowledgeSuffix> - knowledge: {0}</RimWorldAccess.Research.Label.KnowledgeSuffix>
  <RimWorldAccess.Research.Label.ProgressSuffix> - {0}% complete</RimWorldAccess.Research.Label.ProgressSuffix>
  <RimWorldAccess.Research.Label.StatusSuffix> - {0}</RimWorldAccess.Research.Label.StatusSuffix>

  <!-- Detail view navigation (WindowlessResearchDetailState).
       BackTo: {0} = the previous research project we return to. -->
  <RimWorldAccess.Research.Detail.BackTo>Back to {0}</RimWorldAccess.Research.Detail.BackTo>
  <RimWorldAccess.Research.Detail.ReturnedToMenu>Returned to research menu</RimWorldAccess.Research.Detail.ReturnedToMenu>

  <!-- Detail top-level node labels. -->
  <RimWorldAccess.Research.Detail.DescriptionLabel>Description</RimWorldAccess.Research.Detail.DescriptionLabel>
  <RimWorldAccess.Research.Detail.StartResearch>Start Research</RimWorldAccess.Research.Detail.StartResearch>
  <RimWorldAccess.Research.Detail.StopResearch>Stop Research</RimWorldAccess.Research.Detail.StopResearch>
  <RimWorldAccess.Research.Detail.StartResearchHint>Press Enter to start this research</RimWorldAccess.Research.Detail.StartResearchHint>
  <RimWorldAccess.Research.Detail.StopResearchHint>Press Enter to stop this research</RimWorldAccess.Research.Detail.StopResearchHint>

  <!-- Category headers inside the detail tree.
       WithCount: {0} = number of child items; None is used when empty. -->
  <RimWorldAccess.Research.Detail.PrerequisitesWithCount>Prerequisites ({0} items)</RimWorldAccess.Research.Detail.PrerequisitesWithCount>
  <RimWorldAccess.Research.Detail.PrerequisitesNone>Prerequisites (none)</RimWorldAccess.Research.Detail.PrerequisitesNone>
  <RimWorldAccess.Research.Detail.UnlocksWithCount>Unlocks ({0} items)</RimWorldAccess.Research.Detail.UnlocksWithCount>
  <RimWorldAccess.Research.Detail.UnlocksNone>Unlocks (none)</RimWorldAccess.Research.Detail.UnlocksNone>
  <RimWorldAccess.Research.Detail.DependentsWithCount>Dependents ({0} items)</RimWorldAccess.Research.Detail.DependentsWithCount>
  <RimWorldAccess.Research.Detail.DependentsNone>Dependents (none)</RimWorldAccess.Research.Detail.DependentsNone>

  <!-- Research row inside a category (prereqs / dependents).
       {0} = project label, {1} = cost, {2} = status word. -->
  <RimWorldAccess.Research.Detail.ResearchRow>{0} - cost: {1} {2}</RimWorldAccess.Research.Detail.ResearchRow>

  <!-- Hidden prerequisite summary. AllCompleted is used when nothing is
       missing; IncompleteCount takes {0} = number still incomplete.
       HiddenOne/Many compose with the status word: {0} = count (omitted
       in One form), {1} = status word. -->
  <RimWorldAccess.Research.Detail.HiddenAllCompleted>All completed</RimWorldAccess.Research.Detail.HiddenAllCompleted>
  <RimWorldAccess.Research.Detail.HiddenIncompleteCount>{0} incomplete</RimWorldAccess.Research.Detail.HiddenIncompleteCount>
  <RimWorldAccess.Research.Detail.HiddenOne>1 hidden prerequisite - {0}</RimWorldAccess.Research.Detail.HiddenOne>
  <RimWorldAccess.Research.Detail.HiddenMany>{0} hidden prerequisites - {1}</RimWorldAccess.Research.Detail.HiddenMany>

  <!-- Prerequisite bench/facility/techprint/mechanitor/analyze/grav rows.
       Each row has an inline status tail. {0} = value or main label. -->
  <RimWorldAccess.Research.Detail.BenchAvailable>Available</RimWorldAccess.Research.Detail.BenchAvailable>
  <RimWorldAccess.Research.Detail.BenchNotAvailable>Not available</RimWorldAccess.Research.Detail.BenchNotAvailable>
  <RimWorldAccess.Research.Detail.RequiresBench>Requires bench: {0} - {1}</RimWorldAccess.Research.Detail.RequiresBench>
  <RimWorldAccess.Research.Detail.RequiresFacility>Requires facility: {0}</RimWorldAccess.Research.Detail.RequiresFacility>

  <RimWorldAccess.Research.Detail.TechprintsComplete>Complete</RimWorldAccess.Research.Detail.TechprintsComplete>
  <RimWorldAccess.Research.Detail.TechprintsProgress>{0}/{1}</RimWorldAccess.Research.Detail.TechprintsProgress>
  <RimWorldAccess.Research.Detail.RequiresTechprints>Requires techprints: {0}</RimWorldAccess.Research.Detail.RequiresTechprints>

  <RimWorldAccess.Research.Detail.MechanitorMet>Met</RimWorldAccess.Research.Detail.MechanitorMet>
  <RimWorldAccess.Research.Detail.MechanitorNotMet>Not met</RimWorldAccess.Research.Detail.MechanitorNotMet>
  <RimWorldAccess.Research.Detail.RequiresMechanitor>Requires mechanitor - {0}</RimWorldAccess.Research.Detail.RequiresMechanitor>

  <RimWorldAccess.Research.Detail.AnalyzeComplete>Complete</RimWorldAccess.Research.Detail.AnalyzeComplete>
  <RimWorldAccess.Research.Detail.AnalyzeProgress>{0}/{1}</RimWorldAccess.Research.Detail.AnalyzeProgress>
  <RimWorldAccess.Research.Detail.RequiresAnalyzing>Requires analyzing: {0} - {1}</RimWorldAccess.Research.Detail.RequiresAnalyzing>

  <RimWorldAccess.Research.Detail.GravEngineInspected>Inspected</RimWorldAccess.Research.Detail.GravEngineInspected>
  <RimWorldAccess.Research.Detail.GravEngineNotInspected>Not inspected</RimWorldAccess.Research.Detail.GravEngineNotInspected>
  <RimWorldAccess.Research.Detail.RequiresGravEngine>Requires grav engine inspection - {0}</RimWorldAccess.Research.Detail.RequiresGravEngine>

  <!-- Unlocked item categories. Nouns used in labels like "(Building)". -->
  <RimWorldAccess.Research.Detail.UnlockCategoryBuilding>Building</RimWorldAccess.Research.Detail.UnlockCategoryBuilding>
  <RimWorldAccess.Research.Detail.UnlockCategoryPlant>Plant</RimWorldAccess.Research.Detail.UnlockCategoryPlant>
  <RimWorldAccess.Research.Detail.UnlockCategoryItem>Item</RimWorldAccess.Research.Detail.UnlockCategoryItem>
  <RimWorldAccess.Research.Detail.UnlockCategoryRecipe>Recipe</RimWorldAccess.Research.Detail.UnlockCategoryRecipe>

  <!-- No-info-card message for non-target tree sections. -->
  <RimWorldAccess.Research.Detail.NoInfoCardForSection>No info card for this section</RimWorldAccess.Research.Detail.NoInfoCardForSection>

  <!-- Description content builder (StringBuilder in BuildDescriptionContent).
       Each key is a single line in the composed text block. -->
  <RimWorldAccess.Research.Desc.ProjectLine>Project: {0}</RimWorldAccess.Research.Desc.ProjectLine>
  <RimWorldAccess.Research.Desc.ResearchCost>Research Cost: {0}</RimWorldAccess.Research.Desc.ResearchCost>
  <RimWorldAccess.Research.Desc.KnowledgeCost>Knowledge Cost: {0}</RimWorldAccess.Research.Desc.KnowledgeCost>
  <RimWorldAccess.Research.Desc.KnowledgeCategory>Knowledge Category: {0}</RimWorldAccess.Research.Desc.KnowledgeCategory>
  <RimWorldAccess.Research.Desc.Progress>Progress: {0}%</RimWorldAccess.Research.Desc.Progress>
  <RimWorldAccess.Research.Desc.StatusCompleted>Status: Completed</RimWorldAccess.Research.Desc.StatusCompleted>
  <RimWorldAccess.Research.Desc.StatusAvailable>Status: Available to research</RimWorldAccess.Research.Desc.StatusAvailable>
  <RimWorldAccess.Research.Desc.StatusLocked>Status: Locked</RimWorldAccess.Research.Desc.StatusLocked>
  <RimWorldAccess.Research.Desc.RequiredBench>Required Bench: {0}</RimWorldAccess.Research.Desc.RequiredBench>
  <RimWorldAccess.Research.Desc.RequiredFacilitiesPrefix>Required Facilities: </RimWorldAccess.Research.Desc.RequiredFacilitiesPrefix>

  <!-- Research action announcements (start / stop / blocked). -->
  <RimWorldAccess.Research.Action.Stopped>Stopped research on {0}</RimWorldAccess.Research.Action.Stopped>
  <RimWorldAccess.Research.Action.AlreadyCompleted>{0} is already completed</RimWorldAccess.Research.Action.AlreadyCompleted>
  <RimWorldAccess.Research.Action.MissingPrereqs>Cannot start research: Missing prerequisites - {0}</RimWorldAccess.Research.Action.MissingPrereqs>
  <RimWorldAccess.Research.Action.NeedTechprints>Cannot start research: Need {0} techprints, only {1} applied</RimWorldAccess.Research.Action.NeedTechprints>
  <RimWorldAccess.Research.Action.StudyFirst>Cannot start research: Must study required items first</RimWorldAccess.Research.Action.StudyFirst>
  <RimWorldAccess.Research.Action.Started>Started research on {0}</RimWorldAccess.Research.Action.Started>
  <RimWorldAccess.Research.Action.StartedReplacing>Started research on {0}. Stopped {1} at {2}% progress.</RimWorldAccess.Research.Action.StartedReplacing>

  <!-- Missing prerequisite list fragments.
       Unknown: spoken when currentProject is null or no parts collected.
       HiddenOne/Many: {0} = count of hidden missing prereqs (omitted in One form). -->
  <RimWorldAccess.Research.MissingPrereqs.Unknown>Unknown</RimWorldAccess.Research.MissingPrereqs.Unknown>
  <RimWorldAccess.Research.MissingPrereqs.HiddenOne>1 hidden prerequisite</RimWorldAccess.Research.MissingPrereqs.HiddenOne>
  <RimWorldAccess.Research.MissingPrereqs.HiddenMany>{0} hidden prerequisites</RimWorldAccess.Research.MissingPrereqs.HiddenMany>
</LanguageData>
