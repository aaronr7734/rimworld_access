  <!-- ScreenScope shared screen shape (screen-model refactor): the
       automatic Buttons region name and the empty-region word. -->
  <RimWorldAccess.Shell.Screen.ActionsRegion>工具栏</RimWorldAccess.Shell.Screen.ActionsRegion>
  <RimWorldAccess.Shell.Screen.ExtrasRegion>附加控件</RimWorldAccess.Shell.Screen.ExtrasRegion>
