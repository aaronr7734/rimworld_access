<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!-- Global gear screen (src/Shell/Screens/GlobalGearScope.Game.cs). Holder rows use the shared PawnGroup strings in RimWorldAccess_GlobalHealth.xml. -->
  <RimWorldAccess.GlobalGear.Title>地图上的装备</RimWorldAccess.GlobalGear.Title>
  <!-- Section summaries. {0} = the gear tab's section name, {1} = how many items it holds, {2} = how many pawns hold them. -->
  <RimWorldAccess.GlobalGear.Summary.None>{0}. 无</RimWorldAccess.GlobalGear.Summary.None>
  <RimWorldAccess.GlobalGear.Summary.Items>{0}. {1} 件物品, {2} 位持有者</RimWorldAccess.GlobalGear.Summary.Items>
  <RimWorldAccess.GlobalGear.Summary.OneHolder>{0}. {1} 件物品, 1 位持有者</RimWorldAccess.GlobalGear.Summary.OneHolder>
  <RimWorldAccess.GlobalGear.Summary.OneItem>{0}. 1 件物品, 1 位持有者</RimWorldAccess.GlobalGear.Summary.OneItem>
  <!-- {0} = the item's name, {1} = how many are held. -->
  <RimWorldAccess.GlobalGear.Item>{0} x{1}</RimWorldAccess.GlobalGear.Item>
  <!-- {0} = the stack count. -->
  <RimWorldAccess.GlobalGear.StackCount>堆叠 {0}</RimWorldAccess.GlobalGear.StackCount>
  <!-- {0} = hit points as a percentage, already formatted ("43%"). -->
  <RimWorldAccess.GlobalGear.Condition>{0}耐久度</RimWorldAccess.GlobalGear.Condition>
  <RimWorldAccess.GlobalGear.JumpUnavailable>无法跳转到该角色。</RimWorldAccess.GlobalGear.JumpUnavailable>
  <!-- After a filter checkbox is toggled. {0} = the checkbox's new state ("checked"), {1} = how many pawns now hold listed gear. -->
  <RimWorldAccess.GlobalGear.FilterChanged>{0}. 已列出 {1} 位持有者</RimWorldAccess.GlobalGear.FilterChanged>
  <RimWorldAccess.GlobalGear.FilterChangedOne>{0}. 已列出 1 位持有者</RimWorldAccess.GlobalGear.FilterChangedOne>
</LanguageData>
