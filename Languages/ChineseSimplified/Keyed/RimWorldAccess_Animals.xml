  <RimWorldAccess.Animals.AutoSlaughter.Value.PregnantNotAllowed>{0} 只怀孕，不允许宰杀</RimWorldAccess.Animals.AutoSlaughter.Value.PregnantNotAllowed>
  <RimWorldAccess.Animals.AutoSlaughter.Value.BondedAllowed>{0} 只产生牵绊，允许宰杀</RimWorldAccess.Animals.AutoSlaughter.Value.BondedAllowed>
  <RimWorldAccess.Animals.AutoSlaughter.Value.BondedNotAllowed>{0} 只产生牵绊，不允许宰杀</RimWorldAccess.Animals.AutoSlaughter.Value.BondedNotAllowed>

  <!-- Cell announcement composition.
       WithName: {0} = animal LabelCap, {1} = column name, {2} = value,
         {3} = position suffix.
       WithoutName: {0} = column name, {1} = value. -->
  <RimWorldAccess.Animals.AutoSlaughter.Cell.WithName>{0}, {1}: {2}. {3}</RimWorldAccess.Animals.AutoSlaughter.Cell.WithName>
  <RimWorldAccess.Animals.AutoSlaughter.Cell.WithoutName>{0}: {1}</RimWorldAccess.Animals.AutoSlaughter.Cell.WithoutName>

  <!-- Numeric input mode. "minus" is spoken after the user presses the
       minus key so they hear confirmation of what's in the buffer;
       "Empty" is spoken after backspacing the last character. -->
  <RimWorldAccess.Animals.AutoSlaughter.Numeric.Prompt>输入一个数字，然后按 Enter 确认或按 Escape 取消</RimWorldAccess.Animals.AutoSlaughter.Numeric.Prompt>
