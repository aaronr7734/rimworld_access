  <RimWorldAccess.Animals.Paint.Single.MasterApplied>{0}: 已将主人设为 {1}。{2}</RimWorldAccess.Animals.Paint.Single.MasterApplied>
  <RimWorldAccess.Animals.Paint.Single.CannotSetMedicalCare>{0}: 无法设置医疗照顾。{1}</RimWorldAccess.Animals.Paint.Single.CannotSetMedicalCare>
  <RimWorldAccess.Animals.Paint.Single.MedicalCareAlready>{0}: 医疗照顾已是 {1}。{2}</RimWorldAccess.Animals.Paint.Single.MedicalCareAlready>
  <RimWorldAccess.Animals.Paint.Single.MedicalCareApplied>{0}: 已将医疗照顾设为 {1}。{2}</RimWorldAccess.Animals.Paint.Single.MedicalCareApplied>
  <!-- Generic checkbox / training paint: {0} = name, {1} = column name,
       {2} = value label (checked/unchecked), {3} = position. -->
  <RimWorldAccess.Animals.Paint.Single.CellAlready>{0}: {1} 已是 {2}。{3}</RimWorldAccess.Animals.Paint.Single.CellAlready>
