<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Animals module strings (src/Animals/). Five state/helper files contribute:
      - AnimalsMenuState.cs / AnimalsMenuHelper.cs  (colony animals tab)
      - WildlifeMenuState.cs / WildlifeMenuHelper.cs  (wild animals tab)
      - AutoSlaughterState.cs  (Dialog_AutoSlaughter overlay)

    Both menus use TabularMenuHelper<Pawn>, so many of their phrasings
    (cell announcements, sort feedback, paint feedback) are parallel and
    share placeholder patterns. Each state class keeps its own lifecycle
    announcements (OpeningTitle / MenuClosed) so translators can vary
    word order between the colony and wildlife variants.

    Placeholders follow string.Format ({0}, {1}, ...). Data such as animal
    names, area labels, colonist names, trainable LabelCaps, and column
    header text comes from the game and is NOT translated in this file.

    Shared phrases delegated to RimWorldAccess_Common.xml:
      - Already-at-edge / position / cannot-paint keys
      - Info card unavailable
      - Typeahead search scaffolding
    This file only contains phrases that are unique to the animals and
    wildlife tabs and to the auto-slaughter dialog.
  -->

  <!-- Shared fallback values used by both AnimalsMenuHelper and
       WildlifeMenuHelper for cells that cannot be resolved (e.g. a pawn
       with no map, a missing LifeStage). "Normal" is used for the
       MentalState column when the pawn is not in a mental state (vanilla
       shows an empty cell; we speak "Normal" for clarity). -->
  <RimWorldAccess.Animals.Value.Unknown>未知</RimWorldAccess.Animals.Value.Unknown>
  <RimWorldAccess.Animals.Value.NotApplicable>不适用</RimWorldAccess.Animals.Value.NotApplicable>
  <RimWorldAccess.Animals.Value.Normal>正常</RimWorldAccess.Animals.Value.Normal>
  <RimWorldAccess.Animals.Value.BondBroken>牵绊已断裂</RimWorldAccess.Animals.Value.BondBroken>
  <RimWorldAccess.Animals.Value.Scheduled>已排程</RimWorldAccess.Animals.Value.Scheduled>

  <!-- Paint value labels. AnimalsMenuHelper.GetPaintValueLabel and
       WildlifeMenuHelper.GetPaintValueLabel return these for checkbox
       column paint announcements. -->
  <RimWorldAccess.Animals.Paint.Checked>已勾选</RimWorldAccess.Animals.Paint.Checked>
  <RimWorldAccess.Animals.Paint.Unchecked>未勾选</RimWorldAccess.Animals.Paint.Unchecked>

  <!-- =================================================================
       AnimalsMenuHelper column headers (colony animals tab).
       "Name" and "Age" are hard-coded English labels that don't have
       matching vanilla translation keys; Gender/LifeStage/Pregnant etc.
       DO have vanilla keys and are resolved via .Translate() in C#.
       ================================================================= -->
  <RimWorldAccess.Animals.Column.Name>名称</RimWorldAccess.Animals.Column.Name>
  <RimWorldAccess.Animals.Column.Age>年龄</RimWorldAccess.Animals.Column.Age>
  <RimWorldAccess.Animals.Column.LifeStage>生命阶段</RimWorldAccess.Animals.Column.LifeStage>
  <RimWorldAccess.Animals.Column.SpecialTraining>特殊训练</RimWorldAccess.Animals.Column.SpecialTraining>
  <RimWorldAccess.Animals.Column.MentalState>精神状态</RimWorldAccess.Animals.Column.MentalState>
  <RimWorldAccess.Animals.Column.BondInfo>牵绊</RimWorldAccess.Animals.Column.BondInfo>
  <RimWorldAccess.Animals.Column.Sterile>绝育</RimWorldAccess.Animals.Column.Sterile>
  <RimWorldAccess.Animals.Column.MedicalCare>医疗照顾</RimWorldAccess.Animals.Column.MedicalCare>

  <!-- =================================================================
       Training status (AnimalsMenuHelper.GetTrainingStatus and
       GetSpecialTrainableStatus). Both methods share this vocabulary.
       {0} = current steps, {1} = total steps for the trainable.
       ================================================================= -->
  <RimWorldAccess.Animals.Training.CannotTrain>无法训练</RimWorldAccess.Animals.Training.CannotTrain>
  <RimWorldAccess.Animals.Training.Maintaining>巩固中 ({0}/{1})</RimWorldAccess.Animals.Training.Maintaining>
  <RimWorldAccess.Animals.Training.NotMaintaining>未巩固 ({0}/{1})</RimWorldAccess.Animals.Training.NotMaintaining>
  <RimWorldAccess.Animals.Training.InProgress>训练中 ({0}/{1})</RimWorldAccess.Animals.Training.InProgress>
  <RimWorldAccess.Animals.Training.WaitingToTrain>等待训练</RimWorldAccess.Animals.Training.WaitingToTrain>
  <RimWorldAccess.Animals.Training.WillNotTrain>不会训练</RimWorldAccess.Animals.Training.WillNotTrain>
  <RimWorldAccess.Animals.Training.NoSpecialAbility>无可用项</RimWorldAccess.Animals.Training.NoSpecialAbility>

  <!-- =================================================================
       AnimalsMenuState lifecycle and navigation announcements.
       ================================================================= -->
