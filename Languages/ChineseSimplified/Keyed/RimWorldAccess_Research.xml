<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Research module strings (src/Research/). Two state files contribute:
      - WindowlessResearchMenuState.cs  (the accessible research menu that
        replaces MainTabWindow_Research; hierarchical tree of tabs,
        status groups, and projects)
      - WindowlessResearchDetailState.cs  (the detail view opened from a
        project; tree of description, prerequisites, unlocks, dependents,
        and the start/stop action)

    Shared phrases (no info card available, already at edge, etc.) are
    delegated to RimWorldAccess_Common.xml so translators only localize
    them once. Only strings unique to the research UI live here.

    Placeholders follow string.Format ({0}, {1}, ...). One/Many key
    variants are used where English needs singular vs. plural agreement
    (e.g. "1 hidden prerequisite" vs "3 hidden prerequisites");
    translators with different plural classes can either collapse or
    split these further.
  -->

  <!-- Menu open/close announcements (WindowlessResearchMenuState). -->
  <RimWorldAccess.Research.Menu.Title>研究菜单</RimWorldAccess.Research.Menu.Title>
  <RimWorldAccess.Research.Menu.Closed>研究菜单已关闭</RimWorldAccess.Research.Menu.Closed>
  <RimWorldAccess.Research.Menu.ProjectNotAvailable>研究项目不可用</RimWorldAccess.Research.Menu.ProjectNotAvailable>
  <RimWorldAccess.Research.Menu.ProjectNotFound>菜单中未找到研究项目 {0}</RimWorldAccess.Research.Menu.ProjectNotFound>

  <!-- Root label for the built category tree. -->
  <RimWorldAccess.Research.Tree.RootLabel>研究</RimWorldAccess.Research.Tree.RootLabel>

  <!-- Status group labels. {0} = number of projects in the group. -->
  <RimWorldAccess.Research.Status.InProgress>进行中 ({0})</RimWorldAccess.Research.Status.InProgress>
  <RimWorldAccess.Research.Status.Available>可研究 ({0})</RimWorldAccess.Research.Status.Available>
  <RimWorldAccess.Research.Status.Completed>已完成 ({0})</RimWorldAccess.Research.Status.Completed>
  <RimWorldAccess.Research.Status.Locked>已锁定 ({0})</RimWorldAccess.Research.Status.Locked>

  <!-- Short status words used inline in labels (e.g. after prereq/dep rows). -->
  <RimWorldAccess.Research.Status.CompletedWord>已完成</RimWorldAccess.Research.Status.CompletedWord>
  <RimWorldAccess.Research.Status.AvailableWord>可研究</RimWorldAccess.Research.Status.AvailableWord>
  <RimWorldAccess.Research.Status.LockedWord>已锁定</RimWorldAccess.Research.Status.LockedWord>

  <!-- Project label formatting (menu list entries).
       Cost/knowledge/progress suffixes are composed together with the
       project name by the caller. {0} = the numeric value. -->
  <RimWorldAccess.Research.Label.CostSuffix> - 花费: {0}</RimWorldAccess.Research.Label.CostSuffix>
  <RimWorldAccess.Research.Label.KnowledgeSuffix> - 知识: {0}</RimWorldAccess.Research.Label.KnowledgeSuffix>
  <RimWorldAccess.Research.Label.ProgressSuffix> - 完成 {0}%</RimWorldAccess.Research.Label.ProgressSuffix>
  <RimWorldAccess.Research.Label.StatusSuffix> - {0}</RimWorldAccess.Research.Label.StatusSuffix>

  <!-- Detail view navigation (WindowlessResearchDetailState).
       BackTo: {0} = the previous research project we return to. -->
  <RimWorldAccess.Research.Detail.BackTo>返回 {0}</RimWorldAccess.Research.Detail.BackTo>
  <RimWorldAccess.Research.Detail.ReturnedToMenu>已返回研究菜单</RimWorldAccess.Research.Detail.ReturnedToMenu>

  <!-- Detail top-level node labels. -->
  <RimWorldAccess.Research.Detail.DescriptionLabel>描述</RimWorldAccess.Research.Detail.DescriptionLabel>
  <RimWorldAccess.Research.Detail.StartResearch>开始研究</RimWorldAccess.Research.Detail.StartResearch>
  <RimWorldAccess.Research.Detail.StopResearch>停止研究</RimWorldAccess.Research.Detail.StopResearch>
  <RimWorldAccess.Research.Detail.StartResearchHint>按回车开始此研究</RimWorldAccess.Research.Detail.StartResearchHint>
  <RimWorldAccess.Research.Detail.StopResearchHint>按回车停止此研究</RimWorldAccess.Research.Detail.StopResearchHint>

  <!-- Category headers inside the detail tree.
       WithCount: {0} = number of child items; None is used when empty. -->
  <RimWorldAccess.Research.Detail.PrerequisitesWithCount>前置条件 ({0} 项)</RimWorldAccess.Research.Detail.PrerequisitesWithCount>
  <RimWorldAccess.Research.Detail.PrerequisitesNone>前置条件 (无)</RimWorldAccess.Research.Detail.PrerequisitesNone>
  <RimWorldAccess.Research.Detail.UnlocksWithCount>解锁内容 ({0} 项)</RimWorldAccess.Research.Detail.UnlocksWithCount>
  <RimWorldAccess.Research.Detail.UnlocksNone>解锁内容 (无)</RimWorldAccess.Research.Detail.UnlocksNone>
  <RimWorldAccess.Research.Detail.DependentsWithCount>后续项目 ({0} 项)</RimWorldAccess.Research.Detail.DependentsWithCount>
  <RimWorldAccess.Research.Detail.DependentsNone>后续项目 (无)</RimWorldAccess.Research.Detail.DependentsNone>

  <!-- Research row inside a category (prereqs / dependents).
       {0} = project label, {1} = cost, {2} = status word. -->
  <RimWorldAccess.Research.Detail.ResearchRow>{0} - 花费: {1} {2}</RimWorldAccess.Research.Detail.ResearchRow>

  <!-- Hidden prerequisite summary. AllCompleted is used when nothing is
       missing; IncompleteCount takes {0} = number still incomplete.
       HiddenOne/Many compose with the status word: {0} = count (omitted
       in One form), {1} = status word. -->
  <RimWorldAccess.Research.Detail.HiddenAllCompleted>全部已完成</RimWorldAccess.Research.Detail.HiddenAllCompleted>
  <RimWorldAccess.Research.Detail.HiddenIncompleteCount>{0} 项未完成</RimWorldAccess.Research.Detail.HiddenIncompleteCount>
  <RimWorldAccess.Research.Detail.HiddenOne>1 项隐藏前置条件 - {0}</RimWorldAccess.Research.Detail.HiddenOne>
  <RimWorldAccess.Research.Detail.HiddenMany>{0} 项隐藏前置条件 - {1}</RimWorldAccess.Research.Detail.HiddenMany>

  <!-- Prerequisite bench/facility/techprint/mechanitor/analyze/grav rows.
       Each row has an inline status tail. {0} = value or main label. -->
  <RimWorldAccess.Research.Detail.BenchAvailable>可用</RimWorldAccess.Research.Detail.BenchAvailable>
  <RimWorldAccess.Research.Detail.BenchNotAvailable>不可用</RimWorldAccess.Research.Detail.BenchNotAvailable>
  <RimWorldAccess.Research.Detail.RequiresBench>需要工作台: {0} - {1}</RimWorldAccess.Research.Detail.RequiresBench>
  <RimWorldAccess.Research.Detail.RequiresFacility>需要设施: {0} - {1}</RimWorldAccess.Research.Detail.RequiresFacility>

  <RimWorldAccess.Research.Detail.TechprintsComplete>已完成</RimWorldAccess.Research.Detail.TechprintsComplete>
  <RimWorldAccess.Research.Detail.TechprintsProgress>{0}/{1}</RimWorldAccess.Research.Detail.TechprintsProgress>
  <RimWorldAccess.Research.Detail.RequiresTechprints>需要科研蓝图: {0}</RimWorldAccess.Research.Detail.RequiresTechprints>

  <RimWorldAccess.Research.Detail.MechanitorMet>已满足</RimWorldAccess.Research.Detail.MechanitorMet>
  <RimWorldAccess.Research.Detail.MechanitorNotMet>未满足</RimWorldAccess.Research.Detail.MechanitorNotMet>
  <RimWorldAccess.Research.Detail.RequiresMechanitor>需要机械师 - {0}</RimWorldAccess.Research.Detail.RequiresMechanitor>

  <RimWorldAccess.Research.Detail.AnalyzeComplete>已完成</RimWorldAccess.Research.Detail.AnalyzeComplete>
  <RimWorldAccess.Research.Detail.AnalyzeProgress>{0}/{1}</RimWorldAccess.Research.Detail.AnalyzeProgress>
  <RimWorldAccess.Research.Detail.RequiresAnalyzing>需要分析: {0} - {1}</RimWorldAccess.Research.Detail.RequiresAnalyzing>

  <RimWorldAccess.Research.Detail.GravEngineInspected>已检查</RimWorldAccess.Research.Detail.GravEngineInspected>
  <RimWorldAccess.Research.Detail.GravEngineNotInspected>未检查</RimWorldAccess.Research.Detail.GravEngineNotInspected>
  <RimWorldAccess.Research.Detail.RequiresGravEngine>需要检查逆重引擎 - {0}</RimWorldAccess.Research.Detail.RequiresGravEngine>

  <!-- Unlocked item categories. Nouns used in labels like "(Building)". -->
  <RimWorldAccess.Research.Detail.UnlockCategoryBuilding>建筑</RimWorldAccess.Research.Detail.UnlockCategoryBuilding>
  <RimWorldAccess.Research.Detail.UnlockCategoryPlant>植物</RimWorldAccess.Research.Detail.UnlockCategoryPlant>
  <RimWorldAccess.Research.Detail.UnlockCategoryItem>物品</RimWorldAccess.Research.Detail.UnlockCategoryItem>
  <RimWorldAccess.Research.Detail.UnlockCategoryRecipe>配方</RimWorldAccess.Research.Detail.UnlockCategoryRecipe>

  <!-- No-info-card message for non-target tree sections. -->
  <RimWorldAccess.Research.Detail.NoInfoCardForSection>此部分无信息卡</RimWorldAccess.Research.Detail.NoInfoCardForSection>

  <!-- Description content builder (StringBuilder in BuildDescriptionContent).
       Each key is a single line in the composed text block. -->
  <RimWorldAccess.Research.Desc.ProjectLine>项目: {0}</RimWorldAccess.Research.Desc.ProjectLine>
  <RimWorldAccess.Research.Desc.ResearchCost>研究花费: {0}</RimWorldAccess.Research.Desc.ResearchCost>
  <RimWorldAccess.Research.Desc.KnowledgeCost>知识花费: {0}</RimWorldAccess.Research.Desc.KnowledgeCost>
  <RimWorldAccess.Research.Desc.KnowledgeCategory>知识类型: {0}</RimWorldAccess.Research.Desc.KnowledgeCategory>
  <RimWorldAccess.Research.Desc.Progress>进度: {0}%</RimWorldAccess.Research.Desc.Progress>
  <RimWorldAccess.Research.Desc.StatusCompleted>状态: 已完成</RimWorldAccess.Research.Desc.StatusCompleted>
  <RimWorldAccess.Research.Desc.StatusAvailable>状态: 可研究</RimWorldAccess.Research.Desc.StatusAvailable>
  <RimWorldAccess.Research.Desc.StatusLocked>状态: 已锁定</RimWorldAccess.Research.Desc.StatusLocked>
  <RimWorldAccess.Research.Desc.RequiredBench>所需工作台: {0}</RimWorldAccess.Research.Desc.RequiredBench>
  <RimWorldAccess.Research.Desc.RequiredFacilitiesPrefix>所需设施: </RimWorldAccess.Research.Desc.RequiredFacilitiesPrefix>

  <!-- Research action announcements (start / stop / blocked). -->
  <RimWorldAccess.Research.Action.Stopped>已停止研究 {0}</RimWorldAccess.Research.Action.Stopped>
  <RimWorldAccess.Research.Action.AlreadyCompleted>{0} 已完成</RimWorldAccess.Research.Action.AlreadyCompleted>
  <RimWorldAccess.Research.Action.MissingPrereqs>无法开始研究: 缺少前置条件 - {0}</RimWorldAccess.Research.Action.MissingPrereqs>
  <RimWorldAccess.Research.Action.NeedTechprints>无法开始研究: 需要 {0} 份科研蓝图，仅应用了 {1} 份</RimWorldAccess.Research.Action.NeedTechprints>
  <RimWorldAccess.Research.Action.StudyFirst>无法开始研究: 必须先研究所需物品</RimWorldAccess.Research.Action.StudyFirst>
  <RimWorldAccess.Research.Action.Started>已开始研究 {0}</RimWorldAccess.Research.Action.Started>
  <RimWorldAccess.Research.Action.StartedReplacing>已开始研究 {0}。已停止 {1}，进度为 {2}%。</RimWorldAccess.Research.Action.StartedReplacing>

  <!-- Missing prerequisite list fragments.
       Unknown: spoken when currentProject is null or no parts collected.
       HiddenOne/Many: {0} = count of hidden missing prereqs (omitted in One form). -->
  <RimWorldAccess.Research.MissingPrereqs.Unknown>未知</RimWorldAccess.Research.MissingPrereqs.Unknown>
  <RimWorldAccess.Research.MissingPrereqs.HiddenOne>1 项隐藏前置条件</RimWorldAccess.Research.MissingPrereqs.HiddenOne>
  <RimWorldAccess.Research.MissingPrereqs.HiddenMany>{0} 项隐藏前置条件</RimWorldAccess.Research.MissingPrereqs.HiddenMany>
</LanguageData>
