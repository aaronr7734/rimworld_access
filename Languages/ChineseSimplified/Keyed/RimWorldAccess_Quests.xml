  <RimWorldAccess.Notifications.Button.Activate>激活</RimWorldAccess.Notifications.Button.Activate>
  <!-- Single-target jump button: {0} = target description. -->
  <RimWorldAccess.Notifications.Button.JumpTo>跳转到{0}</RimWorldAccess.Notifications.Button.JumpTo>
  <!-- Multi-target jump button: {0} = target description, {1} = 1-based
