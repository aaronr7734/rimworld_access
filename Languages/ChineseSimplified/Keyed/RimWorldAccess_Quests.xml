<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Quests module strings (src/Quests/). Five files contribute:
      - QuestMenuState.cs           (windowless quest browser)
      - NotificationMenuState.cs    (messages/letters/alerts viewer)
      - QuestRewardHelper.cs        (reward extraction + reward prefs)
      - NotificationAccessibilityPatch.cs  (live message/letter/alert
                                            announcements as they arrive)
      - QuestMenuPatch.cs           (no user strings)

    The quest list and detail views, the reward-choice float menu, the
    reward-preferences panel, and the notification menu's two-level
    navigation all live here. Many phrasings are split into One/Many
    pairs (1 quest vs N quests, 1 star vs N stars) so plural agreement
    survives translation.

    Shared phrases delegated elsewhere:
      - Position / Edge / Search / InfoCard.Unavailable -> Common.xml
      - "Jumped to {target}"                            -> Common.xml
      - "Accept", "Delete", "Close", "Activate", "Open",
        "Difficulty", "JumpToLocation", "ViewRelatedQuest",
        "QuestExpiresIn", "AvailableQuests"/"ActiveQuests"/
        "HistoricalQuests", "Goodwill"                  -> vanilla keys

    Data such as quest names, faction names, reward item labels,
    target locations, ticks-to-period strings, sign-formatted
    numbers, and royal favor labels (faction.def.royalFavorLabel)
    comes from the game and is NOT translated in this file.
  -->

  <!-- =================================================================
       Live notification announcements (NotificationAccessibilityPatch).
       Spoken when a Message, Letter, or Alert arrives in-game so screen
       reader users hear the event without opening the notification menu.
       {0} = the cleaned text/label of the notification.
       ================================================================= -->
  <RimWorldAccess.Notification.LiveMessage>消息: {0}</RimWorldAccess.Notification.LiveMessage>
  <RimWorldAccess.Notification.LiveLetter>信件: {0}</RimWorldAccess.Notification.LiveLetter>
  <RimWorldAccess.Notification.LiveAlert>警报: {0}</RimWorldAccess.Notification.LiveAlert>

  <!-- =================================================================
       Quest menu lifecycle (QuestMenuState.Open / Close / OpenAndSelect).
       OpenInstructions is the one-time orientation message spoken when
       the menu opens; it is suffixed with the first quest's announcement
       or the empty-tab message. {0} = first quest announcement, or tab
       summary, depending on context.
       ================================================================= -->
  <RimWorldAccess.Quests.Menu.OpenInstructions>任务菜单。Alt+A 接受，Alt+D 取消。回车键逐条浏览任务详情。</RimWorldAccess.Quests.Menu.OpenInstructions>
  <RimWorldAccess.Quests.Menu.Title>任务菜单</RimWorldAccess.Quests.Menu.Title>
  <RimWorldAccess.Quests.Menu.Closed>任务菜单已关闭</RimWorldAccess.Quests.Menu.Closed>
  <RimWorldAccess.Quests.Menu.QuestNoLongerAvailable>任务已不可接受</RimWorldAccess.Quests.Menu.QuestNoLongerAvailable>
  <RimWorldAccess.Quests.Menu.NoQuestsInTab>此选项卡中没有任务</RimWorldAccess.Quests.Menu.NoQuestsInTab>
  <RimWorldAccess.Quests.Menu.NoQuestSelected>未选择任务</RimWorldAccess.Quests.Menu.NoQuestSelected>
  <RimWorldAccess.Quests.Menu.FailedToActivateButton>激活按钮失败</RimWorldAccess.Quests.Menu.FailedToActivateButton>

  <!-- =================================================================
       Quest tabs. Available/Active/Historical (vanilla provides the
       short labels; we suffix "Quests" because the screen-reader
       announcement uses the tab in a sentence).
       Tab.WithCountOne / Many / NoQuests build the per-tab summary
       sentence; {0} = tab label, {1} = count (Many only).
       ================================================================= -->
  <RimWorldAccess.Quests.Tab.Available>可接受任务</RimWorldAccess.Quests.Tab.Available>
  <RimWorldAccess.Quests.Tab.Active>进行中任务</RimWorldAccess.Quests.Tab.Active>
  <RimWorldAccess.Quests.Tab.Historical>历史任务</RimWorldAccess.Quests.Tab.Historical>
  <RimWorldAccess.Quests.Tab.Generic>任务</RimWorldAccess.Quests.Tab.Generic>
  <RimWorldAccess.Quests.Tab.WithCountOne>{0}选项卡 - 1 项任务</RimWorldAccess.Quests.Tab.WithCountOne>
  <RimWorldAccess.Quests.Tab.WithCountMany>{0}选项卡 - {1} 项任务</RimWorldAccess.Quests.Tab.WithCountMany>
  <RimWorldAccess.Quests.Tab.NoQuests>{0}选项卡 - 没有任务</RimWorldAccess.Quests.Tab.NoQuests>

  <!-- =================================================================
       Status words, used both in the list-view name suffix
       ("{name}, Dismissed") and in the detail-view header
       ("Quest: {name} (Active)"). Available/Active spell out the
       NotYetAccepted/Ongoing states for the screen reader. -->
  <RimWorldAccess.Quests.Status.Available>可接受</RimWorldAccess.Quests.Status.Available>
  <RimWorldAccess.Quests.Status.Active>进行中</RimWorldAccess.Quests.Status.Active>
  <RimWorldAccess.Quests.Status.Dismissed>已取消</RimWorldAccess.Quests.Status.Dismissed>
  <RimWorldAccess.Quests.Status.Completed>已完成</RimWorldAccess.Quests.Status.Completed>
  <RimWorldAccess.Quests.Status.Failed>已失败</RimWorldAccess.Quests.Status.Failed>
  <RimWorldAccess.Quests.Status.Expired>已过期</RimWorldAccess.Quests.Status.Expired>

  <!-- =================================================================
       List-view announcement composition (BuildQuestAnnouncement).
       NameWithStatus appends a status word to the quest name; the bare
       Name case has no suffix and is spoken directly.
       StarsOne/Many is the difficulty rating; CharitySuffix is appended
       when quest.charity is true.
       ExpiresIn / AcceptedAgo / AgoOnly are the short time-info phrases
       (no colon, terse - distinct from the detail-view variants below).
       Rewards: {0} = compact reward summary string. -->
  <RimWorldAccess.Quests.List.NameWithStatus>{0}, {1}</RimWorldAccess.Quests.List.NameWithStatus>
  <RimWorldAccess.Quests.List.StarsOne>1 颗星</RimWorldAccess.Quests.List.StarsOne>
  <RimWorldAccess.Quests.List.StarsMany>{0} 颗星</RimWorldAccess.Quests.List.StarsMany>
  <RimWorldAccess.Quests.List.CharitySuffix>, 慈善任务</RimWorldAccess.Quests.List.CharitySuffix>
  <RimWorldAccess.Quests.List.ExpiresIn>{0}后到期</RimWorldAccess.Quests.List.ExpiresIn>
  <RimWorldAccess.Quests.List.AcceptedAgo>{0}前已接受</RimWorldAccess.Quests.List.AcceptedAgo>
  <RimWorldAccess.Quests.List.AgoOnly>{0}前</RimWorldAccess.Quests.List.AgoOnly>
  <RimWorldAccess.Quests.List.RewardsSummary>奖励: {0}</RimWorldAccess.Quests.List.RewardsSummary>

  <!-- =================================================================
       Detail-view content lines (BuildDetailContentLines). These take
       the same data as the list-view phrases but use a longer "label:"
       layout because each line stands on its own.
       DifficultyOne/Many: {0} = star count (Many only); CharitySuffix
       is appended in the same fashion as the list view.
       ExpiresIn / AcceptedAgo: {0} = ToStringTicksToPeriod output.
       Status: {0} = outcome status word (Completed/Failed/Expired).
       Finished: {0} = ticks-since-cleanup formatted period. -->
  <RimWorldAccess.Quests.Detail.HeaderStatus>任务: {0} ({1})</RimWorldAccess.Quests.Detail.HeaderStatus>
  <RimWorldAccess.Quests.Detail.DifficultyOne>难度: 1 颗星</RimWorldAccess.Quests.Detail.DifficultyOne>
  <RimWorldAccess.Quests.Detail.DifficultyMany>难度: {0} 颗星</RimWorldAccess.Quests.Detail.DifficultyMany>
  <RimWorldAccess.Quests.Detail.CharitySuffix> (慈善任务)</RimWorldAccess.Quests.Detail.CharitySuffix>
  <RimWorldAccess.Quests.Detail.ExpiresIn>到期时间: {0}</RimWorldAccess.Quests.Detail.ExpiresIn>
  <RimWorldAccess.Quests.Detail.AcceptedAgo>已接受: {0}前</RimWorldAccess.Quests.Detail.AcceptedAgo>
  <RimWorldAccess.Quests.Detail.Status>状态: {0}</RimWorldAccess.Quests.Detail.Status>
  <RimWorldAccess.Quests.Detail.Finished>完成于: {0}前</RimWorldAccess.Quests.Detail.Finished>
  <RimWorldAccess.Quests.Detail.StartOfDetails>任务详情开始</RimWorldAccess.Quests.Detail.StartOfDetails>
  <RimWorldAccess.Quests.Detail.EndOfDetails>任务详情结束</RimWorldAccess.Quests.Detail.EndOfDetails>
  <RimWorldAccess.Quests.Detail.OpenFirst>请先按回车键打开任务详情</RimWorldAccess.Quests.Detail.OpenFirst>
  <!-- "Choose item to inspect" lives in Common.xml as
       RimWorldAccess.InfoCard.ChooseItemToInspect. -->


  <!-- =================================================================
       Detail-view button labels (PopulateQuestButtons).
       AcceptChoice: {0} = 1-based choice index, {1} = reward description.
       AcceptWithRewards: {0} = reward description.
       JumpToTarget: {0} = target label (CameraJumper.CanJump returned a
       valid label); JumpToLocation has no label and falls back. -->
  <RimWorldAccess.Quests.Button.Accept>接受</RimWorldAccess.Quests.Button.Accept>
  <RimWorldAccess.Quests.Button.AcceptWithRewards>接受: {0}</RimWorldAccess.Quests.Button.AcceptWithRewards>
  <RimWorldAccess.Quests.Button.AcceptChoice>接受选项 {0}: {1}</RimWorldAccess.Quests.Button.AcceptChoice>
  <RimWorldAccess.Quests.Button.Dismiss>取消</RimWorldAccess.Quests.Button.Dismiss>
  <RimWorldAccess.Quests.Button.Resume>恢复</RimWorldAccess.Quests.Button.Resume>
  <RimWorldAccess.Quests.Button.Delete>删除</RimWorldAccess.Quests.Button.Delete>
  <RimWorldAccess.Quests.Button.JumpToLocation>跳转到位置</RimWorldAccess.Quests.Button.JumpToLocation>
  <RimWorldAccess.Quests.Button.JumpToTarget>跳转到{0}</RimWorldAccess.Quests.Button.JumpToTarget>

  <!-- =================================================================
       Action result announcements after the user accepts/dismisses/
       deletes a quest. {0} = quest name (StripTags applied).
       AcceptedWithRewards: {0} = reward description string.
       AcceptedWithPawn: {0} = colonist's LabelShort.
       CannotAcceptReason: {0} = QuestUtility.CanAcceptQuest's report.
       NotAvailableToAccept: spoken when the quest moved out of
       NotYetAccepted between the user's keypress and our handler. -->
  <RimWorldAccess.Quests.Action.CannotAccept>无法接受任务</RimWorldAccess.Quests.Action.CannotAccept>
  <RimWorldAccess.Quests.Action.NotAvailableToAccept>该任务无法接受</RimWorldAccess.Quests.Action.NotAvailableToAccept>
  <RimWorldAccess.Quests.Action.CannotAcceptReason>无法接受: {0}</RimWorldAccess.Quests.Action.CannotAcceptReason>
  <RimWorldAccess.Quests.Action.AcceptedQuest>已接受任务: {0}</RimWorldAccess.Quests.Action.AcceptedQuest>
  <RimWorldAccess.Quests.Action.AcceptedWithRewards>已接受任务，奖励: {0}</RimWorldAccess.Quests.Action.AcceptedWithRewards>
  <RimWorldAccess.Quests.Action.AcceptedWithPawn>已接受任务，由 {0} 执行</RimWorldAccess.Quests.Action.AcceptedWithPawn>
  <RimWorldAccess.Quests.Action.DismissedQuest>已取消任务: {0}</RimWorldAccess.Quests.Action.DismissedQuest>
  <RimWorldAccess.Quests.Action.ResumedQuest>已恢复任务: {0}</RimWorldAccess.Quests.Action.ResumedQuest>
  <RimWorldAccess.Quests.Action.DeletedQuest>已删除任务: {0}</RimWorldAccess.Quests.Action.DeletedQuest>
  <RimWorldAccess.Quests.Action.NoEligibleColonists>没有符合条件的殖民者可接受此任务</RimWorldAccess.Quests.Action.NoEligibleColonists>
  <RimWorldAccess.Quests.Action.SelectColonist>请选择一名殖民者来接受此任务</RimWorldAccess.Quests.Action.SelectColonist>
  <!-- Eligible-colonist label suffix when the pawn holds royalty:
       {0} = pawn LabelShort, {1} = title label. -->
  <RimWorldAccess.Quests.Action.PawnWithTitle>{0} ({1})</RimWorldAccess.Quests.Action.PawnWithTitle>

  <!-- =================================================================
       Reward-choice float menu (multi-choice quests). The float menu
       is opened by Alt+A on a quest with QuestPart_Choice and 2+
       choices; Choose announces the prompt before WindowlessFloatMenu
       opens. NoItemsToInspect is spoken when Alt+I is pressed but the
       chosen reward has no inspectable Things or Factions. -->
  <RimWorldAccess.Quests.RewardChoice.Prompt>选择一项奖励</RimWorldAccess.Quests.RewardChoice.Prompt>
  <RimWorldAccess.Quests.RewardChoice.NoItemsToInspect>没有可查看的物品</RimWorldAccess.Quests.RewardChoice.NoItemsToInspect>
  <RimWorldAccess.Quests.RewardChoice.BackToList>返回任务列表</RimWorldAccess.Quests.RewardChoice.BackToList>

  <!-- =================================================================
       Reward preferences panel (Tab in the quest list). Toggles
       per-faction acceptance of royal-favor and goodwill rewards.
       Status words (checked / unchecked) compose into the per-faction
       label below; relation phrasing is also a key so translators can
       reorder "currently {amount}, {relation}". -->
  <RimWorldAccess.Quests.Pref.Title>奖励偏好</RimWorldAccess.Quests.Pref.Title>
  <RimWorldAccess.Quests.Pref.QuestList>任务列表</RimWorldAccess.Quests.Pref.QuestList>
  <RimWorldAccess.Quests.Pref.None>没有可用的奖励偏好</RimWorldAccess.Quests.Pref.None>
  <RimWorldAccess.Quests.Pref.Checked>已勾选</RimWorldAccess.Quests.Pref.Checked>
  <RimWorldAccess.Quests.Pref.Unchecked>未勾选</RimWorldAccess.Quests.Pref.Unchecked>
  <!-- Royal-favor row: {0} = faction.Name, {1} = royal favor label
       (CapitalizeFirst), {2} = checked/unchecked. -->
  <RimWorldAccess.Quests.Pref.RoyalFavorRow>{0}: 接受{1}, {2}</RimWorldAccess.Quests.Pref.RoyalFavorRow>
  <!-- Goodwill row: {0} = faction.Name, {1} = checked/unchecked,
       {2} = relation phrase (built from RelationPhrase below). -->
  <RimWorldAccess.Quests.Pref.GoodwillRow>{0}: 接受好感度, {1}, {2}</RimWorldAccess.Quests.Pref.GoodwillRow>
  <!-- Relation phrase: {0} = signed goodwill amount, {1} = relation
       kind label cap (Ally/Neutral/Hostile/etc., from vanilla). -->
  <RimWorldAccess.Quests.Pref.RelationPhrase>当前 {0}, {1}</RimWorldAccess.Quests.Pref.RelationPhrase>
  <!-- Pref-row position suffix: {0} = built row label,
       {1} = position string from MenuHelper.FormatPosition. -->
  <RimWorldAccess.Quests.Pref.RowWithPosition>{0}. {1}</RimWorldAccess.Quests.Pref.RowWithPosition>

  <!-- =================================================================
       Reward extraction (QuestRewardHelper). Builds the reward detail
       lines and the compact reward description used in list views and
       button labels. The "indent" prefix ("  ") is hard-coded in the
       helper so each reward item line is visually grouped under its
       header line; the indent is preserved in keys here. -->
  <RimWorldAccess.Quests.Reward.NoRewards>无奖励</RimWorldAccess.Quests.Reward.NoRewards>
  <RimWorldAccess.Quests.Reward.MultipleChoices>有多项奖励可供选择</RimWorldAccess.Quests.Reward.MultipleChoices>
  <RimWorldAccess.Quests.Reward.RewardsHeader>奖励:</RimWorldAccess.Quests.Reward.RewardsHeader>
  <RimWorldAccess.Quests.Reward.ChoicesHeader>奖励选项（选择一项接受）:</RimWorldAccess.Quests.Reward.ChoicesHeader>
  <!-- {0} = 1-based choice index. -->
  <RimWorldAccess.Quests.Reward.ChoiceLabel>选项 {0}:</RimWorldAccess.Quests.Reward.ChoiceLabel>

  <!-- Item formatting for both the detail-view lines and the compact
       summary. ItemWithCount: {0} = count, {1} = capitalized label;
       ItemSingle: {0} = capitalized label. -->
  <RimWorldAccess.Quests.Reward.ItemWithCount>{0}x {1}</RimWorldAccess.Quests.Reward.ItemWithCount>
  <RimWorldAccess.Quests.Reward.ItemSingle>{0}</RimWorldAccess.Quests.Reward.ItemSingle>
  <RimWorldAccess.Quests.Reward.ItemsFallback>物品</RimWorldAccess.Quests.Reward.ItemsFallback>
  <RimWorldAccess.Quests.Reward.ItemFallback>物品</RimWorldAccess.Quests.Reward.ItemFallback>

  <!-- Goodwill / royal-favor reward composition. {0} = signed amount
       (ToStringWithSign), {1} = faction.Name, {2} = favor label
       (royal favor only; CapitalizeFirst applied at callsite). -->
  <RimWorldAccess.Quests.Reward.Goodwill>{1} 好感度 {0}</RimWorldAccess.Quests.Reward.Goodwill>
  <RimWorldAccess.Quests.Reward.RoyalFavor>{2} {1} {0}</RimWorldAccess.Quests.Reward.RoyalFavor>

  <!-- Pawn reward variants. PawnHidden has no name (details are
       hidden); PawnWithName: {0} = pawn LabelShort. -->
  <RimWorldAccess.Quests.Reward.PawnHidden>角色（详情已隐藏）</RimWorldAccess.Quests.Reward.PawnHidden>
  <RimWorldAccess.Quests.Reward.PawnWithName>角色: {0}</RimWorldAccess.Quests.Reward.PawnWithName>
  <RimWorldAccess.Quests.Reward.PawnGeneric>角色</RimWorldAccess.Quests.Reward.PawnGeneric>

  <!-- Total market value line, appended once per reward set if the
       sum is positive. {0} = ToStringMoney("F0") result. -->
  <RimWorldAccess.Quests.Reward.TotalValue>总价值: {0}</RimWorldAccess.Quests.Reward.TotalValue>

  <!-- Indent applied to detail-view reward item lines. Stays as a
       key so non-English layouts can use a different prefix or none. -->
  <RimWorldAccess.Quests.Reward.LineIndent>  </RimWorldAccess.Quests.Reward.LineIndent>

  <!-- =================================================================
