<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Map module strings (src/Map/). Covers cursor navigation, the
    scanner system (categories, items, search filter), tile info
    readouts, time/weather announcements, bookmarks, go-to dialog,
    and the play-settings overlay menu.

    Phrasing decisions:
      - Cursor and scanner readouts compose many small fragments
        (label, distance, direction, bulk position, region size).
        Each composed shape is its own key so translators can
        reorder fragments instead of relying on C# concatenation.
      - "{N} tiles {direction}" stays as a parameterized key. The
        direction words come from Map.Direction.* and are bare
        nouns, since the same word also appears in cell-side
        descriptions ("fuel port east", "watch from north").
      - Door "(open)" / "(closed)" suffixes appear in both
        TileInfoHelper and ScannerLabelBuilder. Both delegate to
        Map.Label.WithDoorOpen / WithDoorClosed so the parenthesis
        style is editable in one place.
      - PlaySettings toggle labels are split into one key per
        semantic case (Auto-Rebuild on / Auto-Rebuild off / Auto-
        Rebuild enabled / Auto-Rebuild disabled) rather than glue-
        composing the noun with " enabled" / ": On".
      - Game data flowing through these announcements (def labels,
        designation labels, pawn names, terrain labels, room roles,
        ToStringMoney/ToStringPercent output, vanilla ClockTime/
        Weather/ClockDate labels) is NOT translated here - the game
        already provides localized strings.

    Shared phrases delegated elsewhere:
      - Map.JumpedTo / Map.SelectedCell        -> Common.xml
      - Search.NoMatches / Search.Cleared       -> Common.xml
      - Edge.* (boundary announcements)         -> Common.xml
      - Cancel button label                     -> vanilla "Cancel"
  -->

  <!-- =================================================================
       Compass directions (ScannerDirectionHelper, BookmarkHelper).
       Bare nouns composed into "{N} tiles {direction}" and into
       building-cell descriptions ("fuel port {direction}",
       "watch from {direction}", "Interact from {direction}", etc.).
       ================================================================= -->
  <RimWorldAccess.Map.Direction.North>北</RimWorldAccess.Map.Direction.North>
  <RimWorldAccess.Map.Direction.Northeast>东北</RimWorldAccess.Map.Direction.Northeast>
  <RimWorldAccess.Map.Direction.East>东</RimWorldAccess.Map.Direction.East>
  <RimWorldAccess.Map.Direction.Southeast>东南</RimWorldAccess.Map.Direction.Southeast>
  <RimWorldAccess.Map.Direction.South>南</RimWorldAccess.Map.Direction.South>
  <RimWorldAccess.Map.Direction.Southwest>西南</RimWorldAccess.Map.Direction.Southwest>
  <RimWorldAccess.Map.Direction.West>西</RimWorldAccess.Map.Direction.West>
  <RimWorldAccess.Map.Direction.Northwest>西北</RimWorldAccess.Map.Direction.Northwest>
  <!-- Lowercase forms used inside building-cell descriptions
       (e.g. "fuel port east", "Watch from south"). The capitalized
       variants above are spoken on their own; these compose into
       larger phrases. -->
  <RimWorldAccess.Map.Direction.Lower.North>北</RimWorldAccess.Map.Direction.Lower.North>
  <RimWorldAccess.Map.Direction.Lower.Northeast>东北</RimWorldAccess.Map.Direction.Lower.Northeast>
  <RimWorldAccess.Map.Direction.Lower.East>东</RimWorldAccess.Map.Direction.Lower.East>
  <RimWorldAccess.Map.Direction.Lower.Southeast>东南</RimWorldAccess.Map.Direction.Lower.Southeast>
  <RimWorldAccess.Map.Direction.Lower.South>南</RimWorldAccess.Map.Direction.Lower.South>
  <RimWorldAccess.Map.Direction.Lower.Southwest>西南</RimWorldAccess.Map.Direction.Lower.Southwest>
  <RimWorldAccess.Map.Direction.Lower.West>西</RimWorldAccess.Map.Direction.Lower.West>
  <RimWorldAccess.Map.Direction.Lower.Northwest>西北</RimWorldAccess.Map.Direction.Lower.Northwest>

  <!-- =================================================================
       Generic label fragments shared by ScannerLabelBuilder,
       TileInfoHelper, and other map readouts.
       ================================================================= -->
  <!-- Spoken when a thing/zone/room reference is null or unrecognized. -->
  <RimWorldAccess.Map.Label.Unknown>未知</RimWorldAccess.Map.Label.Unknown>
  <!-- Fallback when a Thing's label getter throws (e.g. corrupted
       Blueprint_Install with a missing minified item). -->
  <RimWorldAccess.Map.Label.Corrupted>损坏的物体</RimWorldAccess.Map.Label.Corrupted>
  <!-- Generic "label (defLabel)" pattern, e.g. "monument marker
       (haul)" or "concrete (smoothed)". {0} = primary label,
       {1} = the secondary def/category label. -->
  <RimWorldAccess.Map.Label.Suffixed>{0} ({1})</RimWorldAccess.Map.Label.Suffixed>
  <!-- Door state annotation. {0} = the door's label. -->
  <RimWorldAccess.Map.Label.WithDoorOpen>{0} (打开)</RimWorldAccess.Map.Label.WithDoorOpen>
  <RimWorldAccess.Map.Label.WithDoorClosed>{0} (关闭)</RimWorldAccess.Map.Label.WithDoorClosed>

  <!-- =================================================================
       Bookmark slots (BookmarkHelper).
       {0} = slot number (0-9, the user's typed digit).
       Set:        {0} = slot, {1} = TileInfoHelper.GetTileSummary().
       Jumped:     {0} = TileInfoHelper.GetTileSummary() at target.
       PeekHere:   {0} = tile summary at target (cursor is already
                   on the bookmarked tile).
       PeekDirection: {0} = tile summary, {1} = distance (already
                      formatted with no decimals), {2} = direction.
       ================================================================= -->
  <RimWorldAccess.Map.Bookmark.Set>书签 {0} 已设置: {1}</RimWorldAccess.Map.Bookmark.Set>
  <RimWorldAccess.Map.Bookmark.NotSet>书签 {0} 未设置</RimWorldAccess.Map.Bookmark.NotSet>
  <RimWorldAccess.Map.Bookmark.Invalid>书签 {0} 无效</RimWorldAccess.Map.Bookmark.Invalid>
  <RimWorldAccess.Map.Bookmark.Jumped>已跳转. {0}</RimWorldAccess.Map.Bookmark.Jumped>
  <RimWorldAccess.Map.Bookmark.PeekHere>{0}, 此处</RimWorldAccess.Map.Bookmark.PeekHere>
  <RimWorldAccess.Map.Bookmark.PeekDirection>{0}, {2} {1} 格</RimWorldAccess.Map.Bookmark.PeekDirection>

  <!-- =================================================================
       Cover info (CoverHelper.GetCoverInfo).
       Spoken as part of pawn announcements when a drafted player
       pawn or a hostile pawn has cover nearby.
       Behind: {0} = cover def label, {1} = block-chance percent
               string (already formatted by ToStringPercent).
       NoCoverLower: vanilla key reused via .Translate().
       ================================================================= -->
  <RimWorldAccess.Map.Cover.Behind>{0} 后方 (阻挡 {1})</RimWorldAccess.Map.Cover.Behind>

  <!-- =================================================================
       Tile detail hotkeys (DetailInfoPatch keys 1-7).
       UnknownKey is a defensive fallback that should never reach a
       user in normal play.
       ================================================================= -->
  <RimWorldAccess.Map.Detail.UnknownKey>未知按键</RimWorldAccess.Map.Detail.UnknownKey>

  <!-- =================================================================
       Go-to dialog (GoToState, Ctrl+G).
       Open: {0} = current cursor x, {1} = current cursor z.
       FieldX/FieldZ: announced when the user moves between fields.
       Deleted: {0} = the deleted character (echo).
       ================================================================= -->
  <RimWorldAccess.Map.GoTo.Open>跳转到. 当前位于 {0}, {1}</RimWorldAccess.Map.GoTo.Open>
  <RimWorldAccess.Map.GoTo.FieldX>X</RimWorldAccess.Map.GoTo.FieldX>
  <RimWorldAccess.Map.GoTo.FieldZ>Z</RimWorldAccess.Map.GoTo.FieldZ>
  <RimWorldAccess.Map.GoTo.InvalidX>X 坐标无效</RimWorldAccess.Map.GoTo.InvalidX>
  <RimWorldAccess.Map.GoTo.InvalidZ>Z 坐标无效</RimWorldAccess.Map.GoTo.InvalidZ>
  <RimWorldAccess.Map.GoTo.Cancelled>已取消</RimWorldAccess.Map.GoTo.Cancelled>
  <!-- Backspace echo, shared between GoToState and ScannerSearchState.
       {0} = the deleted character. -->
  <RimWorldAccess.Map.Input.Deleted>已删除 {0}</RimWorldAccess.Map.Input.Deleted>

  <!-- =================================================================
       Map switching and pawn cycling (MapNavigationPatch,
       ThingSelectionUtilityPatch). Triggered by Shift+. / Shift+, to
       cycle maps and by . / , to cycle player pawns on the active map.
       NewMapWithHint: spoken once when the user reaches a new map for
                      the first time and a second map exists.
                      {0} = map name, {1} = total map count.
       NewMapTotal:    same shape but the user has already seen the hint.
       MapClosedOne / MapClosedMany: spoken on map removal.
       SwitchOnlyOne / SwitchFailed: error fallbacks for Shift+./,
       SwitchNoPawns: {0} = target map name.
       SwitchWithInfo: {0} = target map name, {1} = presence info
                        (e.g. "3 colonists, 2 mechs") generated by
                        PawnSelectionState.
       ================================================================= -->
  <RimWorldAccess.Map.NewMap.WithHint>新地图: {0}. 你现在拥有 {1} 张地图. 使用 Shift+句号 和 Shift+逗号 在它们之间切换.</RimWorldAccess.Map.NewMap.WithHint>
  <RimWorldAccess.Map.NewMap.Total>新地图: {0}. 共 {1} 张地图.</RimWorldAccess.Map.NewMap.Total>
  <RimWorldAccess.Map.MapClosed.One>地图已关闭. 剩余 1 张地图.</RimWorldAccess.Map.MapClosed.One>
  <RimWorldAccess.Map.MapClosed.Many>地图已关闭. 剩余 {0} 张地图.</RimWorldAccess.Map.MapClosed.Many>
  <RimWorldAccess.Map.Switch.OnlyOne>仅有一张地图可用</RimWorldAccess.Map.Switch.OnlyOne>
  <RimWorldAccess.Map.Switch.Failed>无法切换地图</RimWorldAccess.Map.Switch.Failed>
  <RimWorldAccess.Map.Switch.NoPawns>现在位于 {0}. 此处没有玩家角色.</RimWorldAccess.Map.Switch.NoPawns>
  <RimWorldAccess.Map.Switch.WithInfo>现在位于 {0} ({1})</RimWorldAccess.Map.Switch.WithInfo>

  <!-- Pawn cycling (. / , without Shift, filtered to the current map).
       NoMechs / NoColonists: nothing to cycle to.
       Idle: fallback when GetJobReport() returns empty.
       Selection: {0} = pawn label, {1} = current job.
       SelectionWithCover: {0} = pawn label, {1} = cover info,
                           {2} = current job. -->
  <RimWorldAccess.Map.Pawn.NoMechs>此地图上没有机械体</RimWorldAccess.Map.Pawn.NoMechs>
  <RimWorldAccess.Map.Pawn.NoColonists>此地图上没有殖民者</RimWorldAccess.Map.Pawn.NoColonists>
  <RimWorldAccess.Map.Pawn.Idle>闲置</RimWorldAccess.Map.Pawn.Idle>
  <RimWorldAccess.Map.Pawn.Selection>{0} - {1}</RimWorldAccess.Map.Pawn.Selection>
  <RimWorldAccess.Map.Pawn.SelectionWithCover>{0}, {1} - {2}</RimWorldAccess.Map.Pawn.SelectionWithCover>

  <!-- =================================================================
       Performance announcement (PerformanceAnnouncementState, Shift+T).
       Speed: {0} = speed name (Map.Time.Speed.*), {1} = actual TPS,
              {2} = target TPS, {3} = percent (0-100).
       SpeedSlowed: same shape with the threat slowdown clause baked in.
       ================================================================= -->
  <RimWorldAccess.Map.Performance.Unavailable>性能数据不可用</RimWorldAccess.Map.Performance.Unavailable>
  <RimWorldAccess.Map.Performance.Speed>{0} 速度, 每秒 {1} / {2} 刻, {3} 百分比</RimWorldAccess.Map.Performance.Speed>
  <RimWorldAccess.Map.Performance.SpeedSlowed>{0} 速度, 因威胁减速, 每秒 {1} / {2} 刻, {3} 百分比</RimWorldAccess.Map.Performance.SpeedSlowed>
  <!-- "Game paused" is spoken by both the performance announcer and
       the time-control patch when the user pauses. -->
  <RimWorldAccess.Map.Game.Paused>游戏已暂停</RimWorldAccess.Map.Game.Paused>

  <!-- =================================================================
       Play-settings menu (PlaySettingsMenuState, opened from gizmo bar).
       Each toggle has four whole-phrase keys: option label in either
       state, plus the post-toggle confirmation in either direction.
       Splitting avoids glue-composing "Auto-Rebuild" + ": " + "On".
       ================================================================= -->
  <RimWorldAccess.Map.PlaySettings.AutoRebuild.LabelOn>自动重建: 开</RimWorldAccess.Map.PlaySettings.AutoRebuild.LabelOn>
  <RimWorldAccess.Map.PlaySettings.AutoRebuild.LabelOff>自动重建: 关</RimWorldAccess.Map.PlaySettings.AutoRebuild.LabelOff>
  <RimWorldAccess.Map.PlaySettings.AutoRebuild.Enabled>自动重建已启用</RimWorldAccess.Map.PlaySettings.AutoRebuild.Enabled>
  <RimWorldAccess.Map.PlaySettings.AutoRebuild.Disabled>自动重建已禁用</RimWorldAccess.Map.PlaySettings.AutoRebuild.Disabled>
  <RimWorldAccess.Map.PlaySettings.AutoHomeArea.LabelOn>自动扩展居住区: 开</RimWorldAccess.Map.PlaySettings.AutoHomeArea.LabelOn>
  <RimWorldAccess.Map.PlaySettings.AutoHomeArea.LabelOff>自动扩展居住区: 关</RimWorldAccess.Map.PlaySettings.AutoHomeArea.LabelOff>
  <RimWorldAccess.Map.PlaySettings.AutoHomeArea.Enabled>自动扩展居住区已启用</RimWorldAccess.Map.PlaySettings.AutoHomeArea.Enabled>
  <RimWorldAccess.Map.PlaySettings.AutoHomeArea.Disabled>自动扩展居住区已禁用</RimWorldAccess.Map.PlaySettings.AutoHomeArea.Disabled>
  <!-- The Cancel option label reuses vanilla "Cancel".Translate(). -->

  <!-- =================================================================
       Time announcement (TimeAnnouncementState, T).
       Composed sentence: "{Time}: {timeString}, {Weather}: {weatherLabel},
       {Date}: {dateString}, Season: {seasonLabel}, Days passed: {N days}".
       ClockTime / Weather / ClockDate are vanilla labels obtained via
       .Translate() at the call site; the section glue and the bare
       Season / DaysPassed labels live here.
       ================================================================= -->
  <RimWorldAccess.Map.Time.Unavailable>时间信息不可用</RimWorldAccess.Map.Time.Unavailable>
  <!-- 12-hour and 24-hour formatting. {0} = display hour, {1} =
       minute (already 2-digit padded), {2} = AM/PM word. -->
  <RimWorldAccess.Map.Time.Hour12>{0}:{1} {2}</RimWorldAccess.Map.Time.Hour12>
  <RimWorldAccess.Map.Time.Hour24>{0}:{1}</RimWorldAccess.Map.Time.Hour24>
  <!-- Section join. SectionFirst is used for the leading element of
       the sentence ("Time: 8:00 AM"); SectionAppend is used for every
       subsequent element (", Weather: Clear", ", Date: ...").
       {0} = label (vanilla "ClockTime"/"Weather"/"ClockDate"),
       {1} = value (the formatted time string, weather label,
       date string). -->
  <RimWorldAccess.Map.Time.SectionFirst>{0}: {1}</RimWorldAccess.Map.Time.SectionFirst>
  <RimWorldAccess.Map.Time.SectionAppend>, {0}: {1}</RimWorldAccess.Map.Time.SectionAppend>
  <!-- Standalone section labels for which vanilla has no exact key
       (Season is referenced as a noun by itself, days-passed phrases
       come from "Period1Day"/"PeriodDays").
       {0} = season label, {0} = days phrase ("1 day", "5 days"). -->
  <RimWorldAccess.Map.Time.SeasonAppend>, 季节: {0}</RimWorldAccess.Map.Time.SeasonAppend>
  <RimWorldAccess.Map.Time.DaysPassedAppend>, 已过天数: {0}</RimWorldAccess.Map.Time.DaysPassedAppend>

  <!-- =================================================================
       Time speed announcer (TimeControlAccessibilityPatch).
       Announcement composes a localized speed name into "Time speed:
       {0}". Paused gets a dedicated phrase ("Game paused", shared
       with Map.Game.Paused).
       Threat slowdown messages are surfaced through Messages.Message
       (so NotificationAccessibilityPatch already speaks them).
       ================================================================= -->
  <RimWorldAccess.Map.Time.SpeedAnnouncement>游戏速度: {0}</RimWorldAccess.Map.Time.SpeedAnnouncement>
  <RimWorldAccess.Map.Time.Speed.Paused>已暂停</RimWorldAccess.Map.Time.Speed.Paused>
  <RimWorldAccess.Map.Time.Speed.Normal>正常</RimWorldAccess.Map.Time.Speed.Normal>
  <RimWorldAccess.Map.Time.Speed.Fast>快速</RimWorldAccess.Map.Time.Speed.Fast>
  <RimWorldAccess.Map.Time.Speed.Superfast>超快</RimWorldAccess.Map.Time.Speed.Superfast>
  <RimWorldAccess.Map.Time.Speed.Ultrafast>极快</RimWorldAccess.Map.Time.Speed.Ultrafast>
  <RimWorldAccess.Map.Time.Threat.Slowed>因威胁出现，游戏已减速。</RimWorldAccess.Map.Time.Threat.Slowed>
  <RimWorldAccess.Map.Time.Threat.Passed>威胁已解除。游戏速度已恢复。</RimWorldAccess.Map.Time.Threat.Passed>

  <!-- =================================================================
       Jump-mode navigation (MapNavigationState).
       PageUp/PageDown cycles between modes; Ctrl+arrows jumps in the
       active mode.
       Distance:        {0} = the new preset jump distance (in tiles).
       PresetDistanceMode: {0} = the preset jump distance.
       Boundary / NoWallFound / AlreadyAdjacent: spoken when the jump
       cannot proceed.
       ================================================================= -->
  <RimWorldAccess.Map.Jump.Distance>跳转距离: {0}</RimWorldAccess.Map.Jump.Distance>
  <RimWorldAccess.Map.Jump.MinimumDistance>最小距离</RimWorldAccess.Map.Jump.MinimumDistance>
  <RimWorldAccess.Map.Jump.Mode.Terrain>跳转模式: 地形</RimWorldAccess.Map.Jump.Mode.Terrain>
  <RimWorldAccess.Map.Jump.Mode.Buildings>跳转模式: 建筑</RimWorldAccess.Map.Jump.Mode.Buildings>
  <RimWorldAccess.Map.Jump.Mode.Geysers>跳转模式: 地热蒸汽口</RimWorldAccess.Map.Jump.Mode.Geysers>
  <RimWorldAccess.Map.Jump.Mode.HarvestableTrees>跳转模式: 可收获的树木</RimWorldAccess.Map.Jump.Mode.HarvestableTrees>
  <RimWorldAccess.Map.Jump.Mode.MinableTiles>跳转模式: 可开采地块</RimWorldAccess.Map.Jump.Mode.MinableTiles>
  <RimWorldAccess.Map.Jump.Mode.PresetDistance>跳转模式: 预设距离, {0} 格</RimWorldAccess.Map.Jump.Mode.PresetDistance>
  <RimWorldAccess.Map.Jump.Mode.AdjacentToWall>跳转模式: 紧邻墙壁</RimWorldAccess.Map.Jump.Mode.AdjacentToWall>
  <RimWorldAccess.Map.Jump.Mode.Unknown>跳转模式: 未知</RimWorldAccess.Map.Jump.Mode.Unknown>
  <RimWorldAccess.Map.Jump.Boundary>地图边界</RimWorldAccess.Map.Jump.Boundary>
  <RimWorldAccess.Map.Jump.AlreadyAdjacent>已紧邻墙壁</RimWorldAccess.Map.Jump.AlreadyAdjacent>
  <RimWorldAccess.Map.Jump.NoWallFound>未找到墙壁</RimWorldAccess.Map.Jump.NoWallFound>

  <!-- =================================================================
       Map display name fallback (MapNavigationState.GetMapDisplayName).
       Used in map-switch announcements and map-changed notifications
       when the map's parent has no readable label.
       Numbered: {0} = the map's unique numeric ID.
       ================================================================= -->
  <RimWorldAccess.Map.Display.Numbered>地图 {0}</RimWorldAccess.Map.Display.Numbered>

  <!-- =================================================================
       Scanner search overlay (ScannerSearchState, Z key).
       Activated:    spoken when search mode opens.
       NowFiltering: {0} = the confirmed query; spoken on Enter.
       CategoryName: {0} = active query; used as the temporary scanner
                     category label, NOT spoken on its own.
       RestoredFilter: {0} = previous filter restored on cancel.
       NoResults / NoMatches: empty-result feedback. NoMatches reuses
                              the shared Common Search.NoMatches key
                              when announced from search input mode.
       Result.One/Many: {0} = first result label, {1} = total count.
       ================================================================= -->
  <RimWorldAccess.Map.Search.Activated>搜索</RimWorldAccess.Map.Search.Activated>
  <RimWorldAccess.Map.Search.NowFiltering>扫描器正在筛选 {0}</RimWorldAccess.Map.Search.NowFiltering>
  <RimWorldAccess.Map.Search.CategoryName>搜索: {0}</RimWorldAccess.Map.Search.CategoryName>
  <RimWorldAccess.Map.Search.RestoredFilter>搜索已取消. 已恢复筛选: {0}</RimWorldAccess.Map.Search.RestoredFilter>
  <RimWorldAccess.Map.Search.Cancelled>搜索已取消</RimWorldAccess.Map.Search.Cancelled>
  <RimWorldAccess.Map.Search.FilterCleared>搜索筛选已清除</RimWorldAccess.Map.Search.FilterCleared>
  <RimWorldAccess.Map.Search.NoMap>没有可用地图</RimWorldAccess.Map.Search.NoMap>
  <RimWorldAccess.Map.Search.WorldNavInactive>世界导航未激活</RimWorldAccess.Map.Search.WorldNavInactive>
  <RimWorldAccess.Map.Search.NoResults>无结果</RimWorldAccess.Map.Search.NoResults>
  <RimWorldAccess.Map.Search.Result.One>{0}, 1 个结果</RimWorldAccess.Map.Search.Result.One>
  <RimWorldAccess.Map.Search.Result.Many>{0}, {1} 个结果</RimWorldAccess.Map.Search.Result.Many>

  <!-- =================================================================
       Scanner state (ScannerState). Drives Page Up/Page Down navigation
       through scanner items, plus the Ctrl/Shift modifiers for category
       and subcategory switching.
       ================================================================= -->
  <!-- Auto-jump toggle (Alt+Home). Whole-phrase split per direction. -->
  <RimWorldAccess.Map.Scanner.AutoJumpEnabled>自动跳转模式已启用</RimWorldAccess.Map.Scanner.AutoJumpEnabled>
  <RimWorldAccess.Map.Scanner.AutoJumpDisabled>自动跳转模式已禁用</RimWorldAccess.Map.Scanner.AutoJumpDisabled>

  <!-- No-move guard (Home key): cursor is already on the target tile.
       AlreadyAt:       {0} = item label (e.g. "silver lode").
       AlreadyAtCenter: {0} = item label — cursor is specifically at the
                        center of a multi-tile patch. -->
  <RimWorldAccess.Map.Scanner.AlreadyAt>已位于 {0}</RimWorldAccess.Map.Scanner.AlreadyAt>
  <RimWorldAccess.Map.Scanner.AlreadyAtCenter>已位于 {0} 的中心</RimWorldAccess.Map.Scanner.AlreadyAtCenter>

  <!-- Error and edge announcements during scanner navigation. -->
  <RimWorldAccess.Map.Scanner.NotInitialized>地图导航未初始化</RimWorldAccess.Map.Scanner.NotInitialized>
  <RimWorldAccess.Map.Scanner.NoActiveMap>没有活动地图</RimWorldAccess.Map.Scanner.NoActiveMap>
  <RimWorldAccess.Map.Scanner.NoItems>地图上未找到项目</RimWorldAccess.Map.Scanner.NoItems>
  <RimWorldAccess.Map.Scanner.ItemGone>项目已不存在</RimWorldAccess.Map.Scanner.ItemGone>
  <RimWorldAccess.Map.Scanner.NoItemSelected>未选择项目</RimWorldAccess.Map.Scanner.NoItemSelected>
  <RimWorldAccess.Map.Scanner.EmptyCategory>此类别中没有项目</RimWorldAccess.Map.Scanner.EmptyCategory>

  <!-- Category / subcategory switch announcements.
       One/Many split for the item count.
       {0} = localized category or subcategory name (see CatName.* /
       SubName.* below), {1} = item count. -->
  <RimWorldAccess.Map.Scanner.CategoryAnnouncementOne>{0} - 1 项</RimWorldAccess.Map.Scanner.CategoryAnnouncementOne>
  <RimWorldAccess.Map.Scanner.CategoryAnnouncementMany>{0} - {1} 项</RimWorldAccess.Map.Scanner.CategoryAnnouncementMany>

  <!-- End-key distance/direction readout. -->
  <RimWorldAccess.Map.Scanner.DistanceDirection>{1} {0} 格</RimWorldAccess.Map.Scanner.DistanceDirection>
  <RimWorldAccess.Map.Scanner.Here>此处</RimWorldAccess.Map.Scanner.Here>

  <!-- Item announcement composition (cursor-jumped to a scanner item).
       The bare announcement is one of:
         WithDirection: {0} = label, {1} = distance, {2} = direction.
         Here:          {0} = label.
       Optional suffixes are appended in this order:
         LocationSuffix:  " {0}" — pawn location context (in jail, etc.).
         CommaSuffix:     ", {0}" — cover info OR activity.
         BulkSuffix:      ", {0} of {1}" — bulk index inside group.
       Each suffix is its own key so a translator can change the
       separator (space vs comma) without editing C#. -->
  <RimWorldAccess.Map.Scanner.Item.WithDirection>{0}, {2} {1} 格</RimWorldAccess.Map.Scanner.Item.WithDirection>
  <RimWorldAccess.Map.Scanner.Item.Here>{0}, 此处</RimWorldAccess.Map.Scanner.Item.Here>
  <RimWorldAccess.Map.Scanner.Item.LocationSuffix> {0}</RimWorldAccess.Map.Scanner.Item.LocationSuffix>
  <RimWorldAccess.Map.Scanner.Item.CommaSuffix>, {0}</RimWorldAccess.Map.Scanner.Item.CommaSuffix>
  <RimWorldAccess.Map.Scanner.Item.BulkSuffix>, 第 {0} 项，共 {1} 项</RimWorldAccess.Map.Scanner.Item.BulkSuffix>

  <!-- Bulk-mode (Alt+PageUp/Down) announcements. Each shape is a
       whole phrase.
       TerrainBulk:   {0} = label, {1} = position, {2} = total.
       WithDirectionBulk: {0} = label, {1} = distance, {2} = direction,
                          {3} = position, {4} = total.
