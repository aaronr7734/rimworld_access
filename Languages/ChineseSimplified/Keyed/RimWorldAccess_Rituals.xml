  <RimWorldAccess.Rituals.Quality.NotMet>未满足。</RimWorldAccess.Rituals.Quality.NotMet>

  <!-- Quality-factor list construction (RitualTreeBuilder.BuildQualityStatsList,
       RitualState.BuildQualityStatsList).
       UnknownFactor: fallback when a QualityFactor has no label.
       ExpectedQualityLabel: row label for the summary row appended after all
       factors. ExpectedQualitySummaryTooltip: description for that row. -->
  <RimWorldAccess.Rituals.Quality.UnknownFactor>未知</RimWorldAccess.Rituals.Quality.UnknownFactor>
  <RimWorldAccess.Rituals.Quality.ExpectedQualityLabel>预期质量</RimWorldAccess.Rituals.Quality.ExpectedQualityLabel>

  <!-- No-data fallbacks (RitualState.BuildQualityStatsList).
       NoQualityFactorsLabel: row label when a ritual has zero quality factors.
       NoQualityFactorsTooltip: description spoken via Alt+I. -->
  <RimWorldAccess.Rituals.Quality.Unavailable>质量数据不可用</RimWorldAccess.Rituals.Quality.Unavailable>

  <!-- Location row prepended to the quality-stats list (RitualState.BuildQualityStatsList,
       GetLocationDescription). The "Location" label is the row title; the
       room/outdoors suffixes compose the value. -->
  <RimWorldAccess.Rituals.Quality.LocationLabel>地点</RimWorldAccess.Rituals.Quality.LocationLabel>
  <RimWorldAccess.Rituals.Location.InRoom>位于{0}</RimWorldAccess.Rituals.Location.InRoom>
  <RimWorldAccess.Rituals.Location.Outdoors>户外</RimWorldAccess.Rituals.Location.Outdoors>
  <RimWorldAccess.Rituals.Location.Cell>单元格 ({0}, {1})</RimWorldAccess.Rituals.Location.Cell>

  <!-- Fluid-ideology development points (RitualState.AddIdeologyDevelopmentPoints).
       Header row announcing the section. FluidIdeologyTag is the parenthetical
       appended to the header's Change column. -->
