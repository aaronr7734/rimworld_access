<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    Rituals module strings (src/Rituals/). Four files contribute:
      - RitualPatch.cs           (dialog-lifecycle Harmony patches, on-screen indicator)
      - RitualState.cs           (three-mode navigation: RoleList, PawnSelection, QualityStats)
      - RitualStatFormatter.cs   (role / pawn / quality announcement composition)
      - RitualTreeBuilder.cs     (role-list, pawn-list, and quality-factor construction)

    This is Ideology-DLC ritual-setup content (Dialog_BeginRitual). Ritual
    names, role names, outcome labels, pawn names, and quality-factor labels
    are data from the game and flow through as placeholders.

    Gravship-launch checkbox strings (forceVisitorsToLeave, boardColonyAnimals,
    boardColonyMechs) are sourced from the Gravships module and localized in
    RimWorldAccess_Gravships.xml — they are NOT duplicated here. The Rituals
    module reads those labels/tooltips via their translation keys.

    Guard-style messages ("Search cleared") delegate to the shared Common keys.

    One/Many splits exist for English subject-verb agreement (role/roles,
    candidate/candidates) — translators can collapse or split further.
  -->

  <!-- Dialog lifecycle (RitualPatch.cs). -->
  <RimWorldAccess.Rituals.Dialog.KeyboardModeIndicator>键盘模式已启用</RimWorldAccess.Rituals.Dialog.KeyboardModeIndicator>

  <!-- Opening announcement (RitualState.Open).
       Begin: {0} = ritual name (e.g., "Wedding", "Funeral").
       Warning: {0} = blocking-issue text joined with periods.
       RoleCount One/Many: {0} = role count. English splits singular "role"
       from plural "roles".
       OpenInstructions: one-time instruction line appended to the opener. -->
  <RimWorldAccess.Rituals.Open.Begin>开始{0}。</RimWorldAccess.Rituals.Open.Begin>
  <RimWorldAccess.Rituals.Open.Warning>警告: {0}</RimWorldAccess.Rituals.Open.Warning>
  <RimWorldAccess.Rituals.Open.RoleCountOne>{0} 个职位。</RimWorldAccess.Rituals.Open.RoleCountOne>
  <RimWorldAccess.Rituals.Open.RoleCountMany>{0} 个职位。</RimWorldAccess.Rituals.Open.RoleCountMany>
  <RimWorldAccess.Rituals.Open.Instructions>上/下键导航，回车键分配角色，Tab 键查看质量数据，Alt+S 开始。</RimWorldAccess.Rituals.Open.Instructions>

  <!-- Expected-quality summary, used both at dialog-open and in the quality
       stats list (RitualState.GetExpectedQualitySummary,
       RitualStatFormatter.FormatQualitySummary).
       Single: {0} = single percentage (min == max).
       Range:  {0} = min percentage, {1} = max percentage. -->

  <!-- Role announcement composition (RitualStatFormatter.FormatRoleAnnouncement).
       The role/spectator label is emitted first, followed by one of the count
       clauses below, followed by optional Required/Locked suffixes.
       AssignedOfMax: {0} = assigned count, {1} = max count.
       AssignedOptional: {0} = assigned count (role has maxCount == 0).
       AssignedUnlimited: {0} = assigned count (role has maxCount == -1). -->
  <RimWorldAccess.Rituals.Role.AssignedOfMax>已分配 {0}，最多 {1}</RimWorldAccess.Rituals.Role.AssignedOfMax>
  <RimWorldAccess.Rituals.Role.AssignedOptional>已分配 {0}，可选</RimWorldAccess.Rituals.Role.AssignedOptional>
  <RimWorldAccess.Rituals.Role.AssignedUnlimited>已分配 {0}</RimWorldAccess.Rituals.Role.AssignedUnlimited>
  <RimWorldAccess.Rituals.Role.Required>，必需</RimWorldAccess.Rituals.Role.Required>
  <RimWorldAccess.Rituals.Role.Locked>，已锁定</RimWorldAccess.Rituals.Role.Locked>

  <!-- Gravship checkbox state words (RitualStatFormatter.FormatCheckboxAnnouncement,
       RitualState.ToggleGravshipCheckbox). The checkbox LABEL and TOOLTIP
       themselves are sourced from RimWorldAccess_Gravships.xml. -->
  <RimWorldAccess.Rituals.Checkbox.Checked>已勾选</RimWorldAccess.Rituals.Checkbox.Checked>
  <RimWorldAccess.Rituals.Checkbox.Unchecked>未勾选</RimWorldAccess.Rituals.Checkbox.Unchecked>
  <RimWorldAccess.Rituals.Checkbox.Toggled>{0}: {1}。</RimWorldAccess.Rituals.Checkbox.Toggled>

  <!-- Pawn announcement fragments (RitualStatFormatter.FormatPawnAnnouncement). -->
  <RimWorldAccess.Rituals.Pawn.ForcedCannotChange>已强制，无法更改</RimWorldAccess.Rituals.Pawn.ForcedCannotChange>
  <RimWorldAccess.Rituals.Pawn.Selected>已选择</RimWorldAccess.Rituals.Pawn.Selected>
  <RimWorldAccess.Rituals.Pawn.CannotAssignReason>无法分配: {0}</RimWorldAccess.Rituals.Pawn.CannotAssignReason>

  <!-- Stat / skill disability marker used in suitability-info strings
       (RitualStatFormatter.FormatPawnSuitability). Spoken as
       "<StatLabel>: Disabled" when the pawn cannot use that stat/skill. -->
  <RimWorldAccess.Rituals.Pawn.StatDisabled>已禁用</RimWorldAccess.Rituals.Pawn.StatDisabled>

  <!-- Quality-factor status suffixes (RitualStatFormatter.FormatQualityFactor).
       Appended to "{Label}: {Change}." when Change doesn't already provide
       context and the factor isn't informational. -->
