  <RimWorldAccess.TransportPods.Loading.MassOverloaded>ПЕРЕВАНТАЖЕНО на {0} кг</RimWorldAccess.TransportPods.Loading.MassOverloaded>
  <RimWorldAccess.TransportPods.Loading.MassRemaining>залишилося {0} кг</RimWorldAccess.TransportPods.Loading.MassRemaining>

  <!-- Summary view (Tab toggle). Empty/error states come next. -->
  <RimWorldAccess.TransportPods.Loading.NoSummaryForDialog>Підсумок для цього діалогу недоступний</RimWorldAccess.TransportPods.Loading.NoSummaryForDialog>
  <RimWorldAccess.TransportPods.Loading.SummaryEntry>Перегляд підсумку. Вгору/Вниз для навігації статистикою. Tab для повернення.</RimWorldAccess.TransportPods.Loading.SummaryEntry>
  <RimWorldAccess.TransportPods.Loading.SummaryNoData>Дані недоступні</RimWorldAccess.TransportPods.Loading.SummaryNoData>
  <RimWorldAccess.TransportPods.Loading.SummaryNoTransporters>Немає транспортів</RimWorldAccess.TransportPods.Loading.SummaryNoTransporters>
  <RimWorldAccess.TransportPods.Loading.SummaryStatsUnavailable>Статистика недоступна</RimWorldAccess.TransportPods.Loading.SummaryStatsUnavailable>
  <RimWorldAccess.TransportPods.Loading.SummaryNoSummary>Немає даних підсумку</RimWorldAccess.TransportPods.Loading.SummaryNoSummary>

  <!-- Summary item format ({item}. {position}). {0} = stat line, {1} = position. -->
  <RimWorldAccess.TransportPods.Loading.SummaryItemAnnouncement>{0}. {1}</RimWorldAccess.TransportPods.Loading.SummaryItemAnnouncement>

  <!-- Stat-breakdown view (Alt+I in summary mode). NoBreakdown is spoken when
       the selected stat has no cached explanation (e.g. Food).
       Stat names (spoken as the breakdown window title). -->
  <RimWorldAccess.TransportPods.Loading.NoBreakdown>Деталізація для цього предмета недоступна</RimWorldAccess.TransportPods.Loading.NoBreakdown>
  <RimWorldAccess.TransportPods.Loading.StatMassCapacity>Вантажопідйомність</RimWorldAccess.TransportPods.Loading.StatMassCapacity>
  <RimWorldAccess.TransportPods.Loading.StatSpeed>Швидкість</RimWorldAccess.TransportPods.Loading.StatSpeed>
  <RimWorldAccess.TransportPods.Loading.StatForaging>Збиральництво</RimWorldAccess.TransportPods.Loading.StatForaging>
  <RimWorldAccess.TransportPods.Loading.StatVisibility>Помітність</RimWorldAccess.TransportPods.Loading.StatVisibility>

