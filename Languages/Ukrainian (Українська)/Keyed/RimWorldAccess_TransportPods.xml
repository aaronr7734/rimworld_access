  <!-- Cancellation (Close). -->
  <RimWorldAccess.TransportPods.Selection.Cancelled>Вибір капсул скасовано</RimWorldAccess.TransportPods.Selection.Cancelled>

  <!-- Per-toggle feedback (TogglePodAtCursor). {0} = current selected count. -->
