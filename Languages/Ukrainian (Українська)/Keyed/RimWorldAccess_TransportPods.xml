<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    TransportPods module strings (src/TransportPods/). Five files contribute:
      - TransportPodHelper.cs            (pod announcement and fuel-cost formatting)
      - TransportPodPatch.cs             (custom gizmos, dialog lifecycle, keyboard-mode overlay)
      - TransportPodSelectionState.cs    (pod grouping selection mode on the map)
      - TransportPodLoadingState.cs      (Dialog_LoadTransporters keyboard navigation)
      - TransportPodLaunchState.cs       (world-map launch targeting with fuel budgeting)

    Covers both transport pods (base game) and shuttles (Royalty DLC), which
    reuse the same Dialog_LoadTransporters and CompLaunchable infrastructure.

    Strings produced by shared helpers live in the owning module:
      - GuardHelper / Edge announcements     -> RimWorldAccess_Common.xml
      - Typeahead "Search cleared"           -> RimWorldAccess_Common.xml
      - Map cursor "Invalid position"        -> RimWorldAccess_Input.xml
      - CaravanQuantityHelper "Taking X of Y, N kg, capacity limit" etc.
      - CaravanAnnouncementHelper item/search announcements
      - CaravanStatFormatter Mass/Speed/Food/Foraging/Visibility
      - CaravanInputHelper pawn-info shortcut announcements (Alt+H/M/N)
      - CaravanUIHelper helpers
      - PawnLabelHelper grouped pawn labels
    These will be localized by the World/UI modules; TransportPods delegates.

    One/Many splits exist where a bare count + noun is spoken in English, so
    translators can pick different plural classes (pod/pods). Mass and fuel
    announcements use whole-phrase keys per semantic case to keep word order
    localizable.
  -->

  <!-- =========================================================
       TransportPodHelper.cs - pod and fuel-cost announcement parts.
       ========================================================= -->

  <!-- Pod type labels. IsShuttle() picks between them for BuildPodAnnouncement
       and GetPodTypeLabel. Shuttles are Royalty DLC; transport pods are base. -->
  <RimWorldAccess.TransportPods.Pod.TypeTransportPod>Транспортна капсула</RimWorldAccess.TransportPods.Pod.TypeTransportPod>
  <RimWorldAccess.TransportPods.Pod.TypeShuttle>Шатл</RimWorldAccess.TransportPods.Pod.TypeShuttle>

  <!-- Per-pod announcement fragments (BuildPodAnnouncement). Joined with ", ".
       {0} = formatted fuel/capacity value, {1} = 1-based index, {2} = total. -->
  <RimWorldAccess.TransportPods.Pod.Selected>ВИБРАНО</RimWorldAccess.TransportPods.Pod.Selected>
  <RimWorldAccess.TransportPods.Pod.FuelLevel>паливо {0}</RimWorldAccess.TransportPods.Pod.FuelLevel>
  <RimWorldAccess.TransportPods.Pod.NotConnectedToFuel>не з'єднано з паливом</RimWorldAccess.TransportPods.Pod.NotConnectedToFuel>
  <RimWorldAccess.TransportPods.Pod.Capacity>місткість {0} кг</RimWorldAccess.TransportPods.Pod.Capacity>
  <RimWorldAccess.TransportPods.Pod.PositionInList>{0} з {1}</RimWorldAccess.TransportPods.Pod.PositionInList>

  <!-- Fuel cost announcement (BuildFuelCostAnnouncement). Shared with
       TransportPodLaunchState.GetFuelCostAnnouncementForTile. {0} = fuel cost,
       {1} = fuel available. "NoLauncher" and "Unavailable" are defensive
       fallbacks when the launchable or its props are missing. -->
  <RimWorldAccess.TransportPods.Fuel.NoLauncher>немає пускового пристрою</RimWorldAccess.TransportPods.Fuel.NoLauncher>
  <RimWorldAccess.TransportPods.Fuel.CostUnavailable>вартість палива недоступна</RimWorldAccess.TransportPods.Fuel.CostUnavailable>
  <RimWorldAccess.TransportPods.Fuel.NotEnough>НЕДОСТАТНЬО ПАЛИВА, потрібно {0}, наявно {1}</RimWorldAccess.TransportPods.Fuel.NotEnough>
  <RimWorldAccess.TransportPods.Fuel.CostChemfuel>{0} хімпалива</RimWorldAccess.TransportPods.Fuel.CostChemfuel>
  <RimWorldAccess.TransportPods.Fuel.OutOfRange>ПОЗА МЕЖАМИ ДАЛЬНОСТІ</RimWorldAccess.TransportPods.Fuel.OutOfRange>

  <!-- =========================================================
       TransportPodPatch.cs - custom grouping gizmos and overlays.
       ========================================================= -->

  <!-- "Group all available pods" gizmo (CompTransporter_GetGizmos_Patch).
       Label: {0} = total pod count (source + all groupable).
       Desc: {0} = same count. Spoken when a sighted player reads the gizmo.
       NoGroupable: disable reason when no adjacent launchers are found;
       reused by the "Select pods to group" gizmo. -->
  <RimWorldAccess.TransportPods.Gizmo.GroupAllLabel>Згрупувати всі доступні капсули ({0})</RimWorldAccess.TransportPods.Gizmo.GroupAllLabel>
  <RimWorldAccess.TransportPods.Gizmo.GroupAllDesc>Вибрати всі доступні транспортні капсули ({0}) та відкрити діалог завантаження.</RimWorldAccess.TransportPods.Gizmo.GroupAllDesc>
  <RimWorldAccess.TransportPods.Gizmo.SelectPodsLabel>Вибрати капсули для групування</RimWorldAccess.TransportPods.Gizmo.SelectPodsLabel>
  <RimWorldAccess.TransportPods.Gizmo.SelectPodsDesc>Увійти в режим вибору капсул, щоб обрати, які транспортні капсули згрупувати разом для завантаження.</RimWorldAccess.TransportPods.Gizmo.SelectPodsDesc>
  <RimWorldAccess.TransportPods.Gizmo.NoGroupable>Немає інших транспортних капсул із з'єднаними пусковими пристроями для групування.</RimWorldAccess.TransportPods.Gizmo.NoGroupable>

  <!-- Gizmo action results. {0} = pod count being grouped. -->
  <RimWorldAccess.TransportPods.Gizmo.LoadCommandMissing>Не вдалося знайти команду завантаження</RimWorldAccess.TransportPods.Gizmo.LoadCommandMissing>
  <RimWorldAccess.TransportPods.Gizmo.GroupingForLoading>Групування {0} капсул для завантаження</RimWorldAccess.TransportPods.Gizmo.GroupingForLoading>

  <!-- Dialog lifecycle (Window_PostClose_LoadTransporters_Patch). Spoken when
       the user closes the loading dialog without pressing Accept. -->
  <RimWorldAccess.TransportPods.Loading.Cancelled>Завантаження транспортної капсули скасовано</RimWorldAccess.TransportPods.Loading.Cancelled>

  <!-- Visual keyboard-mode overlay (Dialog_LoadTransporters_DoWindowContents_Patch).
       Sighted-user indicator drawn in the top-left of the loading dialog so
       testers can tell keyboard mode is active. Localized for consistency. -->
  <RimWorldAccess.TransportPods.Overlay.KeyboardModeActive>Режим клавіатури активний</RimWorldAccess.TransportPods.Overlay.KeyboardModeActive>
  <RimWorldAccess.TransportPods.Overlay.InstructionsLine1>Вліво/Вправо: вкладки | Вгору/Вниз: предмети | Enter/Пробіл: кількість</RimWorldAccess.TransportPods.Overlay.InstructionsLine1>
  <RimWorldAccess.TransportPods.Overlay.InstructionsLine2>Tab: підсумок ваги | Alt+I: огляд | Alt+A: прийняти | Esc: скасувати</RimWorldAccess.TransportPods.Overlay.InstructionsLine2>

  <!-- Landing-spot targeting announcement (Targeter_BeginTargeting_Announce_Patch).
       Spoken once when the drop-pod landing targeter activates. -->
  <RimWorldAccess.TransportPods.Landing.SelectLandingSpot>Виберіть місце приземлення. Використовуйте стрілки для навігації, Пробіл для підтвердження.</RimWorldAccess.TransportPods.Landing.SelectLandingSpot>

