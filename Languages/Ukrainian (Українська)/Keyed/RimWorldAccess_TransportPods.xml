  <!-- Map-portal (Dialog_EnterPortal) announcements, shared via EnterPortalAdapter.
       {0} = the portal's localized EnterString (e.g. "Enter ancient complex"). -->
  <RimWorldAccess.TransportPods.Portal.OpenAnnouncement>{0}. Вліво/Вправо для вкладок, Пробіл або Enter для вибору, Alt S для підтвердження.</RimWorldAccess.TransportPods.Portal.OpenAnnouncement>
  <RimWorldAccess.TransportPods.Portal.Cancelled>{0}: скасовано</RimWorldAccess.TransportPods.Portal.Cancelled>
  <RimWorldAccess.TransportPods.Portal.FallbackEnter>Завантажити портал</RimWorldAccess.TransportPods.Portal.FallbackEnter>
  <RimWorldAccess.TransportPods.Portal.FallbackLoading>Завантаження</RimWorldAccess.TransportPods.Portal.FallbackLoading>
  <!-- Localization guardrail (D.8) sweep — previously hardcoded English. -->
  <RimWorldAccess.TransportPods.Loading.TabSummary>Вкладка {0}, предметів: {1}</RimWorldAccess.TransportPods.Loading.TabSummary>
</LanguageData>
