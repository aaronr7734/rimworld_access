  <RimWorldAccess.TransportPods.Loading.TabAnnouncement>Вкладка {0}, предметів: {1}</RimWorldAccess.TransportPods.Loading.TabAnnouncement>
  <RimWorldAccess.TransportPods.Loading.ReturnedToTab>Повернення до вкладки {0}</RimWorldAccess.TransportPods.Loading.ReturnedToTab>

  <!-- Shared empty-tab feedback (spoken in multiple navigation paths). -->
  <RimWorldAccess.TransportPods.Loading.NoItemsInTab>У цій вкладці немає предметів</RimWorldAccess.TransportPods.Loading.NoItemsInTab>

  <!-- Activation and quantity actions. {0} = item label. -->
  <RimWorldAccess.TransportPods.Loading.ItemChecked>{0}: позначено</RimWorldAccess.TransportPods.Loading.ItemChecked>
  <RimWorldAccess.TransportPods.Loading.ItemUnchecked>{0}: знято позначку</RimWorldAccess.TransportPods.Loading.ItemUnchecked>
  <RimWorldAccess.TransportPods.Loading.ItemRemoved>{0}: вилучено</RimWorldAccess.TransportPods.Loading.ItemRemoved>

  <!-- Inspect results. -->
  <RimWorldAccess.TransportPods.Loading.NoItemToInspect>Немає предмета для огляду</RimWorldAccess.TransportPods.Loading.NoItemToInspect>
  <RimWorldAccess.TransportPods.Loading.CannotInspectItem>Неможливо оглянути цей предмет</RimWorldAccess.TransportPods.Loading.CannotInspectItem>

