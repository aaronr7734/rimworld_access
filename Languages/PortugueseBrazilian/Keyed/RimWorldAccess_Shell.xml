  <!-- ScreenScope shared screen shape (screen-model refactor): the
       automatic Toolbar region name and the empty-region word. -->
  <RimWorldAccess.Shell.Screen.ActionsRegion>Barra de ferramentas</RimWorldAccess.Shell.Screen.ActionsRegion>
  <RimWorldAccess.Shell.Screen.ExtrasRegion>Controles adicionais</RimWorldAccess.Shell.Screen.ExtrasRegion>
  <RimWorldAccess.Shell.Screen.EmptyRegion>vazio</RimWorldAccess.Shell.Screen.EmptyRegion>

  <!-- Fail-safe (B1, semantic quality campaign): spoken once when a scope's own model build
       throws, so the player is told the window went unreadable instead of finding every key
       (including Escape) silently swallowed. See ScreenScope.RefreshModel. -->
  <RimWorldAccess.Shell.ScopeFailed>O suporte de leitor de tela desta janela encontrou um erro. Pressione Esc para fechar a janela.</RimWorldAccess.Shell.ScopeFailed>

  <!-- Band label inheritance (C1, semantic quality campaign): an unlabeled twin control that
       inherited a neighbouring control's caption (BandLabelInheritance/GenericWindowScope).
       {0} is the inherited label, {1} the 1-based ordinal ("Ideology 2"). -->
  <RimWorldAccess.Shell.BandOrdinalLabel>{0} {1}</RimWorldAccess.Shell.BandOrdinalLabel>

  <!-- Silent content swap echo (S8, meaning campaign): a captured Button whose click replaced
       the window's whole page with no dialog, no menu, and no state change on the acted row
       itself (Colony Manager Redux's "New job" button, which swaps the page to a fresh draft
       job's settings) — the honest, generic summary a keyboard user gets instead of dead
       silence. {0} is the new presentation row count. See GenericWindowScope.ResolvePendingStateChange. -->
  <RimWorldAccess.Shell.ContentChanged>Conteúdo da janela alterado. {0} itens.</RimWorldAccess.Shell.ContentChanged>
  <RimWorldAccess.Shell.ContentReordered>Itens reordenados.</RimWorldAccess.Shell.ContentReordered>

  <!-- Enter double-press proceed (DefaultAcceptActionId, S4c): the first Enter on an
       inert element arms this prompt instead of doing nothing; a second Enter on the
       same element fires the screen's default/proceed button. {0} is that button's label. -->
  <RimWorldAccess.Shell.Screen.PressEnterAgain>Pressione Enter novamente para ativar {0}.</RimWorldAccess.Shell.Screen.PressEnterAgain>

  <!-- Shift+Enter one-chord proceed (SharedMenuGrammar.ActivateDefault, QA session 5):
       presses the screen's default/proceed button from anywhere, bypassing the focused
       control. PressingDefault is spoken BEFORE the button fires because the player
       chose not to look the button up first; {0} is that button's label. -->
  <RimWorldAccess.Shell.Screen.PressingDefault>Pressionando {0}.</RimWorldAccess.Shell.Screen.PressingDefault>
  <RimWorldAccess.Shell.Screen.NoDefaultButton>Esta tela não tem um botão padrão.</RimWorldAccess.Shell.Screen.NoDefaultButton>

  <!-- Shared reorder grammar (SharedMenuGrammar.ReorderUp/Down/Left/Right,
       ScreenScope's Ctrl+Up/Down seam): the mod-wide keyboard equivalent of
       the player's drag-and-drop gesture. MovedBetween/MovedToTop/MovedToBottom
       name the item's new neighbors ({0}/{1} are neighbor labels, above then
       below); Moved is the fallback when a neighbor's label cannot be resolved.
       Whichever phrase is chosen prefixes the standard full item announcement
       ("Moved between Duster and Parka. Duster, 3 of 7."); CannotReorder is the
       refusal when the subclass's mutation vehicle vetoes the move. -->
  <RimWorldAccess.Shell.Screen.Moved>Movido.</RimWorldAccess.Shell.Screen.Moved>
  <RimWorldAccess.Shell.Screen.MovedBetween>Movido entre {0} e {1}.</RimWorldAccess.Shell.Screen.MovedBetween>
  <RimWorldAccess.Shell.Screen.MovedToTop>Movido para o topo, acima de {0}.</RimWorldAccess.Shell.Screen.MovedToTop>
  <RimWorldAccess.Shell.Screen.MovedToBottom>Movido para o final, abaixo de {0}.</RimWorldAccess.Shell.Screen.MovedToBottom>
  <RimWorldAccess.Shell.Screen.CannotReorder>Este item não pode ser movido.</RimWorldAccess.Shell.Screen.CannotReorder>

  <!-- Table regions (docs/table-model.md): the shared table grammar spoken
       by AnnouncementComposer.ComposeCell for every table in the mod.
       {0}/{1} in the position phrases are 1-based (the header row is row 1). -->
  <RimWorldAccess.Shell.Screen.TabCount>{0} seções</RimWorldAccess.Shell.Screen.TabCount>
  <RimWorldAccess.Shell.Screen.SectionPosition>seção {0} de {1}</RimWorldAccess.Shell.Screen.SectionPosition>
  <RimWorldAccess.Shell.Table.RowPosition>linha {0} de {1}</RimWorldAccess.Shell.Table.RowPosition>
  <RimWorldAccess.Shell.Table.ColumnPosition>coluna {0} de {1}</RimWorldAccess.Shell.Table.ColumnPosition>
  <RimWorldAccess.Shell.Table.Dimensions>tabela, {0} colunas, {1} linhas</RimWorldAccess.Shell.Table.Dimensions>
  <RimWorldAccess.Shell.Table.SortedBy>Ordenado por {0}, {1}</RimWorldAccess.Shell.Table.SortedBy>
  <RimWorldAccess.Shell.Table.SortCleared>Ordenação removida, ordem padrão</RimWorldAccess.Shell.Table.SortCleared>
  <RimWorldAccess.Shell.Table.NotSortable>Esta coluna não pode ser ordenada</RimWorldAccess.Shell.Table.NotSortable>
  <RimWorldAccess.Shell.Table.SortHint>Enter ordena</RimWorldAccess.Shell.Table.SortHint>

  <!-- Cross-region typeahead (docs/table-model.md section 7): the locating
       frame spoken after a search jump lands in another region, and the
       fallback name for unnamed regions on generic screens ({0} is the
       1-based tab number). -->
  <RimWorldAccess.Shell.Search.NowAt>Agora em {0}</RimWorldAccess.Shell.Search.NowAt>
  <RimWorldAccess.Shell.Search.UnnamedTab>aba {0}</RimWorldAccess.Shell.Search.UnnamedTab>

  <!-- Transfer-screen table columns (table-model T3, TransferableTableColumns).
       Vanilla shows these columns as icons with hover tooltips and has no short
       text labels for them, so the mod provides its own. DaysValue's {0} is a
       decimal day count (e.g. "3.5"); CanGraze replaces vanilla's grazing icon
       in the foraged-food column for animals that graze. -->
  <RimWorldAccess.Shell.Table.Transferable.DaysUntilRot>Dias até apodrecer</RimWorldAccess.Shell.Table.Transferable.DaysUntilRot>
  <RimWorldAccess.Shell.Table.Transferable.DaysValue>{0} dias</RimWorldAccess.Shell.Table.Transferable.DaysValue>
  <RimWorldAccess.Shell.Table.Transferable.CanGraze>Pode pastar</RimWorldAccess.Shell.Table.Transferable.CanGraze>

  <!-- Generic pawn-table tier (table-model T5, GenericPawnTableScope).
       CellNotReadable is the honest fallback for an unknown mod column's
       cell; Incapable mirrors the work tab's disabled-work meaning; Trained
       marks a completed animal training. HourRange/HourSingle format a
       timetable cell's contiguous segments: hour params are 0-23, the last
       param is the assignment label. PawnTableRegion names a pawn table
       whose main button carries no label. -->
  <RimWorldAccess.Shell.Generic.CellNotReadable>valor não disponível</RimWorldAccess.Shell.Generic.CellNotReadable>
  <RimWorldAccess.Shell.Generic.Incapable>incapaz</RimWorldAccess.Shell.Generic.Incapable>
  <RimWorldAccess.Shell.Generic.Trained>treinado</RimWorldAccess.Shell.Generic.Trained>
  <RimWorldAccess.Shell.Generic.HourRange>{0} a {1}: {2}</RimWorldAccess.Shell.Generic.HourRange>
  <RimWorldAccess.Shell.Generic.HourSingle>{0}: {1}</RimWorldAccess.Shell.Generic.HourSingle>
  <RimWorldAccess.Shell.Generic.PawnTableRegion>Tabela de personagens</RimWorldAccess.Shell.Generic.PawnTableRegion>
