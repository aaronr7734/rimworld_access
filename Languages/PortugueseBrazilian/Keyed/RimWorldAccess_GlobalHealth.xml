<LanguageData>
  <!-- Health overview screen (src/Shell/Screens/GlobalHealthScope.Game.cs). -->
  <RimWorldAccess.GlobalHealth.Title>Visão geral da saúde</RimWorldAccess.GlobalHealth.Title>
  <RimWorldAccess.GlobalHealth.RegionName>Personagens</RimWorldAccess.GlobalHealth.RegionName>
  <RimWorldAccess.GlobalHealth.Node.DownedBleeding>Abatidos e sangrando</RimWorldAccess.GlobalHealth.Node.DownedBleeding>
  <RimWorldAccess.GlobalHealth.Node.Downed>Abatidos</RimWorldAccess.GlobalHealth.Node.Downed>
  <RimWorldAccess.GlobalHealth.Node.Bleeding>Sangrando</RimWorldAccess.GlobalHealth.Node.Bleeding>
  <RimWorldAccess.GlobalHealth.Node.Injured>Feridos</RimWorldAccess.GlobalHealth.Node.Injured>
  <!-- Node summaries. {0} = the node's name (one of the Node strings above), {1} = how many pawns it holds, then {2} (or {1} in the One forms) = the soonest time left before bleeding out ("2 hours") or the lowest overall health ("38%"). NotSoon is used when no one in the node bleeds out within a day. -->
  <RimWorldAccess.GlobalHealth.Summary.None>{0}. Nenhum</RimWorldAccess.GlobalHealth.Summary.None>
  <RimWorldAccess.GlobalHealth.Summary.BleedOut>{0}. {1} personagens, o mais próximo sangra até a morte em {2}</RimWorldAccess.GlobalHealth.Summary.BleedOut>
  <RimWorldAccess.GlobalHealth.Summary.BleedOutOne>{0}. 1 personagem, sangra até a morte em {1}</RimWorldAccess.GlobalHealth.Summary.BleedOutOne>
  <RimWorldAccess.GlobalHealth.Summary.NotSoon>{0}. {1} personagens, nenhum em perigo imediato</RimWorldAccess.GlobalHealth.Summary.NotSoon>
  <RimWorldAccess.GlobalHealth.Summary.NotSoonOne>{0}. 1 personagem, sem perigo imediato</RimWorldAccess.GlobalHealth.Summary.NotSoonOne>
  <RimWorldAccess.GlobalHealth.Summary.Deathless>{0}. {1} personagens, todos imortais</RimWorldAccess.GlobalHealth.Summary.Deathless>
  <RimWorldAccess.GlobalHealth.Summary.DeathlessOne>{0}. 1 personagem, imortal</RimWorldAccess.GlobalHealth.Summary.DeathlessOne>
  <RimWorldAccess.GlobalHealth.Summary.LowestHealth>{0}. {1} personagens, menor saúde {2}</RimWorldAccess.GlobalHealth.Summary.LowestHealth>
  <RimWorldAccess.GlobalHealth.Summary.HealthOne>{0}. 1 personagem, {1} de saúde</RimWorldAccess.GlobalHealth.Summary.HealthOne>
  <!-- {0} = the pawn's name with its group (one of the PawnGroup strings below), {1} = its health tag (one of the PawnHealth.Tag strings below). -->
  <RimWorldAccess.GlobalHealth.PawnRow>{0}. {1}</RimWorldAccess.GlobalHealth.PawnRow>
  <!-- After a filter checkbox is toggled. {0} = the checkbox's new state ("checked"), {1} = how many pawns are now listed. -->
  <RimWorldAccess.GlobalHealth.FilterChanged>{0}. {1} personagens listados.</RimWorldAccess.GlobalHealth.FilterChanged>
  <RimWorldAccess.GlobalHealth.FilterChangedOne>{0}. 1 personagem listado.</RimWorldAccess.GlobalHealth.FilterChangedOne>
  <RimWorldAccess.GlobalHealth.JumpUnavailable>Não é possível localizar o personagem.</RimWorldAccess.GlobalHealth.JumpUnavailable>
  <!-- Pawn health tags, spoken on health overview rows and after scanner pawns. {0} = overall health ("45%"), {1} = time left before bleeding out ("2 hours"). The bleeding words mirror the vanilla health tab: "no immediate danger" past a day, "deathless" for the Biotech gene. -->
  <RimWorldAccess.PawnHealth.Tag.Health>{0} de saúde</RimWorldAccess.PawnHealth.Tag.Health>
  <RimWorldAccess.PawnHealth.Tag.Downed>abatido, {0} de saúde</RimWorldAccess.PawnHealth.Tag.Downed>
  <RimWorldAccess.PawnHealth.Tag.Bleeding>sangrando até a morte em {1}, {0} de saúde</RimWorldAccess.PawnHealth.Tag.Bleeding>
  <RimWorldAccess.PawnHealth.Tag.DownedBleeding>abatido, sangrando até a morte em {1}, {0} de saúde</RimWorldAccess.PawnHealth.Tag.DownedBleeding>
  <RimWorldAccess.PawnHealth.Tag.BleedingNotSoon>sangrando, sem perigo imediato, {0} de saúde</RimWorldAccess.PawnHealth.Tag.BleedingNotSoon>
  <RimWorldAccess.PawnHealth.Tag.DownedBleedingNotSoon>abatido, sangrando, sem perigo imediato, {0} de saúde</RimWorldAccess.PawnHealth.Tag.DownedBleedingNotSoon>
  <RimWorldAccess.PawnHealth.Tag.BleedingDeathless>sangrando, imortal, {0} de saúde</RimWorldAccess.PawnHealth.Tag.BleedingDeathless>
  <RimWorldAccess.PawnHealth.Tag.DownedBleedingDeathless>abatido, sangrando, imortal, {0} de saúde</RimWorldAccess.PawnHealth.Tag.DownedBleedingDeathless>
  <!-- Pawn group tags, shared by the health overview and the gear menu. {0} = the pawn's short name. Wild is a pawn with no faction, like a wild man. -->
